<%- include('../layouts/header') %>

    <style>
        .hero-glass {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.4);
        }

        .portal-card {
            background: white;
            border-radius: 2.5rem;
            border: 1px solid #f1f5f9;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.03);
        }

        .stat-pill {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            padding: 12px 24px;
            border-radius: 1.5rem;
            transition: all 0.3s ease;
        }

        .stat-pill:hover {
            background: #ffffff;
            border-color: #6366f1;
            transform: translateY(-2px);
        }
    </style>

    <div class="min-h-screen bg-slate-50 pt-24 pb-20">
        <!-- Immersive College Hero -->
        <div class="hero-glass py-16 px-4 md:px-8 mb-12">
            <div class="max-w-7xl mx-auto flex flex-col lg:flex-row justify-between items-center gap-10">
                <div class="flex flex-col md:flex-row items-center gap-10 text-center md:text-left">
                    <div
                        class="w-32 h-32 bg-gradient-to-br from-indigo-600 to-purple-600 rounded-[2.5rem] flex items-center justify-center text-white text-5xl shadow-2xl relative">
                        <i class="fas fa-university"></i>
                        <div
                            class="absolute -bottom-2 -right-2 w-10 h-10 bg-emerald-500 rounded-full border-4 border-white flex items-center justify-center text-white text-xs">
                            <i class="fas fa-check"></i>
                        </div>
                    </div>
                    <div>
                        <h1 class="text-4xl md:text-5xl font-black text-slate-900 tracking-tight mb-3">
                            <%= college.name %>
                        </h1>
                        <div class="flex flex-wrap justify-center md:justify-start gap-4 items-center">
                            <p class="text-slate-500 text-lg font-bold flex items-center gap-2">
                                <i class="fas fa-map-marker-alt text-indigo-500"></i>
                                <%= college.location %>
                            </p>
                            <span class="text-slate-200">|</span>
                            <p class="text-indigo-600 font-black uppercase tracking-widest text-sm">
                                <%= college.university %>
                            </p>
                        </div>
                        <% if (college.isSponsored) { %>
                            <div class="mt-6 flex justify-center md:justify-start">
                                <span
                                    class="px-5 py-2 bg-amber-50 text-amber-600 text-[10px] font-black uppercase tracking-[0.2em] rounded-full border border-amber-200 shadow-sm">
                                    <i class="fas fa-gem mr-1"></i> Platinum Partner
                                </span>
                            </div>
                            <% } %>
                    </div>
                </div>

                <div class="flex flex-wrap justify-center gap-4">
                    <a href="/student/chat/<%= college.userId %>"
                        class="px-8 py-4 bg-white border border-slate-200 rounded-2xl text-slate-800 font-black text-xs uppercase tracking-widest hover:bg-slate-50 transition-all flex items-center gap-3 shadow-sm">
                        <i class="fas fa-comment-dots text-indigo-500"></i> Instant Inquiry
                    </a>
                    <% if (alreadyApplied) { %>
                        <button
                            class="px-8 py-4 bg-emerald-500 text-white rounded-2xl font-black text-xs uppercase tracking-widest flex items-center gap-3 shadow-xl shadow-emerald-100"
                            disabled>
                            <i class="fas fa-check-double"></i> Applied Successfully
                        </button>
                        <% } else { %>
                            <button onclick="document.getElementById('applyModal').classList.remove('hidden')"
                                class="px-8 py-4 bg-indigo-600 text-white rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-slate-900 transition-all shadow-2xl shadow-indigo-100 flex items-center gap-3 active:scale-95">
                                <i class="fas fa-file-signature"></i> Begin Application
                            </button>
                            <% } %>
                </div>
            </div>
        </div>

        <div class="max-w-7xl mx-auto px-4 md:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12">
            <!-- Main Content Core -->
            <div class="lg:col-span-8 space-y-12">
                <!-- Academic Showcase -->
                <div class="portal-card p-10 md:p-14">
                    <h2 class="text-3xl font-black text-slate-900 mb-8 tracking-tight flex items-center gap-4">
                        <span class="w-2 h-10 bg-indigo-600 rounded-full"></span>
                        Institutional Overview
                    </h2>
                    <div class="prose prose-slate max-w-none">
                        <p class="text-slate-600 text-lg leading-loose font-medium whitespace-pre-line">
                            <%= college.description
                                || "As a premier destination for higher education, this institution focuses on creating an environment that fosters innovation, critical thinking, and professional excellence."
                                %>
                        </p>
                    </div>

                    <!-- Key Highlights Stats -->
                    <div class="grid grid-cols-2 md:grid-cols-3 gap-6 mt-12">
                        <div class="stat-pill">
                            <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Affiliation
                            </p>
                            <p class="text-slate-800 font-black truncate">
                                <%= college.university %>
                            </p>
                        </div>
                        <div class="stat-pill">
                            <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Campus</p>
                            <p class="text-slate-800 font-black truncate">
                                <%= college.location %>
                            </p>
                        </div>
                        <div class="stat-pill">
                            <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Status</p>
                            <p class="text-emerald-500 font-black">Admissions Open</p>
                        </div>
                    </div>
                </div>

                <!-- Features Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div
                        class="bg-indigo-600 p-10 rounded-[2.5rem] text-white relative overflow-hidden group shadow-2xl shadow-indigo-200">
                        <div class="relative z-10">
                            <div class="w-14 h-14 bg-white/10 rounded-2xl flex items-center justify-center mb-6">
                                <i class="fas fa-lightbulb text-xl"></i>
                            </div>
                            <h3 class="text-2xl font-black mb-4 tracking-tight">Career Guidance</h3>
                            <p class="text-indigo-100/80 text-sm leading-relaxed mb-10 font-medium">Speak directly with
                                our expert admission officers to find the right course for your career goals.</p>
                            <a href="/student/chat/<%= college.userId %>"
                                class="inline-flex items-center gap-3 px-6 py-3 bg-white text-indigo-600 rounded-xl font-black text-xs uppercase tracking-widest hover:bg-indigo-50 transition-all">
                                Connect Now <i class="fas fa-arrow-right text-[10px]"></i>
                            </a>
                        </div>
                        <i
                            class="fas fa-rocket absolute -bottom-6 -right-6 text-9xl text-indigo-500 opacity-20 transform -rotate-12 group-hover:scale-110 transition-transform duration-700"></i>
                    </div>

                    <div class="portal-card p-10 border-dashed border-2 border-slate-200 bg-slate-50/30">
                        <h3 class="text-xl font-black text-slate-900 mb-8 tracking-tight">Institutional Resources</h3>
                        <div class="space-y-4">
                            <a href="<%= college.website %>" target="_blank"
                                class="flex items-center justify-between p-5 bg-white rounded-2xl border border-slate-100 hover:border-indigo-200 hover:shadow-md transition-all group">
                                <span class="text-sm font-black text-slate-700">Course Catalogue</span>
                                <i
                                    class="fas fa-external-link-alt text-xs text-slate-300 group-hover:text-indigo-500"></i>
                            </a>
                            <a href="#"
                                class="flex items-center justify-between p-5 bg-white rounded-2xl border border-slate-100 hover:border-indigo-200 hover:shadow-md transition-all group opacity-50 cursor-not-allowed">
                                <span class="text-sm font-black text-slate-700">Campus Tour (Coming Soon)</span>
                                <i class="fas fa-video text-xs text-slate-300"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Strategic Actions Sidebar -->
            <div class="lg:col-span-4 space-y-10">
                <!-- Admission Office Card -->
                <div class="bg-slate-900 rounded-[2.5rem] p-10 text-white relative overflow-hidden shadow-2xl">
                    <div
                        class="absolute -top-20 -right-20 w-64 h-64 bg-indigo-500 rounded-full blur-[100px] opacity-20">
                    </div>
                    <div class="relative z-10">
                        <h3 class="text-2xl font-black mb-8 flex items-center gap-3">
                            <span class="w-1.5 h-6 bg-indigo-500 rounded-full"></span>
                            Office Access
                        </h3>
                        <div class="space-y-8">
                            <div>
                                <p class="text-[10px] font-black text-indigo-400 uppercase tracking-[0.2em] mb-3">
                                    Principal Support</p>
                                <div class="flex items-center gap-4 group">
                                    <div
                                        class="w-12 h-12 bg-white/5 rounded-2xl flex items-center justify-center group-hover:bg-white group-hover:text-slate-900 transition-all">
                                        <i class="fas fa-envelope"></i>
                                    </div>
                                    <p class="text-slate-200 font-bold truncate text-sm">
                                        <%= college.contactEmail %>
                                    </p>
                                </div>
                            </div>
                            <div>
                                <p class="text-[10px] font-black text-indigo-400 uppercase tracking-[0.2em] mb-3">
                                    Official Gateway</p>
                                <a href="<%= college.website %>" target="_blank" class="flex items-center gap-4 group">
                                    <div
                                        class="w-12 h-12 bg-white/5 rounded-2xl flex items-center justify-center group-hover:bg-white group-hover:text-slate-900 transition-all">
                                        <i class="fas fa-globe"></i>
                                    </div>
                                    <p class="text-slate-200 font-bold text-sm">Visit Web Portal <i
                                            class="fas fa-external-link-alt text-[10px] ml-1 opacity-40"></i></p>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Smart Notification -->
                <div
                    class="p-8 bg-gradient-to-br from-amber-50 to-white rounded-[2rem] border border-amber-100 shadow-sm relative overflow-hidden">
                    <div class="absolute top-0 right-0 w-24 h-24 bg-amber-200/20 rounded-full -mr-12 -mt-12"></div>
                    <div class="relative z-10">
                        <h4 class="text-amber-900 font-black flex items-center gap-2 mb-3">
                            <i class="fas fa-info-circle"></i> Verification
                        </h4>
                        <p class="text-amber-900/70 text-sm leading-relaxed font-bold">Applications through this portal
                            are verified and prioritized by the college administration. Ensure all academic records
                            match your official documents.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Premium Application Modal -->
    <div id="applyModal"
        class="fixed inset-0 bg-slate-900/60 backdrop-blur-xl z-50 hidden flex items-center justify-center p-4">
        <div
            class="bg-white rounded-[3.5rem] shadow-2xl w-full max-w-2xl overflow-hidden scale-entering border border-white">
            <div class="p-10 border-b border-slate-50 flex justify-between items-center bg-slate-50/50">
                <div>
                    <h2 class="text-3xl font-black text-slate-900 tracking-tight">Apply to Institution</h2>
                    <p class="text-[10px] text-slate-400 font-black uppercase tracking-[0.2em] mt-1">Enrollment Session
                        2024-25</p>
                </div>
                <button onclick="document.getElementById('applyModal').classList.add('hidden')"
                    class="w-14 h-14 flex items-center justify-center bg-white text-slate-300 hover:text-rose-500 rounded-2xl shadow-sm transition-all border border-slate-100">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>
            <form action="/college/apply/<%= college._id %>" method="POST" class="p-12">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="md:col-span-2 space-y-3">
                        <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest ml-1">Student Full
                            Name</label>
                        <input type="text" name="name"
                            class="w-full px-8 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 transition-all outline-none font-black text-slate-800"
                            placeholder="Required" required>
                    </div>
                    <div class="space-y-3">
                        <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest ml-1">Email
                            Connection</label>
                        <input type="email" name="email"
                            class="w-full px-8 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 transition-all outline-none font-bold text-slate-700"
                            value="<%= user.email %>" required>
                    </div>
                    <div class="space-y-3">
                        <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest ml-1">Mobile
                            Access</label>
                        <input type="tel" name="phone"
                            class="w-full px-8 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 transition-all outline-none font-bold text-slate-700"
                            placeholder="+91" required>
                    </div>
                    <div class="space-y-3">
                        <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest ml-1">Grade 10th
                            Aggregate</label>
                        <input type="number" step="0.01" name="marks_10th"
                            class="w-full px-8 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 transition-all outline-none font-black text-slate-800"
                            placeholder="%" required>
                    </div>
                    <div class="space-y-3">
                        <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest ml-1">Grade 12th
                            Aggregate</label>
                        <input type="number" step="0.01" name="marks_12th"
                            class="w-full px-8 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 transition-all outline-none font-black text-slate-800"
                            placeholder="%" required>
                    </div>
                    <div class="md:col-span-2 space-y-3">
                        <label
                            class="text-[10px] font-black text-slate-500 uppercase tracking-widest ml-1">Specialization
                            Stream</label>
                        <input type="text" name="preferredBranch"
                            class="w-full px-8 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 transition-all outline-none font-black text-slate-800 uppercase"
                            placeholder="e.g. SOFTWARE ENGINEERING" required>
                    </div>
                </div>
                <div class="mt-12 flex gap-8">
                    <button type="button" onclick="document.getElementById('applyModal').classList.add('hidden')"
                        class="flex-1 py-5 bg-slate-100 text-slate-500 rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-slate-200 transition-all">Discard</button>
                    <button type="submit"
                        class="flex-1 py-5 bg-indigo-600 text-white rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-slate-900 transition-all shadow-2xl shadow-indigo-100 active:scale-95">Send
                        Application</button>
                </div>
            </form>
        </div>
    </div>

    <style>
        @keyframes scale-in {
            from {
                opacity: 0;
                transform: scale(0.9) translateY(20px);
            }

            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        .scale-entering {
            animation: scale-in 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }
    </style>

    <%- include('../layouts/footer') %>