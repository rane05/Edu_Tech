<%- include('layouts/header'); %>
  <style>
    /* Clean SaaS Design Variables - Matching Login */
    :root {
      --bg-color: #F8FAFC;
      --card-bg: #FFFFFF;
      --text-main: #0F172A;
      --text-muted: #64748B;
      --primary: #4F46E5;
      --primary-hover: #4338CA;
      --border-color: #E2E8F0;
      --border-focus: #818CF8;
      --error-color: #EF4444;
      --warning-color: #F59E0B;
      --success-color: #10B981;
      --cyan-color: #06B6D4;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .font-heading {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      font-weight: 600;
      letter-spacing: -0.025em;
    }

    /* Layout & Card */
    .auth-container {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      position: relative;
      overflow: hidden;
      background: radial-gradient(circle at 50% 0%, #EEF2FF 0%, transparent 60%);
    }

    /* Ambient slow-moving highlight */
    .auth-container::before {
      content: '';
      position: absolute;
      width: 150vw;
      height: 150vh;
      background: radial-gradient(circle at center, rgba(99, 102, 241, 0.03) 0%, transparent 50%);
      top: -25vh;
      left: -25vw;
      animation: ambient-drift 20s infinite alternate ease-in-out;
      pointer-events: none;
      z-index: 0;
    }

    @keyframes ambient-drift {
      0% {
        transform: translate(0, 0) scale(1);
      }

      100% {
        transform: translate(-5%, 5%) scale(1.05);
      }
    }

    .auth-card {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(16px);
      width: 100%;
      max-width: 32rem;
      border-radius: 1.25rem;
      box-shadow:
        0 30px 60px -12px rgba(15, 23, 42, 0.1),
        0 18px 36px -18px rgba(15, 23, 42, 0.08),
        0 4px 6px -2px rgba(15, 23, 42, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.8);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.5), 0 30px 60px -12px rgba(15, 23, 42, 0.1), 0 18px 36px -18px rgba(15, 23, 42, 0.08);
      padding: 2.5rem;
      position: relative;
      z-index: 10;

      /* Entrance Animation */
      opacity: 0;
      transform: translateY(15px);
      animation: fade-slide-up 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes fade-slide-up {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Floating Label Inputs */
    .input-group {
      position: relative;
      margin-bottom: 1.25rem;
    }

    .form-input {
      width: 100%;
      background: #FFFFFF;
      border: 1px solid var(--border-color);
      border-radius: 0.6rem;
      color: var(--text-main);
      padding: 1.25rem 1rem 0.5rem;
      font-size: 0.95rem;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.01);
    }

    .form-input:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.15), 0 1px 2px rgba(0, 0, 0, 0.01);
      background: #FFFFFF;
    }

    .form-input.has-error {
      border-color: var(--error-color);
    }

    .form-input.has-error:focus {
      box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.15), 0 1px 2px rgba(0, 0, 0, 0.01);
    }

    .form-input.has-success {
      border-color: var(--success-color);
    }

    .form-label {
      position: absolute;
      left: 1rem;
      top: 1rem;
      color: var(--text-muted);
      font-size: 0.95rem;
      pointer-events: none;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      transform-origin: left top;
    }

    /* Floating state */
    .form-input:focus~.form-label,
    .form-input:not(:placeholder-shown)~.form-label {
      transform: translateY(-0.6rem) scale(0.75);
      color: var(--text-muted);
    }

    .form-input:focus~.form-label {
      color: var(--primary);
    }

    .form-input.has-error~.form-label {
      color: var(--error-color);
    }

    /* Buttons */
    .btn-primary {
      width: 100%;
      background-color: var(--primary);
      color: white;
      font-weight: 500;
      padding: 0.85rem 1rem;
      border-radius: 0.6rem;
      border: none;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.5rem;
      margin-top: 2rem;
      position: relative;
    }

    .btn-primary:hover {
      background-color: var(--primary-hover);
      transform: translateY(-2px);
      box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.25), 0 4px 6px -2px rgba(79, 70, 229, 0.1);
    }

    .btn-primary:active {
      transform: translateY(0);
      box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.2);
    }

    .btn-primary:disabled {
      background-color: var(--border-color);
      color: var(--text-muted);
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }

    /* Alert Banners */
    .alert-banner {
      padding: 0.85rem 1rem;
      border-radius: 0.6rem;
      font-size: 0.875rem;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
      overflow: hidden;
      /* Smooth expanding animation */
      animation: alert-slide-fade 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes alert-slide-fade {
      from {
        max-height: 0;
        opacity: 0;
        padding-top: 0;
        padding-bottom: 0;
        margin-bottom: 0;
        transform: translateY(-5px);
      }

      to {
        max-height: 200px;
        opacity: 1;
        transform: translateY(0);
      }
    }

    .alert-error {
      background-color: #FEF2F2;
      color: #991B1B;
      border: 1px solid #F87171;
    }

    /* Password Strength Indicator */
    .strength-meter {
      display: flex;
      gap: 4px;
      margin-top: 0.5rem;
      margin-bottom: 0.25rem;
    }

    .strength-segment {
      height: 4px;
      flex: 1;
      background-color: var(--border-color);
      border-radius: 2px;
      /* Lively width-first expansion */
      transition: background-color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .strength-text {
      font-size: 0.75rem;
      color: var(--text-muted);
      text-align: right;
      height: 1rem;
      transition: color 0.3s ease;
    }

    /* Role Selector Styling */
    .role-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem;
      margin-top: 0.5rem;
    }

    .role-card {
      border: 1px solid var(--border-color);
      border-radius: 0.6rem;
      padding: 1rem 0.5rem;
      text-align: center;
      cursor: pointer;
      background-color: white;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      /* Bouncy spring curve */
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.01);
    }

    .role-card:hover {
      border-color: #CBD5E1;
      background-color: #F8FAFC;
      transform: translateY(-2px);
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .role-input:checked+.role-card {
      border-color: var(--primary);
      background-color: #EEF2FF;
      /* indigo-50 */
      color: var(--primary);
      box-shadow: 0 0 0 1px var(--primary), 0 4px 6px -1px rgba(79, 70, 229, 0.1);
      transform: translateY(-2px);
    }

    .role-input:checked+.role-card i {
      color: var(--primary);
      transform: scale(1.1);
    }

    .role-input:checked+.role-card .role-title {
      color: var(--primary);
      font-weight: 600;
    }

    .role-icon {
      font-size: 1.25rem;
      color: var(--text-muted);
      margin-bottom: 0.5rem;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      display: block;
    }

    .role-title {
      font-size: 0.85rem;
      color: var(--text-main);
      transition: all 0.2s ease;
    }

    /* Loading Spinner */
    .spinner {
      width: 1.25rem;
      height: 1.25rem;
      border: 2px solid rgba(255, 255, 255, 0.3);
      border-radius: 50%;
      border-top-color: white;
      animation: spin 0.8s linear infinite;
      display: none;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    .is-loading .spinner {
      display: block;
    }

    .is-loading .btn-text {
      display: none;
    }

    /* Error Shake Animation (spring-like) */
    @keyframes alert-shake {

      0%,
      100% {
        transform: translateX(0);
      }

      15% {
        transform: translateX(-6px);
      }

      30% {
        transform: translateX(5px);
      }

      45% {
        transform: translateX(-3px);
      }

      60% {
        transform: translateX(2px);
      }

      75% {
        transform: translateX(-1px);
      }
    }

    .shake {
      animation: alert-shake 0.5s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
    }

    /* Success Checkmark */
    .input-success-icon {
      position: absolute;
      right: 1rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--success-color);
      opacity: 0;
      transition: opacity 0.2s ease;
      pointer-events: none;
    }

    .form-input.has-success~.input-success-icon {
      opacity: 1;
    }
  </style>

  <div class="auth-container">
    <div class="auth-card" id="auth-card">
      <div class="mb-8">
        <h1 class="font-heading text-2xl text-slate-900 mb-2 tracking-tight">Create your account</h1>
        <p class="text-sm text-slate-500">Join Edu_Tech to start your educational journey.</p>
      </div>

      <% if (locals.error && locals.error.length> 0) { %>
        <div class="alert-banner alert-error" id="error-banner">
          <i class="fas fa-exclamation-circle mt-0.5"></i>
          <div><%- locals.error %></div>
        </div>
        <% } %>

          <form id="registerForm" action="/register" method="POST" autocomplete="off" novalidate>
            <!-- Honeypot -->
            <input type="text" name="website_url" style="display:none" tabindex="-1" autocomplete="off">

            <!-- Role Selection -->
            <div class="mb-6">
              <label class="block text-sm font-medium text-slate-700 mb-2">I am signing up as a...</label>
              <div class="role-grid grid-cols-2 md:grid-cols-5 gap-4">
                <label class="relative">
                  <input type="radio" name="role" value="student" class="role-input sr-only" checked>
                  <div class="role-card">
                    <i class="fas fa-user-graduate role-icon"></i>
                    <div class="role-title">Student</div>
                  </div>
                </label>
                <label class="relative">
                  <input type="radio" name="role" value="teacher" class="role-input sr-only">
                  <div class="role-card">
                    <i class="fas fa-chalkboard-teacher role-icon"></i>
                    <div class="role-title">Teacher</div>
                  </div>
                </label>
                <label class="relative">
                  <input type="radio" name="role" value="parent" class="role-input sr-only">
                  <div class="role-card">
                    <i class="fas fa-users role-icon"></i>
                    <div class="role-title">Parent</div>
                  </div>
                </label>
                <label class="relative">
                  <input type="radio" name="role" value="college" class="role-input sr-only">
                  <div class="role-card">
                    <i class="fas fa-university role-icon"></i>
                    <div class="role-title">College</div>
                  </div>
                </label>
                <label class="relative">
                  <input type="radio" name="role" value="admin" class="role-input sr-only">
                  <div class="role-card">
                    <i class="fas fa-user-shield role-icon"></i>
                    <div class="role-title">Admin</div>
                  </div>
                </label>
              </div>
            </div>

            <div class="input-group">
              <!-- The backend uses "username" for identifier/email -->
              <input type="text" id="username" name="username"
                class="form-input <%= (locals.error && locals.error.length > 0) ? 'has-error' : '' %>" placeholder=" "
                required>
              <label class="form-label" for="username">Email address</label>
              <i class="fas fa-check-circle input-success-icon"></i>
            </div>

            <div class="input-group mb-1">
              <input type="password" id="password" name="password"
                class="form-input <%= (locals.error && locals.error.length > 0) ? 'has-error' : '' %>" placeholder=" "
                required>
              <label class="form-label" for="password">Create a password</label>
              <button type="button" onclick="togglePassword()"
                class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 transition-colors pt-2 focus:outline-none z-10">
                <i id="eye-icon" class="far fa-eye"></i>
              </button>
            </div>

            <!-- Password Strength Meter -->
            <div class="px-1 mb-6">
              <div class="strength-meter" id="strength-segments">
                <div class="strength-segment" id="seg-1"></div>
                <div class="strength-segment" id="seg-2"></div>
                <div class="strength-segment" id="seg-3"></div>
                <div class="strength-segment" id="seg-4"></div>
              </div>
              <div class="strength-text" id="strength-text">Password strength</div>
            </div>

            <button type="submit" id="submitBtn" class="btn-primary" disabled>
              <span class="btn-text">Create account</span>
              <div class="spinner"></div>
            </button>
          </form>

          <div class="mt-6 text-center text-sm text-slate-500">
            Already have an account?
            <a href="/login" class="font-medium text-indigo-600 hover:text-indigo-700 transition-colors ml-1">Sign in
              instead</a>
          </div>
    </div>
  </div>

  <script>
    const emailInput = document.getElementById('username');
    const pwdInput = document.getElementById('password');
    const submitBtn = document.getElementById('submitBtn');

    // State
    let isEmailValid = false;
    let isPwdValid = false;

    // Password visibility toggle
    function togglePassword() {
      const icon = document.getElementById('eye-icon');
      if (pwdInput.type === 'password') {
        pwdInput.type = 'text'; icon.className = 'far fa-eye-slash';
      } else {
        pwdInput.type = 'password'; icon.className = 'far fa-eye';
      }
    }

    // Email validation styling
    emailInput.addEventListener('input', (e) => {
      const val = e.target.value;
      // Simple email regex for UI visual feedback
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      if (val.length === 0) {
        emailInput.classList.remove('has-success', 'has-error');
        isEmailValid = false;
      } else if (emailRegex.test(val)) {
        emailInput.classList.remove('has-error');
        emailInput.classList.add('has-success');
        isEmailValid = true;
      } else {
        emailInput.classList.remove('has-success');
        // Only show error visually when they blur, not while typing initially
        isEmailValid = false;
      }
      checkFormValidity();
    });

    emailInput.addEventListener('blur', (e) => {
      if (e.target.value.length > 0 && !isEmailValid) {
        emailInput.classList.add('has-error');
      }
    });

    // Password Strength Logic
    pwdInput.addEventListener('input', (e) => {
      const val = e.target.value;
      let score = 0;

      if (!val) {
        resetStrength();
        isPwdValid = false;
        checkFormValidity();
        return;
      }

      // Calculate score
      if (val.length >= 8) score++;
      if (/[A-Z]/.test(val)) score++;
      if (/[0-9]/.test(val)) score++;
      if (/[^A-Za-z0-9]/.test(val)) score++;

      updateStrengthUI(score);

      // Consider valid if score >= 2 (8 chars + 1 requirement at least)
      isPwdValid = score >= 2;
      checkFormValidity();
    });

    function resetStrength() {
      for (let i = 1; i <= 4; i++) {
        document.getElementById(`seg-${i}`).style.backgroundColor = 'var(--border-color)';
      }
      const textEl = document.getElementById('strength-text');
      textEl.innerText = 'Password strength';
      textEl.style.color = 'var(--text-muted)';
    }

    function updateStrengthUI(score) {
      const colors = ['var(--error-color)', 'var(--warning-color)', '#84CC16', 'var(--success-color)']; /* Red, Orange, Lime, Emerald */
      const texts = ['Weak', 'Fair', 'Good', 'Strong'];

      for (let i = 1; i <= 4; i++) {
        const seg = document.getElementById(`seg-${i}`);
        if (i <= score) {
          seg.style.backgroundColor = colors[score - 1]; // All active segments get the highest scored color
        } else {
          seg.style.backgroundColor = 'var(--border-color)';
        }
      }

      const textEl = document.getElementById('strength-text');
      textEl.innerText = score > 0 ? texts[score - 1] : 'Password strength';
      textEl.style.color = score > 0 ? colors[score - 1] : 'var(--text-muted)';
    }

    // Form Validity Check
    function checkFormValidity() {
      if (isEmailValid && isPwdValid) {
        submitBtn.disabled = false;
      } else {
        submitBtn.disabled = true;
      }
    }

    // Form Submit Animation
    document.getElementById('registerForm').addEventListener('submit', function (e) {
      if (!isEmailValid || !isPwdValid) {
        e.preventDefault();
        if (!isEmailValid) {
          emailInput.classList.add('has-error', 'shake');
          setTimeout(() => emailInput.classList.remove('shake'), 400);
        }
        if (!isPwdValid) {
          pwdInput.classList.add('has-error', 'shake');
          setTimeout(() => pwdInput.classList.remove('shake'), 400);
        }
        return;
      }

      const btn = document.getElementById('submitBtn');
      btn.classList.add('is-loading', 'opacity-90', 'cursor-not-allowed');
    });

    // Handle shaking card on server error load
    window.addEventListener('DOMContentLoaded', () => {
      if (document.getElementById('error-banner')) {
        const card = document.getElementById('auth-card');
        card.classList.add('shake');
        setTimeout(() => card.classList.remove('shake'), 400);

        // Populate inputs if they existed to prevent empty error state locking
        const storedUser = localStorage.getItem('edu_draft_user');
        if (storedUser) { emailInput.value = storedUser; emailInput.focus(); emailInput.blur(); }
      }
    });

    // Save minimal draft to memory to persist between reloads (like err states)
    emailInput.addEventListener('blur', (e) => localStorage.setItem('edu_draft_user', e.target.value));

  </script>
  </body>

  </html>