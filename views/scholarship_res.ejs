<%- include('layouts/header'); -%>

    <body
        class="bg-[#f8fafc] text-slate-800 font-sans antialiased overflow-x-hidden selection:bg-indigo-500 selection:text-white relative min-h-screen flex flex-col">

        <!-- Animated SVG Noise Texture Overlay -->
        <div class="fixed inset-0 z-0 opacity-[0.03] pointer-events-none"
            style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');">
        </div>

        <!-- Soft Mesh Gradient Blobs -->
        <div class="fixed top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none">
            <div
                class="absolute -top-[10%] -left-[10%] w-[50%] h-[50%] rounded-full bg-indigo-300 blur-[120px] opacity-30 animate-[float_10s_infinite_ease-in-out]">
            </div>
            <div
                class="absolute top-[20%] -right-[10%] w-[40%] h-[60%] rounded-full bg-blue-300 blur-[120px] opacity-20 animate-[float-delay_12s_infinite_ease-in-out]">
            </div>
            <div
                class="absolute -bottom-[20%] left-[20%] w-[60%] h-[50%] rounded-full bg-teal-200 blur-[150px] opacity-20 animate-[float_14s_infinite_ease-in-out]">
            </div>
        </div>

        <%- include('layouts/navbar'); -%>

            <style>
                /* Modern Micro-animations & Aesthetics */
                @keyframes float {

                    0%,
                    100% {
                        transform: translateY(0) scale(1);
                    }

                    50% {
                        transform: translateY(-20px) scale(1.05);
                    }
                }

                @keyframes float-delay {

                    0%,
                    100% {
                        transform: translateY(0) scale(1);
                    }

                    50% {
                        transform: translateY(20px) scale(0.95);
                    }
                }

                @keyframes fade-in-up {
                    0% {
                        opacity: 0;
                        transform: translateY(30px) scale(0.98);
                    }

                    100% {
                        opacity: 1;
                        transform: translateY(0) scale(1);
                    }
                }

                .animate-fade-in-up {
                    animation: fade-in-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
                }

                .result-card {
                    background: rgba(255, 255, 255, 0.82);
                    backdrop-filter: blur(20px);
                    -webkit-backdrop-filter: blur(20px);
                    border: 1px solid rgba(255, 255, 255, 1);
                    box-shadow:
                        0 4px 6px -1px rgba(0, 0, 0, 0.02),
                        0 10px 20px -5px rgba(99, 102, 241, 0.05),
                        inset 0 1px 0 rgba(255, 255, 255, 1);
                    border-radius: 24px;
                    transition: all 0.4s cubic-bezier(0.3, 0.8, 0.2, 1);
                }

                .result-card:hover {
                    transform: translateY(-4px);
                    box-shadow:
                        0 10px 15px -3px rgba(0, 0, 0, 0.03),
                        0 25px 50px -12px rgba(99, 102, 241, 0.15),
                        inset 0 1px 0 rgba(255, 255, 255, 1);
                    border-color: rgba(99, 102, 241, 0.2);
                }

                /* Button Enhancements */
                .btn-apply {
                    position: relative;
                    overflow: hidden;
                    background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);
                    border: none;
                    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    gap: 8px;
                    text-decoration: none;
                }

                .btn-apply::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: -100%;
                    width: 50%;
                    height: 100%;
                    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
                    transform: skewX(-20deg);
                }

                .btn-apply:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 10px 20px -5px rgba(79, 70, 229, 0.4);
                    color: white;
                }

                .btn-apply:hover::before {
                    animation: shine 1.5s ease-out;
                }

                .btn-apply:active {
                    transform: translateY(1px) scale(0.98);
                }

                @keyframes shine {
                    0% {
                        left: -100%;
                    }

                    100% {
                        left: 200%;
                    }
                }

                /* Custom Header Underline */
                .title-underline {
                    position: relative;
                    display: inline-block;
                }

                .title-underline::after {
                    content: '';
                    position: absolute;
                    bottom: -6px;
                    left: 50%;
                    transform: translateX(-50%);
                    width: 40px;
                    height: 4px;
                    background: #4f46e5;
                    border-radius: 2px;
                    transition: width 0.3s ease;
                }

                .title-underline:hover::after {
                    width: 100%;
                }
            </style>

            <div class="flex-grow pt-32 pb-20 px-4 sm:px-6 lg:px-8 relative z-10 w-full max-w-7xl mx-auto">

                <!-- Header Section -->
                <div class="text-center mb-12 opacity-0 animate-fade-in-up">
                    <a href="/scholarship"
                        class="inline-flex items-center text-sm font-semibold text-indigo-600 hover:text-indigo-800 transition-colors mb-6 bg-white/60 backdrop-blur-sm px-4 py-2 rounded-full border border-indigo-100 shadow-sm no-underline">
                        <i class="fas fa-arrow-left mr-2"></i> Modify Search
                    </a>

                    <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-6 title-underline">
                        Matched Scholarships
                    </h1>

                    <div class="flex flex-wrap items-center justify-center gap-2 max-w-3xl mx-auto mt-8">
                        <span
                            class="px-3 py-1.5 bg-white/80 backdrop-blur-sm border border-slate-200 rounded-lg text-sm font-medium text-slate-600 shadow-sm">
                            <i class="fas fa-graduation-cap text-indigo-500 mr-2"></i>
                            <%= typeof selectedCourse !=='undefined' ? selectedCourse : 'N/A' %>
                        </span>
                        <span
                            class="px-3 py-1.5 bg-white/80 backdrop-blur-sm border border-slate-200 rounded-lg text-sm font-medium text-slate-600 shadow-sm">
                            <i class="fas fa-map-marker-alt text-rose-500 mr-2"></i>
                            <%= typeof selectedState !=='undefined' ? selectedState : 'N/A' %>
                        </span>
                        <span
                            class="px-3 py-1.5 bg-white/80 backdrop-blur-sm border border-slate-200 rounded-lg text-sm font-medium text-slate-600 shadow-sm">
                            <i class="fas fa-users text-teal-500 mr-2"></i>
                            <%= typeof selectedCaste !=='undefined' ? selectedCaste : 'N/A' %>
                        </span>
                    </div>
                </div>

                <!-- Results Section -->
                <% if (scholarships && scholarships.length> 0) { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        <% scholarships.forEach((scholarship, index)=> { %>
                            <div class="result-card p-8 flex flex-col h-full opacity-0 animate-[fade-in-up_0.6s_ease-out_forwards]"
                                style="animation-delay: <%= index * 0.1 %>s">

                                <div class="mb-6 flex-grow">
                                    <div class="flex items-start justify-between mb-4 gap-4">
                                        <div
                                            class="w-12 h-12 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600 shadow-inner flex-shrink-0">
                                            <i class="fas fa-award text-xl"></i>
                                        </div>
                                        <span
                                            class="bg-teal-50 text-teal-700 border border-teal-100 px-3 py-1 rounded-full text-xs font-bold tracking-wide uppercase shadow-sm whitespace-nowrap">
                                            Eligible Match
                                        </span>
                                    </div>

                                    <h3
                                        class="text-xl font-bold text-slate-900 mb-3 leading-tight group-hover:text-indigo-600 transition-colors">
                                        <%= scholarship.name %>
                                    </h3>

                                    <div
                                        class="flex items-start gap-3 text-sm text-slate-600 mt-4 bg-slate-50/50 p-4 rounded-xl border border-slate-100/50">
                                        <i
                                            class="fas fa-check-circle text-indigo-400 mt-1 flex-shrink-0 relative top-px"></i>
                                        <div>
                                            <strong class="block text-slate-800 mb-1">Eligibility Criteria</strong>
                                            <p class="leading-relaxed">
                                                <%= scholarship.eligibility %>
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="pt-6 border-t border-slate-100 mt-auto">
                                    <a href="<%= scholarship.link %>" target="_blank"
                                        class="btn-apply w-full px-6 py-3.5 rounded-xl text-white font-bold tracking-wide shadow-md">
                                        Apply Now <i class="fas fa-external-link-alt text-sm opacity-80 ml-1"></i>
                                    </a>
                                </div>
                            </div>
                            <% }); %>
                    </div>
                    <% } else { %>
                        <!-- Empty State -->
                        <div
                            class="w-full max-w-2xl mx-auto glass-card p-12 text-center opacity-0 animate-[fade-in-up_0.6s_ease-out_forwards]">
                            <div
                                class="w-24 h-24 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-6 text-slate-300 shadow-inner">
                                <i class="fas fa-search-minus text-4xl"></i>
                            </div>
                            <h3 class="text-2xl font-bold text-slate-800 mb-3">No matching scholarships found</h3>
                            <p class="text-slate-500 text-lg mb-8 max-w-md mx-auto">
                                We couldn't find any financial aid programs matching these exact filters. Try broadening
                                your criteria or selecting a different category.
                            </p>
                            <a href="/scholarship"
                                class="btn-apply px-8 py-3 rounded-xl text-white font-bold inline-flex items-center shadow-md">
                                <i class="fas fa-sync-alt mr-2"></i> Modify Search
                            </a>
                        </div>
                        <% } %>

            </div>

            <%- include('layouts/footer'); -%>
    </body>