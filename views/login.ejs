<%- include('layouts/header'); %>
  <%- include('layouts/navbar'); %>

    <style>
      :root {
        --color-primary: #FFB800;
        --color-secondary: #00A8FF;
        --color-dark: #1A1A2E;
        --color-bg-light: #F7FAFC;
      }

      .login-container {
        display: flex;
        min-height: 100vh;
        margin-top: 0;
      }

      .login-left {
        flex: 1;
        background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 60px;
        position: relative;
        overflow: hidden;
      }

      .login-welcome {
        position: relative;
        z-index: 1;
        color: white;
        text-align: center;
      }

      .login-welcome h1 {
        font-size: 3.5rem;
        font-weight: 800;
        margin-bottom: 20px;
      }

      .login-right {
        flex: 1;
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 60px;
      }

      .login-form-container {
        width: 100%;
        max-width: 450px;
      }

      .login-logo {
        text-align: center;
        margin-bottom: 30px;
      }

      .login-logo h2 {
        font-size: 2.2rem;
        font-weight: 800;
        color: var(--color-dark);
      }

      .login-logo h2 span {
        color: var(--color-secondary);
      }

      .role-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-bottom: 25px;
      }

      .role-card {
        border: 2px solid #edf2f7;
        border-radius: 12px;
        padding: 15px 10px;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
      }

      .role-input:checked+.role-card {
        border-color: var(--color-secondary);
        background-color: rgba(0, 168, 255, 0.05);
        transform: translateY(-3px);
      }

      .form-input {
        width: 100%;
        padding: 12px 20px;
        border: 2px solid #edf2f7;
        border-radius: 10px;
        margin-bottom: 20px;
        transition: all 0.3s;
      }

      .form-input:focus {
        outline: none;
        border-color: var(--color-secondary);
      }

      .btn-login {
        width: 100%;
        padding: 15px;
        background: var(--color-primary);
        color: var(--color-dark);
        border: none;
        border-radius: 10px;
        font-size: 1.1rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: 0 4px 15px rgba(255, 184, 0, 0.3);
      }

      .btn-login:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(255, 184, 0, 0.4);
      }

      @media (max-width: 968px) {
        .login-container {
          flex-direction: column;
        }

        .login-left {
          min-height: 40vh;
        }
      }
    </style>

    <div class="login-container">
      <div class="login-left d-none d-lg-flex">
        <div class="login-welcome">
          <h1>Welcome Back!</h1>
          <p class="fs-4">Your journey to academic excellence<br>continues here.</p>
        </div>
      </div>

      <div class="login-right">
        <div class="login-form-container">
          <div class="login-logo">
            <h2>Edu<span>Navigator</span></h2>
          </div>

          <div class="text-center mb-4">
            <h3 class="fw-bold">Sign In</h3>
            <p class="text-muted">Access your personalized dashboard</p>
          </div>

          <form action="/login" method="POST">
            <div class="mb-4">
              <label class="form-label small fw-bold text-muted">LOGIN AS</label>
              <div class="role-grid">
                <label class="m-0">
                  <input type="radio" name="role" value="student" class="role-input d-none" checked>
                  <div class="role-card">
                    <i class="fas fa-user-graduate mb-2 d-block"></i>
                    <span class="small fw-bold">Student</span>
                  </div>
                </label>
                <label class="m-0">
                  <input type="radio" name="role" value="teacher" class="role-input d-none">
                  <div class="role-card">
                    <i class="fas fa-chalkboard-teacher mb-2 d-block"></i>
                    <span class="small fw-bold">Teacher</span>
                  </div>
                </label>
                <label class="m-0">
                  <input type="radio" name="role" value="parent" class="role-input d-none">
                  <div class="role-card">
                    <i class="fas fa-users mb-2 d-block"></i>
                    <span class="small fw-bold">Parent</span>
                  </div>
                </label>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-bold text-muted">USERNAME</label>
              <input type="text" name="username" class="form-input m-0" placeholder="Enter your username" required>
            </div>

            <div class="mb-4">
              <label class="form-label small fw-bold text-muted">PASSWORD</label>
              <input type="password" name="password" class="form-input m-0" placeholder="••••••••" required>
            </div>

            <button type="submit" class="btn-login">Log In to Dashboard</button>
          </form>

          <div class="text-center mt-4">
            <p class="text-muted">Don't have an account? <a href="/register"
                class="text-primary fw-bold text-decoration-none">Create Account</a></p>
            <a href="#!" class="text-muted small text-decoration-none">Forgot Password?</a>
          </div>
        </div>
      </div>
    </div>

    <%- include('layouts/footer'); %>