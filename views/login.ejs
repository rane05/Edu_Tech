    .form-input:focus~.form-label {
      color: var(--primary);
    }

    /* Buttons */
    .btn-primary {
      width: 100%;
      background-color: var(--primary);
      color: white;
      font-weight: 500;
      padding: 0.8rem 1rem;
      border-radius: 0.6rem;
      border: none;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.5rem;
      position: relative;
    }

    .btn-primary:hover {
      background-color: var(--primary-hover);
      transform: translateY(-2px);
      box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.25), 0 4px 6px -2px rgba(79, 70, 229, 0.1);
    }

    .btn-primary:active {
      transform: translateY(0);
      box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.2);
    }

    /* Role Selector Styling */
    .role-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem;
      margin-top: 0.5rem;
      margin-bottom: 1.5rem;
    }

    .role-card {
      border: 1px solid var(--border-color);
      border-radius: 0.6rem;
      padding: 0.8rem 0.4rem;
      text-align: center;
      cursor: pointer;
      background-color: white;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.01);
    }

    .role-card:hover {
      border-color: #CBD5E1;
      background-color: #F8FAFC;
      transform: translateY(-2px);
    }

    .role-input:checked+.role-card {
      border-color: var(--primary);
      background-color: #EEF2FF;
      color: var(--primary);
      box-shadow: 0 0 0 1px var(--primary), 0 4px 6px -1px rgba(79, 70, 229, 0.1);
      transform: translateY(-2px);
    }

    .role-icon {
      font-size: 1.1rem;
      color: var(--text-muted);
      margin-bottom: 0.4rem;
      transition: all 0.3s ease;
      display: block;
    }

    .role-input:checked+.role-card .role-icon {
      color: var(--primary);
      transform: scale(1.1);
    }

    .role-title {
      font-size: 0.8rem;
      color: var(--text-main);
    }

    .role-input:checked+.role-card .role-title {
      color: var(--primary);
      font-weight: 600;
    }

    .btn-social {
      width: 100%;
      background-color: #FFFFFF;
      color: var(--text-main);
      font-weight: 500;
      padding: 0.7rem 1rem;
      border-radius: 0.6rem;
      border: 1px solid var(--border-color);
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.75rem;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
    }

    .btn-social:hover {
      background-color: #F8FAFC;
      border-color: #CBD5E1;
      transform: translateY(-2px);
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    /* Custom Checkbox */
    .custom-checkbox {
      width: 1rem;
      height: 1rem;
      border-radius: 0.25rem;
      border: 1px solid var(--border-color);
      appearance: none;
      -webkit-appearance: none;
      outline: none;
      cursor: pointer;
      position: relative;
      background: white;
      transition: all 0.2s ease;
    }

    .custom-checkbox:checked {
      background-color: var(--primary);
      border-color: var(--primary);
    }

    .custom-checkbox:checked::after {
      content: '';
      position: absolute;
      left: 4px;
      top: 1px;
      width: 4px;
      height: 8px;
      border: solid white;
      border-width: 0 2px 2px 0;
      transform: rotate(45deg);
    }

    /* Alert Banners */
    .alert-banner {
      padding: 0.75rem 1rem;
      border-radius: 0.5rem;
      font-size: 0.875rem;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
      overflow: hidden;
      /* Animation for height */
      max-height: 200px;
      animation: expand-alert 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes expand-alert {
      from {
        max-height: 0;
        opacity: 0;
        padding-top: 0;
        padding-bottom: 0;
        margin-bottom: 0;
      }

      to {
        max-height: 200px;
        opacity: 1;
      }
    }

    .alert-error {
      background-color: #FEF2F2;
      color: #991B1B;
      border: 1px solid #F87171;
    }

    .alert-success {
      background-color: #ECFDF5;
      color: #065F46;
      border: 1px solid #34D399;
    }

    /* Divider */
    .divider {
      display: flex;
      align-items: center;
      text-align: center;
      margin: 1.5rem 0;
      color: var(--text-muted);
      font-size: 0.875rem;
    }

    .divider::before,
    .divider::after {
      content: '';
      flex: 1;
      border-bottom: 1px solid var(--border-color);
    }

    .divider:not(:empty)::before {
      margin-right: 0.75rem;
    }

    .divider:not(:empty)::after {
      margin-left: 0.75rem;
    }

    /* Loading Spinner */
    .spinner {
      width: 1.25rem;
      height: 1.25rem;
      border: 2px solid rgba(255, 255, 255, 0.3);
      border-radius: 50%;
      border-top-color: white;
      animation: spin 0.8s linear infinite;
      display: none;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

