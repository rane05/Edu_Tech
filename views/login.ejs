  <style>
    :root {
      --color-primary: #FFB800;
      --color-secondary: #00A8FF;
      --color-dark: #1A1A2E;
      --color-text: #2D3748;
      --color-bg-light: #F7FAFC;
      --space-16: 60px;
      --space-5: 20px;
      --text-5xl: 3rem;
      --text-xl: 1.25rem;
      --font-extrabold: 800;
      --leading-relaxed: 1.6;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
      overflow-x: hidden;
    }

    .login-container {
      display: flex;
      min-height: 100vh;
    }

    /* Left Panel - Gradient */
    .login-left {
      flex: 1;
      background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--space-16);
      position: relative;
      overflow: hidden;
    }

    .login-left::before {
      content: '';
      position: absolute;
      width: 400px;
      height: 400px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 50%;
      top: -100px;
      right: -100px;
      animation: float 6s ease-in-out infinite;
    }

    .login-left::after {
      content: '';
      position: absolute;
      width: 300px;
      height: 300px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 50%;
      bottom: -80px;
      left: -80px;
      animation: float 8s ease-in-out infinite reverse;
    }

    @keyframes float {
      0%,
      100% {
        transform: translateY(0px);
      }

      50% {
        transform: translateY(-20px);
      }
    }

    .login-welcome {
      position: relative;
      z-index: 1;
      color: white;
      text-align: center;
    }

    .login-welcome h1 {
      font-size: var(--text-5xl);
      font-weight: var(--font-extrabold);
      margin-bottom: var(--space-5);
      text-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
      animation: fadeIn 0.8s ease-out;
    }

    .login-welcome p {
      font-size: var(--text-xl);
      opacity: 0.95;
      line-height: var(--leading-relaxed);
      animation: fadeIn 1s ease-out 0.2s both;
    }

    /* Right Panel - Form */
    .login-right {
      flex: 1;
      background: var(--color-bg);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--space-16);
    }

    .login-form-container {
      width: 100%;
      max-width: 450px;
    }

    .login-logo {
      text-align: center;
      margin-bottom: 40px;
    }

    .login-logo h2 {
      font-size: 2rem;
      font-weight: 800;
      color: var(--color-dark);
    }

    .login-logo h2 span {
      color: var(--color-secondary);
    }

    .login-header {
      text-align: center;
      margin-bottom: 40px;
    }

    .login-header h3 {
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--color-dark);
      margin-bottom: 10px;
    }

    .login-header p {
      color: #718096;
      font-size: 0.95rem;
    }

    .form-group {
      margin-bottom: var(--space-6);
    }

    .form-label {
