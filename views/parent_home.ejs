<%- include('layouts/header'); %>
<%- include('layouts/pnavbar'); %>
        <style>
             @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap');

            :root {
                --p-primary: #0ea5e9;
                --p-secondary: #6366f1;
                --p-accent: #f59e0b;
                --p-surface: #ffffff;
                --p-bg: #f8fafc;
                --p-glass: rgba(255, 255, 255, 0.75);
                --p-border: rgba(255, 255, 255, 0.2);
            }

            body {
                font-family: 'Outfit', sans-serif;
                background: radial-gradient(circle at top right, #f1f5f9, #e2e8f0);
                color: #1e293b;
                overflow-x: hidden;
            }

            .bento-grid {
                display: grid;
                grid-template-columns: repeat(12, 1fr);
                gap: 24px;
            }

            .premium-card {
                background: var(--p-glass);
                backdrop-filter: blur(20px);
                border: 1px solid var(--p-border);
                border-radius: 2.5rem;
                box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.04);
                transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.4s ease;
                overflow: hidden;
            }

            .premium-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 20px 50px -15px rgba(0, 0, 0, 0.1);
            }

            .hero-gradient {
                background: linear-gradient(135deg, #0ea5e9 0%, #6366f1 100%);
                color: white;
            }

            .card-title {
                font-size: 1.25rem;
                font-weight: 800;
                letter-spacing: -0.02em;
            }

            .nav-pill {
                padding: 6px 16px;
                border-radius: 99px;
                background: rgba(255, 255, 255, 0.1);
                font-size: 0.75rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }

            .stat-circle {
                width: 120px;
                height: 120px;
                border-radius: 50%;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                background: white;
                box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
                position: relative;
            }

            .stat-icon-bg {
                width: 48px;
                height: 48px;
                border-radius: 14px;
                display: flex;
                align-items: center;
                justify-content: center;
                margin-bottom: 12px;
            }

            .timeline-item {
                position: relative;
                padding-left: 32px;
                padding-bottom: 24px;
            }

            .timeline-item::before {
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 2px;
                background: #e2e8f0;
            }

            .timeline-dot {
                position: absolute;
                left: -5px;
                top: 0;
                width: 12px;
                height: 12px;
                border-radius: 50%;
                background: var(--p-primary);
                border: 3px solid white;
            }

            @media (max-width: 1024px) {
                .bento-grid { grid-template-columns: 1fr; }
                .col-span-8, .col-span-4, .col-span-12 { grid-column: span 1; }
            }
        </style>

        <div class="min-h-screen pt-24 pb-12 px-6 lg:px-12">
            <div class="max-w-7xl mx-auto">
                
                <!-- Welcome Section -->
                <div class="premium-card hero-gradient p-10 mb-10 flex flex-col md:flex-row items-center justify-between gap-8 relative">
                    <div class="absolute -top-24 -right-24 w-64 h-64 bg-white/10 rounded-full blur-3xl"></div>
                    <div class="relative z-10">
                        <span class="nav-pill mb-4 inline-block">Parent Portal v2.0</span>
                        <h1 class="text-4xl md:text-6xl font-black mb-3">Hello, <%= username %> 👨‍👩‍👧</h1>
                        <p class="text-sky-100 font-medium text-lg max-w-xl">EduNavigator AI has generated your child's weekly performance report. Check the latest growth metrics below.</p>
                    </div>
                    <div class="flex gap-4 relative z-10">
                        <button onclick="window.print()" class="px-8 py-4 bg-white text-sky-600 font-extrabold rounded-2xl shadow-xl hover:bg-sky-50 transition-all flex items-center gap-3">
                            <i class="fas fa-file-pdf"></i> Download PDF
                        </button>
                    </div>
                </div>

                <% if (studentData) { %>
                <div class="bento-grid">
                    
                    <!-- Student Profile Brief -->
                    <div class="col-span-12 lg:col-span-4 premium-card p-8 flex flex-col items-center justify-center bg-white">
                        <div class="relative mb-6">
                            <div class="w-32 h-32 rounded-[2.5rem] bg-sky-100 flex items-center justify-center text-sky-600 shadow-inner">
                                <i class="fas fa-user-astronaut text-5xl"></i>
                            </div>
                            <div class="absolute -bottom-2 -right-2 w-10 h-10 bg-green-500 border-4 border-white rounded-full"></div>
                        </div>
                        <h2 class="text-3xl font-black text-slate-900 mb-1"><%= studentData.fullName %></h2>
                        <p class="text-slate-400 font-bold uppercase tracking-widest text-xs mb-6"><%= studentData.collegeName %></p>
                        
                        <div class="w-full flex justify-between gap-4">
                            <div class="flex-1 p-4 bg-slate-50 rounded-3xl text-center">
                                <span class="block text-2xl font-black text-slate-900"><%= totalAttempts %></span>
                                <span class="text-[10px] font-bold text-slate-400 uppercase">Tests</span>
                            </div>
                            <div class="flex-1 p-4 bg-slate-50 rounded-3xl text-center">
                                <span class="block text-2xl font-black text-slate-900"><%= bestScore || 0 %></span>
                                <span class="text-[10px] font-bold text-slate-400 uppercase">Peak</span>
                            </div>
                            <div class="flex-1 p-4 bg-slate-50 rounded-3xl text-center">
                                <span class="block text-2xl font-black text-slate-900"><%= avgScore || 0 %></span>
                                <span class="text-[10px] font-bold text-slate-400 uppercase">Avg</span>
                            </div>
                        </div>
                    </div>

                    <!-- Growth Trajectory -->
                    <div class="col-span-12 lg:col-span-8 premium-card p-8 bg-white">
                        <div class="flex justify-between items-center mb-8">
                            <h3 class="card-title text-slate-900">Academic Growth Pulse</h3>
                            <div class="flex gap-2">
                                <span class="w-3 h-3 rounded-full bg-sky-500"></span>
                                <span class="text-[10px] font-bold uppercase text-slate-400 tracking-widest">Real-time Analysis</span>
                            </div>
                        </div>
                        <div class="h-[300px]">
                            <canvas id="parentStudentChart"></canvas>
                        </div>
                    </div>

                    <!-- Left: Milestone Tracker -->
                    <div class="col-span-12 lg:col-span-8 premium-card p-10 bg-white">
                        <h3 class="card-title text-slate-900 mb-8 flex items-center gap-3">
                            <i class="fas fa-tasks text-sky-500"></i> Career Milestone Tracker
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                            <% const steps = [
                                { name: "Foundational Skills", val: (studentData.skills ? 90 : 30), icon: "vial", color: "#0ea5e9" },
                                { name: "Analytical IQ", val: (avgScore > 30 ? 85 : 45), icon: "brain", color: "#6366f1" },
                                { name: "Project Readiness", val: 40, icon: "cube", color: "#f59e0b" },
                                { name: "Placement Quality", val: 15, icon: "trophy", color: "#10b981" }
                            ]; %>
                            <% steps.forEach(step => { %>
                                <div class="bg-slate-50 p-6 rounded-[2rem] border border-slate-100" style="--p-val: <%= step.val %>%; --p-col: <%= step.color %>;">
                                    <div class="flex justify-between mb-4">
                                        <div class="flex items-center gap-3">
                                            <div class="w-10 h-10 rounded-xl flex items-center justify-center bg-white shadow-sm" style="color: var(--p-col);">
                                                <i class="fas fa-<%= step.icon %>"></i>
                                            </div>
                                            <span class="font-bold text-slate-700"><%= step.name %></span>
                                        </div>
                                        <span class="font-black text-slate-900"><%= step.val %>%</span>
                                    </div>
                                    <div class="w-full bg-white h-3 rounded-full overflow-hidden border border-slate-200">
                                        <div class="h-full rounded-full" style="width: var(--p-val); background-color: var(--p-col);"></div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>

                    <!-- Right: Feed -->
                    <div class="col-span-12 lg:col-span-4 premium-card bg-slate-900 p-8 text-white">
                        <h3 class="card-title mb-8 flex items-center gap-3">
                            <i class="fas fa-university text-sky-400"></i> Campus Radar
                        </h3>
                        <div class="space-y-6 custom-scroll max-h-[400px] overflow-y-auto pr-2">
                            <% if (teacherUpdates.length > 0) { %>
                                <% teacherUpdates.forEach(update => { %>
                                    <div class="timeline-item">
                                        <div class="timeline-dot"></div>
                                        <div class="flex justify-between mb-1">
                                            <span class="text-[9px] font-black uppercase text-sky-400 tracking-widest"><%= update.type %></span>
                                            <span class="text-[9px] text-slate-500 font-bold"><%= new Date(update.createdAt).toLocaleDateString() %></span>
                                        </div>
                                        <h4 class="text-sm font-bold text-slate-100 mb-1"><%= update.title %></h4>
                                        <p class="text-xs text-slate-500"><%= update.desc || "Verified announcement from the faculty board." %></p>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="text-center py-10">
                                    <i class="fas fa-ghost text-4xl text-slate-800 mb-4"></i>
                                    <p class="text-slate-500 font-bold text-sm">No new updates found.</p>
                                </div>
                            <% } %>
                        </div>
                        
                        <div class="mt-8 p-6 bg-gradient-to-br from-sky-500 to-indigo-600 rounded-[2rem]">
                            <h4 class="font-black text-sm mb-2">AI Perspective 🤖</h4>
                            <p class="text-[11px] text-sky-100 font-medium leading-relaxed">Based on recent data points, we suggest focusing on Logical Reasoning topics for the next 7 days.</p>
                        </div>
                    </div>

                </div>
                <% } else { %>
                    <!-- Linking State -->
                    <div class="premium-card p-16 text-center max-w-2xl mx-auto mt-12 bg-white">
                        <div class="w-32 h-32 bg-slate-50 rounded-full flex items-center justify-center text-slate-300 mx-auto mb-8">
                            <i class="fas fa-key text-5xl"></i>
                        </div>
                        <h2 class="text-4xl font-black text-slate-900 mb-4">Secure Sync Pending</h2>
                        <p class="text-slate-500 font-medium mb-10 leading-relaxed text-lg italic">
                            "Connecting you to your child's future, one milestone at a time."
                        </p>
                        <a href="/parentprofile" class="px-10 py-5 bg-slate-900 text-white font-extrabold rounded-2xl shadow-2xl hover:bg-sky-600 transition-all inline-flex items-center gap-4">
                            Proceed to Linking <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                <% } %>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const ctx = document.getElementById('parentStudentChart');
                if (!ctx) return;

                const resultsRaw = JSON.parse(`<%- JSON.stringify(results || []) %>`);
                const dataPoints = resultsRaw.map(r => r.score);
                const labels = resultsRaw.map((_, i) => `${i + 1}`);

                const gradient = ctx.getContext('2d').createLinearGradient(0, 0, 0, 300);
                gradient.addColorStop(0, 'rgba(14, 165, 233, 0.4)');
                gradient.addColorStop(1, 'rgba(14, 165, 233, 0)');

                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Growth Score',
                            data: dataPoints,
                            borderColor: '#0ea5e9',
                            borderWidth: 6,
                            pointBackgroundColor: '#ffffff',
                            pointBorderColor: '#0ea5e9',
                            pointBorderWidth: 4,
                            pointRadius: 6,
                            pointHoverRadius: 10,
                            tension: 0.5,
                            fill: true,
                            backgroundColor: gradient
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: '#0f172a',
                                titleFont: { size: 14, weight: 'bold', family: 'Outfit' },
                                bodyFont: { size: 13, family: 'Outfit' },
                                padding: 16,
                                cornerRadius: 16,
                                displayColors: false
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                max: 60,
                                grid: { color: 'rgba(0,0,0,0.03)', drawBorder: false },
                                ticks: { font: { weight: '800', size: 11 }, color: '#94a3b8' }
                            },
                            x: {
                                grid: { display: false },
                                ticks: { font: { weight: '800', size: 11 }, color: '#94a3b8' }
                            }
                        }
                    }
                });
            });
        </script>

        <style>
            @media print {
                body { background: white !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
                .glass-nav, .premium-card:hover, .hero-gradient::after { display: none !important; }
                .premium-card { border: 1px solid #eee !important; box-shadow: none !important; margin-bottom: 2rem; break-inside: avoid; }
                .hero-gradient { background: #000 !important; color: #fff !important; }
                .lg\:col-span-12, .lg\:col-span-8, .lg\:col-span-4 { width: 100% !important; grid-column: span 12 !important; }
                canvas { max-width: 100% !important; }
            }
        </style>

        <%- include('layouts/footer'); %>