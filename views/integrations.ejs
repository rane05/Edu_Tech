<%- include('layouts/header'); %>
    <%- include('layouts/navbar'); %>

        <style>
            :root {
                --color-primary: #FFB800;
                /* Yellow */
                --color-secondary: #00A8FF;
                /* Blue */
                --color-dark: #1A1A2E;
                /* Dark Text/Headers */
                --color-text: #2D3748;
                /* Body Text */
                --color-bg-light: #F7FAFC;
                /* Main Background */
            }

            body {
                background-color: var(--color-bg-light);
                color: var(--color-text);
                font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
            }

            /* Cards */
            .feature-card {
                background: white;
                border-radius: 20px;
                box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
                transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.4s ease;
                border: 1px solid rgba(0, 0, 0, 0.02);
            }

            .feature-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 50px rgba(0, 0, 0, 0.08);
            }

            .input-light {
                background: #F7FAFC;
                border: 1px solid #E2E8F0;
                color: var(--color-text);
                transition: all 0.3s ease;
            }

            .input-light:focus {
                outline: none;
                border-color: var(--color-secondary);
                box-shadow: 0 0 0 3px rgba(0, 168, 255, 0.15);
                background: white;
            }

            .btn-primary-theme {
                background: var(--color-secondary);
                color: white;
                transition: all 0.3s ease;
                border: 2px solid var(--color-secondary);
            }

            .btn-primary-theme:hover {
                background: #0097E6;
                border-color: #0097E6;
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(0, 168, 255, 0.3);
            }

            .btn-warning-theme {
                background: var(--color-primary);
                color: var(--color-dark);
                transition: all 0.3s ease;
                border: 2px solid var(--color-primary);
            }

            .btn-warning-theme:hover {
                background: #F0AD00;
                border-color: #F0AD00;
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(255, 184, 0, 0.3);
            }

            .badge-primary {
                background: linear-gradient(135deg, var(--color-secondary), #0BC5FF);
                color: white;
            }

            .badge-warning {
                background: linear-gradient(135deg, var(--color-primary), #FFC024);
                color: white;
            }

            .badge-purple {
                background: linear-gradient(135deg, #9f7aea, #b794f4);
                color: white;
            }

            .badge-green {
                background: linear-gradient(135deg, #48bb78, #68d391);
                color: white;
            }

            .badge-gray {
                background: linear-gradient(135deg, #4a5568, #718096);
                color: white;
            }

            .text-gradient {
                background: linear-gradient(135deg, var(--color-secondary), var(--color-primary));
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
            }

            /* Animations */
            @keyframes slideUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .animate-slide-up {
                animation: slideUp 0.7s cubic-bezier(0.4, 0, 0.2, 1) forwards;
            }

            .delay-100 {
                animation-delay: 150ms;
            }

            .radial-progress-bg {
                stroke: #EDF2F7;
            }

            .radial-progress-fill {
                stroke: var(--color-secondary);
            }
        </style>

        <!-- Main Content -->
        <main class="pt-32 pb-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">



            <!-- Tools Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8 mb-16 animate-slide-up delay-100">

                <!-- LinkedIn Analysis -->
                <div class="feature-card p-8 group relative overflow-hidden flex flex-col justify-between">
                    <div>
                        <div class="flex items-center gap-5 mb-8">
                            <div
                                class="w-16 h-16 rounded-full badge-primary text-2xl flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300">
                                <i class="fab fa-linkedin-in"></i>
                            </div>
                            <h3 class="text-2xl font-bold" style="color: var(--color-dark);">LinkedIn Audit</h3>
                        </div>
                        <form id="linkedinForm" class="space-y-5">
                            <div>
                                <label class="block text-sm font-bold text-gray-700 mb-2">Profile URL</label>
                                <input type="url" name="profileUrl" placeholder="https://linkedin.com/in/..."
                                    class="w-full input-light rounded-xl px-4 py-3.5 text-base" required>
                            </div>
                        </form>
                    </div>
                    <button type="submit" form="linkedinForm"
                        class="w-full mt-6 py-3.5 rounded-full btn-primary-theme text-base font-bold shadow-md">
                        <i class="fas fa-search mr-2"></i> Analyze Profile
                    </button>
                </div>

                <!-- GitHub Analysis -->
                <div class="feature-card p-8 group relative overflow-hidden flex flex-col justify-between">
                    <div>
                        <div class="flex items-center gap-5 mb-8">
                            <div
                                class="w-16 h-16 rounded-full badge-gray text-2xl flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300">
                                <i class="fab fa-github"></i>
                            </div>
                            <h3 class="text-2xl font-bold" style="color: var(--color-dark);">Code Review</h3>
                        </div>
                        <form id="githubForm" class="space-y-5">
                            <div>
                                <label class="block text-sm font-bold text-gray-700 mb-2">Repository URL</label>
                                <input type="url" name="repositoryUrl" placeholder="https://github.com/..."
                                    class="w-full input-light rounded-xl px-4 py-3.5 text-base" required>
                            </div>
                        </form>
                    </div>
                    <button type="submit" form="githubForm"
                        class="w-full mt-6 py-3.5 rounded-full bg-gray-800 hover:bg-gray-900 border-2 border-gray-800 text-white text-base font-bold shadow-md transition-all group-hover:shadow-xl group-hover:-translate-y-0.5">
                        <i class="fas fa-code-branch mr-2"></i> Evaluate Repo
                    </button>
                </div>

                <!-- Research Analysis -->
                <div class="feature-card p-8 group relative overflow-hidden flex flex-col justify-between">
                    <div>
                        <div class="flex items-center gap-5 mb-8">
                            <div
                                class="w-16 h-16 rounded-full badge-purple text-2xl flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300">
                                <i class="fas fa-microscope"></i>
                            </div>
                            <h3 class="text-2xl font-bold" style="color: var(--color-dark);">Research Scanner</h3>
                        </div>
                        <form id="scholarForm" class="space-y-5">
                            <div>
                                <label class="block text-sm font-bold text-gray-700 mb-2">Topic / Abstract</label>
                                <textarea name="researchTopic" rows="2" placeholder="Describe research area..."
                                    class="w-full input-light rounded-xl px-4 py-3.5 text-base resize-none"
                                    required></textarea>
                            </div>
                        </form>
                    </div>
                    <button type="submit" form="scholarForm"
                        class="w-full mt-6 py-3.5 rounded-full border-2 border-purple-600 bg-purple-600 hover:bg-purple-700 text-white text-base font-bold shadow-md transition-all group-hover:shadow-xl group-hover:-translate-y-0.5">
                        <i class="fas fa-flask mr-2"></i> Analyze Topic
                    </button>
                </div>



                <!-- Add Certification -->
                <div class="feature-card p-8 group relative overflow-hidden flex flex-col justify-between">
                    <div>
                        <div class="flex items-center gap-5 mb-8">
                            <div
                                class="w-16 h-16 rounded-full badge-warning text-2xl flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300">
                                <i class="fas fa-plus-circle text-white"></i>
                            </div>
                            <h3 class="text-2xl font-bold" style="color: var(--color-dark);">Add Credential</h3>
                        </div>
                        <p class="text-gray-500 text-sm mb-6 leading-relaxed">Securely record new credentials and
                            certifications into your verified professional footprint.</p>
                    </div>
                    <button onclick="document.getElementById('addCertModal').classList.remove('hidden')"
                        class="w-full mt-auto py-3.5 rounded-full border-2 border-dashed border-yellow-400 text-yellow-600 hover:text-white hover:bg-yellow-500 hover:border-yellow-500 transition-all text-base font-bold flex items-center justify-center">
                        <i class="fas fa-plus mr-2"></i> Open Upload Form
                    </button>
                </div>
            </div>

            <!-- Add Cert Modal -->
            <div id="addCertModal"
                class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-gray-900/60 backdrop-blur-sm">
                <div class="bg-white p-8 rounded-[2rem] max-w-md w-full relative m-4 shadow-2xl border border-gray-100 animate-slide-up"
                    style="animation-duration: 0.3s; transform:translateY(0);">
                    <button onclick="document.getElementById('addCertModal').classList.add('hidden')"
                        class="absolute top-6 right-6 text-gray-400 hover:text-gray-800 bg-gray-100 hover:bg-gray-200 rounded-full w-10 h-10 flex items-center justify-center transition-colors">
                        <i class="fas fa-times text-lg"></i>
                    </button>
                    <h3 class="text-2xl font-bold mb-8" style="color: var(--color-dark);">Add New Certification</h3>
                    <form id="certificationForm" class="space-y-5">
                        <input type="text" name="certificateId" placeholder="Certificate ID"
                            class="w-full input-light rounded-xl px-4 py-3.5 text-base" required>
                        <input type="text" name="issuer" placeholder="Issuer (e.g. AWS)"
                            class="w-full input-light rounded-xl px-4 py-3.5 text-base" required>
                        <div class="grid grid-cols-2 gap-4">
                            <input type="date" name="issueDate"
                                class="w-full input-light rounded-xl px-4 py-3.5 text-base text-gray-500" required>
                            <input type="date" name="expirationDate"
                                class="w-full input-light rounded-xl px-4 py-3.5 text-base text-gray-500">
                        </div>
                        <input type="text" name="skillsCovered" placeholder="Skills (comma separated)"
                            class="w-full input-light rounded-xl px-4 py-3.5 text-base" required>
                        <button type="submit"
                            class="w-full py-4 rounded-full btn-warning-theme font-bold shadow-lg mt-6 text-base tracking-wide uppercase">
                            Save to Profile
                        </button>
                    </form>
                </div>
            </div>

            <!-- Results Section -->
            <div id="resultsSection" class="hidden animate-slide-up scroll-mt-32">
                <div class="flex items-center justify-between mb-8 pb-4 border-b border-gray-200">
                    <h2 class="text-3xl font-extrabold flex items-center gap-3" style="color: var(--color-dark);">
                        <i class="fas fa-bolt text-yellow-500"></i> Analysis Results
                    </h2>
                    <button onclick="document.getElementById('resultsSection').classList.add('hidden')"
                        class="text-sm font-bold text-gray-500 hover:text-gray-800 bg-white px-5 py-2.5 rounded-full border border-gray-200 shadow-sm transition-colors hover:bg-gray-50">
                        <i class="fas fa-times mr-1"></i> Clear Form
                    </button>
                </div>

                <div id="loadingSection"
                    class="hidden py-24 text-center bg-white rounded-[2rem] shadow-md border border-gray-100">
                    <div
                        class="inline-block w-16 h-16 border-4 border-blue-100 border-t-blue-500 rounded-full animate-spin mb-6">
                    </div>
                    <h3 class="text-2xl font-bold" style="color: var(--color-dark);">Neural Processing...</h3>
                    <p class="text-gray-500 mt-2 text-lg">Analyzing data points and generating insights</p>
                </div>

                <div id="resultsContent" class="grid grid-cols-1 gap-8">
                    <!-- Results injected here -->
                </div>
            </div>

        </main>

        <!-- Client Script -->
        <script>
            // Form Handlers
            const forms = [
                { id: 'linkedinForm', url: '/api/linkedin-analysis', type: 'LinkedIn' },
                { id: 'githubForm', url: '/api/github-analysis', type: 'GitHub' },
                { id: 'scholarForm', url: '/api/google-scholar-analysis', type: 'Research' },
                { id: 'certificationForm', url: '/api/certifications/add', type: 'AddCert' }
            ];

            forms.forEach(({ id, url, type }) => {
                const form = document.getElementById(id);
                if (form) {
                    form.addEventListener('submit', async (e) => {
                        e.preventDefault();
                        if (type === 'AddCert') document.getElementById('addCertModal').classList.add('hidden');
                        await analyzeData(url, new FormData(e.target), type);
                    });
                }
            });

            async function analyzeData(endpoint, formData, type) {
                const resultsSection = document.getElementById('resultsSection');
                const loading = document.getElementById('loadingSection');
                const content = document.getElementById('resultsContent');

                resultsSection.classList.remove('hidden');
                loading.classList.remove('hidden');
                content.classList.add('hidden');

                // Smooth scroll
                resultsSection.scrollIntoView({ behavior: 'smooth' });

                try {
                    // Convert formData to JSON
                    const data = Object.fromEntries(formData.entries());

                    const response = await fetch(endpoint, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });

                    const result = await response.json();

                    if (result.success) {
                        displayResults(result, type);
                    } else {
                        throw new Error(result.error);
                    }
                } catch (error) {
                    content.innerHTML = `
                <div class="bg-red-50 border border-red-200 p-10 rounded-[2rem] text-center shadow-md">
                    <div class="text-red-500 text-6xl mb-6"><i class="fas fa-exclamation-triangle"></i></div>
                    <h3 class="text-3xl font-bold text-red-900 mb-3">Analysis Failed</h3>
                    <p class="text-red-700 text-lg">${error.message || 'An unexpected error occurred.'}</p>
                </div>
            `;
                } finally {
                    loading.classList.add('hidden');
                    content.classList.remove('hidden');
                }
            }

            function displayResults(result, type) {
                const content = document.getElementById('resultsContent');
                let html = '';

                if (type === 'LinkedIn') {
                    const a = result.analysis;
                    html = `
                <div class="feature-card p-10 bg-white">
                    <div class="flex flex-col md:flex-row gap-12 items-center md:items-start">
                         <!-- Radial Score -->
                        <div class="relative w-48 h-48 flex-shrink-0">
                            <svg class="w-full h-full transform -rotate-90 drop-shadow-sm">
                                <circle cx="96" cy="96" r="84" class="radial-progress-bg" stroke-width="16" fill="transparent" />
                                <circle cx="96" cy="96" r="84" class="radial-progress-fill" stroke-width="16" fill="transparent" stroke-dasharray="527.7" stroke-dashoffset="${527.7 * (1 - a.profileStrength / 100)}" stroke-linecap="round" />
                            </svg>
                            <div class="absolute inset-0 flex items-center justify-center flex-col">
                                <span class="text-5xl font-extrabold" style="color: var(--color-dark);">${a.profileStrength}</span>
                                <span class="text-xs text-gray-400 font-bold uppercase tracking-widest mt-2">Score</span>
                            </div>
                        </div>
                        
                        <div class="flex-1 w-full mt-4 md:mt-2">
                            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4 pb-6 border-b border-gray-100">
                                <div>
                                    <h3 class="text-3xl font-extrabold tracking-tight" style="color: var(--color-dark);">Profile Strength</h3>
                                    <p class="text-lg text-gray-500 font-medium mt-2">${a.experienceLevel} <span class="text-gray-300 mx-2">•</span> <span class="text-blue-600 font-semibold">${a.industryFit}</span></p>
                                </div>
                                <div class="px-5 py-2 rounded-xl bg-blue-50 text-blue-600 text-base font-extrabold border border-blue-100 shadow-sm">Top 10%</div>
                            </div>
                            
                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
                                <div>
                                    <h4 class="text-sm font-bold text-gray-400 uppercase tracking-widest mb-5 flex items-center gap-2"><i class="fas fa-tags"></i> Key Skills Detected</h4>
                                    <div class="flex flex-wrap gap-2.5">
                                        ${a.keySkills.map(s => `<span class="px-4 py-2 rounded-xl bg-gray-50 text-sm text-gray-800 font-bold border border-gray-200 shadow-sm hover:border-blue-300 hover:bg-blue-50 cursor-default transition-colors">${s}</span>`).join('')}
                                    </div>
                                </div>
                                <div>
                                    <h4 class="text-sm font-bold text-gray-400 uppercase tracking-widest mb-5 flex items-center gap-2"><i class="fas fa-magic"></i> AI Recommendations</h4>
                                    <ul class="space-y-4">
                                        ${a.recommendations.map(r => `
                                            <li class="p-4 bg-blue-50/50 rounded-xl border border-blue-100 flex items-start gap-4">
                                                <div class="w-6 h-6 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center flex-shrink-0 mt-0.5"><i class="fas fa-lightbulb text-xs"></i></div>
                                                <span class="text-gray-700 font-medium leading-relaxed">${r}</span>
                                            </li>
                                        `).join('')}
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
                } else if (type === 'GitHub') {
                    const a = result.analysis;
                    html = `
                <div class="feature-card p-10 bg-white">
                    <div class="flex items-center gap-6 mb-10 pb-6 border-b border-gray-100">
                        <div class="p-5 bg-gray-900 rounded-[1.5rem] shadow-lg"><i class="fab fa-github text-white text-4xl"></i></div>
                        <div>
                            <h3 class="text-3xl font-extrabold tracking-tight" style="color: var(--color-dark);">Repository Audit</h3>
                            <p class="text-lg text-gray-500 font-medium mt-2">Quality: <span class="text-gray-900 font-bold">${a.codeQuality}%</span> <span class="text-gray-300 mx-2">•</span> Activity: <span class="text-gray-900 font-bold">${a.activity}%</span></p>
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
                        <div class="p-6 bg-gray-50 border border-gray-100 rounded-2xl text-center shadow-sm hover:shadow-md transition-shadow">
                            <div class="text-4xl font-black text-gray-900 mb-2">${a.codeQuality}%</div>
                            <div class="text-xs font-bold text-gray-400 uppercase tracking-widest">Quality</div>
                        </div>
                        <div class="p-6 bg-gray-50 border border-gray-100 rounded-2xl text-center shadow-sm hover:shadow-md transition-shadow">
                            <div class="text-4xl font-black text-gray-900 mb-2">${a.documentation}%</div>
                            <div class="text-xs font-bold text-gray-400 uppercase tracking-widest">Docs</div>
                        </div>
                        <div class="p-6 bg-gray-50 border border-gray-100 rounded-2xl text-center shadow-sm hover:shadow-md transition-shadow">
                            <div class="text-4xl font-black text-gray-900 mb-2">${a.collaboration}%</div>
                            <div class="text-xs font-bold text-gray-400 uppercase tracking-widest">Collab</div>
                        </div>
                         <div class="p-6 bg-gray-50 border border-gray-100 rounded-2xl text-center shadow-sm hover:shadow-md transition-shadow flex flex-col justify-center">
                            <div class="text-2xl font-black text-blue-600 mb-2">${a.complexity}</div>
                            <div class="text-xs font-bold text-gray-400 uppercase tracking-widest">Level</div>
                        </div>
                    </div>

                     <div class="p-8 bg-green-50 border border-green-200 rounded-3xl">
                        <h4 class="text-lg font-extrabold text-green-800 mb-4 flex items-center gap-2"><i class="fas fa-medal text-green-500"></i> Key Strengths</h4>
                         <div class="flex flex-wrap gap-3">
                            ${a.strengths.map(s => `<span class="text-base font-bold text-green-800 flex items-center gap-2 bg-white px-4 py-2 rounded-xl border border-green-200 shadow-sm"><i class="fas fa-check text-green-500"></i> ${s}</span>`).join(' ')}
                        </div>
                    </div>
                </div>
            `;
                } else if (type === 'Research') {
                    const a = result.analysis;
                    html = `
                <div class="feature-card p-10 bg-white">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-10 pb-6 border-b border-gray-100 gap-6">
                        <h3 class="text-3xl font-extrabold flex items-center gap-5 tracking-tight" style="color: var(--color-dark);">
                            <div class="w-16 h-16 flex items-center justify-center bg-purple-100 text-purple-600 rounded-[1.5rem] shadow-sm"><i class="fas fa-book-reader text-2xl"></i></div>
                            Research Impact
                        </h3>
                        <div class="text-left md:text-right bg-purple-50 px-6 py-4 rounded-2xl border border-purple-100 shadow-sm">
                            <div class="text-4xl font-black text-purple-600">${a.relevance}%</div>
                            <div class="text-xs font-bold text-purple-400 uppercase tracking-widest mt-1">Relevance Score</div>
                        </div>
                    </div>
                    
                    <div class="grid lg:grid-cols-2 gap-10">
                        <div>
                            <h4 class="text-sm font-bold text-gray-400 uppercase tracking-widest mb-5 flex items-center gap-2"><i class="fas fa-fire text-orange-400"></i> Trending Topics</h4>
                            <div class="flex flex-wrap gap-3">
                                 ${a.currentTrends.map(t => `<span class="px-4 py-2.5 rounded-xl bg-purple-50 text-purple-700 text-sm font-bold border border-purple-100 shadow-sm hover:bg-purple-100 cursor-default transition-colors">${t}</span>`).join('')}
                            </div>
                        </div>
                         <div>
                            <h4 class="text-sm font-bold text-gray-400 uppercase tracking-widest mb-5 flex items-center gap-2"><i class="fas fa-building text-blue-400"></i> Key Venues</h4>
                            <div class="space-y-3">
                                ${a.publicationVenues.map(v => `
                                    <div class="p-4 bg-gray-50 rounded-xl text-base text-gray-800 font-bold border border-gray-200 shadow-sm flex items-center gap-4 hover:border-gray-300 transition-colors">
                                        <div class="w-10 h-10 rounded-lg bg-white shadow-sm flex items-center justify-center text-gray-400 shrink-0"><i class="fas fa-university"></i></div>
                                        ${v}
                                    </div>
                                `).join('')}
                            </div>
                        </div>
                    </div>
                </div>
            `;
                } else {
                    html = `
                <div class="feature-card p-12 text-center bg-white">
                    <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-green-100 mb-8 border-4 border-white shadow-md">
                        <i class="fas fa-check text-green-500 text-5xl"></i>
                    </div>
                    <h3 class="text-3xl font-extrabold text-gray-900 mb-3 tracking-tight">Success</h3>
                    <p class="text-gray-500 text-xl font-medium">Operation completed successfully.</p>
                </div>
            `;
                }

                content.innerHTML = html;
            }
        </script>

        <%- include('layouts/footer'); %>