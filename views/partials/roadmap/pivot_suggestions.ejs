<!-- views/partials/roadmap/pivot_suggestions.ejs -->
<% if (roadmap.backupCareers && roadmap.backupCareers.length> 0) { %>
    <div class="glass-card p-6 mt-6 border-t-4 border-t-fuchsia-500 rounded-[20px] shadow-sm bg-white">
        <div class="mb-5">
            <h3 class="text-xl font-bold text-slate-800 flex items-center">
                <i class="fas fa-project-diagram text-fuchsia-500 mr-2"></i> Graph Transition Intelligence
            </h3>
            <p class="text-sm text-slate-500 mt-1">Algorithmic career pivots engineered from your current skill weight
                edges.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            <% roadmap.backupCareers.forEach((backup, index)=> { %>
                <div
                    class="border border-slate-100 bg-slate-50/50 rounded-2xl p-5 hover:shadow-md hover:border-fuchsia-200 transition-all duration-300 relative overflow-hidden group">
                    <!-- Decorative background elements -->
                    <div
                        class="absolute -right-4 -top-4 w-16 h-16 bg-fuchsia-100 rounded-full opacity-50 group-hover:scale-150 transition-transform duration-500">
                    </div>

                    <div class="relative z-10">
                        <div class="flex justify-between items-start mb-3">
                            <div
                                class="w-10 h-10 rounded-xl bg-white shadow-sm flex items-center justify-center text-fuchsia-600 border border-slate-100">
                                <i class="fas <%= index === 0 ? 'fa-rocket' : 'fa-lightbulb' %> text-lg"></i>
                            </div>
                            <span
                                class="bg-<%= backup.transition_ease === 'Easy' ? 'emerald' : backup.transition_ease === 'Medium' ? 'amber' : 'red' %>-100 text-<%= backup.transition_ease === 'Easy' ? 'emerald' : backup.transition_ease === 'Medium' ? 'amber' : 'red' %>-700 text-xs font-bold px-2 py-1 rounded">
                                <%= backup.transition_ease %> Pivot
                            </span>
                        </div>

                        <h4 class="font-bold text-slate-800 text-lg mb-2">
                            <%= backup.title %>
                        </h4>
                        <p class="text-xs text-slate-500 mb-4 line-clamp-2">
                            <%= backup.why_recommended %>
                        </p>

                        <div class="mt-auto">
                            <div class="flex justify-between items-center mb-1">
                                <span class="text-xs font-semibold text-slate-600">Transition Edge Score</span>
                                <span class="text-xs font-bold text-fuchsia-600">
                                    <%= backup.skill_overlap_percentage %>%
                                </span>
                            </div>
                            <div class="w-full bg-slate-200 rounded-full h-1.5 overflow-hidden">
                                <div class="bg-gradient-to-r from-fuchsia-400 to-fuchsia-500 h-1.5 rounded-full"
                                    style="width: <%= backup.skill_overlap_percentage %>%;"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <% }); %>
        </div>
    </div>
    <% } %>