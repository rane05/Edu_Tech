<!-- views/partials/roadmap/milestones.ejs -->
<div class="glass-card p-6 relative overflow-hidden bg-white border border-slate-200 mt-8">
    <div class="flex items-center justify-between mb-6">
        <h2 class="text-lg font-bold text-slate-800 flex items-center">
            <i class="fas fa-trophy text-orange-400 mr-2"></i> Journey Milestones
        </h2>
        <span id="milestone-count" class="bg-indigo-100 text-indigo-700 text-xs font-bold px-2.5 py-1 rounded-full">
            0 / 6 Unlocked
        </span>
    </div>

    <!-- Major Progress Bar -->
    <div class="mb-8">
        <div class="flex justify-between text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">
            <span>Current Readiness</span>
            <span id="milestone-pct">0%</span>
        </div>
        <div class="h-4 w-full bg-slate-100 rounded-full overflow-hidden p-1 border border-slate-200">
            <div id="milestone-progress-fill" 
                 class="h-full bg-gradient-to-r from-indigo-500 via-purple-500 to-teal-500 rounded-full transition-all duration-1000 ease-out shadow-[0_0_15px_rgba(99,102,241,0.4)]"
                 style="width: 0%"></div>
        </div>
    </div>

    <div class="space-y-4">
        <div class="relative pt-2 pb-2">
            <!-- Gamified Progress Line (Vertical) -->
            <div class="absolute left-6 top-6 bottom-6 w-1 bg-slate-100 rounded-full"></div>
            <div id="milestoneProgressLine" class="absolute left-6 top-6 w-1 bg-gradient-to-b from-teal-400 to-indigo-500 rounded-full transition-all duration-1000 ease-out shadow-[0_0_10px_rgba(20,184,166,0.5)]" style="height: 0%"></div>
            
            <!-- Milestones Mapping -->
            <% 
            const milestoneBadges = [
                { icon: 'fa-seedling', color: 'text-emerald-500', name: 'The Spark', threshold: 5, tip: "Complete your first few modules to unlock 'The Spark'! 🚀" },
                { icon: 'fa-bolt', color: 'text-purple-500', name: 'Fast Starter', threshold: 25, tip: "Great start! Keep pushing to reach 25% and earn your 'Fast Starter' badge. ⚡" },
                { icon: 'fa-mountain', color: 'text-teal-500', name: 'Pathfinder', threshold: 50, tip: "Over halfway there! You're becoming a true Pathfinder. 🗺️" },
                { icon: 'fa-rocket', color: 'text-orange-500', name: 'Elite Specialist', threshold: 75, tip: "Advanced topics ahead! Reach 75% to unlock 'Elite Specialist'. 🚀" },
                { icon: 'fa-briefcase', color: 'text-blue-500', name: 'Ready for Hire', threshold: 90, tip: "Almost project-ready! Just a few more steps to 'Ready for Hire'. 💼" },
                { icon: 'fa-graduation-cap', color: 'text-indigo-900', name: 'Supreme Master', threshold: 100, tip: "Final stretch! Complete everything for 'Supreme Mastery'. 👑" }
            ];
            %>

            <% milestoneBadges.forEach(function(badge, idx) { %>
            <div class="relative flex items-center mb-8 last:mb-0 milestone-item" data-threshold="<%= badge.threshold %>" data-tip="<%= badge.tip %>">
                <!-- Milestone Icon Container -->
                <div class="milestone-icon-box z-10 w-12 h-12 rounded-full bg-slate-100 border-4 border-white shadow-sm flex items-center justify-center transition-all duration-500 filter grayscale opacity-50 relative">
                    <i class="fas <%= badge.icon %> text-xl <%= badge.color %> transition-colors duration-500"></i>
                    <!-- Animated generic pulse for unlocked item -->
                    <div class="unlock-pulse absolute inset-0 rounded-full border-2 border-indigo-400 opacity-0 scale-100"></div>
                </div>
                
                <div class="ml-4 flex-1">
                    <h4 class="text-sm font-bold milestone-title text-slate-400 transition-colors duration-500 mb-0.5"><%= badge.name %></h4>
                    <p class="text-[11px] font-semibold text-slate-500 uppercase tracking-wide"><%= badge.threshold %>% Completion</p>
                </div>
                
                <div class="text-xs font-bold text-slate-300 milestone-status transition-colors duration-500 w-8 text-center">
                    <i class="fas fa-lock"></i>
                </div>
            </div>
            <% }); %>
        </div>
    </div>

    <!-- Career Readiness Insight -->
    <div class="mt-8 pt-6 border-t border-slate-100">
        <div id="readiness-insight" class="bg-indigo-50 rounded-xl p-4 border border-indigo-100 text-center">
            <p class="text-xs text-indigo-600 font-bold mb-1">PRO TIP</p>
            <p class="text-[11px] text-slate-600 leading-relaxed" id="milestone-tip">
                Complete your first 3 modules to unlock the "The Spark" badge and reveal your first project!
            </p>
        </div>
    </div>
</div>

<style>
    @keyframes pulse-ring {
        0% { transform: scale(0.8); opacity: 0.5; }
        100% { transform: scale(1.5); opacity: 0; }
    }
    .milestone-icon-box.unlocked .unlock-pulse {
        animation: pulse-ring 2s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
    }
    .milestone-icon-box.unlocked {
        filter: none;
        opacity: 1;
        background: white;
        transform: scale(1.1);
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    .milestone-item.unlocked .milestone-title {
        color: #1e293b;
    }
    .milestone-item.unlocked .milestone-status {
        color: #10b981;
    }
</style>

<script>
    (function() {
        const originalUpdateProgress = window.updateGlobalProgress;

        window.updateGlobalProgress = function() {
            // Call original if it exists
            if (originalUpdateProgress) originalUpdateProgress();

            const checkboxes = document.querySelectorAll('input[type="checkbox"][data-task-id]');
            const total = checkboxes.length;
            if (total === 0) return;

            let checked = 0;
            checkboxes.forEach(cb => { if (cb.checked) checked++; });

            const pct = Math.round((checked / total) * 100);

            // Update Milestone UI
            const fill = document.getElementById('milestone-progress-fill');
            const pctText = document.getElementById('milestone-pct');
            const milestoneItems = document.querySelectorAll('.milestone-item');
            const milestoneCount = document.getElementById('milestone-count');
            const tipText = document.getElementById('milestone-tip');
            const progressLine = document.getElementById('milestoneProgressLine');

            if (fill) fill.style.width = pct + '%';
            if (pctText) pctText.innerText = pct + '%';

            let unlockedCount = 0;
            milestoneItems.forEach((item, index) => {
                const threshold = parseInt(item.dataset.threshold);
                const iconBox = item.querySelector('.milestone-icon-box');
                const title = item.querySelector('.milestone-title');
                const status = item.querySelector('.milestone-status');

                if (pct >= threshold) {
                    item.classList.add('unlocked');
                    iconBox.classList.add('unlocked');
                    status.innerHTML = '<i class="fas fa-unlock text-emerald-500 animate-bounce"></i>';
                    unlockedCount++;
                } else {
                    item.classList.remove('unlocked');
                    iconBox.classList.remove('unlocked');
                    status.innerHTML = '<i class="fas fa-lock"></i>';
                }
            });

            if (milestoneCount) milestoneCount.innerText = unlockedCount + ' / 6 Unlocked';
            
            // Sync with dashboard badges count if it exists
            const dashboardBadges = document.getElementById('dashboard-badges-count');
            if (dashboardBadges) dashboardBadges.innerText = unlockedCount + ' Badges Earned';

            // Vertical line fill logic
            if (progressLine) {
                const stepHeightPct = 100 / (milestoneItems.length - 1 || 1);
                let linePct = 0;
                if (unlockedCount > 0) {
                    linePct = (unlockedCount - 1) * stepHeightPct;
                }
                setTimeout(() => {
                    progressLine.style.height = `${linePct}%`;
                }, 100);
            }

            // Update Tip
            const tips = [
                "Complete your first few modules to unlock 'The Spark'! 🚀",
                "Great start! Keep pushing to reach 25% and earn your 'Fast Starter' badge. ⚡",
                "You're making real progress. 50% is just around the corner! 🏔️",
                "Over halfway there! You're becoming a true Pathfinder. 🗺️",
                "Advanced topics ahead! Reach 75% to unlock 'Elite Specialist'. 🚀",
                "Almost project-ready! Just a few more steps to 'Ready for Hire'. 💼",
                "Final stretch! Complete everything for 'Supreme Mastery'. 👑",
                "Congratulations Master! Your roadmap is 100% complete. 🏆"
            ];

            let tipIndex = 0;
            if (pct < 5) tipIndex = 0;
            else if (pct < 25) tipIndex = 1;
            else if (pct < 50) tipIndex = 2;
            else if (pct < 75) tipIndex = 3;
            else if (pct < 90) tipIndex = 5;
            else if (pct < 100) tipIndex = 6;
            else tipIndex = 7;

            if (tipText) tipText.innerText = tips[tipIndex];
        };

        // Initialize on load
        window.addEventListener('DOMContentLoaded', () => {
            setTimeout(window.updateGlobalProgress, 500);
        });
    })();
</script>
