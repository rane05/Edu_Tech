<!-- views/partials/roadmap/estimator.ejs -->
<div class="glass-card p-6 md:p-8">
    <div class="flex items-center justify-between mb-6">
        <div>
            <h3 class="text-xl font-bold text-slate-800 flex items-center">
                <i class="fas fa-stopwatch text-indigo-500 mr-2"></i> Timeline Estimator
            </h3>
            <p class="text-sm text-slate-500 mt-1">Adjust your availability to recalculate the roadmap duration.</p>
        </div>
        <div class="text-right">
            <span id="estimatedWeeks" class="text-3xl font-extrabold text-indigo-600">
                <%= roadmap.estimated_total_weeks %>
            </span>
            <span class="text-slate-500 text-sm font-medium block">Total Weeks</span>
        </div>
    </div>

    <!-- Slider Input -->
    <div class="mt-8">
        <div class="flex justify-between text-xs font-bold text-slate-400 mb-2 uppercase">
            <span>5 hrs/wk</span>
            <span id="sliderValueText"
                class="text-indigo-600 font-extrabold text-base bg-indigo-50 px-3 py-1 rounded-full">15 hrs/wk</span>
            <span>40+ hrs/wk</span>
        </div>
        <input type="range" id="hoursSlider" min="5" max="40" value="15" step="1" oninput="updateEstimate(this.value)"
            class="w-full">
    </div>
</div>

<script>
    // Assuming the AI generated total weeks based on "10 hours a week" standard as an internal baseline
    // You could dynamically pull the baseline from userProfile if available.
    const baselineWeeks = parseInt("<%= roadmap.estimated_total_weeks %>");
    const baselineHours = 10; // Assuming 10 was the baseline requested to AI

    function updateEstimate(hours) {
        document.getElementById('sliderValueText').innerText = hours + ' hrs/wk';

        // Simple inverse proportion for recalculation
        let newWeeks = Math.round((baselineWeeks * baselineHours) / hours);
        if (newWeeks < 4) newWeeks = 4; // minimum threshold

        // Animate count change
        animateValue('estimatedWeeks', parseInt(document.getElementById('estimatedWeeks').innerText), newWeeks, 400);
    }

    function animateValue(id, start, end, duration) {
        const obj = document.getElementById(id);
        const range = end - start;
        let current = start;
        const increment = end > start ? 1 : -1;
        const stepTime = Math.abs(Math.floor(duration / range));

        const timer = setInterval(function () {
            current += increment;
            obj.innerHTML = current;
            if (current === end) {
                clearInterval(timer);
            }
        }, stepTime);
    }
</script>