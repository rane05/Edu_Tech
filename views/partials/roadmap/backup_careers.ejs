<!-- views/partials/roadmap/backup_careers.ejs -->
<div class="glass-card p-6 border-t-4 border-t-indigo-500">
    <div class="mb-4">
        <h3 class="text-xl font-bold text-slate-800 flex items-center">
            <i class="fas fa-compass text-indigo-500 mr-2"></i> Pivot Paths
        </h3>
        <p class="text-xs text-slate-500 mt-1 uppercase tracking-wide font-bold">Alternative Career Options</p>
    </div>

    <div class="space-y-4 pt-2">
        <% if(roadmap.backup_careers && roadmap.backup_careers.length> 0) { %>
            <% roadmap.backup_careers.forEach(career=> { %>
                <div
                    class="border border-slate-200 rounded-lg p-4 bg-slate-50 flex items-start group hover:bg-white hover:shadow-md transition-all cursor-pointer">
                    <div
                        class="w-10 h-10 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center font-bold shrink-0 mr-4">
                        <i
                            class="fas fa-arrow-right -rotate-45 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-slate-800 mb-0.5">
                            <%= career.title %>
                        </h4>
                        <div class="flex items-center space-x-3 mb-2">
                            <span
                                class="text-[10px] uppercase font-bold text-teal-600 bg-teal-50 border border-teal-100 px-1.5 py-0.5 rounded">
                                <%= career.skill_overlap_percentage %>% Skill Overlap
                            </span>
                            <span class="text-[10px] uppercase font-bold text-slate-500"><i
                                    class="fas fa-exchange-alt mr-1"></i> Ease: <%= career.transition_ease %></span>
                        </div>
                        <p class="text-xs text-slate-500 leading-snug">
                            <%= career.why_recommended %>
                        </p>
                    </div>
                </div>
                <% }); %>
                    <% } else { %>
                        <p class="text-sm text-slate-500 italic">No alternative paths suggested by AI.</p>
                        <% } %>
    </div>
</div>