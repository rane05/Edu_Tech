<%- include('layouts/header'); %>
  <%- include('layouts/navbar'); %>

    <style>
      :root {
        /* V6 Premium SaaS Layered Palette */
        /* Global Platform Theme Remapping (V7 - Yellow Theme) */

        /* Backgrounds */
        --c-cream: #F7FAFC;
        /* Global light bg */
        --c-cream-alt: #FFFFFF;
        /* Global white */
        --c-base: #FFFFFF;
        /* Card surfaces */

        /* Typography */
        --c-navy: #1A1A2E;
        /* Global dark text */
        --c-navy-muted: #2D3748;
        /* Global dark secondary text */
        --c-slate: #4A5568;
        /* Global standard body text */
        --c-slate-light: #718096;
        /* Global light text */

        /* Accents mapped to Classic Yellow Theme */
        --c-indigo: #FFB800;
        /* Primary Yellow */
        --c-indigo-soft: rgba(255, 184, 0, 0.1);
        --c-teal: #00A8FF;
        /* Secondary Blue */
        --c-teal-soft: rgba(0, 168, 255, 0.1);

        /* Secondary Accents */
        --c-amber: #6C63FF;
        /* Accent Purple */
        --c-amber-soft: rgba(108, 99, 255, 0.1);
        --c-coral: #10B981;
        /* Success Green */
        --c-coral-soft: rgba(16, 185, 129, 0.1);

        /* Ambient Glows Adjusted for new palette */
        --c-indigo-glow: rgba(255, 184, 0, 0.15);
        /* Yellow glow */
        --c-teal-glow: rgba(0, 168, 255, 0.12);
        /* Blue glow */
        --c-amber-glow: rgba(108, 99, 255, 0.08);
        /* Purple glow */
        --c-coral-glow: rgba(16, 185, 129, 0.08);
        /* Green glow */
        --c-tint-indigo: #FFFaf0;
        /* Yellow tint */
        --c-tint-lavender: #f0f8ff;
        /* Blue tint */
        /* Spacing System (Maintained from V5) */
        --space-section-ds: 120px;
        --space-section-tb: 80px;
        --space-section-mb: 64px;
        --gap-xl: 48px;
        --gap-lg: 32px;
        --gap-md: 24px;
        --gap-sm: 16px;
        --card-pad: 32px;

        /* V6 Refined Shadows (Color hinted) */
        --shadow-micro: 0 1px 2px rgba(15, 23, 42, 0.04);
        --shadow-soft: 0 4px 12px rgba(15, 23, 42, 0.05), 0 1px 3px rgba(15, 23, 42, 0.03);
        --shadow-float: 0 24px 48px rgba(15, 23, 42, 0.08), 0 8px 16px rgba(15, 23, 42, 0.03);
        --shadow-base-ui: 0 4px 12px rgba(15, 23, 42, 0.06);
        --shadow-glass: 0 8px 32px rgba(15, 23, 42, 0.05);

        /* Section Specific Drop Shadows for Cards */
        --shadow-glow-indigo: 0 12px 32px rgba(99, 102, 241, 0.08);

        /* Motion Focus */
        --dur-hover: 280ms;
        --dur-reveal: 400ms;
        --dur-chart: 800ms;
        --dur-float: 6s;
        --ease-out-smooth: cubic-bezier(0.16, 1, 0.3, 1);
        --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);

        --bg-noise: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='1'/%3E%3C/svg%3E");
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'SF Pro Display', sans-serif;
        background-color: var(--c-cream);
        /* V6: Removed pure white #FFF globally */
        color: var(--c-navy);
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      /* Base Realism Overlay */
      .noise-overlay {
        position: fixed;
        inset: 0;
        background-image: var(--bg-noise);
        opacity: 0.02;
        /* Subtle grain for physical feel */
        pointer-events: none;
        z-index: 9999;
      }

      /* V6 Refined Glass Token - Reduced Blur for realism */
      .glass-acrylic {
        background: rgba(255, 255, 255, 0.55);
        /* Lighter base */
        backdrop-filter: blur(12px) saturate(140%);
        -webkit-backdrop-filter: blur(12px) saturate(140%);
        border-radius: 20px;
        box-shadow: var(--shadow-glass);
        border: 1px solid rgba(255, 255, 255, 0.5);
        /* Physical rim light */
        border-top: 1px solid rgba(255, 255, 255, 0.9);
        border-left: 1px solid rgba(255, 255, 255, 0.9);
        position: relative;
        overflow: hidden;
        transition: transform var(--dur-hover) var(--ease-out-smooth), box-shadow var(--dur-hover) ease, backdrop-filter var(--dur-hover) ease;
      }

      .glass-acrylic::before {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background-image: var(--bg-noise);
        opacity: 0.02;
        z-index: 0;
      }

      .glass-acrylic::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 1;
        background: linear-gradient(110deg, transparent 20%, rgba(255, 255, 255, 0.5) 40%, transparent 60%);
        transform: translateX(-150%);
        animation: glassSweep 8s infinite var(--ease-in-out);
      }

      @keyframes glassSweep {

        0%,
        30% {
          transform: translateX(-150%);
        }

        70%,
        100% {
          transform: translateX(150%);
        }
      }

      @keyframes move-forever {
        0% {
          transform: translate(-2px, 0)
        }

        100% {
          transform: translate(0px, 0)
        }
      }

      .waves-use-el {
        animation: move-forever 15s linear infinite;
      }

      .waves-use-el:nth-child(2) {
        animation-duration: 20s;
        animation-delay: -5s;
      }

      .waves-use-el:nth-child(1) {
        animation-duration: 25s;
      }

      /* Premium Text Animations */
      @keyframes crystal-shimmer {
        0% {
          background-position: -200% center;
        }

        100% {
          background-position: 200% center;
        }
      }

      @keyframes text-bounce-up {
        0% {
          opacity: 0;
          transform: translateY(40px);
        }

        60% {
          opacity: 1;
          transform: translateY(-10px);
        }

        80% {
          transform: translateY(5px);
        }

        100% {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .animate-text-crystal {
        background: linear-gradient(to right,
            var(--c-navy) 20%,
            #405f99 30%,
            var(--c-navy) 70%,
            var(--c-navy) 80%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        background-size: 500% auto;
        animation: crystal-shimmer 4s linear infinite;
      }

      .animate-reveal-up-1,
      .animate-reveal-up-2,
      .animate-reveal-up-3 {
        opacity: 0;
      }

      .is-revealed.animate-reveal-up-1 {
        animation: text-bounce-up 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
      }

      .is-revealed.animate-reveal-up-2 {
        animation: text-bounce-up 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        animation-delay: 0.15s;
      }

      .is-revealed.animate-reveal-up-3 {
        animation: text-bounce-up 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        animation-delay: 0.3s;
      }

      /* High-End Electric Jagged Border */
      .electric-card-wrapper {
        position: relative;
        background: rgba(255, 255, 255, 0.45) !important;
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: none !important;
        box-shadow: 0 8px 32px rgba(15, 23, 42, 0.04) !important;
      }

      .electric-card-wrapper::before,
      .electric-card-wrapper::after {
        content: '';
        position: absolute;
        inset: 0px;
        border-radius: inherit;
        border: 2px solid transparent;
        pointer-events: none;
        z-index: 10;
        transition: opacity 0.3s ease;
      }

      .electric-card-wrapper::before {
        border-color: #FFB800;
        /* Yellow */
        filter: url(#lightning-filter) drop-shadow(0 0 5px #FFB800) drop-shadow(0 0 10px #FFB800);
        opacity: 0.8;
      }

      .electric-card-wrapper::after {
        border-color: #ffffff;
        filter: url(#lightning-filter) drop-shadow(0 0 2px #ffffff);
        opacity: 0.9;
      }

      .electric-card-wrapper:hover::before {
        opacity: 1;
        filter: url(#lightning-filter) drop-shadow(0 0 8px #FFB800) drop-shadow(0 0 15px rgba(255, 184, 0, 0.8));
      }

      .electric-card-wrapper:hover::after {
        opacity: 1;
        filter: url(#lightning-filter) drop-shadow(0 0 4px #ffffff);
      }

      .electric-card-wrapper .text-h3,
      .electric-card-wrapper .text-body {
        color: var(--c-navy) !important;
      }

      .electric-card-wrapper .pc-list-item {
        color: var(--c-navy) !important;
      }

      .electric-card-wrapper .pc-list-item i {
        color: var(--c-slate-light) !important;
      }

      .electric-card-wrapper:hover .pc-list-item i {
        color: var(--c-navy) !important;
      }

      /* Typography Hierarchy */
      .text-display {
        font-size: clamp(3.5rem, 6.5vw, 6.2rem);
        line-height: 1.05;
        letter-spacing: -0.04em;
        font-weight: 800;
        color: var(--c-navy);
      }

      .text-h1 {
        font-size: clamp(2.5rem, 4vw, 3.5rem);
        line-height: 1.1;
        letter-spacing: -0.03em;
        font-weight: 700;
        color: var(--c-navy);
      }

      .text-h2 {
        font-size: clamp(2rem, 3.5vw, 2.75rem);
        line-height: 1.15;
        letter-spacing: -0.02em;
        font-weight: 700;
        color: var(--c-navy);
      }

      .text-h3 {
        font-size: 1.35rem;
        line-height: 1.4;
        font-weight: 600;
        color: var(--c-navy);
        letter-spacing: -0.01em;
      }

      .text-lead {
        font-size: 1.25rem;
        line-height: 1.6;
        color: var(--c-slate);
        font-weight: 400;
        max-width: 58ch;
      }

      .text-body {
        font-size: 1.05rem;
        line-height: 1.65;
        color: var(--c-slate);
        max-width: 60ch;
      }

      .text-small {
        font-size: 0.875rem;
        color: var(--c-slate-light);
        font-weight: 500;
      }

      .text-eyebrow {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--c-slate-light);
        margin-bottom: 1rem;
        display: block;
      }

      /* Gradient Text Accents */
      .accent-gradient-indigo {
        background: linear-gradient(135deg, var(--c-navy), var(--c-indigo));
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      /* Layout */
      .section {
        padding: var(--space-section-ds) 0;
        position: relative;
      }

      .mb-large {
        margin-bottom: 3rem;
      }

      .mb-medium {
        margin-bottom: 1.5rem;
      }

      /* V6 Color Alternations */
      .b-alt {
        background: var(--c-cream-alt);
      }

      .b-white {
        background: var(--c-cream);
      }

      .b-tint-indigo {
        background: var(--c-tint-indigo);
      }

      .b-tint-lavender {
        background: var(--c-tint-lavender);
      }

      /* V6 Subtle Edges (removed hard black borders) */
      .edge-top {
        border-top: 1px solid rgba(15, 23, 42, 0.03);
      }

      .edge-bot {
        border-bottom: 1px solid rgba(15, 23, 42, 0.03);
      }

      .container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 2rem;
        position: relative;
        z-index: 2;
      }

      .text-center {
        text-align: center;
      }

      .relative {
        position: relative;
      }

      /* Buttons: V6 Gradient & Pulse */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.75rem 1.75rem;
        font-size: 0.95rem;
        font-weight: 600;
        border-radius: 8px;
        text-decoration: none;
        border: 1px solid transparent;
        cursor: pointer;
        transition: all var(--dur-hover) var(--ease-out-smooth);
      }

      /* Buttons updated to classic yellow gradient */
      .btn-primary {
        background: linear-gradient(135deg, #FFB800, #E5A700);
        color: #1A1A2E;
        /* Dark text on yellow for high contrast */
        border: none;
        padding: 0.85rem 1.75rem;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all var(--dur-hover) var(--ease-out-smooth);
        box-shadow: 0 4px 15px rgba(255, 184, 0, 0.3);
        position: relative;
        overflow: hidden;
      }

      .btn-primary::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 50%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
        transition: left 0.6s ease;
        pointer-events: none;
      }

      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(255, 184, 0, 0.5);
        background: linear-gradient(135deg, #E5A700, #FFB800);
      }

      .btn-primary:hover::before {
        left: 150%;
      }

      .btn-primary:active {
        transform: scale(0.97);
        box-shadow: 0 2px 8px rgba(255, 184, 0, 0.2);
      }

      .btn-outline {
        background: rgba(255, 255, 255, 0.5);
        /* Tinted transparent */
        color: var(--c-navy);
        border: 1px solid rgba(15, 23, 42, 0.1);
        backdrop-filter: blur(4px);
      }

      .btn-outline:hover {
        background: var(--c-base);
        border-color: rgba(15, 23, 42, 0.2);
        box-shadow: var(--shadow-micro);
      }

      /* Ambient Motion Glows */
      @keyframes floatGlow {
        0% {
          transform: scale(1) translate(0, 0);
          opacity: 0.6;
        }

        50% {
          transform: scale(1.1) translate(2%, 2%);
          opacity: 0.8;
        }

        100% {
          transform: scale(1) translate(0, 0);
          opacity: 0.6;
        }
      }

      /* ================== V5/V6: 1. HERO & PLATFORM OVERVIEW ================== */
      .hero {
        min-height: 100vh;
        padding-top: 180px;
        padding-bottom: 80px;
        display: flex;
        align-items: center;
        position: relative;
        background: var(--c-cream-alt);
        overflow: hidden;
      }

      /* V6 Hero Ambient Indigo Glow */
      .hero::before {
        content: '';
        position: absolute;
        top: 10%;
        right: 5%;
        width: 50vw;
        height: 50vw;
        background: radial-gradient(circle, var(--c-indigo-glow) 0%, transparent 70%);
        filter: blur(100px);
        z-index: 0;
        pointer-events: none;
        animation: floatGlow 15s ease-in-out infinite;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 10fr 12fr;
        gap: var(--gap-lg);
        align-items: center;
      }

      .hero-content {
        max-width: 500px;
      }

      /* Custom override for white text in hero section */
      .hero-content .text-eyebrow {
        color: rgba(255, 255, 255, 0.9) !important;
      }

      .hero-content .text-display {
        color: #ffffff !important;
      }

      .hero-content .text-lead {
        color: rgba(255, 255, 255, 0.9) !important;
      }

      .hero-content .hp-item,
      .hero-content .hp-item i {
        color: rgba(255, 255, 255, 0.9) !important;
      }

      .hero-content .hero-pillars {
        border-top: 1px solid rgba(255, 255, 255, 0.3) !important;
      }

      .hero-pillars {
        display: flex;
        gap: var(--gap-md);
        margin-top: 2.5rem;
        padding-top: 1.5rem;
      }

      .hp-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--c-slate);
      }

      .hp-item i {
        font-size: 1rem;
        color: var(--c-indigo);
        opacity: 0.8;
      }

      .hero-visual {
        position: relative;
        height: 500px;
        width: 100%;
        perspective: 1200px;
      }

      /* Base glass retains its properties */
      .mockup-base {
        position: absolute;
        width: 520px;
        height: 380px;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) rotateY(-5deg) rotateX(2deg);
        padding: 0;
        display: flex;
        flex-direction: column;
        z-index: 2;
        animation: mockFloat var(--dur-float) ease-in-out infinite alternate;
      }

      @keyframes mockFloat {
        0% {
          transform: translate(-50%, -50%) rotateY(-5deg) rotateX(2deg) translateY(0);
        }

        100% {
          transform: translate(-50%, -50%) rotateY(-5deg) rotateX(2deg) translateY(-15px);
        }
      }

      .mock-nav {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid rgba(15, 23, 42, 0.05);
        display: flex;
        align-items: center;
        justify-content: space-between;
        z-index: 3;
        position: relative;
      }

      .mock-dots {
        display: flex;
        gap: 6px;
      }

      .mock-dots span {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: rgba(15, 23, 42, 0.1);
      }

      .mock-dots span:nth-child(1) {
        background: rgba(15, 23, 42, 0.2);
      }

      .mock-body {
        padding: 2rem;
        flex: 1;
        position: relative;
        z-index: 3;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .mock-skeleton {
        height: 8px;
        border-radius: 4px;
        background: rgba(15, 23, 42, 0.04);
        position: relative;
        overflow: hidden;
      }

      .mock-skeleton::after {
        content: '';
        position: absolute;
        inset: 0;
        transform: translateX(-100%);
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.6), transparent);
        animation: shimmer 2.5s infinite;
      }

      @keyframes shimmer {
        100% {
          transform: translateX(100%);
        }
      }

      /* V6 Refined Cards: Tinted off-white, physical rim light, soft shadow */
      .mock-internal-card {
        background: var(--c-base);
        /* Just barely off-white */
        padding: 1rem;
        border-radius: 12px;
        border: 1px solid rgba(15, 23, 42, 0.03);
        border-top: 1px solid rgba(255, 255, 255, 0.8);
        border-left: 1px solid rgba(255, 255, 255, 0.8);
        margin-top: 1rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        position: relative;
        box-shadow: var(--shadow-soft);
      }

      /* ================== V5/V6: 2. CORE PILLARS (THE MAIN HUB) ================== */
      .hub-section {
        background: var(--c-cream);
        position: relative;
        overflow: hidden;
      }

      /* V6 Hub Ambient Teal Glow */
      .hub-section::before {
        content: '';
        position: absolute;
        bottom: 0;
        left: -10%;
        width: 60vw;
        height: 60vw;
        background: radial-gradient(circle, var(--c-teal-glow) 0%, transparent 60%);
        filter: blur(120px);
        z-index: 0;
        pointer-events: none;
      }

      .pillar-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--gap-lg);
        margin-top: 4rem;
        position: relative;
        z-index: 1;
      }

      /* V10 Elevated SaaS Glass Cards */
      .pillar-card {
        background: rgba(255, 255, 255, 0.45);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-radius: 24px;
        padding: var(--card-pad);
        border: 1px solid rgba(255, 255, 255, 0.6);
        box-shadow: 0 8px 32px rgba(15, 23, 42, 0.04);
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        --mouse-x: 50%;
        --mouse-y: 50%;
        transform-style: preserve-3d;

        /* Pre-reveal state */
        opacity: 0;
        transform: translateY(40px);
        transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
      }

      .pillar-card.revealed {
        opacity: 1;
        transform: translateY(0);
      }

      .pillar-card.revealed:hover {
        transform: translateY(-4px) perspective(1000px) rotateX(var(--rotate-x, 0deg)) rotateY(var(--rotate-y, 0deg));
        box-shadow: 0 24px 48px rgba(15, 23, 42, 0.08), 0 4px 12px rgba(15, 23, 42, 0.04);
        /* Fast transition for smooth mouse tracking */
        transition: transform 0.1s ease-out, box-shadow 0.3s ease;
      }

      /* Inner Hover Glow */
      .pillar-card::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(600px circle at var(--mouse-x) var(--mouse-y),
            rgba(255, 255, 255, 0.8),
            transparent 40%);
        opacity: 0;
        transition: opacity 0.3s ease;
        z-index: 0;
        pointer-events: none;
      }

      /* Shine Border Effect using pseudo-element */
      .pillar-card::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        padding: 1px;
        background: radial-gradient(400px circle at var(--mouse-x) var(--mouse-y),
            rgba(255, 255, 255, 1),
            transparent 40%);
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        opacity: 0;
        transition: opacity 0.3s ease;
        pointer-events: none;
        z-index: 2;
      }

      .pillar-card:hover::before,
      .pillar-card:hover::after {
        opacity: 1;
      }

      .pillar-card>* {
        position: relative;
        z-index: 1;
      }

      /* Spot Colors for Hierarchy */
      .pc-features .pc-icon-wrap {
        background: linear-gradient(135deg, var(--c-indigo-soft), rgba(255, 184, 0, 0.2));
        color: var(--c-indigo);
        border: 1px solid rgba(255, 184, 0, 0.3);
        box-shadow: 0 4px 16px var(--c-indigo-glow);
      }

      .pc-tools .pc-icon-wrap {
        background: linear-gradient(135deg, var(--c-teal-soft), rgba(0, 168, 255, 0.2));
        color: var(--c-teal);
        border: 1px solid rgba(0, 168, 255, 0.3);
        box-shadow: 0 4px 16px var(--c-teal-glow);
      }

      .pc-assess .pc-icon-wrap {
        background: linear-gradient(135deg, var(--c-amber-soft), rgba(108, 99, 255, 0.2));
        color: var(--c-amber);
        border: 1px solid rgba(108, 99, 255, 0.3);
        box-shadow: 0 4px 16px var(--c-amber-glow);
      }

      .pc-resources .pc-icon-wrap {
        background: linear-gradient(135deg, var(--c-coral-soft), rgba(16, 185, 129, 0.2));
        color: var(--c-coral);
        border: 1px solid rgba(16, 185, 129, 0.3);
        box-shadow: 0 4px 16px var(--c-coral-glow);
      }

      .pc-header {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
      }

      .pc-icon-wrap {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        flex-shrink: 0;
        position: relative;
        overflow: hidden;
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      }

      .pillar-card:hover .pc-icon-wrap {
        transform: scale(1.1) rotate(5deg);
      }

      .pc-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-top: 1rem;
      }

      .pc-list-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: var(--c-navy);
        font-weight: 500;
        font-size: 0.95rem;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      }

      .pillar-card:hover .pc-list-item {
        transform: translateX(6px);
      }

      .pc-list-item i {
        color: var(--c-slate-light);
        font-size: 0.8rem;
        transition: color 0.3s ease;
      }

      .pillar-card:hover .pc-list-item i {
        color: var(--c-navy);
      }

      /* Pillar Subtle Connectors */
      .hub-connectors {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        opacity: 0.6;
      }

      .hub-connectors svg {
        width: 100%;
        height: 100%;
      }

      .animated-path {
        fill: none;
        stroke: url(#network-gradient);
        stroke-width: 1.5;
        stroke-dasharray: 12 12;
        animation: dashMove 30s linear infinite;
        opacity: 0.4;
      }

      @keyframes dashMove {
        from {
          stroke-dashoffset: 0;
        }

        to {
          stroke-dashoffset: -1000;
        }
      }

      /* ================== V5/V6: 3. FEATURE STORYTELLING ================== */
      .story-section {
        background: var(--c-tint-lavender);
        /* V6: Light lavender atmospheric layer */
        position: relative;
        overflow: hidden;
      }

      /* V6 Story Ambient Glow */
      .story-section::after {
        content: '';
        position: absolute;
        top: 20%;
        right: -10%;
        width: 70vw;
        height: 70vw;
        background: radial-gradient(circle, var(--c-indigo-glow) 0%, transparent 60%);
        filter: blur(120px);
        z-index: 0;
        pointer-events: none;
      }

      .story-block {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--gap-xl);
        align-items: center;
        margin-bottom: 8rem;
        position: relative;
        z-index: 1;
      }

      .story-block:last-child {
        margin-bottom: 0;
      }

      .story-block.reversed {
        direction: rtl;
      }

      .story-block.reversed>* {
        direction: ltr;
      }

      .story-text {
        max-width: 460px;
      }

      .story-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 20px;
        background: var(--c-base);
        border: 1px solid rgba(15, 23, 42, 0.05);
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--c-navy);
        margin-bottom: 1.5rem;
        box-shadow: var(--shadow-micro);
      }

      /* V6 Elevated Image Wrap */
      .story-visual-wrap {
        position: relative;
        width: 100%;
        aspect-ratio: 4/3;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--c-base);
        border-radius: 24px;
        box-shadow: var(--shadow-float);
        border: 1px solid rgba(15, 23, 42, 0.03);
        border-top: 1px solid rgba(255, 255, 255, 0.8);
        border-left: 1px solid rgba(255, 255, 255, 0.8);
        overflow: hidden;
      }

      .sv-bg-grid {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(#E2E8F0 1px, transparent 1px);
        background-size: 20px 20px;
        opacity: 0.5;
      }

      /* Specific UI mocks for storytelling */
      .ui-mock-form {
        width: 80%;
        background: var(--c-base);
        border-radius: 12px;
        box-shadow: var(--shadow-base-ui);
        border: 1px solid rgba(15, 23, 42, 0.04);
        border-top: 1px solid rgba(255, 255, 255, 0.9);
        padding: 1.5rem;
        z-index: 2;
        position: relative;
      }

      .ui-skeleton-line {
        height: 12px;
        background: rgba(15, 23, 42, 0.04);
        border-radius: 4px;
        margin-bottom: 12px;
        width: 100%;
      }

      /* ================== V5/V6: 4. ECOSYSTEM JOURNEY ================== */
      .journey-section {
        background: var(--c-cream-alt);
        overflow: hidden;
        padding-bottom: 160px;
        position: relative;
      }

      /* Subtle Indigo glow behind the path */
      .journey-section::before {
        content: '';
        position: absolute;
        top: 10%;
        left: 50%;
        width: 80vw;
        height: 30vw;
        transform: translateX(-50%);
        background: radial-gradient(ellipse, var(--c-indigo-glow) 0%, transparent 70%);
        filter: blur(80px);
        pointer-events: none;
        z-index: 0;
      }

      .journey-flow {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        position: relative;
        margin-top: 4rem;
        padding-top: 2rem;
        z-index: 1;
      }

      .j-line {
        position: absolute;
        top: 22px;
        left: 0;
        width: 100%;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--c-indigo), transparent);
        opacity: 0.15;
        z-index: 0;
      }

      .j-node {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        position: relative;
        z-index: 1;
        width: 140px;
      }

      .j-dot {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--c-base);
        border: 2px solid var(--c-indigo-soft);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: var(--shadow-soft);
        margin-bottom: 1rem;
        color: var(--c-indigo);
        font-size: 1.1rem;
        transition: all var(--dur-hover);
      }

      .j-node:hover .j-dot {
        transform: scale(1.1);
        border-color: var(--c-indigo);
        background: var(--c-indigo);
        color: white;
        box-shadow: var(--shadow-glow-indigo);
      }

      .j-title {
        font-weight: 700;
        font-size: 0.95rem;
        color: var(--c-navy);
        margin-bottom: 4px;
      }

      .j-desc {
        font-size: 0.8rem;
        color: var(--c-slate-light);
        line-height: 1.4;
      }

      /* ================== V5/V6: 5. GROWTH HUB (Analytics) ================== */
      .growth-section {
        background: var(--c-cream);
        position: relative;
        overflow: hidden;
      }

      /* V6 Amber Warm Glow */
      .growth-section::before {
        content: '';
        position: absolute;
        top: 30%;
        right: -5%;
        width: 60vw;
        height: 60vw;
        background: radial-gradient(circle, var(--c-amber-glow) 0%, transparent 60%);
        filter: blur(120px);
        z-index: 0;
        pointer-events: none;
      }

      .growth-wrap {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--gap-xl);
        align-items: center;
        position: relative;
        z-index: 1;
      }

      .growth-context {
        padding-right: 2rem;
        border-right: 1px solid rgba(15, 23, 42, 0.05);
      }

      .analytics-board {
        position: relative;
        width: 100%;
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .a-sheet {
        position: absolute;
        width: 100%;
        height: 90%;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 1;
      }

      /* V6 Elevated Main Chart Card */
      .a-card-main {
        position: relative;
        width: 70%;
        background: var(--c-base);
        border-radius: 18px;
        box-shadow: var(--shadow-base-ui);
        border: 1px solid rgba(15, 23, 42, 0.03);
        border-top: 1px solid rgba(255, 255, 255, 0.8);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2.5rem 1.5rem;
        z-index: 3;
      }

      .a-ring-wrap {
        position: relative;
        width: 160px;
        height: 160px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.5rem;
      }

      .a-ring-svg {
        position: absolute;
        inset: 0;
        transform: rotate(-90deg);
      }

      .a-ring-bg {
        fill: none;
        stroke: var(--c-cream-alt);
        stroke-width: 6;
      }

      .a-ring-fg {
        fill: none;
        stroke: var(--c-indigo);
        stroke-width: 6;
        stroke-dasharray: 440;
        stroke-dashoffset: 440;
        transition: stroke-dashoffset var(--dur-chart) var(--ease-in-out);
        stroke-linecap: round;
        animation: ringPulse 4s infinite alternate;
        /* V6 slow color motion on ring */
      }

      @keyframes ringPulse {
        0% {
          filter: drop-shadow(0 0 4px rgba(99, 102, 241, 0.2));
        }

        100% {
          filter: drop-shadow(0 0 12px rgba(99, 102, 241, 0.5));
        }
      }

      .a-score {
        font-size: 3.5rem;
        font-weight: 800;
        letter-spacing: -0.04em;
        color: var(--c-navy);
        line-height: 1;
      }

      .a-stat-pill {
        position: absolute;
        background: #FFF;
        border: 1px solid rgba(0, 0, 0, 0.04);
        box-shadow: var(--shadow-base-ui);
        border-radius: 8px;
        padding: 0.75rem 1rem;
        font-size: 0.85rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        top: 10%;
        right: -5%;
        color: var(--c-teal);
        z-index: 4;
        animation: solidFloat 5s ease-in-out infinite alternate;
      }

      @keyframes solidFloat {
        0% {
          transform: translateY(0);
        }

        100% {
          transform: translateY(-8px);
        }
      }

      /* ================== V5/V6: 6. COMMUNITY & LEADERBOARD ================== */
      .community-section {
        background: var(--c-cream-alt);
        position: relative;
        overflow: hidden;
      }

      /* V6 Coral Ambient Glow */
      .community-section::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: -10%;
        width: 50vw;
        height: 50vw;
        background: radial-gradient(circle, var(--c-coral-glow) 0%, transparent 60%);
        filter: blur(120px);
        z-index: 0;
        pointer-events: none;
      }

      .com-grid {
        display: grid;
        grid-template-columns: 10fr 14fr;
        gap: var(--gap-xl);
        align-items: center;
        position: relative;
        z-index: 1;
      }

      /* Leaderboard Glass Preview */
      .lb-preview {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 1.5rem;
      }

      /* V6 Refined Leaderboard Rows */
      .lb-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        background: var(--c-base);
        /* Not pure white */
        border-radius: 8px;
        border: 1px solid rgba(15, 23, 42, 0.03);
        border-top: 1px solid rgba(255, 255, 255, 0.8);
        box-shadow: var(--shadow-micro);
        transition: transform var(--dur-hover);
      }

      .lb-row:hover {
        transform: translateX(4px);
        box-shadow: var(--shadow-soft);
      }

      .lb-user {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .lb-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #E2E8F0;
      }

      .lb-score {
        font-weight: 700;
        color: var(--c-indigo);
      }

      /* Cinematic Testimonials within Community */
      .test-marquee {
        display: flex;
        width: 100%;
        padding: 2rem 0;
        margin-top: 4rem;
        position: relative;
        z-index: 1;
        mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
        -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
      }

      .test-track {
        display: flex;
        gap: var(--gap-md);
        animation: scrollHoriz 40s linear infinite;
        width: max-content;
      }

      .test-track:hover {
        animation-play-state: paused;
      }

      @keyframes scrollHoriz {
        0% {
          transform: translateX(0);
        }

        100% {
          transform: translateX(-50%);
        }
      }

      /* V6 Refined Testimonial Cards */
      .t-card {
        width: 380px;
        white-space: normal;
        position: relative;
        overflow: hidden;
        display: inline-block;
        border-radius: 12px;
        padding: var(--card-pad);
        background: var(--c-base);
        /* Replaced cream-alt with explicit card surface */
        border: 1px solid rgba(15, 23, 42, 0.03);
        border-top: 1px solid rgba(255, 255, 255, 0.8);
        box-shadow: var(--shadow-soft);
        transition: transform var(--dur-hover);
      }

      .t-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-float);
      }

      .t-featured {
        width: 440px;
      }

      .t-quote {
        font-size: 1.05rem;
        line-height: 1.6;
        color: var(--c-slate);
        margin-bottom: 2rem;
        position: relative;
        z-index: 2;
      }

      .t-author {
        display: flex;
        align-items: center;
        gap: 1rem;
        z-index: 2;
        position: relative;
      }

      /* ================== V5/V6: 7. EMOTIONAL FINAL CTA ================== */
      .final-cta {
        text-align: center;
        background: var(--c-cream);
        position: relative;
        overflow: hidden;
      }

      /* V6 Warm CTA Glow mapped to Yellow Brand */
      .final-cta::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 60vw;
        height: 60vw;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(255, 184, 0, 0.1) 0%, rgba(0, 168, 255, 0.05) 40%, transparent 70%);
        filter: blur(80px);
        z-index: 0;
        pointer-events: none;
        animation: floatGlow 15s ease-in-out infinite reverse;
      }

      /* ================== V8: PARALLAX BACKGROUND LAYERS ================== */
      .hero-parallax-container {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 0;
        overflow: hidden;
      }

      .parallax-layer {
        position: absolute;
        pointer-events: none;
        transition: transform 0.1s cubic-bezier(0.2, 0.8, 0.2, 1);
        opacity: 0.15;
        /* Much softer background blend */
        z-index: 0;
      }

      .parallax-float {
        width: 100%;
        height: auto;
        display: block;
      }

      /* Push images to the absolute edges to frame the hero content beautifully */
      .p-img-1 {
        top: 10%;
        left: -2%;
        width: 220px;
      }

      .p-img-1 .parallax-float {
        animation: floatGlow 10s infinite alternate;
      }

      .p-img-2 {
        bottom: 5%;
        right: -5%;
        width: 280px;
      }

      .p-img-2 .parallax-float {
        animation: floatGlow 12s infinite alternate-reverse;
      }

      .p-img-3 {
        top: 60%;
        left: -4%;
        width: 140px;
      }

      .p-img-3 .parallax-float {
        animation: floatGlow 8s infinite alternate;
      }

      .p-img-4 {
        top: 5%;
        right: 2%;
        width: 180px;
      }

      .p-img-4 .parallax-float {
        animation: floatGlow 14s infinite alternate-reverse;
      }

      .p-img-5 {
        bottom: 10%;
        left: 35%;
        width: 150px;
        opacity: 0.1;
      }

      .p-img-5 .parallax-float {
        animation: floatGlow 11s infinite alternate;
      }

      .cta-inner {
        max-width: 680px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        z-index: 2;
        padding: 4rem;
        border-radius: 24px;
      }

      .footer {
        background: var(--c-cream);
        padding: var(--space-section-tb) 0 3rem;
        border-top: 1px solid rgba(15, 23, 42, 0.05);
        position: relative;
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr 1.5fr;
        gap: var(--gap-lg);
        margin-bottom: 5rem;
        position: relative;
        z-index: 2;
      }

      .footer-brand .logo {
        font-size: 1.25rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--c-navy);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1rem;
      }

      .f-col h5 {
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--c-slate-light);
        margin-bottom: 1.5rem;
      }

      .f-col a {
        display: block;
        color: var(--c-slate);
        text-decoration: none;
        margin-bottom: 1rem;
        font-size: 0.95rem;
        font-weight: 400;
        transition: color 0.2s;
      }

      .f-col a:hover {
        color: var(--c-navy);
      }

      .subscribe-box {
        display: flex;
        gap: 0.5rem;
        margin-top: 1rem;
      }

      .subscribe-box input {
        flex: 1;
        padding: 0.6rem 1rem;
        border: 1px solid rgba(15, 23, 42, 0.1);
        border-radius: 6px;
        font-family: inherit;
        font-size: 0.95rem;
        transition: all 0.2s;
        background: var(--c-tint-indigo);
        color: var(--c-navy);
      }

      .subscribe-box input:focus {
        outline: none;
        border-color: var(--c-indigo);
        background: var(--c-base);
        box-shadow: 0 0 0 3px var(--c-indigo-glow);
      }

      .subscribe-box button {
        padding: 0.6rem 1rem;
        background: var(--c-navy);
        color: white;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.1s;
      }

      .subscribe-box button:active {
        transform: scale(0.96);
      }

      .footer-bottom {
        border-top: 1px solid rgba(15, 23, 42, 0.05);
        padding-top: 2rem;
        display: flex;
        justify-content: space-between;
        font-size: 0.85rem;
        color: var(--c-slate-light);
        position: relative;
        z-index: 2;
      }

      @media(max-width: 1024px) {
        .section {
          padding: var(--space-section-tb) 0;
        }

        .hero-grid,
        .pillar-grid,
        .story-block,
        .growth-wrap,
        .com-grid {
          grid-template-columns: 1fr;
          gap: var(--gap-lg);
        }

        .story-block.reversed {
          direction: ltr;
        }

        .hero-content {
          margin: 0 auto;
          text-align: center;
        }

        .hero-actions {
          justify-content: center;
        }

        .hero-pillars {
          justify-content: center;
          flex-wrap: wrap;
        }

        .journey-flow {
          display: none;
        }

        .mockup-base {
          position: relative;
          top: auto;
          left: auto;
          transform: none;
          width: 100%;
          max-width: 500px;
          margin: 0 auto;
          min-height: 320px;
          height: auto;
          animation: none;
        }

        .growth-context {
          padding-right: 0;
          border-right: none;
          border-bottom: 1px solid rgba(0, 0, 0, 0.05);
          padding-bottom: 2rem;
        }

        .footer-grid {
          grid-template-columns: 1fr 1fr;
        }
      }

      @media(max-width: 640px) {
        .section {
          padding: var(--space-section-mb) 0;
        }

        .text-display {
          font-size: 2.75rem;
        }

        .footer-grid {
          grid-template-columns: 1fr;
        }

        .footer-bottom {
          flex-direction: column;
          gap: 1rem;
          text-align: center;
        }
      }

      /* V9 College Carousel */
      .college-carousel {
        position: relative;
        width: 100%;
        height: 180px;
        border-radius: 12px;
        overflow: hidden;
        background: var(--c-slate-light);
        margin-bottom: 20px;
      }

      .carousel-img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity 0.8s ease-in-out, transform 8s ease-out;
        transform: scale(1.05);
      }

      .carousel-img.active {
        opacity: 1;
        transform: scale(1);
      }

      .carousel-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(15, 23, 42, 0.4), transparent);
        pointer-events: none;
      }

      /* V7 Override: Prevent carr_style.css from forcing hero h1 to green */
      .hero h1.text-display {
        color: var(--c-navy) !important;
      }

      /* ULTRA PREMIUM SAAS CSS */
      .blueprint-grid {
        position: absolute;
        inset: -20%;
        background-image:
          linear-gradient(rgba(15, 23, 42, 0.03) 1px, transparent 1px),
