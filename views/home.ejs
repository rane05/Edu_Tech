      <script>
        // Shared Intersection logic
        document.addEventListener('DOMContentLoaded', () => {
          // Analytics Ring
          const ring = document.getElementById('dash-ring');
          const scoreVal = document.getElementById('dash-score');
          if (ring && scoreVal) {
            const targetScore = 93;
            const observer = new IntersectionObserver((entries) => {
              if (entries[0].isIntersecting) {
                setTimeout(() => {
                  ring.style.strokeDashoffset = '30';
                  let current = 0;
                  const interval = setInterval(() => {
                    current += 1;
                    if (current >= targetScore) { current = targetScore; clearInterval(interval); }
                    scoreVal.innerText = current;
                  }, 9);
                }, 100);
                observer.disconnect();
              }
            }, { threshold: 0.6 });
            observer.observe(document.querySelector('.growth-wrap'));
          }

          // V8: Hero Parallax Javascript Engine
          const heroSection = document.getElementById('hero-section');
          const parallaxLayers = document.querySelectorAll('.parallax-layer');

          if (heroSection && parallaxLayers.length > 0) {
            heroSection.addEventListener('mousemove', (e) => {
              // Calculate center of window representing the hero
              const rect = heroSection.getBoundingClientRect();
              const centerX = rect.left + rect.width / 2;
              const centerY = rect.top + rect.height / 2;

              const mouseX = e.clientX - centerX;
              const mouseY = e.clientY - centerY;

              // Smoothly map mouse to translation based on data-speed
              parallaxLayers.forEach(layer => {
                const speed = parseFloat(layer.getAttribute('data-speed')) || 0;
                // Stronger effect limits to prevent flying completely off-screen
                const xPos = Math.max(-50, Math.min(50, -(mouseX * speed)));
                const yPos = Math.max(-50, Math.min(50, -(mouseY * speed)));

                // Directly set the inline transform
                layer.style.transform = `translate3d(${xPos}px, ${yPos}px, 0)`;
              });
            });

            heroSection.addEventListener('mouseleave', () => {
              parallaxLayers.forEach(layer => {
                layer.style.transform = `translate3d(0, 0, 0)`;
              });
            });
          }

          // V9: College Predictor Carousel Engine
          const collegeData = [
            { name: "COEP Tech (CS)", prob: "98.4" },
            { name: "VJTI Mumbai (IT)", prob: "95.2" },
            { name: "PICT Pune (CE)", prob: "92.1" },
            { name: "SPIT Mumbai (CS)", prob: "89.7" }
          ];
          const slides = document.querySelectorAll('.carousel-img');
          const nameEl = document.getElementById('predict-name');
          const probEl = document.getElementById('predict-prob-num');

          if (slides.length > 0 && nameEl && probEl) {
            let currentSlide = 0;
            setInterval(() => {
              nameEl.style.opacity = 0;
              probEl.parentElement.style.opacity = 0;

              setTimeout(() => {
                slides[currentSlide].classList.remove('active');
                currentSlide = (currentSlide + 1) % slides.length;
                slides[currentSlide].classList.add('active');

                nameEl.innerText = collegeData[currentSlide].name;
                probEl.innerText = collegeData[currentSlide].prob;

                nameEl.style.opacity = 1;
                probEl.parentElement.style.opacity = 1;
              }, 300);
            }, 3500);
          }

          // ULTRA SASS PREMIUM JS 
          // 1. Cursor Orb
          const orb = document.getElementById('cursor-orb');
          let mouseX = window.innerWidth / 2;
          let mouseY = window.innerHeight / 2;
          let orbX = mouseX;
          let orbY = mouseY;

          window.addEventListener('mousemove', (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;
            if (orb && orb.style.opacity == 0) orb.style.opacity = 1;
          });

          function renderOrb() {
            orbX += (mouseX - orbX) * 0.1;
            orbY += (mouseY - orbY) * 0.1;
            if (orb) orb.style.transform = `translate3d(${orbX}px, ${orbY}px, 0)`;
            requestAnimationFrame(renderOrb);
          }
          if (orb) renderOrb();

          // 2. 3D Tilt Card Component
          const tiltCard = document.getElementById('predictor-card');
          if (tiltCard) {
            tiltCard.addEventListener('mousemove', (e) => {
              const rect = tiltCard.getBoundingClientRect();
              const x = e.clientX - rect.left;
              const y = e.clientY - rect.top;

              const centerX = rect.width / 2;
              const centerY = rect.height / 2;

              const rotateX = ((y - centerY) / centerY) * -6;
              const rotateY = ((x - centerX) / centerX) * 6;

              tiltCard.style.setProperty('--rx', `${rotateX}deg`);
              tiltCard.style.setProperty('--ry', `${rotateY}deg`);

              const px = ((x - centerX) / centerX) * -8;
              const py = ((y - centerY) / centerY) * -8;
              tiltCard.querySelectorAll('.cinematic-img').forEach(img => {
                img.style.setProperty('--px', `${px}px`);
                img.style.setProperty('--py', `${py}px`);
              });
            });

            tiltCard.addEventListener('mouseleave', () => {
              tiltCard.style.setProperty('--rx', `0deg`);
              tiltCard.style.setProperty('--ry', `0deg`);
              tiltCard.querySelectorAll('.cinematic-img').forEach(img => {
                img.style.setProperty('--px', `0px`);
                img.style.setProperty('--py', `0px`);
              });
            });
          }

          // 3. Number Counter & Scroll Reveal
          const spRevealObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');

                if (entry.target.classList.contains('story-visual-wrap')) {
                  const probEl2 = document.getElementById('predict-prob-num');
                  const wrap = document.getElementById('predict-prob-wrap');
                  if (probEl2 && wrap && probEl2.innerText == '0') {
                    setTimeout(() => {
                      let current = 0;
                      const target = 98.4;
                      const duration = 1200;
                      const startTime = performance.now();

                      function animateCounter(currentTime) {
                        const elapsed = currentTime - startTime;
                        const progress = Math.min(elapsed / duration, 1);
                        const easeOut = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
                        current = target * easeOut;
                        probEl2.innerText = current.toFixed(1);

                        if (progress < 1) {
                          requestAnimationFrame(animateCounter);
                        } else {
                          wrap.classList.add('glow-pulse');
                        }
                      }
                      requestAnimationFrame(animateCounter);
                    }, 600);
                  }
                }

                spRevealObserver.unobserve(entry.target);
              }
            });
          }, { threshold: 0.15 });

          document.querySelectorAll('.animate-sp-reveal, .animate-sp-scale').forEach(el => {
            spRevealObserver.observe(el);
          });

          // 4. Magnetic Buttons
          document.querySelectorAll('.btn-magnetic').forEach(btn => {
            btn.addEventListener('mousemove', (e) => {
              const rect = btn.getBoundingClientRect();
              const x = e.clientX - rect.left - rect.width / 2;
              const y = e.clientY - rect.top - rect.height / 2;
              btn.style.transform = `translate(${x * 0.2}px, ${y * 0.2}px)`;
            });
            btn.addEventListener('mouseleave', () => {
              btn.style.transform = `translate(0px, 0px)`;
              btn.style.transition = 'transform 0.5s cubic-bezier(0.2, 0, 0.2, 1)';
            });
            btn.addEventListener('mouseenter', () => {
              btn.style.transition = 'none'; // remove transition for smooth tracking
            });
          });

          // V10: High-End Mouse Tracking Spotlight & 3D Tilt for Hub Cards
          const hubCards = document.querySelectorAll('.pillar-card');
          if (hubCards.length > 0) {
            hubCards.forEach(card => {
              card.addEventListener('mousemove', e => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                card.style.setProperty('--mouse-x', `${x}px`);
                card.style.setProperty('--mouse-y', `${y}px`);
                const centerX = rect.width / 2;
                const centerY = rect.height / 2;
                const rotateX = ((y - centerY) / centerY) * -5;
                const rotateY = ((x - centerX) / centerX) * 5;
                card.style.setProperty('--rotate-x', `${rotateX}deg`);
                card.style.setProperty('--rotate-y', `${rotateY}deg`);
              });
              card.addEventListener('mouseleave', () => {
                card.style.setProperty('--rotate-x', `0deg`);
                card.style.setProperty('--rotate-y', `0deg`);
              });
            });

            // IntersectionObserver setup
            const hubObserver = new IntersectionObserver((entries) => {
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('revealed');
                  hubObserver.unobserve(entry.target);
                  // Remove transition delay after animation completes to avoid hover lag
                  setTimeout(() => {
                    entry.target.style.transitionDelay = '0s';
                  }, 800);
                }
              });
            }, { threshold: 0.15 });

            hubCards.forEach((card, index) => {
              card.style.transitionDelay = `${index * 0.15}s`;
              hubObserver.observe(card);
            });
          }

          // Scroll Bounce Observer for Hub Text
          const bounceTextObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                bounceTextObserver.unobserve(entry.target);
              }
            });
          }, { threshold: 0.1 });

          document.querySelectorAll('.animate-reveal-up-1, .animate-reveal-up-2, .animate-reveal-up-3').forEach(el => {
            bounceTextObserver.observe(el);
          });

        });
      </script>
      <div id="cursor-orb"></div>
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
      </body>

