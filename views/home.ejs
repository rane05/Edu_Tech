      .story-block.reversed {
        direction: rtl;
      }

      .story-block.reversed>* {
        direction: ltr;
      }

      .story-text {
        max-width: 460px;
      }

      .story-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 20px;
        background: var(--c-base);
        border: 1px solid rgba(15, 23, 42, 0.05);
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--c-navy);
        margin-bottom: 1.5rem;
        box-shadow: var(--shadow-micro);
      }

      /* V6 Elevated Image Wrap */
      .story-visual-wrap {
        position: relative;
        width: 100%;
        aspect-ratio: 4/3;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--c-base);
        border-radius: 24px;
