<%- include('layouts/header'); %>
  <%- include('layouts/navbar'); %>

    <div class="page-transition overflow-hidden">
      <!-- Hero Section -->
      <section
        class="relative min-h-screen flex items-center pt-24 pb-16 bg-gradient-to-br from-white via-blue-50 to-indigo-50">
        <!-- Floating Elements -->
        <div
          class="absolute top-20 left-10 w-32 h-32 bg-yellow-200 rounded-full mix-blend-multiply filter blur-xl opacity-30 animate-pulse">
        </div>
        <div
          class="absolute bottom-20 right-10 w-48 h-48 bg-blue-200 rounded-full mix-blend-multiply filter blur-xl opacity-30 animate-pulse"
          style="animation-delay: 2s;"></div>

        <div class="container mx-auto px-6 relative z-10">
          <div class="flex flex-col lg:flex-row items-center gap-16">
            <!-- Hero Content -->
            <div class="lg:w-1/2 text-center lg:text-left">
              <div
                class="inline-flex items-center px-4 py-2 rounded-full bg-blue-50 text-blue-700 font-bold text-sm mb-6 animate-fade-in shadow-sm border border-blue-100">
                <img src="/img/custom/logo.png" alt="Logo" class="h-6 w-auto mr-3">
                The Future of Career Guidance is Here
              </div>
              <h1 class="text-5xl lg:text-7xl font-extrabold text-[#1A1A2E] leading-tight mb-8 animate-slide-in-left">
                Navigate Your <br />
                <span class="text-gradient-primary">Dream Career</span> with AI
              </h1>
              <p class="text-xl text-[#64748b] leading-relaxed mb-10 max-w-xl animate-fade-in"
                style="animation-delay: 0.2s;">
                Discover personalized paths, predict your perfect college, and master skills with our AI-powered
                counseling ecosystem.
              </p>
              <div class="flex flex-wrap justify-center lg:justify-start gap-6 animate-fade-in"
                style="animation-delay: 0.4s;">
                <a href="/cet-predictor" class="btn-primary px-8 py-4 text-lg">
                  <i class="fas fa-compass mr-2"></i> Predict College
                </a>
                <a href="/smart-quiz" class="btn-outline px-8 py-4 text-lg border-2">
                  <i class="fas fa-brain mr-2"></i> Take Career Quiz
                </a>
              </div>

              <!-- Trust Indicators -->
              <div class="mt-12 flex items-center justify-center lg:justify-start gap-8 opacity-70">
                <div class="flex flex-col">
                  <span class="text-2xl font-bold">50k+</span>
                  <span class="text-sm">Students Guided</span>
                </div>
                <div class="w-px h-10 bg-gray-300"></div>
                <div class="flex flex-col">
                  <span class="text-2xl font-bold">98%</span>
                  <span class="text-sm">Accuracy Rate</span>
                </div>
                <div class="w-px h-10 bg-gray-300"></div>
                <div class="flex flex-col">
                  <span class="text-2xl font-bold">150+</span>
                  <span class="text-sm">Career Paths</span>
                </div>
              </div>
            </div>

            <!-- Hero Visual -->
            <div class="lg:w-1/2 relative h-[500px] lg:h-[650px] flex items-center justify-center animate-float">
              <img src="/img/custom/hero_main.png" alt="EduNavigator AI"
                class="max-w-full max-h-full object-contain drop-shadow-2xl z-20">
              <!-- Decorative backplates -->
              <div
                class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[120%] bg-white/40 backdrop-blur-3xl rounded-full z-0">
              </div>
              <div
                class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[100%] h-[100%] border-2 border-blue-200/50 rounded-full animate-spin-slow z-10">
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Why Section -->
      <section class="py-24 bg-white relative overflow-hidden">
        <div class="container mx-auto px-6">
          <div class="flex flex-col lg:flex-row-reverse items-center gap-20">
            <!-- Content -->
            <div class="lg:w-1/2">
              <div class="text-[#FFB800] font-bold tracking-widest uppercase text-sm mb-4">Transforming Education</div>
              <h2 class="text-4xl lg:text-5xl font-bold text-[#1A1A2E] mb-8 leading-tight">
                Why Choose AI Career Counseling?
              </h2>
              <p class="text-lg text-[#64748b] mb-10 leading-relaxed">
                Traditional methods are based on old data. Our AI analyzes <strong>trillion-point market trends</strong>
                and <strong>psychometric markers</strong> to find where you truly belong.
              </p>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="flex items-start gap-4 p-4 rounded-2xl hover:bg-amber-50 transition-colors duration-300">
                  <div
                    class="w-12 h-12 bg-amber-100 flex items-center justify-center rounded-xl text-amber-600 shrink-0">
                    <i class="fas fa-bolt text-xl"></i>
                  </div>
                  <div>
                    <h4 class="font-bold text-lg mb-1">Instant Insights</h4>
                    <p class="text-sm text-gray-500 font-medium">Get results in seconds, not weeks of expensive
                      sessions.</p>
                  </div>
                </div>
                <div class="flex items-start gap-4 p-4 rounded-2xl hover:bg-blue-50 transition-colors duration-300">
                  <div class="w-12 h-12 bg-blue-100 flex items-center justify-center rounded-xl text-blue-600 shrink-0">
                    <i class="fas fa-fingerprint text-xl"></i>
                  </div>
                  <div>
                    <h4 class="font-bold text-lg mb-1">Truly Personalized</h4>
                    <p class="text-sm text-gray-500 font-medium">Mapped to your unique strengths and personality.</p>
                  </div>
                </div>
                <div class="flex items-start gap-4 p-4 rounded-2xl hover:bg-indigo-50 transition-colors duration-300">
                  <div
                    class="w-12 h-12 bg-indigo-100 flex items-center justify-center rounded-xl text-indigo-600 shrink-0">
                    <i class="fas fa-globe text-xl"></i>
                  </div>
                  <div>
                    <h4 class="font-bold text-lg mb-1">Global Coverage</h4>
                    <p class="text-sm text-gray-500 font-medium">Access data from colleges and careers worldwide.</p>
                  </div>
                </div>
                <div class="flex items-start gap-4 p-4 rounded-2xl hover:bg-emerald-50 transition-colors duration-300">
                  <div
                    class="w-12 h-12 bg-emerald-100 flex items-center justify-center rounded-xl text-emerald-600 shrink-0">
                    <i class="fas fa-shield-check text-xl"></i>
                  </div>
                  <div>
                    <h4 class="font-bold text-lg mb-1">Evidence Based</h4>
                    <p class="text-sm text-gray-500 font-medium">Scientific accuracy powered by data analytics.</p>
                  </div>
                </div>
              </div>
            </div>
            <!-- Visual -->
            <div class="lg:w-1/2">
              <div class="relative p-8 group">
                <div
                  class="absolute inset-0 bg-blue-600 rounded-[3rem] rotate-3 group-hover:rotate-0 transition-transform duration-500">
                </div>
                <img src="/img/custom/why_choose.png" alt="Collaborative Learning"
                  class="relative z-10 rounded-[2.5rem] shadow-2xl transition-transform duration-500 group-hover:-translate-y-4">
                <!-- Floating Toast -->
                <div
                  class="absolute -bottom-6 -right-6 lg:-right-12 z-20 bg-white p-6 rounded-2xl shadow-2xl animate-float">
                  <div class="flex items-center gap-4 mb-2">
                    <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center text-green-600">
                      <i class="fas fa-check"></i>
                    </div>
                    <div>
                      <div class="font-bold">Career Match</div>
                      <div class="text-xs text-gray-400">96.5% Probability</div>
                    </div>
                  </div>
                  <div class="text-sm font-semibold text-blue-600">Software Architect</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Services Bento Grid -->
      <section class="py-24 bg-gray-50">
        <div class="container mx-auto px-6">
          <div class="text-center max-w-3xl mx-auto mb-20">
            <h2 class="text-4xl lg:text-5xl font-bold text-[#1A1A2E] mb-6">Our Intelligence Suite</h2>
            <p class="text-lg text-gray-500">Comprehensive tools designed to take you from student to professional.</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            <!-- AI Search -->
            <a href="/career-bank" class="premium-card group hover:bg-[#1A1A2E]">
              <div
                class="w-14 h-14 bg-amber-100 rounded-2xl flex items-center justify-center text-amber-600 mb-8 transition-colors group-hover:bg-amber-500 group-hover:text-white">
                <i class="fas fa-database text-2xl"></i>
              </div>
              <h3 class="text-2xl font-bold mb-4 group-hover:text-white">Career Bank</h3>
              <p class="text-gray-500 group-hover:text-gray-300 mb-6">Explore 500+ career paths with deep insights into
                salary, required skills, and growth.</p>
              <span class="text-blue-600 font-bold group-hover:text-amber-400 transition-colors">Learn More <i
                  class="fas fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform"></i></span>
            </a>

            <!-- College Finder -->
            <a href="/exam_choice" class="premium-card group hover:bg-[#1A1A2E] md:row-span-2">
              <div
                class="w-14 h-14 bg-indigo-100 rounded-2xl flex items-center justify-center text-indigo-600 mb-8 transition-colors group-hover:bg-indigo-500 group-hover:text-white">
                <i class="fas fa-university text-2xl"></i>
              </div>
              <h3 class="text-2xl font-bold mb-4 group-hover:text-white text-balance">College Predictor</h3>
              <p class="text-gray-500 group-hover:text-gray-300 mb-10 leading-relaxed">Our advanced algorithm predicts
                which top colleges fit your marks and preferences with high accuracy.</p>
              <div class="mt-auto bg-gray-100 group-hover:bg-white/10 p-4 rounded-xl mb-6">
                <div class="text-xs text-gray-400 uppercase font-bold mb-2">Supported Exams</div>
                <div class="flex flex-wrap gap-2">
                  <span
                    class="px-2 py-1 bg-white group-hover:bg-indigo-600 group-hover:text-white rounded text-[10px] font-bold">JEE
                    MAINS</span>
                  <span
                    class="px-2 py-1 bg-white group-hover:bg-indigo-600 group-hover:text-white rounded text-[10px] font-bold">MHT-CET</span>
                </div>
              </div>
              <span class="text-blue-600 font-bold group-hover:text-indigo-400 transition-colors">Identify Best Match <i
                  class="fas fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform"></i></span>
            </a>

            <!-- AI Interview -->
            <div class="premium-card relative overflow-hidden group hover:bg-blue-600 md:col-span-2">
              <div class="flex flex-col md:flex-row items-center gap-10">
                <div class="w-full md:w-3/5">
                  <div
                    class="inline-block px-3 py-1 bg-blue-100 text-blue-700 text-xs font-bold rounded-full mb-4 group-hover:bg-white/20 group-hover:text-white">
                    FEATURED</div>
                  <h3 class="text-3xl font-bold mb-4 group-hover:text-white">AI Interview Simulator</h3>
                  <p class="text-gray-500 group-hover:text-blue-100 text-lg mb-8 leading-relaxed">Practice your dream
                    job interview with our conversational AI. Get real-time feedback on your speech, confidence, and
                    answers.</p>
                  <a href="/interview-simulator" class="btn-primary group-hover:bg-white group-hover:text-blue-600">Try
                    Simulation Now</a>
                </div>
                <div class="w-full md:w-2/5 shrink-0">
                  <img src="/img/custom/ai_interview_icon.png" alt="AI Interview"
                    class="w-full animate-float opacity-90">
                </div>
              </div>
            </div>

            <!-- Aptitude -->
            <a href="/apti" class="premium-card group hover:bg-[#1A1A2E]">
              <div
                class="w-14 h-14 bg-emerald-100 rounded-2xl flex items-center justify-center text-emerald-600 mb-8 transition-colors group-hover:bg-emerald-500 group-hover:text-white">
                <i class="fas fa-brain text-2xl"></i>
              </div>
              <h3 class="text-2xl font-bold mb-4 group-hover:text-white">Aptitude Test</h3>
              <p class="text-gray-500 group-hover:text-gray-300 mb-6">Scientific assessments that measure your cognitive
                abilities and natural flair.</p>
              <span class="text-blue-600 font-bold group-hover:text-emerald-400 transition-colors">Start Assessment <i
                  class="fas fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform"></i></span>
            </a>

            <!-- Roadmap -->
            <a href="/career-roadmap" class="premium-card group hover:bg-[#1A1A2E]">
              <div class="flex justify-between items-start mb-4">
                <div
                  class="w-14 h-14 bg-purple-100 rounded-2xl flex items-center justify-center text-purple-600 transition-colors group-hover:bg-purple-500 group-hover:text-white">
                  <i class="fas fa-route text-2xl"></i>
                </div>
                <img src="/img/custom/career_roadmap_icon.png" alt="Roadmap Icon"
                  class="w-16 h-16 group-hover:scale-110 transition-transform duration-500">
              </div>
              <h3 class="text-2xl font-bold mb-4 group-hover:text-white">Career Roadmap</h3>
              <p class="text-gray-500 group-hover:text-gray-300 mb-6">Step-by-step navigational guide from where you are
                to your ultimate goal.</p>
              <span class="text-blue-600 font-bold group-hover:text-purple-400 transition-colors mt-auto">View My Path
                <i class="fas fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform"></i></span>
            </a>

            <!-- Resources -->
            <a href="/scholarship" class="premium-card group hover:bg-[#1A1A2E]">
              <div
                class="w-14 h-14 bg-rose-100 rounded-2xl flex items-center justify-center text-rose-600 mb-8 transition-colors group-hover:bg-rose-500 group-hover:text-white">
                <i class="fas fa-graduation-cap text-2xl"></i>
              </div>
              <h3 class="text-2xl font-bold mb-4 group-hover:text-white">Scholarships</h3>
              <p class="text-gray-500 group-hover:text-gray-300 mb-6">Funding your education shouldn't be hard. Find
                grants you qualify for easily.</p>
              <span class="text-blue-600 font-bold group-hover:text-rose-400 transition-colors">Explore Grants <i
                  class="fas fa-arrow-right ml-2 group-hover:translate-x-2 transition-transform"></i></span>
            </a>
          </div>
        </div>
      </section>

      <!-- Performance Spotlight -->
      <section class="py-24 bg-white">
        <div class="container mx-auto px-6">
          <div class="flex flex-col lg:flex-row items-center gap-16">
            <div class="lg:w-1/2">
              <h2 class="text-4xl font-bold text-[#1A1A2E] mb-8 leading-tight">Advanced Performance <br />Analytics &
                Leaderboards</h2>
              <p class="text-lg text-gray-500 mb-10 leading-relaxed">Don't just practice—compete and improve. Our
                dashboard tracks your progress over time, identifying micro-weaknesses and celebrating your milestones
                on the global stage.</p>

              <ul class="space-y-6">
                <li class="flex items-center gap-4">
                  <div class="w-6 h-6 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 text-xs">
                    <i class="fas fa-check"></i>
                  </div>
                  <span class="font-semibold text-gray-700">Real-time Rank Updates</span>
                </li>
                <li class="flex items-center gap-4">
                  <div class="w-6 h-6 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 text-xs">
                    <i class="fas fa-check"></i>
                  </div>
                  <span class="font-semibold text-gray-700">Skill-based Weakness Detection</span>
                </li>
                <li class="flex items-center gap-4">
                  <div class="w-6 h-6 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 text-xs">
                    <i class="fas fa-check"></i>
                  </div>
                  <span class="font-semibold text-gray-700">Badge & Achievement System</span>
                </li>
              </ul>

              <div class="mt-12">
                <a href="/leaderboard" class="btn-primary hover:bg-[#1A1A2E] hover:text-white">
                  <i class="fas fa-medal mr-2"></i> View Leaderboard
                </a>
              </div>
            </div>

            <div class="lg:w-1/2 relative">
              <!-- Dashboard Visual Card -->
              <div class="bg-[#1A1A2E] p-8 rounded-[2rem] shadow-2xl overflow-hidden relative group">
                <!-- Glowing spots -->
                <div class="absolute -top-10 -right-10 w-40 h-40 bg-blue-500/20 blur-[80px]"></div>
                <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-purple-500/20 blur-[80px]"></div>

                <div class="flex justify-between items-center mb-10 border-b border-white/10 pb-6">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-yellow-400">
                      <i class="fas fa-user"></i>
                    </div>
                    <div>
                      <div class="text-white font-bold text-sm">Alex Johnson</div>
                      <div class="text-blue-400 text-xs">Rank #1 (Engineering)</div>
                    </div>
                  </div>
                  <div class="text-right">
                    <div class="text-gray-400 text-[10px] uppercase font-black">Score</div>
                    <div class="text-2xl font-black text-white">982</div>
                  </div>
                </div>

                <!-- Graph Placeholder -->
                <div class="h-48 mb-8 relative flex items-end justify-between px-4">
                  <div class="w-8 bg-blue-500/40 rounded-t-lg transition-all duration-500 group-hover:h-32 h-16"></div>
                  <div class="w-8 bg-blue-500/60 rounded-t-lg transition-all duration-500 group-hover:h-40 h-24"></div>
                  <div class="w-8 bg-amber-500 rounded-t-lg transition-all duration-500 group-hover:h-44 h-32"></div>
                  <div class="w-8 bg-blue-500/80 rounded-t-lg transition-all duration-500 group-hover:h-28 h-12"></div>
                  <div class="w-8 bg-blue-500 rounded-t-lg transition-all duration-500 group-hover:h-36 h-20"></div>
                </div>

                <!-- Mini Score Cards -->
                <div class="grid grid-cols-2 gap-4">
                  <div class="bg-white/5 p-4 rounded-xl border border-white/5">
                    <div class="text-[10px] text-gray-400 uppercase font-black mb-1 text-center">Logic</div>
                    <div class="text-center font-bold text-white">85%</div>
                  </div>
                  <div class="bg-white/5 p-4 rounded-xl border border-white/5">
                    <div class="text-[10px] text-gray-400 uppercase font-black mb-1 text-center">Quant</div>
                    <div class="text-center font-bold text-amber-500">62%</div>
                  </div>
                </div>

                <!-- Toast -->
                <div
                  class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-white/10 backdrop-blur-md border border-white/20 px-6 py-3 rounded-full text-white text-sm font-bold shadow-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  <i class="fas fa-chart-line mr-2 text-green-400"></i> New Personal Best!
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Testimonials Marquee -->
      <section class="py-24 bg-gray-50 border-y border-gray-200 overflow-hidden">
        <div class="container mx-auto px-6 text-center mb-16">
          <h2 class="text-4xl font-bold text-[#1A1A2E]">Voice of our Students</h2>
          <p class="text-gray-500 mt-4">Real stories from the EduNavigator community.</p>
        </div>

        <div class="marquee-wrapper relative">
          <!-- Left Gradient -->
          <div class="absolute left-0 top-0 w-40 h-full bg-gradient-to-r from-gray-50 to-transparent z-10"></div>
          <!-- Right Gradient -->
          <div class="absolute right-0 top-0 w-40 h-full bg-gradient-to-l from-gray-50 to-transparent z-10"></div>

          <div class="marquee-track flex gap-8 py-4">
            <!-- Testimonial Item (Duplicate for infinite effect) -->
            <% const testimonials=[ { name: 'Aarav Patel' , role: 'Computer Science' ,
              text: 'The AI career roadmap helped me visualize my path clearly. Highly recommended!' , color: 'blue' },
              { name: 'Zara Khan' , role: 'Psychology Aspirant' ,
              text: 'I was confused about my options, but the aptitude test nailed my strengths.' , color: 'purple' }, {
              name: 'Rohan Gupta' , role: 'Mechanical Eng.' ,
              text: 'Found the best college for my rank using the Finder tool. Saved weeks of stress.' , color: 'amber'
              }, { name: 'Ishita Sharma' , role: 'Medical Aspirant' ,
              text: 'The scholarship database is a goldmine. I found a grant I didn\' t know existed.', color: 'emerald'
              }, { name: 'Vivaan Singh' , role: 'Economics Student' ,
              text: 'The webinars gave me real insights into what an economist actually does.' , color: 'rose' } ]; %>

              <% [...testimonials, ...testimonials, ...testimonials].forEach((t, i)=> { %>
                <div
                  class="min-w-[350px] bg-white p-8 rounded-3xl shadow-sm border border-gray-100 hover:shadow-xl transition-all duration-300">
                  <div class="flex items-center gap-4 mb-6">
                    <div
                      class="w-12 h-12 rounded-full bg-<%= t.color %>-100 text-<%= t.color %>-600 flex items-center justify-center font-black text-xl">
                      <%= t.name[0] %>
                    </div>
                    <div>
                      <div class="font-bold text-[#1A1A2E]">
                        <%= t.name %>
                      </div>
                      <div class="text-xs text-gray-400 font-bold uppercase">
                        <%= t.role %>
                      </div>
                    </div>
                  </div>
                  <p class="text-gray-600 italic leading-relaxed">"<%= t.text %>"</p>
                  <div class="mt-6 flex text-yellow-400 text-xs gap-1">
                    <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i
                      class="fas fa-star"></i><i class="fas fa-star"></i>
                  </div>
                </div>
                <% }); %>
          </div>
        </div>
      </section>

      <!-- Final CTA -->
      <section class="py-24 bg-[#1A1A2E] relative overflow-hidden">
        <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-blue-600/10 rounded-full blur-[100px]"></div>
        <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-amber-600/10 rounded-full blur-[100px]"></div>

        <div class="container mx-auto px-6 relative z-10">
          <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-5xl lg:text-7xl font-bold text-white mb-8 leading-tight">
              Ready to build your <br />
              <span class="text-[#FFB800]">Dream Career?</span>
            </h2>
            <p class="text-xl text-blue-100/60 mb-12 max-w-2xl mx-auto">
              Join thousands of students who are already navigating their future with confidence. Signing up takes less
              than a minute.
            </p>
            <div class="flex flex-wrap justify-center gap-6">
              <a href="/register" class="btn-primary px-10 py-5 text-xl bg-[#FFB800] hover:bg-amber-400">
                Create Free Account
              </a>
              <a href="/login" class="btn-glass px-10 py-5 text-xl border-white/20">
                Welcome Back
              </a>
            </div>
          </div>
        </div>
      </section>
    </div>

    <style>
      /* Custom Overrides for Home Page */
      :root {
        --color-primary: #FFB800;
        --color-secondary: #00A8FF;
      }

      .text-gradient-primary {
        background: linear-gradient(135deg, #FFB800 0%, #FF9F00 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .btn-primary {
        transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      }

      .animate-float {
        animation: float 6s ease-in-out infinite;
      }

      @keyframes float {

        0%,
        100% {
          transform: translateY(0px);
        }

        50% {
          transform: translateY(-20px);
        }
      }

      @keyframes spin-slow {
        from {
          transform: translate(-50%, -50%) rotate(0deg);
        }

        to {
          transform: translate(-50%, -50%) rotate(360deg);
        }
      }

      .animate-spin-slow {
        animation: spin-slow 20s linear infinite;
      }

      .marquee-track {
        animation: scroll 40s linear infinite;
        width: fit-content;
      }

      .marquee-track:hover {
        animation-play-state: paused;
      }

      @keyframes scroll {
        0% {
          transform: translateX(0);
        }

        100% {
          transform: translateX(calc(-350px * 5 - 2rem * 5));
        }
      }

      .premium-card {
        border: 1px solid rgba(0, 0, 0, 0.05);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
        display: flex;
        flex-direction: column;
        height: 100%;
      }

      @keyframes gradientShift {
        0% {
          background-position: 0% 50%;
        }

        50% {
          background-position: 100% 50%;
        }

        100% {
          background-position: 0% 50%;
        }
      }

      .premium-gradient-bg {
        background: linear-gradient(-45deg, #FFB800, #FF9F00, #00A8FF, #6C63FF);
        background-size: 400% 400%;
        animation: gradientShift 15s ease infinite;
      }
