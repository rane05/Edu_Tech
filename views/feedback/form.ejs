<%- include('../layouts/header') %>

    <style>
        .feedback-bg {
            background: radial-gradient(circle at top right, #f8fafc, #eff6ff);
        }

        .rating-btn:hover i {
            color: #fbbf24;
            transform: scale(1.2) rotate(15deg);
        }

        .rating-btn peer-checked+div i {
            color: #fbbf24;
        }
    </style>

    <div class="min-h-screen bg-slate-50 pt-24 pb-12 px-4 flex items-center justify-center feedback-bg">
        <div class="max-w-2xl w-full">
            <!-- Explorer Header -->
            <div class="text-center mb-12 translate-y-4 animate-in fade-in slide-in-from-bottom-4 duration-1000">
                <h1 class="text-4xl font-black text-slate-900 mb-3 tracking-tight">Direct Improvement Line</h1>
                <p class="text-slate-500 font-medium">Your insights drive the evolution of Edu_Tech. Every word matters.
                </p>
            </div>

            <div
                class="bg-white rounded-[3rem] shadow-2xl shadow-slate-200/60 border border-white overflow-hidden animate-in fade-in zoom-in-95 duration-700">
                <div class="bg-slate-900 p-10 text-white relative overflow-hidden">
                    <div
                        class="absolute top-0 right-0 w-32 h-32 bg-indigo-500 rounded-full blur-3xl opacity-30 -mr-16 -mt-16">
                    </div>
                    <div class="relative z-10 flex flex-col items-center">
                        <div
                            class="w-16 h-16 bg-white/10 rounded-2xl flex items-center justify-center text-rose-400 text-2xl mb-4">
                            <i class="fas fa-heart"></i>
                        </div>
                        <h2 class="text-2xl font-black tracking-tight">Share Your Experience</h2>
                        <p class="text-indigo-200/60 text-xs font-black uppercase tracking-[0.2em] mt-2">Valuable
                            Contribution</p>
                    </div>
                </div>

                <form action="/feedback" method="POST" class="p-10 md:p-14 space-y-10">
                    <div class="space-y-4">
                        <label class="text-xs font-black text-slate-400 uppercase tracking-widest ml-1">Overall
                            Satisfaction</label>
                        <div
                            class="flex justify-between items-center bg-slate-50/50 p-6 rounded-[2rem] border border-slate-100">
                            <% for(let i=1; i<=5; i++) { %>
                                <label class="cursor-pointer group rating-btn">
                                    <input type="radio" name="rating" value="<%= i %>" class="sr-only peer" required>
                                    <div
                                        class="w-12 h-12 md:w-16 md:h-16 flex items-center justify-center text-3xl text-slate-200 peer-checked:text-amber-400 peer-checked:bg-white peer-checked:shadow-xl peer-checked:shadow-amber-100 rounded-2xl transition-all duration-300">
                                        <i class="fas fa-star transition-all"></i>
                                    </div>
                                    <span class="sr-only">
                                        <%= i %> Star
                                    </span>
                                </label>
                                <% } %>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <label class="text-xs font-black text-slate-400 uppercase tracking-widest ml-1">Focus
                            Area</label>
                        <input type="text" name="subject"
                            class="w-full px-8 py-5 bg-slate-50/50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 transition-all outline-none font-bold text-slate-800 placeholder:text-slate-300"
                            placeholder="e.g. Navigation, Features, Accessibility" required>
                    </div>

                    <div class="space-y-4">
                        <label class="text-xs font-black text-slate-400 uppercase tracking-widest ml-1">Key
                            Insights</label>
                        <textarea name="message" rows="5"
                            class="w-full px-8 py-5 bg-slate-50/50 border border-slate-200 rounded-3xl focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 transition-all outline-none font-medium text-slate-700 placeholder:text-slate-300 resize-none"
                            placeholder="Tell us exactly how we can improve your journey..." required></textarea>
                    </div>

                    <button type="submit"
                        class="w-full py-6 bg-indigo-600 text-white rounded-[2rem] font-black text-sm uppercase tracking-widest hover:bg-slate-900 transition-all shadow-2xl shadow-indigo-100 active:scale-95">
                        Dispatch Feedback
                    </button>
                </form>
            </div>

            <p class="text-center mt-10 text-slate-400 text-xs font-medium">By submitting, you agree to our <a href="#"
                    class="text-indigo-500 hover:underline">Community Guidelines</a></p>
        </div>
    </div>

    <%- include('../layouts/footer') %>