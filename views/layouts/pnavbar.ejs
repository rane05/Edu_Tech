<!-- Modern Glassmorphism Parent Navbar -->
<style>
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&display=swap');

    :root {
        --p-primary: #10b981;
        --p-dark: #0f172a;
        --p-slate: #64748b;
    }

    .glass-nav {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 70px;
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.5);
        z-index: 1000;
        display: flex;
        align-items: center;
        transition: all 0.3s ease;
    }

    .nav-container {
        max-width: 1280px;
        margin: 0 auto;
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 2rem;
    }

    .nav-brand {
        font-family: 'Outfit', sans-serif;
        font-size: 1.5rem;
        font-weight: 800;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .brand-edu {
        color: var(--p-primary);
    }

    .brand-nav {
        color: var(--p-dark);
    }

    .nav-links {
        display: flex;
        gap: 2.5rem;
        align-items: center;
    }

    .nav-link {
        text-decoration: none;
        color: var(--p-slate);
        font-weight: 600;
        font-size: 0.95rem;
        font-family: 'Outfit', sans-serif;
        transition: all 0.2s ease;
        position: relative;
    }

    .nav-link:hover {
        color: var(--p-primary);
    }

    .nav-link::after {
        content: '';
        position: absolute;
        bottom: -4px;
        left: 0;
        width: 0;
        height: 2px;
        background: var(--p-primary);
        transition: width 0.3s ease;
    }

    .nav-link:hover::after {
        width: 100%;
    }

    .btn-logout {
        background: var(--p-dark);
        color: white !important;
        padding: 0.6rem 1.25rem;
        border-radius: 0.75rem;
        text-decoration: none;
        font-weight: 700;
        font-size: 0.9rem;
        transition: all 0.2s ease;
    }

    .btn-logout:hover {
        background: #1e293b;
        transform: translateY(-1px);
    }

    /* Mobile Toggle */
    .mobile-toggle {
        display: none;
        flex-direction: column;
        gap: 5px;
        cursor: pointer;
    }

    .bar {
        width: 22px;
        height: 2px;
        background: var(--p-dark);
        transition: 0.3s;
    }

    @media (max-width: 768px) {
        .nav-links {
            position: fixed;
            top: 70px;
            right: -100%;
            width: 80%;
            height: calc(100vh - 70px);
            background: white;
            flex-direction: column;
            padding: 2rem;
            box-shadow: -10px 0 30px rgba(0, 0, 0, 0.05);
            transition: 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .nav-links.active {
            right: 0;
        }

        .mobile-toggle {
            display: flex;
        }
    }
</style>

<nav class="glass-nav">
    <div class="nav-container">
        <a href="/parent_home" class="nav-brand">
            <span class="brand-edu">Edu</span><span class="brand-nav">Navigator</span>
        </a>

        <div class="mobile-toggle" id="mobile-toggle">
            <div class="bar"></div>
            <div class="bar"></div>
            <div class="bar"></div>
        </div>

        <div class="nav-links" id="nav-links">
            <a href="/parent_home" class="nav-link">Dashboard</a>
            <a href="/parentprofile" class="nav-link">My Profile</a>

            <% if ((typeof userId !== 'undefined' && userId) || (typeof username !== 'undefined' && username)) { %>
                <a href="/logout" class="btn-logout">Log Out</a>
            <% } else { %>
                <a href="/login" class="nav-link">Log In</a>
            <% } %>
        </div>
    </div>
</nav>

<script>
    const toggle = document.getElementById('mobile-toggle');
    const links = document.getElementById('nav-links');

    toggle.addEventListener('click', () => {
        links.classList.toggle('active');
        toggle.classList.toggle('active');
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
        if (!toggle.contains(e.target) && !links.contains(e.target)) {
            links.classList.remove('active');
        }
    });
</script>