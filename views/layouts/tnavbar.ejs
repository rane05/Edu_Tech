<!-- Modern Glassmorphism Teacher Navbar -->
<style>
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap');

    :root {
        --nav-glass-bg: rgba(255, 255, 255, 0.7);
        --nav-glass-border: rgba(255, 255, 255, 0.2);
        --nav-glass-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.07);
    }

    .dark {
        --nav-glass-bg: rgba(15, 23, 42, 0.6);
        --nav-glass-border: rgba(255, 255, 255, 0.05);
        --nav-glass-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
    }

    .t-glass-nav {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 72px;
        background: var(--nav-glass-bg);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--nav-glass-border);
        box-shadow: var(--nav-glass-shadow);
        z-index: 1000;
        transition: all 0.3s ease;
    }

    .t-nav-content {
        max-width: 1536px;
        margin: 0 auto;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 32px;
    }

    .t-logo {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        font-weight: 800;
        font-size: 1.5rem;
        letter-spacing: -0.5px;
        color: #1e293b;
    }

    .dark .t-logo {
        color: #f1f5f9;
    }

    .t-logo-accent {
        background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .t-nav-links {
        display: flex;
        align-items: center;
        gap: 2rem;
    }

    .t-nav-link {
        text-decoration: none;
        color: #64748b;
        font-size: 0.875rem;
        font-weight: 600;
        transition: all 0.2s ease;
        position: relative;
    }

    .t-nav-link:hover {
        color: #6366f1;
    }

    .t-nav-link::after {
        content: '';
        position: absolute;
        bottom: -4px;
        left: 0;
        width: 0;
        height: 2px;
        background: #6366f1;
        transition: width 0.2s ease;
        border-radius: 2px;
    }

    .t-nav-link:hover::after {
        width: 100%;
    }

    .t-logout-btn {
        background: rgba(244, 63, 94, 0.1);
        color: #f43f5e;
        padding: 8px 20px;
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: all 0.2s ease;
        border: 1px solid rgba(244, 63, 94, 0.2);
    }

    .t-logout-btn:hover {
        background: #f43f5e;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(244, 63, 94, 0.3);
    }

    @media (max-width: 1024px) {
        .t-nav-links {
            display: none;
        }
    }
</style>

<nav class="t-glass-nav">
    <div class="t-nav-content">
        <a href="/teacher_home" class="t-logo">
            <i class="fas fa-graduation-cap t-logo-accent"></i>
            <span>Edu<span class="t-logo-accent">Navigator</span> <span
                    class="text-xs ml-2 py-0.5 px-2 bg-indigo-500/10 text-indigo-500 rounded-full font-black uppercase">Faculty</span></span>
        </a>

        <div class="t-nav-links">
            <a href="/teacher_home" class="t-nav-link">Dashboard</a>
            <a href="/studentlist" class="t-nav-link">Roster Control</a>
            <a href="/tprofile" class="t-nav-link">Faculty Profile</a>

            <% if ((typeof userId !== 'undefined' && userId) || (typeof username !== 'undefined' && username)) { %>
                <a href="/logout" class="t-logout-btn">Log Out</a>
            <% } else { %>
                <a href="/login" class="t-logout-btn"
                    style="background: rgba(99, 102, 241, 0.1); color: #6366f1; border-color: rgba(99, 102, 241, 0.2);">Faculty
                    Login</a>
            <% } %>
        </div>

        <button class="lg:hidden p-2 text-slate-500" id="t-mobile-menu-toggle">
            <i class="fas fa-bars fa-lg"></i>
        </button>
    </div>
</nav>

<!-- Padding to avoid content overlap -->
<div class="h-[72px]"></div>

<script>
    // Simple mobile menu toggle if needed
    const mobileBtn = document.getElementById('t-mobile-menu-toggle');
    if (mobileBtn) {
        mobileBtn.addEventListener('click', () => {
            // For now, teacher dashboard is mostly used on large screens, 
            // but we could add a mobile drawer here if requested.
            alert('Mobile workspace management optimized for desktop. Please use a larger display for full Faculty controls.');
        });
    }
</script>