<!-- Modern Glassmorphism Navbar -->
<style>
    :root {
        --nav-primary: #FFB800;
        --nav-secondary: #00A8FF;
        --nav-dark: #0B1120;
        /* Refined to match V4 deep navy */
        --nav-text: #526075;
        /* Match V4 slate */
    }

    /* Navbar Container - V4 Glass System */
    .glass-nav {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 80px;
        /* Slightly taller for breathability */
        background: transparent;
        border-bottom: 1px solid transparent;
        z-index: 1000;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* The active scrolled state: Acrylic Glass */
    .glass-nav.is-scrolled {
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(16px) saturate(160%);
        -webkit-backdrop-filter: blur(16px) saturate(160%);
        border-bottom: 1px solid rgba(255, 255, 255, 0.8);
        box-shadow: 0 4px 24px rgba(11, 17, 32, 0.04);
        height: 70px;
        /* Shrinks slightly on scroll */
    }

    /* Faint noise overlay for acrylic realism on scroll */
    .glass-nav::before {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='1'/%3E%3C/svg%3E");
        opacity: 0;
        transition: opacity 0.4s ease;
        z-index: -1;
    }

    .glass-nav.is-scrolled::before {
        opacity: 0.02;
    }

    .nav-content {
        max-width: 1280px;
        margin: 0 auto;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 2rem;
    }

    /* Logo Styles */
    .nav-logo {
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 12px;
        z-index: 1002;
        padding: 5px;
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        position: relative;
    }

    .nav-logo:hover {
        transform: scale(1.02);
    }

    /* Desktop Navigation */
    .nav-desktop {
        display: flex;
        align-items: center;
        gap: 2rem;
    }

    .nav-item {
        position: relative;
        padding: 10px 0;
    }

    .nav-link {
        color: var(--nav-text);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        transition: color 0.2s ease;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .nav-link i {
        font-size: 0.70rem;
        opacity: 0.5;
        transition: transform 0.2s;
    }

    .nav-link:hover {
        color: var(--nav-dark);
    }

    .nav-link:hover i {
        transform: rotate(180deg);
        color: var(--nav-dark);
    }

    /* Dropdowns - Match V4 elevated cards */
    .nav-dropdown {
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%) translateY(10px) scale(0.98);
        background: #FFFFFF;
        border-radius: 12px;
        box-shadow: 0 12px 32px rgba(11, 17, 32, 0.08);
        /* V4 Shadow-float logic */
        padding: 12px;
        min-width: 240px;
        opacity: 0;
        visibility: hidden;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        border: 1px solid rgba(11, 17, 32, 0.05);
        transform-origin: top center;
    }

    .nav-item:hover .nav-dropdown {
        opacity: 1;
        visibility: visible;
        transform: translateX(-50%) translateY(0) scale(1);
    }

    .dropdown-link {
        display: block;
        padding: 10px 16px;
        color: var(--nav-text);
        text-decoration: none;
        font-size: 0.95rem;
        border-radius: 8px;
        transition: all 0.2s ease;
        font-weight: 500;
    }

    .dropdown-link:hover {
        background: #F9F9F8;
        /* V4 cream-alt */
        color: var(--nav-dark);
        transform: translateX(4px);
    }

    /* Auth Buttons - Update to match V4 button styles */
    .nav-auth {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .btn-login {
        color: var(--nav-text);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        transition: color 0.2s;
        border: 1px solid transparent;
        padding: 0.5rem 1rem;
        border-radius: 8px;
    }

    .btn-login:hover {
        color: var(--nav-dark);
        background: rgba(11, 17, 32, 0.03);
    }

    .btn-signup {
        background: var(--nav-dark);
        color: white;
        padding: 0.6rem 1.25rem;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 2px 4px rgba(11, 17, 32, 0.05);
        /* Match V4 shadow-micro */
    }

    .btn-signup:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(11, 17, 32, 0.1);
        background: #1E293B;
    }

    .btn-signup:active {
        transform: scale(0.98);
    }

    /* Mobile Toggle */
    .mobile-toggle {
        display: none;
        flex-direction: column;
        gap: 6px;
        cursor: pointer;
        z-index: 1002;
    }

    .bar {
        width: 24px;
        height: 2px;
        background: var(--nav-dark);
        transition: all 0.3s ease;
        border-radius: 2px;
    }

    /* Mobile Menu - Match V4 */
    .mobile-menu {
        position: fixed;
        top: 0;
        right: -100%;
        width: 100%;
        max-width: 320px;
        height: 100vh;
        background: #FFFFFF;
        padding: 90px 24px 24px;
        box-shadow: -10px 0 30px rgba(0, 0, 0, 0.05);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 1001;
        overflow-y: auto;
    }

    .mobile-menu.active {
        right: 0;
    }

    .mobile-link-group {
        margin-bottom: 24px;
    }

    .mobile-group-title {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #8A98AB;
        margin-bottom: 12px;
        font-weight: 700;
    }

    .mobile-link {
        display: block;
        padding: 12px 0;
        color: var(--nav-dark);
        text-decoration: none;
        font-weight: 500;
        border-bottom: 1px solid rgba(0, 0, 0, 0.03);
    }

    /* Overlay */
    .nav-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        background: rgba(11, 17, 32, 0.2);
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 1000;
        backdrop-filter: blur(4px);
    }

    .nav-overlay.active {
        opacity: 1;
        visibility: visible;
    }

    /* Active States for Hamburger */
    .mobile-toggle.active .bar:nth-child(1) {
        transform: translateY(8px) rotate(45deg);
    }

    .mobile-toggle.active .bar:nth-child(2) {
        opacity: 0;
    }

    .mobile-toggle.active .bar:nth-child(3) {
        transform: translateY(-8px) rotate(-45deg);
    }

    @media (max-width: 1024px) {

        .nav-desktop,
        .nav-auth {
            display: none;
        }

        .mobile-toggle {
            display: flex;
        }
    }
</style>

