              <option value="All">All Domains</option>
              <option value="Software Engineering">Software Engineering</option>
              <option value="Frontend Web">Frontend Web</option>
              <option value="Data Science">Data Science</option>
              <option value="Product Design">Product Design</option>
            </select>

            <select id="levelSelect"
              class="shrink-0 appearance-none bg-slate-50 border border-slate-200 text-slate-700 text-sm font-medium rounded-xl py-3 pl-4 pr-10 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/50 cursor-pointer outline-none transition-all">
              <option value="All">All Levels</option>
              <option value="Beginner">Beginner</option>
              <option value="Intermediate">Intermediate</option>
              <option value="Advanced">Advanced</option>
            </select>

            <select id="statusSelect"
              class="shrink-0 appearance-none bg-slate-50 border border-slate-200 text-slate-700 text-sm font-medium rounded-xl py-3 pl-4 pr-10 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/50 cursor-pointer outline-none transition-all bg-[length:16px_16px]">
              <option value="All">All Statuses</option>
