      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">

        <!-- Featured Webinar Injection Point -->
        <div id="featuredWebinarContainer" class="w-full transition-opacity duration-500"></div>

        <!-- Section Title -->
        <div id="resultsTitle" class="text-2xl font-black text-slate-800 flex items-center gap-3">
