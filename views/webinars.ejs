            <button
              class="magnetic-btn px-8 py-4 w-full sm:w-auto rounded-2xl bg-white/90 backdrop-blur-xl border border-slate-200 text-slate-700 font-semibold flex items-center justify-center gap-2 text-[17px] shadow-sm transition-all duration-300 hover:bg-white hover:border-slate-300 hover:text-slate-900 hover:shadow-md hover:-translate-y-1">
