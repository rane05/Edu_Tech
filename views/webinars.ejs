    <script>
      // Live Data Fetcher
      let WEBINARS_DATA = [];

      const fetchLiveWebinars = async () => {
        try {
          resultsTitle.innerHTML = '<i class="fas fa-spinner fa-spin text-indigo-600 mr-2"></i> Loading Live Webinars...';
          webinarGrid.innerHTML = '';

          const domain = domainSelect.value === 'All' ? 'Software Engineering' : domainSelect.value;
          const query = encodeURIComponent(domain + ' Tech Talk Webinar Conference');

          const res = await fetch('/api/webinars?domain=' + encodeURIComponent(domain) + '&q=' + query);
          const data = await res.json();

          WEBINARS_DATA = data;
          filterData();
        } catch (err) {
          console.error("Failed to load webinars", err);
          resultsTitle.innerHTML = 'Error loading webinars.';
        }
      };

      // Bookmark Store
      const Store = {
        getBookmarks: () => JSON.parse(localStorage.getItem("bookmarkedWebinars") || "[]"),
        toggleBookmark: (id) => {
          let bookmarks = Store.getBookmarks();
          if (bookmarks.includes(id)) {
            bookmarks = bookmarks.filter(b => b !== id);
          } else {
            bookmarks.push(id);
          }
          localStorage.setItem("bookmarkedWebinars", JSON.stringify(bookmarks));
          return bookmarks;
        }
      };

      // DOM Elements
      const searchInput = document.getElementById("searchInput");
      const domainSelect = document.getElementById("domainSelect");
      const levelSelect = document.getElementById("levelSelect");
      const statusSelect = document.getElementById("statusSelect");
      const webinarGrid = document.getElementById("webinarGrid");
      const emptyState = document.getElementById("emptyState");
      const resultsTitle = document.getElementById("resultsTitle");

      // Helper Generators
      const generateBadges = (webinar) => {
        let statusBadge = '';
        let levelBadge = '';

        if (webinar.status === "Upcoming") statusBadge = `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800">Upcoming</span>`;
        else if (webinar.status === "Recorded") statusBadge = `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-800">Recorded</span>`;
        else if (webinar.status === "Live") statusBadge = `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 animate-pulse">Live Now</span>`;

        if (webinar.level === "Beginner") levelBadge = `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Beginner</span>`;
        else if (webinar.level === "Intermediate") levelBadge = `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">Intermediate</span>`;
        else if (webinar.level === "Advanced") levelBadge = `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800">Advanced</span>`;

        return `${statusBadge} ${levelBadge}`;
      };

      // Render Logic
      const renderCards = (data) => {
        const bookmarks = Store.getBookmarks();
        const featuredContainer = document.getElementById("featuredWebinarContainer");

        if (data.length === 0) {
          webinarGrid.classList.add('hidden');
          featuredContainer.classList.add('hidden');
          emptyState.classList.remove('hidden');
          emptyState.classList.add('flex');
          return;
        }

        webinarGrid.classList.remove('hidden');
        featuredContainer.classList.remove('hidden');
        emptyState.classList.add('hidden');
        emptyState.classList.remove('flex');

        // Extract the first item as the Featured Webinar
        const featured = data[0];
        const gridItems = data.slice(1);

        // --- Render Featured Webinar ---
        if (featured) {
          const fIsBookmarked = bookmarks.includes(featured.id);
          const fTagsHTML = featured.tags.map((tag, i) => `<span class="text-xs bg-indigo-50/50 text-indigo-700 px-3 py-1 rounded-full font-semibold backdrop-blur-sm border border-indigo-100 flex-shrink-0" style="animation: float-delay ${2 + i}s infinite ease-in-out">${tag}</span>`).join('');
          const fBookmarkIconColor = fIsBookmarked ? "text-indigo-600" : "text-white";

          featuredContainer.innerHTML = `
            <div class="relative w-full rounded-[2rem] overflow-hidden glass-panel group card-hover-lift mb-8">
              <div class="flex flex-col lg:flex-row min-h-[400px]">
                
                <!-- Left Image & Badges -->
                <div class="relative w-full lg:w-3/5 min-h-[300px] overflow-hidden bg-slate-100">
                  ${featured.thumbnail ? `<img src="${featured.thumbnail}" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />` : ''}
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-transparent to-transparent"></div>
                  <div class="absolute inset-0 bg-gradient-to-r from-transparent via-transparent to-white/10 opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
                  
                  <!-- Floating Top Badges -->
                  <div class="absolute top-6 left-6 flex gap-2 z-10">
                    ${featured.status === "Live" ? `<span class="px-3 py-1.5 rounded-full text-xs font-bold bg-rose-500 text-white shadow-lg animate-pulse uppercase tracking-widest"><i class="fas fa-circle text-[8px] mr-1 mb-[2px]"></i> Live Now</span>` : generateBadges(featured)}
                  </div>

                  <!-- Floating Bottom Speaker -->
                  <div class="absolute bottom-6 left-6 flex items-center gap-3 z-10">
                    <img src="${featured.speaker.image}" alt="${featured.speaker.name}" class="w-12 h-12 rounded-full ring-4 ring-white/20 shadow-lg" loading="lazy" />
                    <div class="text-white">
                      <p class="text-sm font-bold text-slate-50">${featured.speaker.name}</p>
                      <p class="text-xs font-semibold text-slate-300 opacity-90">${featured.speaker.company}</p>
                    </div>
                  </div>
                </div>

                <!-- Right Content -->
                <div class="relative w-full lg:w-2/5 p-8 lg:p-10 flex flex-col justify-between bg-white/90">
                  <div>
                    <div class="flex items-center justify-between mb-4">
                      <div class="flex items-center gap-2 text-indigo-600 font-bold text-sm uppercase tracking-widest">
                        <i class="fas fa-star text-amber-400"></i> Featured Live Session
                      </div>
                      <button onclick="window.toggleBookmark('${featured.id}')" class="p-2.5 rounded-full bg-slate-100 hover:bg-slate-200 transition-transform active:scale-90 group/btn shadow-inner">
                        <i class="fas fa-bookmark ${fIsBookmarked ? 'text-indigo-600' : 'text-slate-400'} group-hover/btn:-translate-y-0.5 transition-transform"></i>
                      </button>
                    </div>
                    
                    <h2 class="text-3xl font-extrabold text-slate-900 mb-4 leading-tight group-hover:text-indigo-600 transition-colors duration-300">
                      ${featured.title}
                    </h2>
                    
                    <p class="text-slate-500 text-base leading-relaxed line-clamp-3 mb-6">
                      ${featured.description}
                    </p>

                    <div class="flex flex-wrap gap-2 mb-8">
                       ${fTagsHTML}
                    </div>
                  </div>

                  <div class="flex items-center justify-between mt-auto">
                    <div class="flex items-center gap-2 text-slate-500 font-semibold text-sm">
                      <div class="w-8 h-8 rounded-full bg-indigo-50 flex items-center justify-center text-indigo-500 shadow-inner">
                        <i class="fas fa-clock"></i>
                      </div>
                      ${featured.duration} mins intensive
                    </div>
                    
                    <a href="${featured.url}" target="_blank" class="px-8 py-3.5 bg-gradient-to-r from-indigo-600 to-indigo-500 text-white rounded-xl font-bold hover:shadow-[0_0_20px_-5px_rgba(99,102,241,0.6)] hover:-translate-y-0.5 transition-all outline-none">
                      Join Masterclass
                    </a>
                  </div>

                </div>
              </div>
            </div>
          `;
        } else {
          featuredContainer.innerHTML = '';
        }

        // --- Render Grid Webinars ---
        webinarGrid.innerHTML = gridItems.map((webinar, index) => {
          const isBookmarked = bookmarks.includes(webinar.id);
          const tagsHTML = webinar.tags.map(tag => `<span class="text-[10px] uppercase tracking-wider font-bold bg-slate-100/80 text-slate-600 px-2.5 py-1 rounded-md border border-slate-200/50">${tag}</span>`).join('');

          const bookmarkIconColor = isBookmarked ? "text-indigo-600 drop-shadow-md" : "text-white drop-shadow-md";

          const btnText = webinar.status === "Recorded" ? `<i class="fas fa-play ml-1"></i> Watch VOD` : 'Register Seat';
          const btnClass = webinar.status === "Recorded"
            ? "border border-slate-200 text-slate-700 bg-white hover:bg-slate-50 hover:shadow-sm"
            : "bg-slate-900 text-white hover:shadow-lg hover:shadow-slate-900/20";

          // Cascade animation delay based on index
          const animDelay = (index % 10) * 0.05;

          return `
      <div class="flex flex-col h-full bg-white rounded-2xl shadow-sm border border-slate-100 group card-hover-lift opacity-0 animate-[fade-in-up_0.6s_ease-out_forwards]" style="animation-delay: ${animDelay}s">
        <!-- Image Card Top -->
        <div class="relative w-full aspect-video rounded-t-2xl overflow-hidden bg-slate-100 shrink-0">
           ${webinar.thumbnail ? `<img src="${webinar.thumbnail}" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />` : ''}
           
           <!-- Overlay Gradient for Text Contrast -->
           <div class="absolute inset-0 bg-gradient-to-t from-slate-900/90 via-slate-900/20 to-transparent"></div>
           
           <!-- Top Floating Badges -->
           <div class="absolute top-3 left-3 flex gap-1.5 z-10">
             ${generateBadges(webinar)}
           </div>

           <!-- Floating Bookmark -->
           <button onclick="window.toggleBookmark('${webinar.id}')" class="absolute top-3 right-3 z-10 p-2 rounded-full backdrop-blur-sm bg-black/20 hover:bg-black/40 transition-colors group/bkmk">
             <i class="fas fa-bookmark ${bookmarkIconColor} text-sm group-hover/bkmk:-translate-y-0.5 transition-transform duration-300"></i>
           </button>

           <!-- Bottom Speaker Info Over Image -->
           <div class="absolute bottom-3 left-3 flex items-center gap-2.5 z-10 w-[calc(100%-24px)]">
             <img src="${webinar.speaker.image}" alt="${webinar.speaker.name}" class="w-9 h-9 rounded-full ring-2 ring-white/30 object-cover shadow-sm" loading="lazy" />
             <div class="truncate">
               <p class="text-sm font-bold text-white truncate drop-shadow-md">${webinar.speaker.name}</p>
               <p class="text-[10px] font-medium text-slate-200 truncate opacity-90">${webinar.speaker.company}</p>
             </div>
           </div>
        </div>

        <!-- Content Body -->
        <div class="p-5 flex-1 flex flex-col relative z-20 bg-white rounded-b-2xl">
          <h3 class="font-extrabold text-[17px] text-slate-800 mb-2 leading-snug line-clamp-2 transition-colors group-hover:text-indigo-600">
            ${webinar.title}
          </h3>
          <p class="text-sm text-slate-500 mb-4 line-clamp-2 leading-relaxed flex-1">
            ${webinar.description}
          </p>
          
          <div class="space-y-4 w-full mt-auto">
            <!-- Tags -->
            <div class="flex flex-wrap gap-1.5 hide-scroll">
              ${tagsHTML}
            </div>

            <!-- Meta Stats -->
            <div class="flex items-center justify-between text-xs font-semibold text-slate-400 pt-2 border-t border-slate-100">
              <span class="flex items-center gap-1.5">
                <i class="fas fa-clock text-indigo-400"></i> ${webinar.duration}m
              </span>
              ${webinar.status === "Upcoming" && webinar.seatsLeft ? `
                <span class="flex items-center gap-1.5 text-rose-500">
                  <i class="fas fa-fire"></i> ${webinar.seatsLeft} spots
                </span>
              ` : ''}
            </div>

            <!-- Action Area -->
            <div class="pt-1">
              <a href="${webinar.url}" target="_blank" class="w-full inline-flex items-center justify-center rounded-xl font-bold transition-all px-4 py-3 text-sm ${btnClass} outline-none group/action">
                ${btnText}
              </a>
            </div>
          </div>
        </div>
      </div>
    `;
        }).join('');
      };

      window.toggleBookmark = (id) => {
        Store.toggleBookmark(id);
        filterData(); // Re-render to update UI icon
      };

      // Filter Engine
      const filterData = () => {
        const q = searchInput.value.toLowerCase();
        const domain = domainSelect.value;
        const level = levelSelect.value;
        const status = statusSelect.value;

        const filtered = WEBINARS_DATA.filter(w => {
          const matchQ = !q || w.title.toLowerCase().includes(q) || w.description.toLowerCase().includes(q) || w.speaker.name.toLowerCase().includes(q);
          const matchD = domain === "All" || w.domain === domain;
          const matchL = level === "All" || w.level === level;
          const matchS = status === "All" || w.status === status;
          return matchQ && matchD && matchL && matchS;
        });

        if (q || domain !== 'All' || level !== 'All' || status !== 'All') {
          resultsTitle.innerHTML = "Search Results";
        } else {
          resultsTitle.innerHTML = "🔥 Top Webinars";
        }

        renderCards(filtered);
      };

      // Listeners
      searchInput.addEventListener("input", filterData);
      domainSelect.addEventListener("change", fetchLiveWebinars); /* Fetch new batch on domain change */
      levelSelect.addEventListener("change", filterData);
      statusSelect.addEventListener("change", filterData);

      // Initial Load
      document.addEventListener("DOMContentLoaded", fetchLiveWebinars);

    </script>

    <%- include('layouts/footer'); %>