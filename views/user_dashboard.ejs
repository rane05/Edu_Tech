<%- include('layouts/header'); %>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap');

        :root {
            --primary: #4f46e5;
            --primary-hover: #4338ca;
            --bg-main: #f8fafc;
            --sidebar-bg: #ffffff;
            --text-dark: #0f172a;
            --text-muted: #64748b;
            --border-color: #f1f5f9;

            /* Stats Colors */
            --stat-red: #ef4444;
            --stat-red-bg: #fef2f2;
            --stat-green: #10b981;
            --stat-green-bg: #f0fdf4;
            --stat-blue: #3b82f6;
            --stat-blue-bg: #eff6ff;
            --stat-purple: #8b5cf6;
            --stat-purple-bg: #f5f3ff;
        }

        body {
            font-family: 'Outfit', sans-serif !important;
            background-color: var(--bg-main) !important;
            color: var(--text-dark);
            margin: 0;
        }

        /* Base Layout */
        .dashboard-layout {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar */
        .sidebar {
            width: 250px;
            background: var(--sidebar-bg);
            border-right: 1px solid var(--border-color);
            padding: 30px 20px;
            display: flex;
            flex-direction: column;
            position: fixed;
            height: 100vh;
            left: 0;
            top: 0;
            z-index: 50;
        }

        .logo-area {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 20px;
            font-weight: 800;
            margin-bottom: 40px;
            padding-left: 10px;
        }

        .logo-icon {
            width: 28px;
            height: 28px;
            background: #818cf8;
            border-radius: 8px;
            position: relative;
        }

        .logo-icon::after {
            content: '';
            position: absolute;
            width: 14px;
            height: 14px;
            background: #4f46e5;
            border-radius: 4px;
            bottom: -4px;
            right: -4px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 16px;
            border-radius: 12px;
            text-decoration: none;
            color: var(--text-muted);
            font-weight: 600;
            font-size: 15px;
            margin-bottom: 8px;
            transition: all 0.2s;
        }

        .nav-item:hover {
            background: var(--bg-main);
            color: var(--text-dark);
        }

        .nav-item.active {
            background: var(--primary);
            color: white;
        }

        .nav-item i {
            font-size: 18px;
            width: 20px;
            text-align: center;
        }

        /* Promo Card in Sidebar */
        .promo-card {
            display: none !important;
            margin-top: auto;
            background: #f8fafc;
            border-radius: 20px;
            padding: 24px 16px 16px;
            text-align: center;
            position: relative;
        }

        .promo-illustration {
            position: absolute;
            top: -50px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
        }

        .promo-card h4 {
            font-size: 16px;
            font-weight: 800;
            margin: 30px 0 8px 0;
        }

        .promo-card p {
            font-size: 11px;
            color: var(--text-muted);
            margin-bottom: 16px;
            line-height: 1.4;
        }

        .promo-btn {
            background: var(--primary);
            color: white;
            border: none;
            padding: 10px;
            width: 100%;
            border-radius: 10px;
            font-weight: 700;
            font-size: 13px;
            cursor: pointer;
            font-family: inherit;
        }

        /* Main Content */
        .main-content {
            flex: 1;
            margin-left: 250px;
            padding: 30px 40px;
        }

        /* Top Header */
        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 30px;
        }

        .greeting-area h1 {
            font-size: 28px;
            font-weight: 800;
            margin: 0 0 4px 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .greeting-area p {
            color: var(--text-muted);
            font-size: 14px;
            margin: 0;
            font-weight: 500;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 30px;
        }

        .search-bar {
            display: flex;
            align-items: center;
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 10px 16px;
            width: 250px;
        }

        .search-bar input {
            border: none;
            outline: none;
            background: transparent;
            padding-left: 10px;
            font-size: 14px;
            width: 100%;
            font-family: inherit;
        }

        .search-bar i {
            color: var(--text-muted);
        }

        .notification-btn {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            position: relative;
            cursor: pointer;
        }

        .notification-btn::after {
            content: '';
            position: absolute;
            top: 10px;
            right: 12px;
            width: 6px;
            height: 6px;
            background: var(--stat-purple);
            border-radius: 50%;
        }

        .profile-card {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            object-fit: cover;
            background: #e2e8f0;
        }

        .profile-info h4 {
            margin: 0;
            font-size: 15px;
            font-weight: 700;
        }

        .profile-info p {
            margin: 0;
            font-size: 12px;
            color: var(--text-muted);
            font-weight: 500;
        }

        /* Overview Layout */
        .dashboard-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 30px;
        }

        .left-panel,
        .right-panel {
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        /* Stat Cards */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: white;
            border-radius: 20px;
            padding: 20px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
        }

        .stat-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 16px;
        }

        .stat-icon {
            width: 24px;
            height: 24px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            color: white;
        }

        .stat-title {
            font-size: 12px;
            font-weight: 700;
            margin: 0;
            color: var(--text-dark);
        }

        .stat-value {
            font-size: 32px;
            font-weight: 800;
            margin: 0 0 10px 0;
            line-height: 1;
        }

        .stat-indicator {
            height: 4px;
            border-radius: 2px;
            background: #f1f5f9;
            width: 100%;
        }

        .stat-indicator-fill {
            height: 100%;
            border-radius: 2px;
            width: 60%;
        }

        /* Charts Area */
        .charts-grid {
            display: grid;
            grid-template-columns: 3fr 2fr;
            gap: 20px;
        }

        .chart-card {
            background: white;
            border-radius: 20px;
            padding: 24px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }

        .card-title {
            font-size: 18px;
            font-weight: 800;
            margin: 0;
        }

        .card-dropdown {
            background: #f8fafc;
            border: none;
            padding: 6px 12px;
            border-radius: 8px;
            font-family: inherit;
            font-size: 12px;
            font-weight: 600;
            color: var(--text-muted);
        }

        .chart-stats-row {
            display: flex;
            justify-content: space-between;
            margin-top: 10px;
        }

        .c-stat h5 {
            font-size: 11px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin: 0 0 4px 0;
            font-weight: 700;
        }

        .c-stat-val {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 20px;
            font-weight: 800;
        }

        .c-stat-badge {
            background: var(--stat-green-bg);
            color: var(--stat-green);
            font-size: 11px;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: 700;
        }

        .chart-container-large {
            height: 200px;
            width: 100%;
        }

        .chart-container-small {
            height: 120px;
            width: 100%;
            margin-top: 20px;
        }

        /* Assignments Table */
        .assignments-card {
            background: white;
            border-radius: 20px;
            padding: 24px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
        }

        .data-table th {
            text-align: left;
            padding: 12px;
            font-size: 11px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 700;
            border-bottom: 1px solid var(--border-color);
        }

        .data-table td {
            padding: 16px 12px;
            border-bottom: 1px solid #f8fafc;
            vertical-align: middle;
        }

        .task-cell {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .task-icon {
            width: 36px;
            height: 36px;
            background: var(--bg-main);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-dark);
        }

        .task-icon.resolved {
            background: var(--stat-green-bg);
            color: var(--stat-green);
        }

        .task-icon.pending {
            background: var(--bg-main);
            color: inherit;
        }

        .task-info h4 {
            margin: 0 0 4px 0;
            font-size: 14px;
            font-weight: 700;
        }

        .task-info p {
            margin: 0;
            font-size: 11px;
            color: var(--text-muted);
            font-weight: 500;
        }

        .grade-val {
            font-size: 14px;
            font-weight: 800;
            color: var(--text-dark);
        }

        .grade-max {
            color: var(--text-muted);
            font-weight: 600;
        }

        .grade-status {
            font-size: 11px;
            color: var(--text-muted);
            margin-top: 4px;
            display: block;
        }

        .pill-completed {
            background: var(--stat-blue-bg);
            color: var(--stat-blue);
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
            display: inline-block;
        }

        .pill-upcoming {
            background: var(--stat-red-bg);
            color: var(--stat-red);
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
            display: inline-block;
        }

        /* Right Panel - Calendar Widget */
        .calendar-widget {
            background: white;
            border-radius: 20px;
            padding: 24px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
        }

        .cal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            font-weight: 800;
            font-size: 15px;
        }

        .cal-nav {
            color: var(--text-muted);
            cursor: pointer;
        }

        .cal-days {
            display: flex;
            justify-content: space-between;
        }

        .cal-day {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            font-weight: 700;
            color: var(--text-muted);
        }

        .cal-date {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            color: var(--text-dark);
            font-size: 14px;
        }

        .cal-day.active .cal-date {
            background: var(--primary);
            color: white;
        }

        /* Timeline/Events */
        .events-card {
            background: white;
            border-radius: 20px;
            padding: 24px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
            flex: 1;
        }

        .timeline-header {
            display: flex;
            justify-content: space-between;
            font-size: 11px;
            font-weight: 700;
            color: var(--text-muted);
            margin-bottom: 20px;
            padding-left: 50px;
        }

        .timeline-wrap {
            position: relative;
            padding-left: 50px;
        }

        .time-labels {
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
        }

        .time-label {
            height: 40px;
            display: flex;
            align-items: flex-start;
        }

        .timeline-event {
            margin-bottom: 12px;
            border-radius: 20px;
            padding: 8px 16px;
            color: white;
            font-size: 12px;
            font-weight: 600;
            display: inline-block;
            position: relative;
        }

        .timeline-event::before {
            content: '';
            position: absolute;
            left: -20px;
            top: 50%;
            transform: translateY(-50%);
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

        .event-orange {
            background: #f28c68;
            color: white;
            width: 60%;
            margin-left: 10%;
        }

        .event-orange::before {
            color: #f28c68;
        }

        .event-black {
            background: #0f172a;
            color: white;
            width: 50%;
            margin-left: 40%;
        }

        .event-black::before {
            color: #0f172a;
        }

        .event-blue {
            background: #3b82f6;
            color: white;
            width: 50%;
            margin-left: 5%;
        }

        .event-blue::before {
            color: #3b82f6;
        }

        .event-peach {
            background: #fcb5a7;
            color: white;
            width: 40%;
            margin-left: 60%;
        }

        .event-peach::before {
            color: #fcb5a7;
        }

        .event-green {
            background: #6ee7b7;
            color: white;
            width: 45%;
            margin-left: 30%;
            color: #064e3b;
        }

        .event-green::before {
            color: #6ee7b7;
        }


        /* FAB for Ask Anonymously */
        .fab-container {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 100;
        }

        .fab-btn {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: var(--primary);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            box-shadow: 0 10px 25px rgba(79, 70, 229, 0.4);
            cursor: pointer;
            border: none;
            transition: transform 0.2s;
        }

        .fab-btn:hover {
            transform: scale(1.05);
        }

        .ask-modal {
            display: none;
            position: absolute;
            bottom: 80px;
            right: 0;
            width: 350px;
            background: white;
            border-radius: 20px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
            padding: 24px;
            border: 1px solid var(--border-color);
        }

        .ask-modal.active {
            display: block;
            animation: slideUp 0.3s ease;
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .ask-modal h3 {
            margin: 0 0 16px 0;
            font-size: 18px;
            font-weight: 800;
        }

        .ask-input {
            width: 100%;
            background: var(--bg-main);
            border: 1px solid var(--border-color);
            padding: 12px;
            border-radius: 12px;
            margin-bottom: 12px;
            font-family: inherit;
            font-size: 14px;
            outline: none;
        }

        .ask-input:focus {
            border-color: var(--primary);
        }

        .ask-submit {
            width: 100%;
            background: var(--text-dark);
            color: white;
            border: none;
            padding: 12px;
            border-radius: 12px;
            font-weight: 700;
            cursor: pointer;
            font-family: inherit;
        }

        @media (max-width: 1024px) {
            .sidebar {
                display: none;
            }

            .main-content {
                margin-left: 0;
            }

            .dashboard-grid {
                grid-template-columns: 1fr;
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .charts-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>

    <div class="dashboard-layout">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="logo-area"
                style="font-size: 20px; font-weight: 800; display: flex; align-items: center; gap: 8px;">
                <span style="color: var(--text-dark); letter-spacing: -0.5px;">Student Dashboard</span>
            </div>

            <div style="flex: 1;">
                <a href="/dashboard" class="nav-item active">
                    <i class="fas fa-th-large"></i> Dashboard
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <!-- Header -->
            <header class="top-header">
                <div class="greeting-area">
                    <h1>Hello <%= username.split('@')[0] %> 👋</h1>
                    <p>Let's learn something new today!</p>
                </div>

                <div class="header-right">
                    <div class="search-bar">
                        <i class="fas fa-search"></i>
                        <input type="text" placeholder="Search">
                    </div>
                    <div class="notification-btn">
                        <i class="far fa-bell"></i>
                    </div>
                    <!-- Top Right Profile matching "Andreas Iniesta" -->
                    <div class="profile-card">
                        <img src="https://ui-avatars.com/api/?name=<%= username %>&background=0D8ABC&color=fff"
                            alt="User" class="avatar">
                        <div class="profile-info">
                            <h4>
                                <%= username.split('@')[0] %>
                            </h4>
                            <p>College Student</p>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Stats Grid matching the 4 blocks exactly -->
            <div class="card-title" style="margin-bottom: 20px;">Overview</div>
            <div class="stats-grid">
                <!-- 1. Course in Progress (mapped to Peak Score) -->
                <div class="stat-card">
                    <div class="stat-header">
                        <div class="stat-icon" style="background: var(--stat-red);">
                            <i class="fas fa-book-open"></i>
                        </div>
                        <h3 class="stat-title">Peak Score</h3>
                    </div>
                    <h2 class="stat-value">
                        <%= bestScore || 0 %>
                    </h2>
                    <div class="stat-indicator">
                        <div class="stat-indicator-fill" style="background: var(--stat-red);"
                            data-width="<%= Math.min(((bestScore || 0)/60)*100, 100) %>">
                        </div>
                    </div>
                </div>

                <!-- 2. Course Completed (mapped to Attempts) -->
                <div class="stat-card">
                    <div class="stat-header">
                        <div class="stat-icon" style="background: var(--stat-green);">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <h3 class="stat-title">Quizzes Taken</h3>
                    </div>
                    <h2 class="stat-value">
                        <%= totalAttempts %>
                    </h2>
                    <div class="stat-indicator">
                        <div class="stat-indicator-fill" style="background: var(--stat-green);"
                            data-width="<%= Math.min((totalAttempts/50)*100, 100) %>">
                        </div>
                    </div>
                </div>

                <!-- 3. Certificates Earned (mapped to Average Score) -->
                <div class="stat-card">
                    <div class="stat-header">
                        <div class="stat-icon" style="background: var(--stat-blue);">
                            <i class="fas fa-certificate"></i>
                        </div>
                        <h3 class="stat-title">Average Score</h3>
                    </div>
                    <h2 class="stat-value">
                        <%= avgScore || 0 %>
                    </h2>
                    <div class="stat-indicator">
                        <div class="stat-indicator-fill" style="background: var(--stat-blue);"
                            data-width="<%= Math.min(((avgScore || 0)/60)*100, 100) %>">
                        </div>
                    </div>
                </div>

                <!-- 4. Community Support (mapped to Resources) -->
                <div class="stat-card">
                    <div class="stat-header">
                        <div class="stat-icon" style="background: var(--stat-purple);">
                            <i class="fas fa-users"></i>
                        </div>
                        <h3 class="stat-title">Resources Read</h3>
                    </div>
                    <h2 class="stat-value">
                        <%= resources ? resources.length : 0 %>
                    </h2>
                    <div class="stat-indicator">
                        <div class="stat-indicator-fill" style="background: var(--stat-purple); width: 87%;"></div>
                    </div>
                </div>
            </div>

            <!-- Social Learning Feed Snippet (Task 9) -->
            <% if (typeof socialFeed !== 'undefined' && socialFeed.length > 0) { %>
            <div style="margin-bottom: 30px; background: linear-gradient(135deg, #e0e7ff 0%, #ede9fe 100%); border-radius: 16px; padding: 12px 20px; display: flex; align-items: center; gap: 15px; border: 1px solid #c7d2fe;">
                <div style="background: white; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--primary); font-size: 14px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); flex-shrink: 0;">
                    <i class="fas fa-bolt"></i>
                </div>
                <div style="flex: 1; overflow: hidden; white-space: nowrap; font-size: 13px; font-weight: 600; color: #4338ca;">
                    <span style="font-weight: 800; text-transform: uppercase; font-size: 10px; margin-right: 8px; background: white; padding: 2px 6px; border-radius: 4px;">Community</span>
                    <marquee behavior="scroll" direction="left" scrollamount="4" style="vertical-align: middle;">
                        <% socialFeed.forEach((item, i) => { %>
                            <%= item %> &nbsp;&nbsp;&nbsp;&nbsp; • &nbsp;&nbsp;&nbsp;&nbsp;
                        <% }); %>
                    </marquee>
                </div>
            </div>
            <% } %>

            <div class="dashboard-grid">
                <!-- LEFT PANEL -->
                <div class="left-panel">
                    <!-- Charts Row -->
                    <div class="charts-grid">
                        <!-- Bar Chart: Actively Hours -->
                        <div class="chart-card">
                            <div class="card-header">
                                <h3 class="card-title">Score History</h3>
