                // AI Advisor Logic (Task 14 Lite)
                const advisorBtn = document.getElementById('aiAdvisorSubmit');
                const advisorInput = document.getElementById('aiAdvisorInput');
                const advisorResponse = document.getElementById('aiAdvisorResponse');

                advisorBtn.addEventListener('click', async () => {
                    const query = advisorInput.value;
                    if(!query) return;
                    
                    advisorBtn.disabled = true;
                    advisorBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Thinking...';
                    advisorResponse.style.display = 'block';
                    advisorResponse.innerHTML = 'Analyzing your profile and global trends...';

                    try {
                        const res = await fetch('/api/chatbot/ask', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ message: query })
                        });
                        const data = await res.json();
                        advisorResponse.innerHTML = `<div style="line-height: 1.5;">${data.response || data.reply || "I'm sorry, I couldn't process that right now."}</div>`;
                    } catch (e) {
                        advisorResponse.innerHTML = 'Sorry, the AI advisor is currently offline.';
                    }
                    advisorBtn.disabled = false;
                    advisorBtn.innerText = 'Ask AI Assistant';
                });
            });
        </script>