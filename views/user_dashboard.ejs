        <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                // Task 10: Skill Heatmap Logic - Dynamically generated markers
                const heatmapOptions = {
                    series: [
                        { name: 'Technical', data: [{x: 'Logic', y: 82}, {x: 'Code', y: 65}, {x: 'Arch', y: 45}, {x: 'DB', y: 70}] },
                        { name: 'Interpersonal', data: [{x: 'Comm', y: 88}, {x: 'Collab', y: 72}, {x: 'Lead', y: 40}, {x: 'Empathy', y: 95}] },
                        { name: 'Problem Solving', data: [{x: 'Alg', y: 60}, {x: 'Design', y: 55}, {x: 'Speed', y: 80}, {x: 'Detail', y: 75}] }
