<%- include('layouts/header'); %>
    <%- include('layouts/navbar'); %>

        <style>
            @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap');

            :root {
                --glass-bg: rgba(255, 255, 255, 0.7);
                --glass-border: rgba(255, 255, 255, 0.2);
                --glass-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.07);
                --primary: #4f46e5;
            }

            .dark {
                --glass-bg: rgba(15, 23, 42, 0.6);
                --glass-border: rgba(255, 255, 255, 0.05);
                --glass-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
            }

            body {
                font-family: 'Outfit', sans-serif;
                background-color: #f8fafc;
                transition: background-color 0.5s ease;
                color: #1e293b;
            }

            .dark body {
                background-color: #020617;
                color: #f1f5f9;
            }

            .glass-morphism {
                background: var(--glass-bg);
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                border: 1px solid var(--glass-border);
                box-shadow: var(--glass-shadow);
            }

            .gradient-text {
                background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
                -webkit-background-clip: text;
                background-clip: text;
                -webkit-text-fill-color: transparent;
            }

            @keyframes float {
                0% {
                    transform: translateY(0px);
                }

                50% {
                    transform: translateY(-10px);
                }

                100% {
                    transform: translateY(0px);
                }
            }

            .float-animation {
                animation: float 6s ease-in-out infinite;
            }

            @keyframes pulse-soft {

                0%,
                100% {
                    opacity: 1;
                }

                50% {
                    opacity: 0.6;
                }
            }

            .pulse-soft {
                animation: pulse-soft 2s ease-in-out infinite;
            }

            .custom-scrollbar::-webkit-scrollbar {
                width: 6px;
            }

            .custom-scrollbar::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 10px;
            }

            .dark .custom-scrollbar::-webkit-scrollbar-thumb {
                background: #334155;
            }
        </style>

        <div class="min-h-screen pb-20 px-4 md:px-8 pt-24">
            <div class="max-w-7xl mx-auto space-y-10">

                <!-- Hero Header Section -->
                <header
                    class="relative overflow-hidden rounded-[2.5rem] p-8 md:p-12 glass-morphism border-none shadow-2xl">
                    <div class="absolute top-0 right-0 -mr-20 -mt-20 w-80 h-80 bg-indigo-500/10 rounded-full blur-3xl">
                    </div>
                    <div
                        class="absolute bottom-0 left-0 -ml-20 -mb-20 w-80 h-80 bg-purple-500/10 rounded-full blur-3xl">
                    </div>

                    <div class="relative flex flex-col md:flex-row justify-between items-center gap-8">
                        <div class="text-center md:text-left">
                            <div
                                class="inline-flex items-center gap-2 px-4 py-1.5 bg-indigo-100 dark:bg-indigo-900/40 text-indigo-600 dark:text-indigo-400 rounded-full text-xs font-bold mb-4 border border-indigo-200 dark:border-indigo-800">
                                <span class="w-2 h-2 bg-indigo-500 rounded-full pulse-soft"></span>
                                STUDENT DASHBOARD ACTIVE
                            </div>
                            <h1
                                class="text-4xl md:text-5xl font-extrabold text-slate-800 dark:text-white mb-2 leading-tight">
                                Welcome Back, <span class="gradient-text">
                                    <%= user.username %>
                                </span> 👋
                            </h1>
                            <p class="text-slate-500 dark:text-slate-400 font-medium">
                                <i class="fas fa-university mr-2"></i>
                                <%= (profile && profile.collegeName && profile.collegeName !=='N/A' ) ?
                                    profile.collegeName : 'Global Learner' %>
                            </p>
                        </div>

                        <div class="flex flex-col items-center md:items-end gap-4">
                            <div class="glass-morphism p-4 rounded-3xl w-64">
                                <div class="flex justify-between items-center mb-2">
                                    <span class="text-xs font-bold text-slate-500 dark:text-slate-400">Profile
                                        Readiness</span>
                                    <span class="text-indigo-500 font-black">
                                        <%= stats.profileCompletion %>%
                                    </span>
                                </div>
                                <div class="w-full bg-slate-100 dark:bg-slate-800 h-2 rounded-full overflow-hidden">
                                    <div id="profileProgress"
                                        class="h-full bg-gradient-to-r from-indigo-500 to-purple-500 transition-all duration-1000">
                                    </div>
                                </div>
                                <a href="/profile"
                                    class="mt-3 block text-center text-[10px] font-black uppercase tracking-widest text-indigo-500 hover:text-indigo-600 transition-colors">Optimize
                                    Profile →</a>
                            </div>
                            <button id="darkModeToggle"
                                class="p-3 bg-white dark:bg-slate-900 rounded-2xl shadow-sm text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all">
                                <i class="fas fa-sun block dark:hidden"></i>
                                <i class="fas fa-moon hidden dark:block"></i>
                            </button>
                        </div>
                    </div>
                </header>

                <!-- Stats Bar -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div
                        class="glass-morphism rounded-[2rem] p-6 flex items-center gap-6 group hover:scale-[1.02] transition-all duration-300 border-t-4 border-indigo-500">
                        <div
                            class="w-14 h-14 bg-indigo-100 dark:bg-indigo-900/40 text-indigo-600 dark:text-indigo-400 rounded-2xl flex items-center justify-center text-xl shadow-lg border border-indigo-200 dark:border-indigo-800 group-hover:rotate-6 transition-transform">
                            <i class="fas fa-trophy"></i>
                        </div>
                        <div>
                            <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest mb-1">Best Score</h3>
                            <p class="text-3xl font-black dark:text-white">
                                <%= stats.bestScore %><span class="text-sm font-medium text-slate-400 ml-1">/60</span>
                            </p>
                        </div>
                    </div>

                    <div
                        class="glass-morphism rounded-[2rem] p-6 flex items-center gap-6 group hover:scale-[1.02] transition-all duration-300 border-t-4 border-emerald-500">
                        <div
                            class="w-14 h-14 bg-emerald-100 dark:bg-emerald-900/40 text-emerald-600 dark:text-emerald-400 rounded-2xl flex items-center justify-center text-xl shadow-lg border border-emerald-200 dark:border-emerald-800 group-hover:rotate-6 transition-transform">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <div>
                            <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest mb-1">Average Success
                            </h3>
                            <p class="text-3xl font-black dark:text-white">
                                <%= stats.avgScore %><span class="text-sm font-medium text-slate-400 ml-1">%</span>
                            </p>
                        </div>
                    </div>

                    <div
                        class="glass-morphism rounded-[2rem] p-6 flex items-center gap-6 group hover:scale-[1.02] transition-all duration-300 border-t-4 border-amber-500">
                        <div
                            class="w-14 h-14 bg-amber-100 dark:bg-amber-900/40 text-amber-600 dark:text-amber-400 rounded-2xl flex items-center justify-center text-xl shadow-lg border border-amber-200 dark:border-amber-800 group-hover:rotate-6 transition-transform">
                            <i class="fas fa-tasks"></i>
                        </div>
                        <div>
                            <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest mb-1">Total Attempts
                            </h3>
                            <p class="text-3xl font-black dark:text-white">
                                <%= stats.totalAttempts %>
                            </p>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                    <!-- Main Content -->
                    <div class="lg:col-span-2 space-y-10">

                        <!-- Performance Analytics -->
                        <div class="glass-morphism p-8 rounded-[2.5rem] relative overflow-hidden">
                            <div class="flex items-center justify-between mb-8">
                                <div>
                                    <h3 class="text-xl font-bold dark:text-white">Performance Analytics</h3>
                                    <p class="text-xs text-slate-400 mt-1">Timeline of your assessment scores</p>
                                </div>
                                <a href="/smart-quiz"
                                    class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-bold transition-all shadow-lg shadow-indigo-500/20">TAKE
                                    QUIZ</a>
                            </div>
                            <div class="h-80 w-full">
                                <canvas id="scoreChart"></canvas>
                            </div>
                        </div>

                        <!-- Campus Updates -->
                        <div>
                            <div class="flex items-center justify-between mb-8">
                                <div class="flex items-center gap-4">
                                    <div class="h-1 w-12 bg-indigo-500 rounded-full"></div>
                                    <h2 class="text-2xl font-bold text-slate-800 dark:text-white">Campus Updates</h2>
                                </div>
                                <% if(feed.meetings && feed.meetings.length> 0) { %>
                                    <div
                                        class="flex items-center gap-3 px-4 py-2 bg-rose-500/10 text-rose-500 rounded-full border border-rose-500/20 animate-pulse">
                                        <span class="w-2 h-2 bg-rose-500 rounded-full"></span>
                                        <span class="text-xs font-black uppercase tracking-widest">LIVE NOW: <%=
                                                feed.meetings[0].title %></span>
                                        <a href="<%= feed.meetings[0].description %>" target="_blank"
                                            class="text-[10px] font-black bg-rose-500 text-white px-2 py-0.5 rounded-full">JOIN</a>
                                    </div>
                                    <% } %>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <!-- Quizzes -->
                                <div class="glass-morphism p-6 rounded-[2rem] border-t-4 border-amber-500">
                                    <div class="flex justify-between items-center mb-6">
                                        <div
                                            class="w-10 h-10 bg-amber-100 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 rounded-xl flex items-center justify-center">
                                            <i class="fas fa-bolt"></i>
                                        </div>
                                        <span
                                            class="text-[10px] font-black text-amber-500 uppercase tracking-widest">Quizzes</span>
                                    </div>
                                    <div class="space-y-3">
                                        <% if (feed.quizzes && feed.quizzes.length> 0) { %>
                                            <% feed.quizzes.forEach(quiz=> { %>
                                                <div
                                                    class="p-4 bg-white/40 dark:bg-slate-800/40 rounded-2xl border border-white/10 group hover:border-amber-500/50 transition-all">
                                                    <p class="text-sm font-bold dark:text-white mb-1">
                                                        <%= quiz.title %>
                                                    </p>
                                                    <div class="flex justify-between items-center">
                                                        <span class="text-[10px] text-slate-400 italic">
                                                            <%= quiz.description || 'Institutional Assessment' %>
                                                        </span>
                                                        <a href="/smart-quiz"
                                                            class="text-[10px] font-black text-amber-500 uppercase">Attempt
                                                            →</a>
                                                    </div>
                                                </div>
                                                <% }); %>
                                                    <% } else { %>
                                                        <p class="text-center py-8 text-xs text-slate-400 italic">No
                                                            active quizzes.</p>
                                                        <% } %>
                                    </div>
                                </div>

                                <!-- Tasks -->
                                <div class="glass-morphism p-6 rounded-[2rem] border-t-4 border-indigo-500">
                                    <div class="flex justify-between items-center mb-6">
                                        <div
                                            class="w-10 h-10 bg-indigo-100 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400 rounded-xl flex items-center justify-center">
                                            <i class="fas fa-tasks"></i>
                                        </div>
                                        <span
                                            class="text-[10px] font-black text-indigo-500 uppercase tracking-widest">Pending
                                            Tasks</span>
                                    </div>
                                    <div class="space-y-3">
                                        <% if (feed.tasks && feed.tasks.length> 0) { %>
                                            <% feed.tasks.forEach(task=> { %>
                                                <div
                                                    class="p-4 bg-white/40 dark:bg-slate-800/40 rounded-2xl border border-white/10 group hover:border-indigo-500/50 transition-all">
                                                    <p class="text-sm font-bold dark:text-white">
                                                        <%= task.title %>
                                                    </p>
                                                    <p class="text-[10px] text-slate-400 mt-1">Due: <%= task.dueDate %>
                                                    </p>
                                                </div>
                                                <% }); %>
                                                    <% } else { %>
                                                        <p class="text-center py-8 text-xs text-slate-400 italic">No
                                                            pending tasks.</p>
                                                        <% } %>
                                    </div>
                                </div>

                                <!-- Announcements -->
                                <div class="glass-morphism p-6 rounded-[2rem] border-t-4 border-emerald-500">
                                    <div class="flex justify-between items-center mb-6">
                                        <div
                                            class="w-10 h-10 bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 rounded-xl flex items-center justify-center">
                                            <i class="fas fa-bullhorn"></i>
                                        </div>
                                        <span
                                            class="text-[10px] font-black text-emerald-500 uppercase tracking-widest">Notices</span>
                                    </div>
                                    <div class="space-y-3">
                                        <% if (feed.announcements && feed.announcements.length> 0) { %>
                                            <% feed.announcements.forEach(notice=> { %>
                                                <div
                                                    class="p-4 bg-white/40 dark:bg-slate-800/40 rounded-2xl border border-white/10">
                                                    <p class="text-sm font-bold dark:text-white">
                                                        <%= notice.title %>
                                                    </p>
                                                    <p class="text-[10px] text-slate-400 mt-1">
                                                        <%= new Date(notice.createdAt).toLocaleDateString() %>
                                                    </p>
                                                </div>
                                                <% }); %>
                                                    <% } else { %>
                                                        <p class="text-center py-8 text-xs text-slate-400 italic">No new
                                                            notices.</p>
                                                        <% } %>
                                    </div>
                                </div>

                                <!-- Resources -->
                                <div class="glass-morphism p-6 rounded-[2rem] border-t-4 border-cyan-500">
                                    <div class="flex justify-between items-center mb-6">
                                        <div
                                            class="w-10 h-10 bg-cyan-100 dark:bg-cyan-900/30 text-cyan-600 dark:text-cyan-400 rounded-xl flex items-center justify-center">
                                            <i class="fas fa-book-open"></i>
                                        </div>
                                        <span
                                            class="text-[10px] font-black text-cyan-500 uppercase tracking-widest">Resources</span>
                                    </div>
                                    <div class="space-y-3">
                                        <% if (feed.resources && feed.resources.length> 0) { %>
                                            <% feed.resources.forEach(res=> { %>
                                                <div
                                                    class="p-4 bg-white/40 dark:bg-slate-800/40 rounded-2xl border border-white/10 group hover:border-cyan-500/50 transition-all">
                                                    <p class="text-sm font-bold dark:text-white mb-1">
                                                        <%= res.title %>
                                                    </p>
                                                    <p class="text-[10px] text-slate-500 line-clamp-2">
                                                        <%= res.description %>
                                                    </p>
                                                </div>
                                                <% }); %>
                                                    <% } else { %>
                                                        <p class="text-center py-8 text-xs text-slate-400 italic">No
                                                            shared materials.</p>
                                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Sidebar -->
                    <div class="space-y-8">

                        <!-- Doubt Master -->
                        <div class="glass-morphism p-8 rounded-[2.5rem] relative overflow-hidden">
                            <div
                                class="absolute top-0 right-0 -mr-10 -mt-10 w-40 h-40 bg-indigo-500/5 rounded-full blur-2xl">
                            </div>

                            <div class="flex items-center gap-3 mb-8">
                                <div
                                    class="w-10 h-10 bg-indigo-500/10 text-indigo-500 rounded-xl flex items-center justify-center">
                                    <i class="fas fa-comment-dots text-lg"></i>
                                </div>
                                <h3 class="text-lg font-bold dark:text-white">Knowledge Hub</h3>
                            </div>

                            <form action="/ask-doubt" method="POST" class="space-y-4">
                                <div>
                                    <label
                                        class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1 mb-2 block">Consult
                                        Faculty</label>
                                    <select name="teacherId"
                                        class="w-full bg-slate-50 dark:bg-slate-900/50 border-none rounded-xl text-xs p-3 focus:ring-1 focus:ring-indigo-500 dark:text-white transition-all"
                                        required>
                                        <option value="" disabled selected>Select a Teacher</option>
                                        <% feed.teachers.forEach(t=> { %>
                                            <option value="<%= t.userId %>">
                                                <%= t.fullName %>
                                            </option>
                                            <% }); %>
                                    </select>
                                </div>
                                <input type="text" name="title" placeholder="Topic e.g., Calculus Help"
                                    class="w-full bg-slate-50 dark:bg-slate-900/50 border-none rounded-xl text-xs p-3 focus:ring-1 focus:ring-indigo-500 dark:text-white"
                                    required>
                                <textarea name="description" placeholder="Describe your query..."
                                    class="w-full bg-slate-50 dark:bg-slate-900/50 border-none rounded-xl text-xs p-3 focus:ring-1 focus:ring-indigo-500 dark:text-white h-24"
                                    required></textarea>
                                <button type="submit"
                                    class="w-full py-4 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-black uppercase tracking-widest transition-all shadow-xl shadow-indigo-500/20">SEND
                                    QUERY</button>
                            </form>

                            <div
                                class="mt-8 pt-8 border-t border-white/10 space-y-4 max-h-[400px] overflow-y-auto custom-scrollbar">
                                <h4 class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1">My
                                    History</h4>
                                <% if (feed.doubts && feed.doubts.length> 0) { %>
                                    <% feed.doubts.forEach(d=> { %>
                                        <div
                                            class="p-4 rounded-2xl <%= d.status === 'pending' ? 'bg-amber-500/5 border border-amber-500/10' : 'bg-emerald-500/5 border border-emerald-500/10' %>">
                                            <div class="flex justify-between items-start mb-2">
                                                <p class="text-xs font-bold dark:text-white">
                                                    <%= d.title %>
                                                </p>
                                                <span
                                                    class="text-[8px] font-black py-0.5 px-2 rounded-full <%= d.status === 'pending' ? 'bg-amber-500 text-white' : 'bg-emerald-500 text-white' %> uppercase">
                                                    <%= d.status %>
                                                </span>
                                            </div>
                                            <p class="text-[10px] text-slate-500 line-clamp-2">
                                                <%= d.description %>
                                            </p>
                                            <% if(d.status==='answered' ) { %>
                                                <div
                                                    class="mt-3 p-2.5 bg-white/50 dark:bg-slate-900/50 rounded-xl text-[10px] border border-white/20">
                                                    <strong class="text-emerald-500 block mb-1">FACULTY REPLY:</strong>
                                                    <%= d.teacherReply %>
                                                </div>
                                                <% } %>
                                        </div>
                                        <% }); %>
                                            <% } else { %>
                                                <div class="text-center py-10 opacity-30">
                                                    <i class="fas fa-inbox text-3xl mb-2 text-slate-400"></i>
                                                    <p class="text-[10px] font-medium">No queries yet.</p>
                                                </div>
                                                <% } %>
                            </div>
                        </div>

                        <!-- Recent Activity Timeline -->
                        <div class="glass-morphism p-8 rounded-[2.5rem]">
                            <h3 class="font-bold dark:text-white mb-8">Recent Activity</h3>
                            <div class="relative pl-6 border-l-2 border-slate-100 dark:border-slate-800 space-y-8">
                                <% results.slice(-4).reverse().forEach(r=> { %>
                                    <div class="relative">
                                        <div
                                            class="absolute -left-[31px] top-1 w-4 h-4 rounded-full bg-white dark:bg-slate-900 border-2 border-indigo-500">
                                        </div>
                                        <div class="flex justify-between items-start">
                                            <div>
                                                <p class="text-xs font-bold dark:text-white">Assessment Complete</p>
                                                <p class="text-[10px] text-slate-400 mt-0.5">
                                                    <%= new Date(r.date).toLocaleDateString() %>
                                                </p>
                                            </div>
                                            <span class="text-[10px] font-black text-indigo-500">
                                                <%= r.score %> PTS
                                            </span>
                                        </div>
                                    </div>
                                    <% }); %>
                                        <% if(results.length===0) { %>
                                            <p class="text-xs text-slate-400 italic">No activity yet. Start by taking a
                                                quiz!</p>
                                            <% } %>
                            </div>
                            <a href="/smart-quiz"
                                class="mt-8 block py-3 text-center border-2 border-white/20 dark:border-slate-800 rounded-xl text-[10px] font-black uppercase tracking-widest text-slate-500 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-all">VIEW
                                FULL HISTORY</a>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <script>
            document.addEventListener('DOMContentLoaded', () => {
                // Theme Management
                const darkModeToggle = document.getElementById('darkModeToggle');
                const setupDarkMode = () => {
                    const isDark = localStorage.getItem('darkMode') === 'true' ||
                        (!('darkMode' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches);
                    document.documentElement.classList.toggle('dark', isDark);
                };

                darkModeToggle.addEventListener('click', () => {
                    const isDark = document.documentElement.classList.toggle('dark');
                    localStorage.setItem('darkMode', isDark);
                    // Reload to re-sync chart colors if needed (or just update colors dynamically)
                    updateChartColors();
                });
                setupDarkMode();

                // Set Profile Progress
                const profileProgress = document.getElementById('profileProgress');
                if (profileProgress) {
                    profileProgress.style.width = Number('<%= stats.profileCompletion || 0 %>') + '%';
                }

                // Performance Chart
                const ctx = document.getElementById('scoreChart').getContext('2d');
                const dataPoints = JSON.parse('<%- JSON.stringify(results.map(r => r.score)) %>') || [];
                const labels = JSON.parse('<%- JSON.stringify(results.map((r, i) => `Test ${i + 1}`)) %>') || [];

                let scoreChart;

                const updateChartColors = () => {
                    const isDark = document.documentElement.classList.contains('dark');
                    const labelColor = isDark ? '#94a3b8' : '#64748b';
                    const gridColor = isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)';

                    if (scoreChart) {
                        scoreChart.options.scales.x.ticks.color = labelColor;
                        scoreChart.options.scales.y.ticks.color = labelColor;
                        scoreChart.options.scales.y.grid.color = gridColor;
                        scoreChart.update();
                    }
                };

                if (dataPoints.length > 0) {
                    const isDark = document.documentElement.classList.contains('dark');
                    scoreChart = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: labels,
                            datasets: [{
                                label: 'Performance Score',
                                data: dataPoints,
                                borderColor: '#4f46e5',
                                backgroundColor: 'rgba(79, 70, 229, 0.08)',
                                tension: 0.4,
                                fill: true,
                                pointBackgroundColor: '#4f46e5',
                                pointBorderColor: '#fff',
                                pointHoverRadius: 6,
                                pointRadius: 4,
                                borderWidth: 3
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    backgroundColor: isDark ? '#1e293b' : '#fff',
                                    titleColor: isDark ? '#fff' : '#1e293b',
                                    bodyColor: isDark ? '#cbd5e1' : '#64748b',
                                    padding: 12,
                                    borderRadius: 12,
                                    borderColor: 'rgba(0,0,0,0.05)',
                                    borderWidth: 1
                                }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    max: 60,
                                    grid: { color: 'rgba(0,0,0,0.05)', drawBorder: false },
                                    ticks: { color: '#64748b', font: { family: 'Outfit', size: 10 } }
                                },
                                x: {
                                    grid: { display: false },
                                    ticks: { color: '#64748b', font: { family: 'Outfit', size: 10 } }
                                }
                            }
                        }
                    });
                    updateChartColors();
                } else {
                    // Fallback for empty state
                    ctx.font = '14px Outfit';
                    ctx.fillStyle = '#64748b';
                    ctx.textAlign = 'center';
                    ctx.fillText('Complete your first assessment to see analytics.', ctx.canvas.width / 2, ctx.canvas.height / 2);
                }
            });
        </script>

