<%- include('layouts/header'); %>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap');

        :root {
            --primary: #4f46e5;
            --primary-hover: #4338ca;
            --bg-main: #f8fafc;
            --sidebar-bg: #ffffff;
            --text-dark: #0f172a;
            --text-muted: #64748b;
            --border-color: #f1f5f9;

            /* Stats Colors */
            --stat-red: #ef4444;
            --stat-red-bg: #fef2f2;
            --stat-green: #10b981;
            --stat-green-bg: #f0fdf4;
            --stat-blue: #3b82f6;
            --stat-blue-bg: #eff6ff;
            --stat-purple: #8b5cf6;
            --stat-purple-bg: #f5f3ff;
        }

        body {
            font-family: 'Outfit', sans-serif !important;
            background-color: var(--bg-main) !important;
            color: var(--text-dark);
            margin: 0;
        }

        /* Base Layout */
        .dashboard-layout {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar */
        .sidebar {
            width: 250px;
            background: var(--sidebar-bg);
            border-right: 1px solid var(--border-color);
            padding: 30px 20px;
            display: flex;
            flex-direction: column;
            position: fixed;
            height: 100vh;
            left: 0;
            top: 0;
            z-index: 50;
        }

        .logo-area {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 20px;
            font-weight: 800;
            margin-bottom: 40px;
            padding-left: 10px;
        }

        .logo-icon {
            width: 28px;
            height: 28px;
            background: #818cf8;
            border-radius: 8px;
            position: relative;
        }

        .logo-icon::after {
            content: '';
            position: absolute;
            width: 14px;
            height: 14px;
            background: #4f46e5;
            border-radius: 4px;
            bottom: -4px;
            right: -4px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 16px;
            border-radius: 12px;
            text-decoration: none;
            color: var(--text-muted);
            font-weight: 600;
            font-size: 15px;
            margin-bottom: 8px;
            transition: all 0.2s;
        }

        .nav-item:hover {
            background: var(--bg-main);
            color: var(--text-dark);
        }

        .nav-item.active {
            background: var(--primary);
            color: white;
        }

        .nav-item i {
            font-size: 18px;
            width: 20px;
            text-align: center;
        }

        /* Promo Card in Sidebar */
        .promo-card {
            display: none !important;
            margin-top: auto;
            background: #f8fafc;
            border-radius: 20px;
            padding: 24px 16px 16px;
            text-align: center;
            position: relative;
        }

        .promo-illustration {
            position: absolute;
            top: -50px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
        }

        .promo-card h4 {
            font-size: 16px;
            font-weight: 800;
            margin: 30px 0 8px 0;
        }

        .promo-card p {
            font-size: 11px;
            color: var(--text-muted);
            margin-bottom: 16px;
            line-height: 1.4;
        }

        .promo-btn {
            background: var(--primary);
            color: white;
            border: none;
            padding: 10px;
            width: 100%;
            border-radius: 10px;
            font-weight: 700;
            font-size: 13px;
            cursor: pointer;
            font-family: inherit;
        }

        /* Main Content */
        .main-content {
            flex: 1;
            margin-left: 250px;
            padding: 30px 40px;
        }

        /* Top Header */
        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 30px;
        }

        .greeting-area h1 {
            font-size: 28px;
            font-weight: 800;
            margin: 0 0 4px 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .greeting-area p {
            color: var(--text-muted);
            font-size: 14px;
            margin: 0;
            font-weight: 500;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 30px;
        }

        .search-bar {
            display: flex;
            align-items: center;
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 10px 16px;
            width: 250px;
        }

        .search-bar input {
            border: none;
            outline: none;
            background: transparent;
            padding-left: 10px;
            font-size: 14px;
            width: 100%;
            font-family: inherit;
        }

        .search-bar i {
            color: var(--text-muted);
        }

        .notification-btn {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            position: relative;
            cursor: pointer;
        }

        .notification-btn::after {
            content: '';
            position: absolute;
            top: 10px;
            right: 12px;
            width: 6px;
            height: 6px;
            background: var(--stat-purple);
            border-radius: 50%;
        }

        .profile-card {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            object-fit: cover;
            background: #e2e8f0;
        }

        .profile-info h4 {
            margin: 0;
            font-size: 15px;
            font-weight: 700;
        }

        .profile-info p {
            margin: 0;
            font-size: 12px;
            color: var(--text-muted);
            font-weight: 500;
        }

        /* Overview Layout */
        .dashboard-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 30px;
        }

        .left-panel,
        .right-panel {
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        /* Stat Cards */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: white;
            border-radius: 20px;
            padding: 20px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
        }

        .stat-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 16px;
        }

        .stat-icon {
            width: 24px;
            height: 24px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            color: white;
        }

        .stat-title {
            font-size: 12px;
            font-weight: 700;
            margin: 0;
            color: var(--text-dark);
        }

        .stat-value {
            font-size: 32px;
            font-weight: 800;
            margin: 0 0 10px 0;
            line-height: 1;
        }

        .stat-indicator {
            height: 4px;
            border-radius: 2px;
            background: #f1f5f9;
            width: 100%;
        }

        .stat-indicator-fill {
            height: 100%;
            border-radius: 2px;
            width: 60%;
        }

        /* Charts Area */
        .charts-grid {
            display: grid;
            grid-template-columns: 3fr 2fr;
            gap: 20px;
        }

        .chart-card {
            background: white;
            border-radius: 20px;
            padding: 24px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }

        .card-title {
            font-size: 18px;
            font-weight: 800;
            margin: 0;
        }

        .card-dropdown {
            background: #f8fafc;
            border: none;
            padding: 6px 12px;
            border-radius: 8px;
            font-family: inherit;
            font-size: 12px;
            font-weight: 600;
            color: var(--text-muted);
        }

        .chart-stats-row {
            display: flex;
            justify-content: space-between;
            margin-top: 10px;
        }

        .c-stat h5 {
            font-size: 11px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin: 0 0 4px 0;
            font-weight: 700;
        }

        .c-stat-val {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 20px;
            font-weight: 800;
        }

        .c-stat-badge {
            background: var(--stat-green-bg);
            color: var(--stat-green);
            font-size: 11px;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: 700;
        }

        .chart-container-large {
            height: 200px;
            width: 100%;
        }

        .chart-container-small {
            height: 120px;
            width: 100%;
            margin-top: 20px;
        }

        /* Assignments Table */
        .assignments-card {
            background: white;
            border-radius: 20px;
            padding: 24px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
        }

        .data-table th {
            text-align: left;
            padding: 12px;
            font-size: 11px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 700;
            border-bottom: 1px solid var(--border-color);
        }

        .data-table td {
            padding: 16px 12px;
            border-bottom: 1px solid #f8fafc;
            vertical-align: middle;
        }

        .task-cell {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .task-icon {
            width: 36px;
            height: 36px;
            background: var(--bg-main);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-dark);
        }

        .task-icon.resolved {
            background: var(--stat-green-bg);
            color: var(--stat-green);
        }

        .task-icon.pending {
            background: var(--bg-main);
            color: inherit;
        }

        .task-info h4 {
            margin: 0 0 4px 0;
            font-size: 14px;
            font-weight: 700;
        }

        .task-info p {
            margin: 0;
            font-size: 11px;
            color: var(--text-muted);
            font-weight: 500;
        }

        .grade-val {
            font-size: 14px;
            font-weight: 800;
            color: var(--text-dark);
        }

        .grade-max {
            color: var(--text-muted);
            font-weight: 600;
        }

        .grade-status {
            font-size: 11px;
            color: var(--text-muted);
            margin-top: 4px;
            display: block;
        }

        .pill-completed {
            background: var(--stat-blue-bg);
            color: var(--stat-blue);
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
            display: inline-block;
        }

        .pill-upcoming {
            background: var(--stat-red-bg);
            color: var(--stat-red);
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
            display: inline-block;
        }

        /* Right Panel - Calendar Widget */
        .calendar-widget {
            background: white;
            border-radius: 20px;
            padding: 24px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
        }

        .cal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            font-weight: 800;
            font-size: 15px;
        }

        .cal-nav {
            color: var(--text-muted);
            cursor: pointer;
        }

        .cal-days {
            display: flex;
            justify-content: space-between;
        }

        .cal-day {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            font-weight: 700;
            color: var(--text-muted);
        }

        .cal-date {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            color: var(--text-dark);
            font-size: 14px;
        }

        .cal-day.active .cal-date {
            background: var(--primary);
            color: white;
        }

        /* Timeline/Events */
        .events-card {
            background: white;
            border-radius: 20px;
            padding: 24px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
            flex: 1;
        }

        .timeline-header {
            display: flex;
            justify-content: space-between;
            font-size: 11px;
            font-weight: 700;
            color: var(--text-muted);
            margin-bottom: 20px;
            padding-left: 50px;
        }

        .timeline-wrap {
            position: relative;
            padding-left: 50px;
        }

        .time-labels {
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
        }

        .time-label {
            height: 40px;
            display: flex;
            align-items: flex-start;
        }

        .timeline-event {
            margin-bottom: 12px;
            border-radius: 20px;
            padding: 8px 16px;
            color: white;
            font-size: 12px;
            font-weight: 600;
            display: inline-block;
            position: relative;
        }

        .timeline-event::before {
            content: '';
            position: absolute;
            left: -20px;
            top: 50%;
            transform: translateY(-50%);
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

        .event-orange {
            background: #f28c68;
            color: white;
            width: 60%;
            margin-left: 10%;
        }

        .event-orange::before {
            color: #f28c68;
        }

        .event-black {
            background: #0f172a;
            color: white;
            width: 50%;
            margin-left: 40%;
        }

        .event-black::before {
            color: #0f172a;
        }

        .event-blue {
            background: #3b82f6;
            color: white;
            width: 50%;
            margin-left: 5%;
        }

        .event-blue::before {
            color: #3b82f6;
        }

        .event-peach {
            background: #fcb5a7;
            color: white;
            width: 40%;
            margin-left: 60%;
        }

        .event-peach::before {
            color: #fcb5a7;
        }

        .event-green {
            background: #6ee7b7;
            color: white;
            width: 45%;
            margin-left: 30%;
            color: #064e3b;
        }

        .event-green::before {
            color: #6ee7b7;
        }


        /* FAB for Ask Anonymously */
        .fab-container {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 100;
        }

        .fab-btn {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: var(--primary);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            box-shadow: 0 10px 25px rgba(79, 70, 229, 0.4);
            cursor: pointer;
            border: none;
            transition: transform 0.2s;
        }

        .fab-btn:hover {
            transform: scale(1.05);
        }

        .ask-modal {
            display: none;
            position: absolute;
            bottom: 80px;
            right: 0;
            width: 350px;
            background: white;
            border-radius: 20px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
            padding: 24px;
            border: 1px solid var(--border-color);
        }

        .ask-modal.active {
            display: block;
            animation: slideUp 0.3s ease;
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .ask-modal h3 {
            margin: 0 0 16px 0;
            font-size: 18px;
            font-weight: 800;
        }

        .ask-input {
            width: 100%;
            background: var(--bg-main);
            border: 1px solid var(--border-color);
            padding: 12px;
            border-radius: 12px;
            margin-bottom: 12px;
            font-family: inherit;
            font-size: 14px;
            outline: none;
        }

        .ask-input:focus {
            border-color: var(--primary);
        }

        .ask-submit {
            width: 100%;
            background: var(--text-dark);
            color: white;
            border: none;
            padding: 12px;
            border-radius: 12px;
            font-weight: 700;
            cursor: pointer;
            font-family: inherit;
        }

        @media (max-width: 1024px) {
            .sidebar {
                display: none;
            }

            .main-content {
                margin-left: 0;
            }

            .dashboard-grid {
                grid-template-columns: 1fr;
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .charts-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>

    <div class="dashboard-layout">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="logo-area"
                style="font-size: 20px; font-weight: 800; display: flex; align-items: center; gap: 8px;">
                <span style="color: var(--text-dark); letter-spacing: -0.5px;">Student Dashboard</span>
            </div>

            <div style="flex: 1;">
                <a href="/dashboard" class="nav-item active">
                    <i class="fas fa-th-large"></i> Dashboard
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <!-- Header -->
            <header class="top-header">
                <div class="greeting-area">
                    <h1>Hello <%= username.split('@')[0] %> 👋</h1>
                    <p>Let's learn something new today!</p>
                </div>

                <div class="header-right">
                    <div class="search-bar">
                        <i class="fas fa-search"></i>
                        <input type="text" placeholder="Search">
                    </div>
                    <div class="notification-btn">
                        <i class="far fa-bell"></i>
                    </div>
                    <!-- Top Right Profile matching "Andreas Iniesta" -->
                    <div class="profile-card">
                        <img src="https://ui-avatars.com/api/?name=<%= username %>&background=0D8ABC&color=fff"
                            alt="User" class="avatar">
                        <div class="profile-info">
                            <h4>
                                <%= username.split('@')[0] %>
                            </h4>
                            <p>College Student</p>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Stats Grid matching the 4 blocks exactly -->
            <div class="card-title" style="margin-bottom: 20px;">Overview</div>
            <div class="stats-grid">
                <!-- 1. Course in Progress (mapped to Peak Score) -->
                <div class="stat-card">
                    <div class="stat-header">
                        <div class="stat-icon" style="background: var(--stat-red);">
                            <i class="fas fa-book-open"></i>
                        </div>
                        <h3 class="stat-title">Peak Score</h3>
                    </div>
                    <h2 class="stat-value">
                        <%= bestScore || 0 %>
                    </h2>
                    <div class="stat-indicator">
                        <div class="stat-indicator-fill" style="background: var(--stat-red);"
                            data-width="<%= Math.min(((bestScore || 0)/60)*100, 100) %>">
                        </div>
                    </div>
                </div>

                <!-- 2. Course Completed (mapped to Attempts) -->
                <div class="stat-card">
                    <div class="stat-header">
                        <div class="stat-icon" style="background: var(--stat-green);">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <h3 class="stat-title">Quizzes Taken</h3>
                    </div>
                    <h2 class="stat-value">
                        <%= totalAttempts %>
                    </h2>
                    <div class="stat-indicator">
                        <div class="stat-indicator-fill" style="background: var(--stat-green);"
                            data-width="<%= Math.min((totalAttempts/50)*100, 100) %>">
                        </div>
                    </div>
                </div>

                <!-- 3. Certificates Earned (mapped to Average Score) -->
                <div class="stat-card">
                    <div class="stat-header">
                        <div class="stat-icon" style="background: var(--stat-blue);">
                            <i class="fas fa-certificate"></i>
                        </div>
                        <h3 class="stat-title">Average Score</h3>
                    </div>
                    <h2 class="stat-value">
                        <%= avgScore || 0 %>
                    </h2>
                    <div class="stat-indicator">
                        <div class="stat-indicator-fill" style="background: var(--stat-blue);"
                            data-width="<%= Math.min(((avgScore || 0)/60)*100, 100) %>">
                        </div>
                    </div>
                </div>

                <!-- 4. Community Support (mapped to Resources) -->
                <div class="stat-card">
                    <div class="stat-header">
                        <div class="stat-icon" style="background: var(--stat-purple);">
                            <i class="fas fa-users"></i>
                        </div>
                        <h3 class="stat-title">Resources Read</h3>
                    </div>
                    <h2 class="stat-value">
                        <%= resources ? resources.length : 0 %>
                    </h2>
                    <div class="stat-indicator">
                        <div class="stat-indicator-fill" style="background: var(--stat-purple); width: 87%;"></div>
                    </div>
                </div>
            </div>

            <div class="dashboard-grid">
                <!-- LEFT PANEL -->
                <div class="left-panel">
                    <!-- Charts Row -->
                    <div class="charts-grid">
                        <!-- Bar Chart: Actively Hours -->
                        <div class="chart-card">
                            <div class="card-header">
                                <h3 class="card-title">Score History</h3>
                                <button class="card-dropdown">Weekly <i class="fas fa-chevron-down ms-1"></i></button>
                            </div>
                            <div class="chart-container-large">
                                <canvas id="activeHoursChart"></canvas>
                            </div>
                        </div>

                        <!-- Line Chart: Performance -->
                        <div class="chart-card">
                            <div class="card-header">
                                <h3 class="card-title">Performance</h3>
                            </div>
                            <div class="chart-container-small">
                                <canvas id="performanceChart"></canvas>
                            </div>
                            <div class="mt-4" style="margin-top: 20px;">
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <span style="font-size: 24px; font-weight: 800;">
                                        <%= avgScore || 0 %>%
                                    </span>
                                    <span style="font-size: 11px; color: var(--text-muted); line-height: 1.3;">Your
                                        productivity is higher<br>compared to last month</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- My Assignments Table -->
                    <div class="assignments-card">
                        <div class="card-header">
                            <h3 class="card-title">My Assignments</h3>
                        </div>
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>TASK</th>
                                    <th>GRADE</th>
                                    <th>UPDATE</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (typeof teacherUpdates !=='undefined' && teacherUpdates.length> 0) { %>
                                    <% teacherUpdates.forEach((update, index)=> { %>
                                        <tr>
                                            <td>
                                                <div class="task-cell">
                                                    <div class="task-icon">
                                                        <% if(index % 3===0) { %><i class="fas fa-font"></i>
                                                            <% } else if(index % 3===1) { %><i
                                                                    class="fas fa-code-branch"></i>
                                                                <% } else { %><i class="fas fa-paint-brush"></i>
                                                                    <% } %>
                                                    </div>
                                                    <div class="task-info">
                                                        <h4>
                                                            <%= update.title %>
                                                        </h4>
                                                        <p>
                                                            <%= update.type==='task' ? 'Due ' : 'Posted ' %>: <%=
                                                                    update.dueDate || update.date %>
                                                        </p>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="grade-val">--<span class="grade-max">/100</span></div>
                                                <span class="grade-status">Final grade</span>
                                            </td>
                                            <td>
                                                <% if (update.type==='task' ) { %>
                                                    <span class="pill-upcoming">Upcoming</span>
                                                    <% } else { %>
                                                        <span class="pill-completed">Completed</span>
                                                        <% } %>
                                            </td>
                                        </tr>
                                        <% }); %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="3"
                                                        style="text-align: center; color: var(--text-muted); padding: 30px;">
                                                        No active assignments pending! Complete some quizzes.
                                                    </td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Additional Data row: My Doubts mapped here subtly -->
                    <div class="assignments-card">
                        <div class="card-header">
                            <h3 class="card-title">Consultation Inbox</h3>
                        </div>
                        <table class="data-table">
                            <tbody>
                                <% if (myDoubts && myDoubts.length> 0) { %>
                                    <% myDoubts.slice(0,3).forEach(doubt=> { %>
                                        <tr>
                                            <td>
                                                <div class="task-cell">
                                                    <div
                                                        class="task-icon <%= doubt.status === 'resolved' ? 'resolved' : 'pending' %>">
                                                        <i
                                                            class="far <%= doubt.status === 'resolved' ? 'fa-check-circle' : 'fa-question-circle' %>"></i>
                                                    </div>
                                                    <div class="task-info">
                                                        <h4>
                                                            <%= doubt.subject %>
                                                        </h4>
                                                        <p>
                                                            <%= doubt.question %>
                                                        </p>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <% if(doubt.status==='resolved' ){ %>
                                                    <span class="pill-completed">Resolved</span>
                                                    <% } else { %>
                                                        <span class="pill-upcoming">Pending</span>
                                                        <% } %>
                                            </td>
                                        </tr>
                                        <% }); %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="2"
                                                        style="text-align: center; color: var(--text-muted); padding: 30px;">
                                                        Inbox zero. Use the chat button bottom right to ask an
                                                        expert.
                                                    </td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- RIGHT PANEL -->
                <div class="right-panel">
                    <!-- Calendar Widget -->
                    <div class="calendar-widget">
                        <div class="cal-header">
                            <i class="fas fa-chevron-left cal-nav"></i>
                            <span>March 2026</span>
                            <i class="fas fa-chevron-right cal-nav"></i>
                        </div>
                        <div class="cal-days">
                            <div class="cal-day">
                                <span>Fri</span>
                                <div class="cal-date">4</div>
                            </div>
                            <div class="cal-day">
                                <span>Sat</span>
                                <div class="cal-date">5</div>
                            </div>
                            <div class="cal-day">
                                <span>Sun</span>
                                <div class="cal-date">6</div>
                            </div>
                            <div class="cal-day active">
                                <span>Mon</span>
                                <div class="cal-date">7</div>
                            </div>
                            <div class="cal-day">
                                <span>Tue</span>
                                <div class="cal-date">8</div>
                            </div>
                            <div class="cal-day">
                                <span>Wed</span>
                                <div class="cal-date">9</div>
                            </div>
                        </div>
                    </div>

                    <!-- Upcoming Events Timeline -->
                    <div class="events-card">
                        <h3 class="card-title" style="margin-bottom: 30px;">Upcoming Events</h3>

                        <div class="timeline-header">
                            <span>9:30</span>
                            <span>10:30</span>
                            <span>11:30</span>
                            <span>12:30</span>
                            <span>13:30</span>
                        </div>

                        <div class="timeline-wrap">
                            <div class="time-labels">
                                <div class="time-label">Sun</div>
                                <div class="time-label">Mon</div>
                                <div class="time-label">Tue</div>
                                <div class="time-label">Wed</div>
                                <div class="time-label">Thu</div>
                                <div class="time-label">Fri</div>
                                <div class="time-label">Sat</div>
                            </div>

                            <!-- Map live doubtSessions to these blocks, or fallback to visual placeholders if empty -->
                            <div style="height: 280px; position: relative;">
                                <!-- Static visual line for design match -->
                                <div
                                    style="position: absolute; left: 0; top: 180px; bottom: 20px; width: 1px; background: #c7d2fe;">
                                </div>
                                <div
                                    style="position: absolute; left: -3px; top: 180px; width: 7px; height: 7px; border-radius: 50%; background: #4f46e5;">
                                </div>

                                <div
                                    style="display: flex; flex-direction: column; justify-content: space-around; height: 100%;">
                                    <% if (typeof doubtSessions !=='undefined' && doubtSessions.length> 0) { %>
                                        <!-- Dynamic Events mapped to visual classes -->
                                        <% doubtSessions.slice(0, 5).forEach((session, idx)=> {
                                            // Pick a random event class based on index
                                            const classes = ['event-orange', 'event-black', 'event-blue',
                                            'event-peach',
                                            'event-green'];
                                            const evClass = classes[idx % classes.length];
                                            %>
                                            <a href="<%= session.link %>" target="_blank" style="text-decoration:none;">
                                                <div class="timeline-event <%= evClass %>">
                                                    • <%= session.title.substring(0, 15) %>...
                                                </div>
                                            </a>
                                            <% }); %>
                                                <% } else { %>
                                                    <!-- Dummy events purely for design mapping if none exist -->
                                                    <div class="timeline-event event-orange">• Live Session</div>
                                                    <div style="height:20px;"></div>
                                                    <div class="timeline-event event-black">• Illustration</div>
                                                    <div class="timeline-event event-blue">• Research</div>
                                                    <div class="timeline-event event-peach">• Presentation</div>
                                                    <div style="height:20px;"></div>
                                                    <div class="timeline-event event-green">• Report</div>
                                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <!-- Floating Action Button for Ask Anonymously -->
        <div class="fab-container">
            <button class="fab-btn" onclick="document.getElementById('askModal').classList.toggle('active')">
                <i class="far fa-comment-dots"></i>
            </button>

            <div id="askModal" class="ask-modal">
                <h3>Ask Anonymously</h3>
                <p style="font-size: 13px; color: var(--text-muted); margin-bottom: 20px;">Drop your doubt to our
                    experts, hidden identity guaranteed.</p>
                <form action="/submitDoubt" method="POST">
                    <input type="text" name="subject" class="ask-input" placeholder="Question Subject" required>
                    <textarea name="question" class="ask-input" placeholder="Describe your doubt here..." rows="4"
                        required style="resize: none;"></textarea>
                    <button type="submit" class="ask-submit">Send Securely</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Scripts for Charts -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script id="chart-data" type="application/json">
    <%- JSON.stringify(results || []) %>
</script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Apply widths to stat indicators
            document.querySelectorAll('.stat-indicator-fill').forEach(el => {
                if (el.dataset.width) el.style.width = el.dataset.width + '%';
            });

            // Chart Data Parsing
            const resultsRawText = document.getElementById('chart-data').textContent;
            const resultsRaw = resultsRawText ? JSON.parse(resultsRawText) : [];

            // Use real backend data or fallback dummy data to match the UI visual exactly
            const dataPoints = resultsRaw.length > 0 ? resultsRaw.map(r => r.score) : [2, 5, 3, 7, 4, 3, 5];
            const labels = resultsRaw.length > 0 ? resultsRaw.map((_, i) => 'T' + (i + 1)) : ['S', 'M', 'T', 'W', 'T', 'F', 'S'];

            // 1. Bar Chart (Actively Hours equivalent mapping)
            const ctxBar = document.getElementById('activeHoursChart').getContext('2d');
            const gradientBar = ctxBar.createLinearGradient(0, 0, 0, 200);
            gradientBar.addColorStop(0, '#6366f1');   // Indigo
            gradientBar.addColorStop(1, '#a5b4fc');   // Light Indigo

            new Chart(ctxBar, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Scores',
                        data: dataPoints,
                        backgroundColor: gradientBar,
                        borderRadius: 8,
                        barPercentage: 0.5,
                        categoryPercentage: 0.6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: {
                            grid: { display: false },
                            border: { display: false },
                            ticks: { font: { family: 'Outfit', size: 12, weight: 600 }, color: '#94a3b8' }
                        },
                        y: {
                            beginAtZero: true,
                            grid: { borderDash: [4, 4], color: '#f1f5f9' },
                            border: { display: false },
                            ticks: { font: { family: 'Outfit', size: 12, weight: 600 }, color: '#94a3b8', stepSize: 2 }
                        }
                    }
                }
            });

            // 2. Line Chart (Performance)
            const ctxLine = document.getElementById('performanceChart').getContext('2d');
            const secondaryData = dataPoints.map(v => v * 0.8 + 1); // Fake 2nd line for visual flair

            new Chart(ctxLine, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            data: dataPoints,
                            borderColor: '#6366f1',
                            borderWidth: 2,
                            tension: 0.4,
                            pointRadius: 0
                        },
                        {
                            data: secondaryData,
                            borderColor: '#94a3b8',
                            borderWidth: 2,
                            tension: 0.4,
                            borderDash: [5, 5],
                            pointRadius: 0
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: {
                            display: true,
                            grid: { display: false },
                            border: { display: false },
                            ticks: { font: { family: 'Outfit', size: 10, weight: 600 }, color: '#94a3b8' }
                        },
                        y: {
                            display: false
                        }
                    }
                }
            });
        });
    </script>

    <%- include('layouts/footer'); %>