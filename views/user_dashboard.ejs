                <input type="text" id="aiAdvisorInput" class="ask-input" placeholder="How do I improve my logic scores?" style="margin-bottom: 10px;">
                <button type="button" id="aiAdvisorSubmit" class="ask-submit" style="background: var(--primary);">Ask AI Assistant</button>
