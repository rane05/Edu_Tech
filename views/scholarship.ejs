<%- include('layouts/header'); -%>

    <body
        class="bg-[#f8fafc] text-slate-800 font-sans antialiased overflow-x-hidden selection:bg-indigo-500 selection:text-white relative">

        <!-- Animated SVG Noise Texture Overlay -->
        <div class="fixed inset-0 z-0 opacity-[0.03] pointer-events-none"
            style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');">
        </div>

        <!-- Soft Mesh Gradient Blobs -->
        <div class="fixed top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none">
            <div
                class="absolute -top-[10%] -left-[10%] w-[50%] h-[50%] rounded-full bg-indigo-300 blur-[120px] opacity-30 animate-[float_10s_infinite_ease-in-out]">
            </div>
            <div
                class="absolute top-[20%] -right-[10%] w-[40%] h-[60%] rounded-full bg-blue-300 blur-[120px] opacity-20 animate-[float-delay_12s_infinite_ease-in-out]">
            </div>
            <div
                class="absolute -bottom-[20%] left-[20%] w-[60%] h-[50%] rounded-full bg-teal-200 blur-[150px] opacity-20 animate-[float_14s_infinite_ease-in-out]">
            </div>
        </div>

        <%- include('layouts/navbar'); -%>

            <style>
                /* Modern Micro-animations & Aesthetics */
                @keyframes float {

                    0%,
                    100% {
                        transform: translateY(0) scale(1);
                    }

                    50% {
                        transform: translateY(-20px) scale(1.05);
                    }
                }

                @keyframes float-delay {

                    0%,
                    100% {
                        transform: translateY(0) scale(1);
                    }

                    50% {
                        transform: translateY(20px) scale(0.95);
                    }
                }

                @keyframes fade-in-up {
                    0% {
                        opacity: 0;
                        transform: translateY(30px) scale(0.98);
                    }

                    100% {
                        opacity: 1;
                        transform: translateY(0) scale(1);
                    }
                }

                @keyframes shine {
                    0% {
                        left: -100%;
                    }

                    100% {
                        left: 200%;
                    }
                }

                .animate-fade-in-up {
                    animation: fade-in-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
                }

                /* Glass / Premium Container */
                .glass-card {
                    background: rgba(255, 255, 255, 0.82);
                    backdrop-filter: blur(20px);
                    -webkit-backdrop-filter: blur(20px);
                    border: 1px solid rgba(255, 255, 255, 1);
                    box-shadow:
                        0 4px 6px -1px rgba(0, 0, 0, 0.05),
                        0 20px 40px -10px rgba(99, 102, 241, 0.1),
                        inset 0 1px 0 rgba(255, 255, 255, 1);
                    border-radius: 32px;
                    transition: transform 0.4s cubic-bezier(0.3, 0.8, 0.2, 1), box-shadow 0.4s ease;
                }

                .glass-card:hover {
                    transform: translateY(-4px);
                    box-shadow:
                        0 10px 15px -3px rgba(0, 0, 0, 0.05),
                        0 30px 60px -15px rgba(99, 102, 241, 0.15),
                        inset 0 1px 0 rgba(255, 255, 255, 1);
                }

                /* Custom Input Restyling */
                .custom-select-wrapper {
                    position: relative;
                }

                .custom-select-wrapper i {
                    position: absolute;
                    left: 18px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: #94a3b8;
                    pointer-events: none;
                    transition: color 0.2s ease;
                    font-size: 1.1rem;
                }

                .custom-select:focus+i,
                .custom-select-wrapper:focus-within i {
                    color: #4f46e5;
                }

                .custom-select {
                    appearance: none;
                    width: 100%;
                    background-color: #ffffff;
                    border: 1px solid #e2e8f0;
                    border-radius: 16px;
                    padding: 16px 44px 16px 50px;
                    /* space for icon on left, chevron on right */
                    font-size: 0.95rem;
                    color: #1e293b;
                    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
                    transition: all 0.2s ease;
                    cursor: pointer;
                    font-weight: 500;
                }

                .custom-select:hover {
                    border-color: #cbd5e1;
                    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.03);
                    transform: translateY(-1px);
                }

                .custom-select:focus {
                    outline: none;
                    border-color: #6366f1;
                    box-shadow: 0 4px 14px 0 rgba(99, 102, 241, 0.2), inset 0 0 0 1px #6366f1;
                    transform: scale(1.01);
                    background-color: #ffffff;
                }

                /* Custom Chevron down */
                .custom-select-wrapper::after {
                    content: '\f107';
                    /* FontAwesome chevron-down */
                    font-family: 'Font Awesome 5 Free', 'Font Awesome 6 Free';
                    font-weight: 900;
                    position: absolute;
                    right: 20px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: #94a3b8;
                    pointer-events: none;
                    font-size: 0.9rem;
                }

                /* Button Enhancements */
                .btn-premium {
                    position: relative;
                    overflow: hidden;
                    background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);
                    border: none;
                    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                }

                .btn-premium::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: -100%;
                    width: 50%;
                    height: 100%;
                    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
                    transform: skewX(-20deg);
                }

                .btn-premium:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 14px 28px -5px rgba(79, 70, 229, 0.4);
                }

                .btn-premium:hover::before {
                    animation: shine 1.5s ease-out;
                }

                .btn-premium:active {
                    transform: translateY(1px) scale(0.98);
                }

                /* Custom Header Underline */
                .title-underline {
                    position: relative;
                    display: inline-block;
                }

                .title-underline::after {
                    content: '';
                    position: absolute;
                    bottom: -6px;
                    left: 50%;
                    transform: translateX(-50%);
                    width: 40px;
                    height: 4px;
                    background: #4f46e5;
                    border-radius: 2px;
                    transition: width 0.3s ease;
                }

                .title-underline:hover::after {
                    width: 100%;
                }
            </style>

            <div class="min-h-screen pt-36 pb-20 px-4 sm:px-6 lg:px-8 flex items-center justify-center -mt-6">

                <div class="w-full max-w-4xl glass-card opacity-0 animate-fade-in-up relative z-10">

                    <!-- Header Section -->
                    <div class="text-center pt-14 pb-10 px-6 border-b border-indigo-50/50 relative">
                        <!-- Eyebrow text -->
                        <span
                            class="inline-block py-1.5 px-4 rounded-full bg-indigo-50/80 border border-indigo-100/50 text-indigo-600 text-[11px] font-bold uppercase tracking-widest mb-6 shadow-sm backdrop-blur-sm">
                            <i class="fas fa-search-dollar mr-1.5"></i> Financial Aid Finder
                        </span>

                        <h1
                            class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-5 title-underline">
                            Discover Scholarships
                        </h1>

                        <p class="text-slate-500 text-[17px] max-w-2xl mx-auto font-medium leading-relaxed">
                            Uncover funding opportunities expertly tailored to your background, education, and location.
                            Let's invest in your future.
                        </p>
                    </div>

                    <!-- Form Body -->
                    <div class="p-8 md:p-12">
                        <form action="/scholarship_res" method="get"
                            class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-8">

                            <!-- Caste Category -->
                            <div class="space-y-2.5">
                                <label for="casteCategory" class="block text-sm font-bold text-slate-700 ml-2">Caste
                                    Category</label>
                                <div class="custom-select-wrapper">
                                    <select name="casteCategory" id="casteCategory" class="custom-select" required>
                                        <option value="" disabled selected hidden>Select a caste category</option>
                                        <option value="All">All</option>
                                        <option value="General">General</option>
                                        <option value="SC">Scheduled Caste (SC)</option>
                                        <option value="ST">Scheduled Tribe (ST)</option>
                                        <option value="OBC">Other Backward Classes (OBC)</option>
                                        <option value="EWS">Economically Weaker Sections (EWS)</option>
                                        <option value="VJNT">Vimukta Jati and Nomadic Tribes (VJNT)</option>
                                        <option value="NT">Nomadic Tribes (NT)</option>
                                        <option value="SEBC">Socially and Educationally Backward Classes (SEBC)</option>
                                        <option value="SBC">Special Backward Classes (SBC)</option>
                                        <option value="Minority">Minority Communities (Muslim, Sikh, etc.)</option>
                                        <option value="PwD">Persons with Disabilities (PwD)</option>
                                    </select>
                                    <i class="fas fa-users"></i>
                                </div>
                            </div>

                            <!-- Current Education -->
                            <div class="space-y-2.5">
                                <label for="currentEducation"
                                    class="block text-sm font-bold text-slate-700 ml-2">Current Education</label>
                                <div class="custom-select-wrapper">
                                    <select name="currentEducation" id="currentEducation" class="custom-select"
                                        required>
                                        <option value="" disabled selected hidden>Select Current Education</option>
                                        <option value="Primary School">Primary School</option>
                                        <option value="Middle School">Middle School</option>
                                        <option value="High School">High School</option>
                                        <option value="Higher Secondary">Higher Secondary (Class 11-12)</option>
                                        <option value="Diploma">Diploma</option>
                                        <option value="Undergraduate">Undergraduate</option>
                                        <option value="Postgraduate">Postgraduate</option>
                                        <option value="Doctorate">Doctorate (PhD)</option>
                                        <option value="Post-Doctorate">Post-Doctorate</option>
                                        <option value="Vocational Training">Vocational Training</option>
                                        <option value="Professional Certification">Professional Certification</option>
                                    </select>
                                    <i class="fas fa-graduation-cap"></i>
                                </div>
                            </div>

                            <!-- Courses -->
                            <div class="space-y-2.5">
                                <label for="course" class="block text-sm font-bold text-slate-700 ml-2">Course
                                    Stream</label>
                                <div class="custom-select-wrapper">
                                    <select name="course" id="course" class="custom-select" required>
                                        <option value="" disabled selected hidden>Select a Course</option>
                                    </select>
                                    <i class="fas fa-book-open"></i>
                                </div>
                            </div>

                            <!-- State -->
                            <div class="space-y-2.5">
                                <label for="state" class="block text-sm font-bold text-slate-700 ml-2">State /
                                    Region</label>
                                <div class="custom-select-wrapper">
                                    <select name="state" id="state" class="custom-select" required>
                                        <option value="" disabled selected hidden>Select a State</option>
                                        <option value="Andhra Pradesh">Andhra Pradesh</option>
                                        <option value="Arunachal Pradesh">Arunachal Pradesh</option>
                                        <option value="Assam">Assam</option>
                                        <option value="Bihar">Bihar</option>
                                        <option value="Chhattisgarh">Chhattisgarh</option>
                                        <option value="Delhi">Delhi</option>
                                        <option value="Goa">Goa</option>
                                        <option value="Gujarat">Gujarat</option>
                                        <option value="Haryana">Haryana</option>
                                        <option value="Himachal Pradesh">Himachal Pradesh</option>
                                        <option value="Jharkhand">Jharkhand</option>
                                        <option value="Karnataka">Karnataka</option>
                                        <option value="Kerala">Kerala</option>
                                        <option value="Madhya Pradesh">Madhya Pradesh</option>
                                        <option value="Maharashtra">Maharashtra</option>
                                        <option value="Manipur">Manipur</option>
                                        <option value="Meghalaya">Meghalaya</option>
                                        <option value="Mizoram">Mizoram</option>
                                        <option value="Nagaland">Nagaland</option>
                                        <option value="Odisha">Odisha</option>
                                        <option value="Punjab">Punjab</option>
                                        <option value="Rajasthan">Rajasthan</option>
                                        <option value="Sikkim">Sikkim</option>
                                        <option value="Tamil Nadu">Tamil Nadu</option>
                                        <option value="Telangana">Telangana</option>
                                        <option value="Tripura">Tripura</option>
                                        <option value="Uttar Pradesh">Uttar Pradesh</option>
                                        <option value="Uttarakhand">Uttarakhand</option>
                                        <option value="West Bengal">West Bengal</option>
                                    </select>
                                    <i class="fas fa-map-marker-alt"></i>
                                </div>
                            </div>

                            <!-- University -->
                            <div class="space-y-2.5 md:col-span-2">
                                <label for="university" class="block text-sm font-bold text-slate-700 ml-2">University /
                                    Board</label>
                                <div class="custom-select-wrapper">
                                    <select name="university" id="university" class="custom-select" required>
                                        <option value="" disabled selected hidden>Select a University</option>
                                    </select>
                                    <i class="fas fa-university"></i>
                                </div>
                            </div>

                            <!-- Submit Button Area -->
                            <div class="md:col-span-2 pt-8 flex justify-center border-t border-slate-100 mt-4 relative">
                                <!-- Abstract decorative circle behind button -->
                                <div
                                    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 bg-indigo-300 rounded-full blur-3xl opacity-20 pointer-events-none">
                                </div>

                                <button type="submit"
                                    class="btn-premium px-12 py-4 rounded-xl text-white font-bold tracking-wide text-lg shadow-lg w-full md:w-auto min-w-[320px] flex justify-center items-center gap-3">
                                    <span>Find Scholarships</span>
                                    <i
                                        class="fas fa-arrow-right text-sm group-hover:translate-x-1 transition-transform"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <%- include('layouts/footer'); -%>

                <script>
                    // Populate courses based on current education
                    const educationDropdown = document.getElementById('currentEducation');
                    const courseDropdown = document.getElementById('course');

                    educationDropdown.addEventListener('change', function () {
                        const education = this.value;
                        courseDropdown.innerHTML = ''; // Clear previous courses

                        let courses = [];
                        if (education === 'Primary School') {
                            courses = ['General Studies'];
                        } else if (education === 'Middle School') {
                            courses = ['General Studies'];
                        } else if (education === 'High School') {
                            courses = ['Science', 'Commerce', 'Arts'];
                        } else if (education === 'Higher Secondary') {
                            courses = ['Physics, Chemistry, Biology (PCB)', 'Physics, Chemistry, Mathematics (PCM)', 'Commerce', 'Humanities', 'Vocational Studies'];
                        } else if (education === 'Diploma') {
                            courses = ['Diploma in Engineering', 'Diploma in Pharmacy', 'Diploma in Business Management', 'Diploma in Hotel Management', 'Diploma in Education'];
                        } else if (education === 'Undergraduate') {
                            courses = ['B.Tech', 'B.Sc', 'B.Com', 'BA', 'BBA', 'BCA', 'LLB', 'MBBS', 'BDS', 'B.Arch', 'B.Pharm', 'B.Ed'];
                        } else if (education === 'Postgraduate') {
                            courses = ['M.Tech', 'M.Sc', 'MBA', 'MA', 'M.Com', 'MCA', 'LLM', 'MD', 'MDS', 'M.Arch', 'M.Pharm', 'M.Ed'];
                        } else if (education === 'Doctorate') {
                            courses = ['PhD in Engineering', 'PhD in Science', 'PhD in Humanities', 'PhD in Law', 'PhD in Management', 'PhD in Medicine'];
                        } else if (education === 'Post-Doctorate') {
                            courses = ['Post-Doctoral Fellowship in Science', 'Post-Doctoral Fellowship in Engineering', 'Post-Doctoral Fellowship in Social Sciences', 'Post-Doctoral Fellowship in Medicine'];
                        } else if (education === 'Vocational Training') {
                            courses = ['Automobile Engineering', 'Computer Hardware and Networking', 'Plumbing', 'Electrician', 'Beauty and Wellness', 'Culinary Arts'];
                        } else if (education === 'Professional Certification') {
                            courses = ['Project Management', 'Data Science', 'Cybersecurity', 'Digital Marketing', 'Graphic Design', 'AI and Machine Learning'];
                        }

                        // Populate courses
                        courses.forEach(course => {
                            const option = document.createElement('option');
                            option.value = course;
                            option.textContent = course;
                            courseDropdown.appendChild(option);
                        });
                    });

                    // Populate universities based on state
                    const stateDropdown = document.getElementById('state');
                    const universityDropdown = document.getElementById('university');

