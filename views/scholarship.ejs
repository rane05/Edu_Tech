<%- include('layouts/header'); -%>

    <style>
        :root {
            --bg-color: #FFFDF6;
            --primary-accent: #FFE66D;
            --secondary-accent: #F4D03F;
            --text-main: #1F2937;
            --text-muted: #6B7280;
            --card-bg: #FFFFFF;
            --border-color: #F2E8C9;
            --focus-ring: rgba(244, 208, 63, 0.2);
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
            position: relative;
        }

        /* Subtle top radial gradient */
        .bg-gradient-top {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 600px;
            background: radial-gradient(circle at 50% -20%, rgba(255, 230, 109, 0.15), transparent 70%);
            pointer-events: none;
            z-index: -1;
        }

        /* Page Layout Container */
        .page-container {
            max-width: 900px;
            margin: 0 auto;
            padding: 60px 24px 100px;
        }

        /* Header */
        .page-header {
            margin-bottom: 40px;
            position: relative;
        }

        .page-title {
            font-size: 2.25rem;
            font-weight: 700;
            color: var(--text-main);
            letter-spacing: -0.02em;
            margin-bottom: 8px;
        }

        .page-subtitle {
            font-size: 1.05rem;
            color: var(--text-muted);
            max-width: 600px;
            line-height: 1.5;
        }

        /* Form Container */
        .workspace-form {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
            overflow: hidden;
        }

        .form-workspace-body {
            padding: 32px 40px;
        }

        /* Section styling */
        .form-section {
            margin-bottom: 32px;
        }

        .form-section:last-child {
            margin-bottom: 0;
        }

        .section-header {
            font-size: 0.875rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            margin-bottom: 20px;
            padding-bottom: 8px;
            border-bottom: 1px solid #F3F4F6;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Grid layout */
        .input-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 24px;
        }

        @media (min-width: 768px) {
            .input-grid {
                grid-template-columns: 1fr 1fr;
                gap: 24px 32px;
            }
        }

        /* Inputs */
        .input-group {
            display: flex;
            flex-direction: column;
        }

        .input-label {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-main);
            margin-bottom: 8px;
        }

        .input-wrapper {
            position: relative;
        }

        .input-wrapper i.icon-left {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #9CA3AF;
            font-size: 1rem;
            transition: color 0.2s ease;
            pointer-events: none;
        }

        .input-wrapper::after {
            content: '\f107';
            font-family: 'Font Awesome 5 Free', 'Font Awesome 6 Free';
            font-weight: 900;
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #9CA3AF;
            pointer-events: none;
            font-size: 0.8rem;
            transition: transform 0.2s ease;
        }

        .custom-select {
            appearance: none;
            width: 100%;
            background-color: #FFFFFF;
            border: 1px solid #E5E7EB;
            border-radius: 8px;
            padding: 12px 36px 12px 40px;
            font-size: 0.95rem;
            color: var(--text-main);
            transition: all 0.2s ease;
            cursor: pointer;
            font-family: inherit;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.01);
        }

        .custom-select:hover {
            border-color: #D1D5DB;
        }

        .custom-select:focus {
            outline: none;
            border-color: var(--secondary-accent);
            box-shadow: 0 0 0 4px var(--focus-ring);
        }

        .custom-select:focus+i.icon-left,
        .input-wrapper:focus-within i.icon-left {
            color: var(--secondary-accent);
        }

        .custom-select:focus~.input-wrapper::after,
        .input-wrapper:focus-within::after {
            transform: translateY(-50%) rotate(180deg);
        }

        /* Footer and Button */
        .form-footer {
            background-color: #FAFAFA;
            border-top: 1px solid var(--border-color);
            padding: 24px 40px;
            display: flex;
            justify-content: flex-end;
            align-items: center;
        }

        .btn-primary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: linear-gradient(135deg, var(--primary-accent), var(--secondary-accent));
            color: var(--text-main);
            font-weight: 600;
            font-size: 0.95rem;
            padding: 12px 28px;
            border-radius: 8px;
            border: 1px solid rgba(0, 0, 0, 0.05);
            cursor: pointer;
            box-shadow: 0 2px 4px rgba(244, 208, 63, 0.15);
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            text-decoration: none;
        }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(244, 208, 63, 0.25);
        }

        .btn-primary i.fa-arrow-right {
            transition: transform 0.2s ease;
            font-size: 0.85rem;
        }

        .btn-primary:hover i.fa-arrow-right {
            transform: translateX(4px);
        }

        .btn-primary:active {
            transform: translateY(0);
            box-shadow: 0 2px 4px rgba(244, 208, 63, 0.15);
        }
    </style>

    <%- include('layouts/navbar'); -%>

        <main style="padding-top: 80px;">
            <!-- Background Gradient Setup -->
            <div class="bg-gradient-top"></div>

            <div class="page-container">
                <!-- Header -->
                <header class="page-header">
                    <h1 class="page-title">Discover Scholarships</h1>
                    <p class="page-subtitle">Find scholarships tailored to your education background.</p>
                </header>

                <!-- Main Form Workspace -->
                <form action="/scholarship_res" method="get" class="workspace-form">
                    <div class="form-workspace-body">

                        <!-- Section 1 -->
                        <div class="form-section">
                            <div class="section-header">Category and Eligibility</div>
                            <div class="input-grid" style="grid-template-columns: 1fr;">
                                <!-- Override for single item or span across columns if needed. But user requested two column for everything. We will make it 2-col or span 2 -->
                                <div class="input-group">
                                    <label for="casteCategory" class="input-label">Caste Category</label>
                                    <div class="input-wrapper">
                                        <i class="fas fa-users icon-left"></i>
                                        <select name="casteCategory" id="casteCategory" class="custom-select" required>
                                            <option value="" disabled selected hidden>Select your category</option>
                                            <option value="All">All</option>
                                            <option value="General">General</option>
                                            <option value="SC">Scheduled Caste (SC)</option>
                                            <option value="ST">Scheduled Tribe (ST)</option>
                                            <option value="OBC">Other Backward Classes (OBC)</option>
                                            <option value="EWS">Economically Weaker Sections (EWS)</option>
                                            <option value="VJNT">Vimukta Jati and Nomadic Tribes (VJNT)</option>
                                            <option value="NT">Nomadic Tribes (NT)</option>
                                            <option value="SEBC">Socially and Educationally Backward Classes (SEBC)
                                            </option>
                                            <option value="SBC">Special Backward Classes (SBC)</option>
                                            <option value="Minority">Minority Communities (Muslim, Sikh, etc.)</option>
                                            <option value="PwD">Persons with Disabilities (PwD)</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Section 2 -->
                        <div class="form-section">
                            <div class="section-header">Education Details</div>
                            <div class="input-grid">
                                <div class="input-group">
                                    <label for="currentEducation" class="input-label">Current Education</label>
                                    <div class="input-wrapper">
                                        <i class="fas fa-school icon-left"></i>
                                        <select name="currentEducation" id="currentEducation" class="custom-select"
                                            required>
                                            <option value="" disabled selected hidden>Select current education</option>
                                            <option value="Primary School">Primary School</option>
                                            <option value="Middle School">Middle School</option>
                                            <option value="High School">High School</option>
                                            <option value="Higher Secondary">Higher Secondary (Class 11-12)</option>
                                            <option value="Diploma">Diploma</option>
                                            <option value="Undergraduate">Undergraduate</option>
                                            <option value="Postgraduate">Postgraduate</option>
                                            <option value="Doctorate">Doctorate (PhD)</option>
                                            <option value="Post-Doctorate">Post-Doctorate</option>
                                            <option value="Vocational Training">Vocational Training</option>
                                            <option value="Professional Certification">Professional Certification
                                            </option>
                                        </select>
                                    </div>
                                </div>
                                <div class="input-group">
                                    <label for="course" class="input-label">Course Stream</label>
                                    <div class="input-wrapper">
                                        <i class="fas fa-book-open icon-left"></i>
                                        <select name="course" id="course" class="custom-select" required>
                                            <option value="" disabled selected hidden>Select course stream</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Section 3 -->
                        <div class="form-section">
                            <div class="section-header">Institution Location</div>
                            <div class="input-grid">
                                <div class="input-group">
                                    <label for="state" class="input-label">State / Region</label>
                                    <div class="input-wrapper">
                                        <i class="fas fa-map icon-left"></i>
                                        <select name="state" id="state" class="custom-select" required>
                                            <option value="" disabled selected hidden>Select state or region</option>
                                            <option value="Andhra Pradesh">Andhra Pradesh</option>
                                            <option value="Arunachal Pradesh">Arunachal Pradesh</option>
                                            <option value="Assam">Assam</option>
                                            <option value="Bihar">Bihar</option>
                                            <option value="Chhattisgarh">Chhattisgarh</option>
                                            <option value="Delhi">Delhi</option>
                                            <option value="Goa">Goa</option>
                                            <option value="Gujarat">Gujarat</option>
                                            <option value="Haryana">Haryana</option>
                                            <option value="Himachal Pradesh">Himachal Pradesh</option>
                                            <option value="Jharkhand">Jharkhand</option>
                                            <option value="Karnataka">Karnataka</option>
                                            <option value="Kerala">Kerala</option>
                                            <option value="Madhya Pradesh">Madhya Pradesh</option>
                                            <option value="Maharashtra">Maharashtra</option>
                                            <option value="Manipur">Manipur</option>
                                            <option value="Meghalaya">Meghalaya</option>
                                            <option value="Mizoram">Mizoram</option>
                                            <option value="Nagaland">Nagaland</option>
                                            <option value="Odisha">Odisha</option>
                                            <option value="Punjab">Punjab</option>
                                            <option value="Rajasthan">Rajasthan</option>
                                            <option value="Sikkim">Sikkim</option>
                                            <option value="Tamil Nadu">Tamil Nadu</option>
                                            <option value="Telangana">Telangana</option>
                                            <option value="Tripura">Tripura</option>
                                            <option value="Uttar Pradesh">Uttar Pradesh</option>
                                            <option value="Uttarakhand">Uttarakhand</option>
                                            <option value="West Bengal">West Bengal</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="input-group">
                                    <label for="university" class="input-label">University / Board</label>
                                    <div class="input-wrapper">
                                        <i class="fas fa-university icon-left"></i>
                                        <select name="university" id="university" class="custom-select" required>
                                            <option value="" disabled selected hidden>Select university</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Button anchored at bottom -->
                    <div class="form-footer">
                        <button type="submit" class="btn-primary">
                            Find Scholarships <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>
                </form>
            </div>
        </main>

        <%- include('layouts/footer'); -%>

            <script>
                // Populate courses based on current education
                const educationDropdown = document.getElementById('currentEducation');
                const courseDropdown = document.getElementById('course');

                educationDropdown.addEventListener('change', function () {
                    const education = this.value;
                    courseDropdown.innerHTML = ''; // Clear previous courses

                    // Add placeholder back
                    const placeholder = document.createElement('option');
                    placeholder.value = "";
                    placeholder.disabled = true;
                    placeholder.selected = true;
                    placeholder.hidden = true;
                    placeholder.textContent = "Select course stream";
                    courseDropdown.appendChild(placeholder);

                    let courses = [];
                    if (education === 'Primary School' || education === 'Middle School') {
                        courses = ['General Studies'];
                    } else if (education === 'High School') {
                        courses = ['Science', 'Commerce', 'Arts'];
                    } else if (education === 'Higher Secondary') {
                        courses = ['Physics, Chemistry, Biology (PCB)', 'Physics, Chemistry, Mathematics (PCM)', 'Commerce', 'Humanities', 'Vocational Studies'];
                    } else if (education === 'Diploma') {
                        courses = ['Diploma in Engineering', 'Diploma in Pharmacy', 'Diploma in Business Management', 'Diploma in Hotel Management', 'Diploma in Education'];
                    } else if (education === 'Undergraduate') {
                        courses = ['B.Tech', 'B.Sc', 'B.Com', 'BA', 'BBA', 'BCA', 'LLB', 'MBBS', 'BDS', 'B.Arch', 'B.Pharm', 'B.Ed'];
                    } else if (education === 'Postgraduate') {
                        courses = ['M.Tech', 'M.Sc', 'MBA', 'MA', 'M.Com', 'MCA', 'LLM', 'MD', 'MDS', 'M.Arch', 'M.Pharm', 'M.Ed'];
                    } else if (education === 'Doctorate') {
                        courses = ['PhD in Engineering', 'PhD in Science', 'PhD in Humanities', 'PhD in Law', 'PhD in Management', 'PhD in Medicine'];
                    } else if (education === 'Post-Doctorate') {
                        courses = ['Post-Doctoral Fellowship in Science', 'Post-Doctoral Fellowship in Engineering', 'Post-Doctoral Fellowship in Social Sciences', 'Post-Doctoral Fellowship in Medicine'];
                    } else if (education === 'Vocational Training') {
                        courses = ['Automobile Engineering', 'Computer Hardware and Networking', 'Plumbing', 'Electrician', 'Beauty and Wellness', 'Culinary Arts'];
                    } else if (education === 'Professional Certification') {
                        courses = ['Project Management', 'Data Science', 'Cybersecurity', 'Digital Marketing', 'Graphic Design', 'AI and Machine Learning'];
                    }

                    courses.forEach(course => {
                        const option = document.createElement('option');
                        option.value = course;
                        option.textContent = course;
                        courseDropdown.appendChild(option);
                    });
                });

                // Populate universities based on state
                const stateDropdown = document.getElementById('state');
                const universityDropdown = document.getElementById('university');

                stateDropdown.addEventListener('change', function () {
                    const state = this.value;
                    universityDropdown.innerHTML = ''; // Clear previous universities

                    // Add placeholder back
                    const placeholder = document.createElement('option');
                    placeholder.value = "";
                    placeholder.disabled = true;
                    placeholder.selected = true;
                    placeholder.hidden = true;
                    placeholder.textContent = "Select university";
                    universityDropdown.appendChild(placeholder);

                    let universities = [];
                    if (state === 'Andhra Pradesh') universities = ['Andhra University', 'Sri Venkateswara University', 'Jawaharlal Nehru Technological University', 'Acharya Nagarjuna University', 'Dr. B.R. Ambedkar University', 'Sri Padmavati Mahila Visvavidyalayam'];
                    else if (state === 'Arunachal Pradesh') universities = ['Rajiv Gandhi University', 'North Eastern Regional Institute of Science and Technology', 'Arunachal University of Studies', 'Indira Gandhi Technological and Medical Sciences University', 'Himalayan University', 'Venkateshwara Open University'];
                    else if (state === 'Assam') universities = ['Gauhati University', 'Tezpur University', 'Dibrugarh University', 'Assam University', 'Kaziranga University', 'Cotton University'];
                    else if (state === 'Bihar') universities = ['Patna University', 'Nalanda University', 'Magadh University', 'Lalit Narayan Mithila University', 'Babasaheb Bhimrao Ambedkar Bihar University', 'Aryabhatta Knowledge University'];
                    else if (state === 'Chhattisgarh') universities = ['Pandit Ravishankar Shukla University', 'Guru Ghasidas Vishwavidyalaya', 'Indira Gandhi Krishi Vishwavidyalaya', 'Chhattisgarh Swami Vivekanand Technical University', 'Kushabhau Thakre Patrakarita Avam Jansanchar Vishwavidyalaya', 'Ayush and Health Sciences University'];
                    else if (state === 'Delhi') universities = ['Delhi University'];
                    else if (state === 'Goa') universities = ['Goa University', 'BITS Pilani, Goa Campus', 'Goa Institute of Management', 'National Institute of Technology Goa', 'Goa College of Engineering', 'Don Bosco College, Goa'];
                    else if (state === 'Gujarat') universities = ['Gujarat University', 'Maharaja Sayajirao University of Baroda', 'Sardar Vallabhbhai National Institute of Technology', 'Nirma University', 'Indian Institute of Technology Gandhinagar', 'Gujarat Technological University'];
                    else if (state === 'Haryana') universities = ['Kurukshetra University', 'Maharshi Dayanand University', 'Guru Jambheshwar University of Science and Technology', 'Chaudhary Charan Singh Haryana Agricultural University', 'Deenbandhu Chhotu Ram University of Science and Technology', 'Lingaya\'s University'];
                    else if (state === 'Himachal Pradesh') universities = ['Himachal Pradesh University', 'Indian Institute of Technology Mandi', 'Dr. Yashwant Singh Parmar University of Horticulture and Forestry', 'National Institute of Technology Hamirpur', 'Chaudhary Sarwan Kumar Himachal Pradesh Krishi Vishvavidyalaya', 'Shoolini University'];
                    else if (state === 'Jharkhand') universities = ['Ranchi University', 'Birla Institute of Technology, Mesra', 'Vinoba Bhave University', 'Jharkhand Rai University', 'Kolhan University', 'National University of Study and Research in Law'];
                    else if (state === 'Karnataka') universities = ['Bangalore University', 'Visvesvaraya Technological University', 'University of Mysore', 'Karnataka State Open University', 'National Institute of Technology Karnataka', 'Manipal Academy of Higher Education'];
                    else if (state === 'Kerala') universities = ['University of Kerala', 'Cochin University of Science and Technology', 'Mahatma Gandhi University', 'Kerala Agricultural University', 'National Institute of Technology Calicut', 'Indian Institute of Space Science and Technology'];
                    else if (state === 'Madhya Pradesh') universities = ['Devi Ahilya Vishwavidyalaya', 'Rajiv Gandhi Proudyogiki Vishwavidyalaya', 'Barkatullah University', 'Jiwaji University', 'Mahatma Gandhi Chitrakoot Gramodaya Vishwavidyalaya', 'Dr. Harisingh Gour University'];
                    else if (state === 'Maharashtra') universities = ['University of Mumbai', 'Savitribai Phule Pune University', 'Shivaji University', 'Dr. Babasaheb Ambedkar Marathwada University', 'Maharashtra University of Health Sciences', 'Yashwantrao Chavan Maharashtra Open University'];
                    else if (state === 'Manipur') universities = ['Manipur University', 'Central Agricultural University', 'National Institute of Technology Manipur', 'Manipur Technical University', 'Manipur International University', 'Indira Gandhi National Tribal University, Manipur'];
                    else if (state === 'Meghalaya') universities = ['North-Eastern Hill University', 'Martin Luther Christian University', 'Mahatma Gandhi University, Meghalaya', 'CMJ University', 'William Carey University', 'University of Science and Technology, Meghalaya'];
                    else if (state === 'Mizoram') universities = ['Mizoram University', 'ICFAI University, Mizoram', 'National Institute of Technology Mizoram', 'College of Veterinary Sciences and Animal Husbandry, Selesih', 'Central Agricultural University, Mizoram Campus', 'Zoram Medical College'];
                    else if (state === 'Nagaland') universities = ['Nagaland University', 'St. Joseph University, Dimapur', 'Global Open University', 'National Institute of Technology Nagaland', 'ICFAI University, Nagaland', 'Patkai Christian College'];
                    else if (state === 'Odisha') universities = ['Utkal University', 'Sambalpur University', 'Ravenshaw University', 'Berhampur University', 'Veer Surendra Sai University of Technology', 'National Institute of Technology Rourkela'];
                    else if (state === 'Punjab') universities = ['Panjab University', 'Guru Nanak Dev University', 'Punjab Agricultural University', 'Lovely Professional University', 'Chandigarh University', 'Thapar Institute of Engineering and Technology'];
                    else if (state === 'Rajasthan') universities = ['University of Rajasthan', 'Malaviya National Institute of Technology', 'Mohanlal Sukhadia University', 'Birla Institute of Technology and Science Pilani', 'Rajasthan Technical University', 'Jaipur National University'];
                    else if (state === 'Sikkim') universities = ['Sikkim University', 'Sikkim Manipal University', 'ICFAI University, Sikkim', 'SRM University Sikkim', 'Vinayaka Missions Sikkim University', 'EIILM University'];
                    else if (state === 'Tamil Nadu') universities = ['University of Madras', 'Anna University', 'Indian Institute of Technology Madras', 'Madurai Kamaraj University', 'Tamil Nadu Agricultural University', 'Bharathiar University'];
                    else if (state === 'Telangana') universities = ['Osmania University', 'Jawaharlal Nehru Technological University', 'University of Hyderabad', 'Kakatiya University', 'Dr. B.R. Ambedkar Open University', 'Potti Sreeramulu Telugu University'];
                    else if (state === 'Tripura') universities = ['Tripura University', 'National Institute of Technology Agartala', 'Maharaja Bir Bikram University', 'ICFAI University, Tripura', 'Holy Cross College', 'Agartala Government Medical College'];
                    else if (state === 'Uttar Pradesh') universities = ['University of Lucknow', 'Banaras Hindu University', 'Aligarh Muslim University', 'Dr. Ram Manohar Lohia National Law University', 'Chhatrapati Shahu Ji Maharaj University', 'Indian Institute of Technology Kanpur'];
                    else if (state === 'Uttarakhand') universities = ['Hemwati Nandan Bahuguna Garhwal University', 'Gurukul Kangri Vishwavidyalaya', 'Doon University', 'Graphic Era University', 'Uttarakhand Technical University', 'Kumaun University'];
                    else if (state === 'West Bengal') universities = ['University of Calcutta', 'Jadavpur University', 'Indian Institute of Technology Kharagpur', 'Visva-Bharati University', 'Presidency University', 'Indian Statistical Institute'];

                    universities.forEach(university => {
                        const option = document.createElement('option');
                        option.value = university;
                        option.textContent = university;
                        universityDropdown.appendChild(option);
                    });
                });
            </script>
            </body>

            </html>