<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nexus AI Interview - EduNavigator</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --nexus-primary: #00f2ff;
            --nexus-secondary: #7000ff;
            --nexus-bg: #030712;
            --nexus-surface: rgba(17, 24, 39, 0.7);
            --nexus-border: rgba(255, 255, 255, 0.1);
            --nexus-text: #f3f4f6;
            --nexus-glow: rgba(0, 242, 255, 0.3);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Outfit', sans-serif;
        }

        body {
            background: var(--nexus-bg);
            color: var(--nexus-text);
            overflow: hidden;
            height: 100vh;
        }

        /* --- IMMERSIVE BACKGROUND --- */
        #neural-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            opacity: 0.4;
        }

        .ambient-glow {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 80vw;
            height: 80vh;
            background: radial-gradient(circle, var(--nexus-secondary) 0%, transparent 70%);
            filter: blur(100px);
            opacity: 0.15;
            z-index: -2;
            pointer-events: none;
        }

        /* --- DASHBOARD LAYOUT --- */
        .nexus-layout {
            display: grid;
            grid-template-columns: 320px 1fr 320px;
            height: 100vh;
            padding: 24px;
            gap: 24px;
        }

        @media (max-width: 1200px) {
            .nexus-layout {
                grid-template-columns: 280px 1fr;
            }
            .right-panel { display: none; }
        }

        .glass-panel {
            background: var(--nexus-surface);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid var(--nexus-border);
            border-radius: 2rem;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
        }

        /* --- LEFT PANEL: CONFIG --- */
        .left-panel {
            padding: 32px;
        }

        .logo-area {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 48px;
        }

        .logo-icon {
            font-size: 2rem;
            background: linear-gradient(135deg, var(--nexus-primary), var(--nexus-secondary));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .section-tag {
            font-size: 0.7rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--nexus-primary);
            margin-bottom: 24px;
            opacity: 0.8;
            display: block;
        }

        .input-group {
            margin-bottom: 24px;
        }

        .input-group label {
            display: block;
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 8px;
            color: #9ca3af;
        }

        .nexus-input {
            width: 100%;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid var(--nexus-border);
            border-radius: 1rem;
            padding: 14px 18px;
            color: white;
            font-weight: 500;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .nexus-input:focus {
            outline: none;
            border-color: var(--nexus-primary);
            box-shadow: 0 0 15px var(--nexus-glow);
        }

        .btn-nexus {
            width: 100%;
            padding: 16px;
            border-radius: 1rem;
            border: none;
            font-weight: 800;
            font-size: 0.95rem;
            cursor: pointer;
            transition: all 0.4s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-top: 12px;
        }

        .btn-nexus-primary {
            background: linear-gradient(135deg, var(--nexus-primary), var(--nexus-secondary));
            color: white;
            box-shadow: 0 4px 20px rgba(0, 242, 255, 0.2);
        }

        .btn-nexus-primary:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 30px rgba(0, 242, 255, 0.4);
        }

        .btn-nexus-primary:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }

        /* --- CENTER PANEL: INTERACTION --- */
        .center-panel {
            position: relative;
            justify-content: center;
            align-items: center;
            padding: 40px;
        }

        .interviewer-avatar {
            width: 220px;
            height: 220px;
            position: relative;
            margin-bottom: 60px;
        }

        .avatar-core {
            width: 100%;
            height: 100%;
            background: radial-gradient(circle, rgba(112, 0, 255, 0.4) 0%, transparent 70%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            z-index: 2;
        }

        .avatar-brain {
            width: 120px;
            height: 120px;
            font-size: 4rem;
            color: var(--nexus-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            animation: breathe 4s infinite ease-in-out;
            text-shadow: 0 0 30px var(--nexus-primary);
        }

        @keyframes breathe {
            0%, 100% { transform: scale(1); filter: brightness(1); }
            50% { transform: scale(1.1); filter: brightness(1.5); }
        }

        .speaking-rings {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 100%;
            height: 100%;
        }

        .ring {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: 2px solid var(--nexus-primary);
            border-radius: 50%;
            opacity: 0;
        }

        .avatar-container.speaking .ring {
            animation: ring-pulse 2s infinite linear;
        }

        .avatar-container.speaking .ring:nth-child(2) { animation-delay: 0.5s; }
        .avatar-container.speaking .ring:nth-child(3) { animation-delay: 1s; }

        @keyframes ring-pulse {
            0% { transform: translate(-50%, -50%) scale(1); opacity: 0.8; }
            100% { transform: translate(-50%, -50%) scale(2); opacity: 0; }
        }

        .transcript-bubble {
            width: 100%;
            max-width: 800px;
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid var(--nexus-border);
            border-radius: 2.5rem;
            padding: 40px;
            text-align: center;
            margin-bottom: 40px;
            position: relative;
        }

        .ai-question {
            font-size: 1.75rem;
            font-weight: 700;
            margin-bottom: 24px;
            line-height: 1.4;
            color: white;
            min-height: 80px;
        }

        .user-live-text {
            font-family: 'JetBrains Mono', monospace;
            font-size: 1.1rem;
            color: #9ca3af;
            font-style: italic;
        }

        /* --- VISUALIZER --- */
        .visualizer-container {
            height: 60px;
            display: flex;
            align-items: center;
            gap: 4px;
            margin-bottom: 40px;
        }

        .vis-bar {
            width: 4px;
            height: 10px;
            background: var(--nexus-primary);
            border-radius: 2px;
            transition: height 0.05s ease;
            box-shadow: 0 0 10px var(--nexus-primary);
        }

        /* --- CONTROLS --- */
        .nexus-controls {
            display: flex;
            gap: 24px;
        }

        .control-hex {
            width: 80px;
            height: 80px;
            background: var(--nexus-surface);
            border: 2px solid var(--nexus-border);
            border-radius: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.75rem;
            color: white;
            cursor: pointer;
            transition: all 0.4s;
            position: relative;
        }

        .control-hex:hover {
            border-color: var(--nexus-primary);
            color: var(--nexus-primary);
            transform: translateY(-8px);
            box-shadow: 0 10px 30px var(--nexus-glow);
        }

        .control-hex.active {
            background: var(--nexus-primary);
            color: var(--nexus-bg);
            border-color: var(--nexus-primary);
            box-shadow: 0 0 40px var(--nexus-glow);
        }

        .control-hex.disabled {
            opacity: 0.3;
            pointer-events: none;
        }

        /* --- RIGHT PANEL: STATUS --- */
        .right-panel {
            padding: 32px;
        }

        .status-card {
            background: rgba(255, 255, 255, 0.03);
            border-radius: 1.5rem;
            padding: 24px;
            margin-bottom: 24px;
        }

        .stat-label {
            font-size: 0.65rem;
            font-weight: 900;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 12px;
            display: block;
        }

        .live-badge {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #4ade80;
            font-weight: 700;
            font-size: 0.8rem;
        }

        .pulse-dot {
            width: 8px;
            height: 8px;
            background: #4ade80;
            border-radius: 50%;
            animation: pulse-dot 1s infinite;
        }

        @keyframes pulse-dot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.5; transform: scale(1.5); }
        }

        /* --- PROGRESS --- */
        .nexus-progress {
            margin-top: auto;
        }

        .progress-track {
            height: 6px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 3px;
            overflow: hidden;
            margin-top: 12px;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--nexus-primary), var(--nexus-secondary));
            width: 0%;
            transition: width 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* --- FINAL REPORT OVERLAY --- */
        .overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            visibility: hidden;
            transition: all 0.5s;
            backdrop-filter: blur(10px);
        }

        .overlay.show {
            opacity: 1;
            visibility: visible;
        }

        .report-card {
            width: 90%;
            max-width: 900px;
            background: var(--nexus-surface);
            border: 1px solid var(--nexus-border);
            border-radius: 3rem;
            padding: 60px;
            text-align: center;
        }

        .score-display {
            font-size: 5rem;
            font-weight: 900;
            margin-bottom: 20px;
            background: linear-gradient(135deg, var(--nexus-primary), var(--nexus-secondary));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* UTILS */
        .hidden { display: none !important; }

        #ai-typing {
            display: inline-flex;
            gap: 4px;
        }

        .dot {
            width: 8px;
            height: 8px;
            background: var(--nexus-primary);
            border-radius: 50%;
            animation: dot-bounce 1s infinite;
        }
        .dot:nth-child(2) { animation-delay: 0.2s; }
        .dot:nth-child(3) { animation-delay: 0.4s; }

        @keyframes dot-bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

    </style>
</head>

<body>

    <canvas id="neural-canvas"></canvas>
    <div class="ambient-glow"></div>

    <div class="nexus-layout">
        
        <!-- LEFT: CONFIG -->
        <div class="glass-panel left-panel">
            <div class="logo-area">
                <i class="fas fa-brain logo-icon"></i>
                <div style="font-weight: 900; font-size: 1.5rem; letter-spacing: -1px;">NEXUS <span style="font-weight: 400; color: #6b7280;">AI</span></div>
            </div>

            <span class="section-tag">Neural Setup</span>
            
            <div id="setup-controls">
                <div class="input-group">
                    <label>Professional Domain</label>
                    <input type="text" id="role" class="nexus-input" placeholder="e.g. Machine Learning Engineer" value="Frontend Developer">
                </div>
                
                <div class="input-group">
                    <label>Experience Tier</label>
                    <select id="seniority" class="nexus-input">
                        <option value="Intern">Internship</option>
                        <option value="Junior" selected>Associate / Junior</option>
                        <option value="Mid-Level">Professional / Mid-Level</option>
                        <option value="Senior">Senior Expert</option>
                        <option value="Lead">Strategic Lead</option>
                    </select>
                </div>

                <button id="startBtn" class="btn-nexus btn-nexus-primary">
                    <i class="fas fa-bolt"></i> INITIALIZE INTERVIEW
                </button>
            </div>

            <div id="progress-area" class="nexus-progress hidden" style="margin-top: 40px; display: none;">
                <span class="section-tag">Cycle Status</span>
                <div style="font-size: 2rem; font-weight: 900; margin-bottom: 8px;">
                    <span id="current-q">0</span><span style="color: #4b5563; font-weight: 300;"> / <span id="total-q">5</span></span>
                </div>
                <div class="progress-track">
                    <div id="progress-fill" class="progress-fill"></div>
                </div>
                <p style="margin-top: 15px; font-size: 0.8rem; color: #6b7280; font-weight: 600;">Neural Link: Active</p>
            </div>
            
            <div style="margin-top: auto; padding-top: 40px;">
                <a href="/" style="color: #6b7280; text-decoration: none; font-weight: 700; font-size: 0.8rem; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-arrow-left"></i> DISCONNECT SESSION
                </a>
            </div>
        </div>

        <!-- CENTER: INTERACTION -->
        <div class="glass-panel center-panel">
            
            <div class="avatar-container" id="avatar">
                <div class="interviewer-avatar">
                    <div class="speaking-rings">
                        <div class="ring"></div>
                        <div class="ring"></div>
                        <div class="ring"></div>
                    </div>
                    <div class="avatar-core">
                        <div class="avatar-brain">
                            <i class="fas fa-microchip"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="transcript-bubble">
                <div id="ai-text" class="ai-question">
                    System Hub Online. Please configure the domain and experience tier to begin your immersive AI interview experience.
                </div>
                <div id="ai-typing" class="hidden">
                    <div class="dot"></div>
                    <div class="dot"></div>
                    <div class="dot"></div>
                </div>
                <div id="user-text" class="user-live-text">Waiting for input...</div>
            </div>

            <div class="visualizer-container" id="visualizer">
                <!-- Bars added by JS -->
            </div>

            <div class="nexus-controls hidden" id="nexus-controls">
                <button class="control-hex" id="mic-btn" onclick="toggleRecording()" title="Toggle Neural Link">
                    <i class="fas fa-microphone"></i>
                </button>
                <button class="control-hex" id="analyze-btn" onclick="submitAnswer()" title="Finalize Response">
                    <i class="fas fa-paper-plane"></i>
                </button>
                <button class="control-hex hidden" id="next-btn" onclick="nextQuestion()" title="Next Challenge">
                    <i class="fas fa-forward-step"></i>
                </button>
            </div>

        </div>

        <!-- RIGHT: LIVE FEEDBACK -->
        <div class="glass-panel right-panel">
            <span class="section-tag">Telemetry Analytics</span>
            
            <div class="status-card">
                <span class="stat-label">Neural Integrity</span>
                <div class="live-badge">
                    <div class="pulse-dot"></div> READY FOR SYNC
                </div>
            </div>

            <div id="feedback-panel" class="hidden" style="display: none;">
                <div class="status-card">
                    <span class="stat-label">Communication Pulse</span>
                    <div style="font-size: 1.5rem; font-weight: 900; display: flex; align-items: baseline; gap: 4px;">
                        <span id="comm-score">0</span> <span style="font-size: 0.7rem; color: #4b5563;">% ACCURACY</span>
                    </div>
                </div>

                <div class="status-card">
                    <span class="stat-label">Confidence Metrics</span>
                    <div id="sentiment-tag" style="padding: 6px 14px; background: rgba(0, 242, 255, 0.1); border: 1px solid var(--nexus-primary); color: var(--nexus-primary); border-radius: 99px; font-size: 0.7rem; font-weight: 900; display: inline-block;">
                        ANALYZING...
                    </div>
                </div>

                <div class="status-card">
                    <span class="stat-label">Key Strengths</span>
                    <ul id="strengths-list" style="list-style: none; padding: 0;">
                        <!-- JS items -->
                    </ul>
                </div>
            </div>

            <div style="margin-top: auto; padding: 20px; background: linear-gradient(135deg, rgba(112,0,255,0.1), rgba(0,242,255,0.1)); border-radius: 1.5rem; border: 1px solid var(--nexus-border);">
                <p style="font-size: 0.75rem; font-weight: 500; color: #9ca3af; line-height: 1.6;">
                    <i class="fas fa-circle-info" style="color: var(--nexus-primary); margin-right: 5px;"></i>
                    NEXUS AI utilizes deep semantic processing to evaluate technical depth and non-verbal cues.
                </p>
            </div>
        </div>
    </div>

    <!-- FINAL REPORT -->
    <div class="overlay" id="report-overlay">
        <div class="report-card">
            <i class="fas fa-award" style="font-size: 4rem; color: var(--nexus-primary); margin-bottom: 30px;"></i>
            <h2 style="font-size: 2.5rem; font-weight: 900; margin-bottom: 10px;">CYCLE COMPLETE</h2>
            <p style="color: #9ca3af; margin-bottom: 40px; font-weight: 500;">Your interview analytics has been compiled successfully.</p>
            
            <div class="score-display" id="final-score">84</div>
            <p style="font-weight: 800; letter-spacing: 2px; color: var(--nexus-primary); margin-bottom: 40px;">OVERALL IMPACT SCORE</p>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 50px;">
                <div class="status-card" style="margin: 0;">
                    <span class="stat-label">Technical Mastery</span>
                    <div id="final-tech" style="font-size: 1.5rem; font-weight: 900;">92%</div>
                </div>
                <div class="status-card" style="margin: 0;">
                    <span class="stat-label">Verbal Delivery</span>
                    <div id="final-comm" style="font-size: 1.5rem; font-weight: 900;">78%</div>
                </div>
            </div>

            <div style="display: flex; gap: 20px; justify-content: center;">
                <button class="btn-nexus btn-nexus-primary" style="width: auto; padding: 18px 40px;" onclick="location.reload()">
                    RESTART CYCLE
                </button>
                <button class="btn-nexus" style="width: auto; padding: 18px 40px; background: white; color: black;" onclick="window.print()">
                    EXPORT DOSSIER
                </button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // --- NEURAL CANVAS ---
        const canvas = document.getElementById('neural-canvas');
        const ctx = canvas.getContext('2d');
        let particles = [];

        function initCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
            particles = [];
            for (let i = 0; i < 80; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 0.5,
                    vy: (Math.random() - 0.5) * 0.5,
                    size: Math.random() * 2 + 1
                });
            }
        }

        function drawCanvas() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = '#00f2ff';
            ctx.strokeStyle = 'rgba(0, 242, 255, 0.1)';
            
            particles.forEach((p, i) => {
                p.x += p.vx;
                p.y += p.vy;
                if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
                if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
                
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                ctx.fill();

                for (let j = i + 1; j < particles.length; j++) {
                    const p2 = particles[j];
                    const dist = Math.hypot(p.x - p2.x, p.y - p2.y);
                    if (dist < 150) {
                        ctx.lineWidth = 1 - dist / 150;
                        ctx.beginPath();
                        ctx.moveTo(p.x, p.y);
                        ctx.lineTo(p2.x, p2.y);
                        ctx.stroke();
                    }
                }
            });
            requestAnimationFrame(drawCanvas);
        }

        window.addEventListener('resize', initCanvas);
        initCanvas();
        drawCanvas();

        // --- VISUALIZER ---
        const visualizer = document.getElementById('visualizer');
        const barCount = 40;
        const bars = [];
        for (let i = 0; i < barCount; i++) {
            const bar = document.createElement('div');
            bar.className = 'vis-bar';
            visualizer.appendChild(bar);
            bars.push(bar);
        }

        function updateVisualizer(intensity) {
            bars.forEach(bar => {
                const h = Math.random() * intensity * 50 + 5;
                bar.style.height = h + 'px';
                bar.style.opacity = intensity > 0.1 ? 1 : 0.3;
            });
        }

        // --- INTERVIEW LOGIC ---
        let questions = [];
        let currentIndex = 0;
        let recognition;
        let isRecording = false;
        let finalScores = { tech: [], comm: [] };

        const els = {
            startBtn: document.getElementById('startBtn'),
            aiText: document.getElementById('ai-text'),
            userText: document.getElementById('user-text'),
            micBtn: document.getElementById('mic-btn'),
            nexusControls: document.getElementById('nexus-controls'),
            progressArea: document.getElementById('progress-area'),
            currentQ: document.getElementById('current-q'),
            totalQ: document.getElementById('total-q'),
            progressFill: document.getElementById('progress-fill'),
            feedbackPanel: document.getElementById('feedback-panel'),
            commScore: document.getElementById('comm-score'),
            sentimentTag: document.getElementById('sentiment-tag'),
            strengths: document.getElementById('strengths-list'),
            analyzeBtn: document.getElementById('analyze-btn'),
            nextBtn: document.getElementById('next-btn'),
            reportOverlay: document.getElementById('report-overlay'),
            avatar: document.getElementById('avatar'),
            aiTyping: document.getElementById('ai-typing')
        };

        // Speech Init
        if ('webkitSpeechRecognition' in window) {
            recognition = new webkitSpeechRecognition();
            recognition.continuous = true;
            recognition.interimResults = true;

            recognition.onstart = () => {
                isRecording = true;
                els.micBtn.classList.add('active');
                updateVisualizer(0.5);
            };

            recognition.onresult = (event) => {
                let final = '';
                for (let i = event.resultIndex; i < event.results.length; ++i) {
                    if (event.results[i].isFinal) final += event.results[i][0].transcript;
                }
                if (final) {
                    els.userText.textContent = final;
                    updateVisualizer(0.8);
                }
            };

            recognition.onend = () => {
                isRecording = false;
                els.micBtn.classList.remove('active');
                updateVisualizer(0);
            };
        }

        els.startBtn.addEventListener('click', async () => {
            const role = document.getElementById('role').value;
            const seniority = document.getElementById('seniority').value;

            els.startBtn.disabled = true;
            els.startBtn.innerHTML = '<i class="fas fa-sync fa-spin"></i> SYNCING...';

            try {
                const res = await fetch('/interview/questions', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ role, seniority })
                });
                const data = await res.json();

                if (data.success) {
                    questions = data.questions;
                    document.getElementById('setup-controls').classList.add('hidden');
                    els.progressArea.classList.remove('hidden');
                    els.progressArea.style.display = 'block';
                    els.nexusControls.classList.remove('hidden');
                    els.totalQ.textContent = questions.length;
                    
                    loadQuestion(0);
                }
            } catch (e) { console.error(e); }
        });

        function loadQuestion(index) {
            currentIndex = index;
            const q = questions[index];
            
            // UI Transition
            els.aiText.style.opacity = 0;
            els.aiTyping.classList.remove('hidden');
            
            setTimeout(() => {
                els.aiTyping.classList.add('hidden');
                els.aiText.textContent = q;
                els.aiText.style.opacity = 1;
                speak(q);
            }, 1000);

            els.userText.textContent = "Listening for audio signals...";
            els.currentQ.textContent = index + 1;
            els.progressFill.style.width = ((index / questions.length) * 100) + "%";

            els.analyzeBtn.classList.remove('hidden');
            els.nextBtn.classList.add('hidden');
        }

        function toggleRecording() {
            if (!recognition) return;
            if (isRecording) recognition.stop();
            else {
                els.userText.textContent = "";
                recognition.start();
            }
        }

        async function submitAnswer() {
            if (isRecording) recognition.stop();
            const transcript = els.userText.textContent;
            if (!transcript || transcript.includes("Listening")) {
                alert("Please articulate your response first.");
                return;
            }

            els.analyzeBtn.disabled = true;
            els.analyzeBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

            try {
                const res = await fetch('/interview/analyze', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        role: document.getElementById('role').value,
                        seniority: document.getElementById('seniority').value,
                        transcript: transcript
                    })
                });
                const data = await res.json();

                if (data.success) {
                    showRealtimeFeedback(data.analysis);
                    finalScores.tech.push(data.analysis.technicalScore);
                    finalScores.comm.push(data.analysis.communicationScore);

                    els.analyzeBtn.classList.add('hidden');
                    if (currentIndex < questions.length - 1) {
                        els.nextBtn.classList.remove('hidden');
                    } else {
                        showFinalReport();
                    }
                }
            } catch (e) {
                console.error(e);
            }
            els.analyzeBtn.disabled = false;
            els.analyzeBtn.innerHTML = '<i class="fas fa-paper-plane"></i>';
        }

        function showRealtimeFeedback(analysis) {
            els.feedbackPanel.classList.remove('hidden');
            els.feedbackPanel.style.display = 'block';
            
            els.commScore.textContent = analysis.communicationScore;
            els.sentimentTag.textContent = analysis.overallSentiment.toUpperCase();
            
            els.strengths.innerHTML = (analysis.strengths || []).slice(0, 3).map(s => `
                <li style="font-size: 0.75rem; color: #9ca3af; margin-bottom: 8px; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-circle-check" style="color: var(--nexus-primary); font-size: 0.6rem;"></i> ${s}
                </li>
            `).join('');

            // Speak the feedback
            speak(analysis.feedback || "Good response. Moving to the next area.");
        }

        function nextQuestion() {
            loadQuestion(currentIndex + 1);
        }

        function showFinalReport() {
            const avgTech = Math.round(finalScores.tech.reduce((a, b) => a + b, 0) / finalScores.tech.length);
            const avgComm = Math.round(finalScores.comm.reduce((a, b) => a + b, 0) / finalScores.comm.length);
            const total = Math.round((avgTech + avgComm) / 2);

            document.getElementById('final-score').textContent = total;
            document.getElementById('final-tech').textContent = avgTech + '%';
            document.getElementById('final-comm').textContent = avgComm + '%';
            
            els.reportOverlay.classList.add('show');
        }

        function speak(text) {
            window.speechSynthesis.cancel();
            const u = new SpeechSynthesisUtterance(text);
            u.rate = 1.1;
            u.pitch = 0.9;
            u.onstart = () => els.avatar.classList.add('speaking');
            u.onend = () => els.avatar.classList.remove('speaking');
            window.speechSynthesis.speak(u);
        }

    </script>
</body>

</html>