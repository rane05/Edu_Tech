<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Interview Live - EduNavigator</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --accent: #6366f1;
            --accent-hover: #4f46e5;
            --success: #22c55e;
            --error: #ef4444;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', -apple-system, system-ui, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-primary);
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            /* Prevent body scroll, handle in content */
        }

        /* --- NAVBAR (Simple) --- */
        .navbar {
            padding: 1rem 2rem;
            background: rgba(30, 41, 59, 0.8);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-weight: 700;
            font-size: 1.25rem;
            color: var(--accent);
        }

        .nav-end a {
            color: var(--text-secondary);
            text-decoration: none;
            margin-left: 20px;
            font-size: 0.9rem;
        }

        /* --- MAIN LAYOUT --- */
        .main-container {
            flex: 1;
            display: flex;
            height: calc(100vh - 60px);
        }

        /* LEFT: Sidebar / Setup */
        .sidebar {
            width: 350px;
            background: var(--card-bg);
            border-right: 1px solid rgba(255, 255, 255, 0.05);
            padding: 2rem;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            overflow-y: auto;
        }

        .section-title {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-secondary);
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        .form-group {
            margin-bottom: 1rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-size: 0.9rem;
        }

        .form-control {
            width: 100%;
            padding: 0.75rem;
            background: rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            color: white;
            font-size: 0.95rem;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--accent);
        }

        .btn {
            width: 100%;
            padding: 0.85rem;
            border-radius: 8px;
            border: none;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .btn-primary {
            background: var(--accent);
            color: white;
        }

        .btn-primary:hover {
            background: var(--accent-hover);
        }

        .btn-outline {
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: var(--text-secondary);
        }

        .btn-danger {
            background: rgba(239, 68, 68, 0.2);
            color: #fca5a5;
        }

        .btn-danger:hover {
            background: rgba(239, 68, 68, 0.3);
        }

        /* RIGHT: Interaction Area */
        .chat-area {
            flex: 1;
            padding: 2rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: radial-gradient(circle at center, #1e293b 0%, #0f172a 70%);
            position: relative;
        }

        /* AVATAR */
        .avatar-container {
            position: relative;
            width: 120px;
            height: 120px;
            margin-bottom: 2rem;
        }

        .avatar-circle {
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #6366f1, #a855f7);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            box-shadow: 0 10px 30px rgba(99, 102, 241, 0.3);
            z-index: 2;
            position: relative;
            transition: transform 0.2s;
        }

        .avatar-ring {
            position: absolute;
            top: -10px;
            left: -10px;
            right: -10px;
            bottom: -10px;
            border: 2px solid rgba(99, 102, 241, 0.3);
            border-radius: 50%;
            z-index: 1;
        }

        .avatar-container.speaking .avatar-ring {
            animation: pulse-ring 2s infinite;
        }

        @keyframes pulse-ring {
            0% {
                transform: scale(0.8);
                opacity: 1;
            }

            100% {
                transform: scale(1.5);
                opacity: 0;
            }
        }

        /* TRANSCRIPT */
        .transcript-box {
            width: 100%;
            max-width: 700px;
            background: rgba(255, 255, 255, 0.03);
            padding: 1.5rem;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            min-height: 150px;
            margin-bottom: 2rem;
            text-align: center;
        }

        .ai-text {
            font-size: 1.25rem;
            font-weight: 500;
            margin-bottom: 1rem;
            line-height: 1.6;
        }

        .user-text {
            color: var(--text-secondary);
            font-style: italic;
            font-size: 1.1rem;
        }

        /* CONTROLS */
        .controls {
            display: flex;
            gap: 1rem;
        }

        .control-btn {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
            border: none;
            color: white;
            font-size: 1.5rem;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .control-btn:hover {
            background: rgba(255, 255, 255, 0.2);
        }

        .control-btn.active {
            background: var(--success);
            box-shadow: 0 0 20px rgba(34, 197, 94, 0.4);
        }

        .control-btn.disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        /* FEEDBACK OVERLAY */
        .feedback-overlay {
            position: absolute;
            top: 2rem;
            right: 2rem;
            background: rgba(15, 23, 42, 0.95);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 1.5rem;
            border-radius: 12px;
            width: 300px;
            transform: translateX(120%);
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            backdrop-filter: blur(10px);
            z-index: 100;
        }

        .feedback-overlay.show {
            transform: translateX(0);
        }

        .feedback-score {
            font-size: 2rem;
            font-weight: 800;
            color: var(--accent);
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 1rem;
        }

        .feedback-score span {
            font-size: 0.8rem;
            color: var(--text-secondary);
            font-weight: 400;
            text-transform: uppercase;
        }

        .feedback-item {
            margin-bottom: 0.8rem;
            font-size: 0.9rem;
            color: #e2e8f0;
        }

        .feedback-item i {
            color: var(--success);
            margin-right: 8px;
        }

        /* UTILS */
        .hidden {
            display: none !important;
        }

        .badge {
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.75rem;
            background: rgba(255, 255, 255, 0.1);
        }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar">
        <div class="logo"><i class="fas fa-graduation-cap"></i> EduNavigator AI</div>
        <div class="nav-end">
            <span class="badge" id="status-badge">System Ready</span>
            <a href="/">Exit</a>
        </div>
    </nav>

    <div class="main-container">

        <!-- SIDEBAR -->
        <div class="sidebar">
            <div>
                <div class="section-title">Interview Configuration</div>
                <div class="form-group">
                    <label>Target Role</label>
                    <input type="text" id="role" class="form-control" placeholder="e.g. React Developer"
                        value="Frontend Developer">
                </div>
                <div class="form-group">
                    <label>Seniority Level</label>
                    <select id="seniority" class="form-control">
                        <option value="Intern">Intern</option>
                        <option value="Junior" selected>Junior</option>
                        <option value="Mid-Level">Mid-Level</option>
                        <option value="Senior">Senior</option>
                    </select>
                </div>
                <button id="generateQuestionsBtn" class="btn btn-primary">
                    <i class="fas fa-magic"></i> Start Interview
                </button>
            </div>

            <div id="progress-section" class="hidden">
                <div class="section-title" style="margin-top: 2rem;">Progress</div>
                <div style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 10px;">
                    Question <span id="current-q">0</span> of <span id="total-q">5</span>
                </div>
                <div style="height: 4px; background: rgba(255,255,255,0.1); border-radius: 2px;">
                    <div id="progress-bar"
                        style="width: 0%; height: 100%; background: var(--accent); transition: width 0.3s;"></div>
                </div>
            </div>
        </div>

        <!-- CHAT AREA -->
        <div class="chat-area">

            <div class="avatar-container" id="avatar">
                <div class="avatar-ring"></div>
                <div class="avatar-circle">
                    <i class="fas fa-robot"></i>
                </div>
            </div>

            <div class="transcript-box">
                <div id="ai-text" class="ai-text">Welcome. Please configure your interview settings and click 'Start'.
                </div>
                <div id="user-text" class="user-text"></div>
            </div>

            <div class="controls hidden" id="action-controls">
                <button class="control-btn" id="mic-btn" onclick="toggleRecording()">
                    <i class="fas fa-microphone"></i>
                </button>
                <button class="control-btn" id="analyze-btn" onclick="submitAnswer()"
                    style="background: var(--accent);">
                    <i class="fas fa-check"></i>
                </button>
                <button class="control-btn" id="next-btn" onclick="nextQuestion()" style="display: none;">
                    <i class="fas fa-arrow-right"></i>
                </button>
            </div>

        </div>
    </div>

    <!-- FEEDBACK OVERLAY -->
    <div class="feedback-overlay" id="feedback-panel">
        <div class="feedback-score" id="fb-score">0 <span>/ 100</span></div>
        <div id="fb-content"></div>
    </div>

    <script>
        // State
        let questions = [];
        let currentIndex = 0;
        let recognition;
        let isRecording = false;

        // Elements
        const els = {
            role: document.getElementById('role'),
            seniority: document.getElementById('seniority'),
            startBtn: document.getElementById('generateQuestionsBtn'),
            aiText: document.getElementById('ai-text'),
            userText: document.getElementById('user-text'),
            micBtn: document.getElementById('mic-btn'),
            controls: document.getElementById('action-controls'),
            avatar: document.getElementById('avatar'),
            statusBadge: document.getElementById('status-badge'),
            progressBar: document.getElementById('progress-bar'),
            currentQ: document.getElementById('current-q'),
            totalQ: document.getElementById('total-q'),
            progressSection: document.getElementById('progress-section'),
            nextBtn: document.getElementById('next-btn'),
            analyzeBtn: document.getElementById('analyze-btn'),
            feedbackPanel: document.getElementById('feedback-panel'),
            fbScore: document.getElementById('fb-score'),
            fbContent: document.getElementById('fb-content')
        };

        // --- SPEECH RECOGNITION ---
        if ('webkitSpeechRecognition' in window) {
            recognition = new webkitSpeechRecognition();
            recognition.continuous = true;
            recognition.interimResults = true;

            recognition.onstart = () => {
                isRecording = true;
                els.micBtn.classList.add('active');
                els.statusBadge.textContent = "Listening...";
                els.statusBadge.style.color = "#4ade80";
            };

            recognition.onresult = (event) => {
                let final = '';
                for (let i = event.resultIndex; i < event.results.length; ++i) {
                    if (event.results[i].isFinal) final += event.results[i][0].transcript;
                }
                if (final) els.userText.textContent = final;
            };

            recognition.onend = () => {
                isRecording = false;
                els.micBtn.classList.remove('active');
                els.statusBadge.textContent = "Idle";
                els.statusBadge.style.color = "var(--text-secondary)";
            };
        } else {
            alert("Speech API not supported in this browser.");
        }

        // --- ACTIONS ---

        els.startBtn.addEventListener('click', async () => {
            const role = els.role.value;
            const seniority = els.seniority.value;

            els.startBtn.disabled = true;
            els.startBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating...';

            try {
                const res = await fetch('/interview/questions', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ role, seniority })
                });
                const data = await res.json();

                if (data.success) {
                    questions = data.questions;
                    currentIndex = 0;
                    startInterviewMode();
                } else {
                    alert("Error: " + data.error);
                }
            } catch (e) { console.error(e); alert("Network Error"); }

            els.startBtn.disabled = false;
            els.startBtn.innerHTML = '<i class="fas fa-magic"></i> Start Interview';
        });

        function startInterviewMode() {
            els.progressSection.classList.remove('hidden');
            els.controls.classList.remove('hidden');
            els.totalQ.textContent = questions.length;
            loadQuestion(0);
        }

        function loadQuestion(index) {
            currentIndex = index;
            const q = questions[index];
            els.aiText.textContent = q;
            els.userText.textContent = "";
            els.currentQ.textContent = index + 1;
            els.progressBar.style.width = ((index / questions.length) * 100) + "%";

            // Hide Feedback
            els.feedbackPanel.classList.remove('show');

            // Reset buttons
            els.analyzeBtn.style.display = 'flex';
            els.nextBtn.style.display = 'none';

            speak(q);
        }

        function toggleRecording() {
            if (!recognition) return;
            if (isRecording) recognition.stop();
            else {
                els.userText.textContent = ""; // clear previous
                recognition.start();
            }
        }

        async function submitAnswer() {
            if (isRecording) recognition.stop();

            const transcript = els.userText.textContent;
            if (!transcript) { alert("Please speak an answer first."); return; }

            els.analyzeBtn.disabled = true;
            els.statusBadge.textContent = "Analyzing w/ Ollama...";

            try {
                const res = await fetch('/interview/analyze', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        role: els.role.value,
                        seniority: els.seniority.value,
                        transcript: transcript
                    })
                });
                const data = await res.json();

                if (data.success) {
                    showFeedback(data.analysis);
                    speak(data.analysis.summary);

                    els.analyzeBtn.style.display = 'none';
                    if (currentIndex < questions.length - 1) {
                        els.nextBtn.style.display = 'flex';
                    } else {
                        els.aiText.textContent += " [Interview Finished]";
                    }

                }
            } catch (e) { console.error(e); }

            els.analyzeBtn.disabled = false;
            els.statusBadge.textContent = "Idle";
        }

        function showFeedback(analysis) {
            els.fbScore.innerHTML = `${analysis.confidence} <span>/ 100</span>`;
            els.fbContent.innerHTML = `
                <div class="feedback-item">${analysis.summary}</div>
                <div style="margin-top:10px; font-weight:bold; color:var(--accent);">Strengths</div>
                ${analysis.strengths.map(s => `<div class="feedback-item"><i class="fas fa-check"></i> ${s}</div>`).join('')}
             `;
            els.feedbackPanel.classList.add('show');
        }

        function nextQuestion() {
            if (currentIndex < questions.length - 1) {
                loadQuestion(currentIndex + 1);
            }
        }

        // --- TTS ---
        function speak(text) {
            window.speechSynthesis.cancel();
            const u = new SpeechSynthesisUtterance(text);
            const voices = window.speechSynthesis.getVoices();
            u.voice = voices.find(v => v.name.includes("Google US English")) || voices[0];

            u.onstart = () => els.avatar.classList.add('speaking');
            u.onend = () => {
                els.avatar.classList.remove('speaking');
                // Auto-start mic after question, but not after feedback
                if (!els.analyzeBtn.style.display.includes('none')) {
                    // small delay
                    setTimeout(() => { if (!isRecording) toggleRecording(); }, 500);
                }
            };
            window.speechSynthesis.speak(u);
        }

    </script>
</body>

</html>