<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Career Roadmaps | Edu_Tech</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #334155;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            border-radius: 1rem;
            transition: all 0.3s ease;
        }

        .glass-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 20px -8px rgba(99, 102, 241, 0.15);
            border-color: rgba(99, 102, 241, 0.3);
        }

        .bg-indigo-gradient {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        }
    </style>
</head>

<body class="antialiased font-sans">
    <%- include('layouts/navbar') %>

        <main class="min-h-screen pt-24 pb-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
            <!-- Header -->
            <div class="text-center max-w-3xl mx-auto mb-16">
                <h1 class="text-4xl md:text-5xl font-extrabold text-slate-800 tracking-tight mb-4">
                    Accelerate Your Tech Journey
                </h1>
                <p class="text-lg text-slate-500 mb-8">
                    Choose a career path below to generate a highly personalized, AI-driven learning roadmap based on
                    your current education, skills, and risk tolerance. We analyze the market so you don't have to.
                </p>

                <div class="relative max-w-xl mx-auto">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fas fa-search text-slate-400"></i>
                    </div>
                    <input type="text" id="searchInput"
                        class="block w-full pl-10 pr-3 py-4 border border-slate-200 rounded-xl leading-5 bg-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm shadow-sm transition-all"
                        placeholder="Search for a career (e.g. Data Scientist, Blockchain...)">
                </div>
            </div>

            <!-- Careers Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="careersGrid">
                <% if (careers && careers.length> 0) { %>
                    <% careers.forEach(function(career) { %>
                        <a href="/career-roadmap/<%= encodeURIComponent(career.title) %>"
                            class="glass-card p-6 block group career-item"
                            data-title="<%= career.title.toLowerCase() %>">
                            <div class="flex items-start justify-between mb-4">
                                <div
                                    class="w-12 h-12 rounded-lg bg-indigo-50 flex items-center justify-center text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white transition-colors">
                                    <i class="fas fa-route text-xl"></i>
                                </div>
                                <span
                                    class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                    <i class="fas fa-arrow-trend-up mr-1"></i>
                                    <%= career.growth_rate && career.growth_rate.includes('%') ?
                                        career.growth_rate.split(' ')[0] : ' High' %>
                                </span>
                            </div>
                            <h3
                                class="text-xl font-bold text-slate-800 mb-2 group-hover:text-indigo-600 transition-colors">
                                <%= career.title %>
                            </h3>

                            <!-- Snippet of Required Skills -->
                            <div class="mt-4 flex flex-wrap gap-2">
                                <% const topSkills=career.required_skills ? career.required_skills.slice(0, 3) : [] %>
                                    <% topSkills.forEach(function(skill) { %>
                                        <span
                                            class="px-2 py-1 bg-slate-100 text-slate-600 rounded text-xs font-semibold">
                                            <%= skill.name || skill %>
                                        </span>
                                        <% }); %>
                                            <% if (career.required_skills && career.required_skills.length> 3) { %>
                                                <span
                                                    class="px-2 py-1 bg-slate-50 text-slate-400 border border-slate-200 rounded text-xs font-semibold">+
                                                    <%= career.required_skills.length - 3 %> more
                                                </span>
                                                <% } %>
                            </div>
                        </a>
                        <% }); %>
                            <% } else { %>
                                <div class="col-span-full text-center py-12">
                                    <i class="fas fa-folder-open text-4xl text-slate-300 mb-3"></i>
                                    <h3 class="text-lg font-medium text-slate-900">No careers found</h3>
                                    <p class="mt-1 text-sm text-slate-500">Wait for the database seeder to finish
                                        running, then refresh.</p>
                                </div>
                                <% } %>
            </div>
        </main>

        <script>
            // Simple client-side search filtering
            document.getElementById('searchInput').addEventListener('input', function (e) {
                const term = e.target.value.toLowerCase();
                const items = document.querySelectorAll('.career-item');

                items.forEach(item => {
                    const title = item.getAttribute('data-title');
                    if (title.includes(term)) {
                        item.style.display = 'block';
                    } else {
                        item.style.display = 'none';
                    }
                });
            });
        </script>
</body>

</html>