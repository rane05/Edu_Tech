<%- include('layouts/header'); %>
    <%- include('layouts/navbar'); %>

        <div class="container" style="margin-top: 100px; margin-bottom: 50px;">
            <div class="row">
                <!-- Search Form -->
                <div class="col-md-4">
                    <div class="card p-4 shadow-sm" style="border-radius: 12px;">
                        <h3 class="mb-4">⚛️ JOSAA College Predictor</h3>
                        <div class="alert alert-info">
                            <small>Predicts IITs, NITs, and IIITs based on your All India Rank (CRL) or Category
                                Rank.</small>
                        </div>
                        <form action="/api/jee/predict" method="POST">
                            <div class="mb-3">
                                <label class="form-label fw-bold">JEE Rank (CRL/Category)</label>
                                <input type="number" name="jeeRank" class="form-control" required
                                    placeholder="e.g. 15000" value="<%= locals.jeeRank || '' %>">
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Category</label>
                                <select name="category" class="form-select">
                                    <option value="OPEN" <%=locals.category==='OPEN' ? 'selected' : '' %>>OPEN</option>
                                    <option value="OBC-NCL" <%=locals.category==='OBC-NCL' ? 'selected' : '' %>>OBC-NCL
                                    </option>
                                    <option value="SC" <%=locals.category==='SC' ? 'selected' : '' %>>SC</option>
                                    <option value="ST" <%=locals.category==='ST' ? 'selected' : '' %>>ST</option>
                                </select>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-bold">Institute Type</label>
                                <select name="type" class="form-select">
                                    <option value="All" <%=locals.type==='All' ? 'selected' : '' %>>All Institutes
                                    </option>
                                    <option value="IIT" <%=locals.type==='IIT' ? 'selected' : '' %>>IITs</option>
                                    <option value="NIT" <%=locals.type==='NIT' ? 'selected' : '' %>>NITs</option>
                                    <option value="IIIT" <%=locals.type==='IIIT' ? 'selected' : '' %>>IIITs</option>
                                </select>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold"
                                style="background: linear-gradient(135deg, #00A8FF, #0BC5FF); border:none; border-radius: 8px;">🔮
                                Predict
                                Colleges</button>
                        </form>

                        <% if(locals.error) { %>
                            <div class="alert alert-danger mt-3">
                                <%= error %>
                            </div>
                            <% } %>
                    </div>
                </div>

                <!-- Results Display -->
                <div class="col-md-8">
                    <% if(locals.results && results.length> 0) { %>
                        <h4 class="mb-3">🎯 Recommended Institutes (<%= results.length %>)</h4>
                        <% results.forEach(college=> { %>
                            <div class="card mb-4 shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h5 class="card-title text-primary fw-bold mb-1">
                                                <%= college.name %>
                                            </h5>
                                            <h6 class="card-subtitle text-muted"><i
                                                    class="fas fa-map-marker-alt text-danger"></i>
                                                <%= college.location %> &bull; <span class="badge bg-secondary">
                                                        <%= college.type %>
                                                    </span>
                                            </h6>
                                        </div>
                                        <span class="badge bg-success py-2 px-3" style="font-size: 0.9rem;">
                                            <%= college.rating %> ★
                                        </span>
                                    </div>

                                    <div class="row mt-3 mb-3 bg-light p-2 rounded">
                                        <div class="col-md-6"><small><strong>Estimated Fees:</strong> ₹<%= college.fees
                                                    %></small>
                                        </div>
                                        <div class="col-md-6"><small><strong>Placement Rating:</strong>
                                                <%= college.placement %>/10
                                            </small></div>
                                    </div>

                                    <h6 class="fw-bold text-dark mt-3 mb-2">Eligible Branches for <%= locals.jeeRank %>
                                            Rank (<%= locals.category %>):</h6>
                                    <div class="d-flex flex-wrap gap-2">
                                        <% college.branches.forEach(branch=> { %>
                                            <div class="border rounded p-2 bg-white flex-fill" style="min-width: 45%;">
                                                <div class="fw-bold text-primary mb-1" style="font-size: 0.9rem;">
                                                    <%= branch.name %>
                                                </div>
                                                <div class="d-flex justify-content-between text-muted"
                                                    style="font-size: 0.8rem;">
                                                    <span>Quota: <%= branch.quota %></span>
                                                    <span>Close: <strong>
                                                            <%= branch.closingRank %>
                                                        </strong></span>
                                                </div>
                                            </div>
                                            <% }); %>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                                <% } else if(locals.results) { %>
                                    <div class="alert alert-warning shadow-sm" style="border-radius: 12px;">
                                        <i class="fas fa-exclamation-triangle me-2"></i> No institutes found matching
                                        your rank in the selected category/type. Try relaxing the Institute Type filter.
                                    </div>
                                    <% } else { %>
                                        <div class="text-center text-muted mt-5 pt-5">
                                            <i class="fas fa-university fa-4x mb-4 text-primary opacity-50"></i>
                                            <h4>Enter your JEE Rank to see JOSAA predictions</h4>
                                            <p>Discover which IITs, NITs, and IIITs you can get into based on past year
                                                cutoffs.</p>
                                        </div>
                                        <% } %>
                </div>
            </div>
        </div>

        <%- include('layouts/footer'); %>