<%- include('../layouts/header') %>

    <div class="min-h-screen bg-slate-50 pt-24 pb-12 px-4 flex items-center justify-center">
        <div class="max-w-3xl w-full">
            <div class="text-center mb-10">
                <h1 class="text-4xl font-extrabold text-slate-900 mb-3 tracking-tight">Complete Your College Profile
                </h1>
                <p class="text-slate-500 text-lg">Join our network and start connecting with thousands of students.</p>
            </div>

            <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/60 border border-slate-100 overflow-hidden">
                <div class="bg-indigo-600 p-8 text-white relative overflow-hidden">
                    <div class="relative z-10 flex items-center gap-6">
                        <div
                            class="w-16 h-16 bg-white/20 backdrop-blur-md rounded-2xl flex items-center justify-center text-3xl">
                            <i class="fas fa-university"></i>
                        </div>
                        <div>
                            <h2 class="text-2xl font-bold">Registration Step 2</h2>
                            <p class="text-indigo-100/80">Tell us about your institution</p>
                        </div>
                    </div>
                    <div class="absolute -top-10 -right-10 w-40 h-40 bg-white/10 rounded-full blur-3xl"></div>
                </div>

                <form action="/college/profile/update" method="POST" class="p-10">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div class="space-y-2">
                            <label class="text-sm font-bold text-slate-700 ml-1">College Name</label>
                            <input type="text" name="name"
                                class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all outline-none"
                                placeholder="e.g. Stanford University" required>
                        </div>
                        <div class="space-y-2">
                            <label class="text-sm font-bold text-slate-700 ml-1">Affiliated University</label>
                            <input type="text" name="university"
                                class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all outline-none"
                                placeholder="e.g. State University Board" required>
                        </div>
                        <div class="space-y-2">
                            <label class="text-sm font-bold text-slate-700 ml-1">City/State</label>
                            <input type="text" name="location"
                                class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all outline-none"
                                placeholder="e.g. Mumbai, Maharashtra" required>
                        </div>
                        <div class="space-y-2">
                            <label class="text-sm font-bold text-slate-700 ml-1">Contact Email</label>
                            <input type="email" name="contactEmail"
                                class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all outline-none"
                                placeholder="admissions@college.edu" required>
                        </div>
                        <div class="md:col-span-2 space-y-2">
                            <label class="text-sm font-bold text-slate-700 ml-1">Official Website</label>
                            <input type="url" name="website"
                                class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all outline-none"
                                placeholder="https://www.college.edu">
                        </div>
                        <div class="md:col-span-2 space-y-2">
                            <label class="text-sm font-bold text-slate-700 ml-1">About Your College</label>
                            <textarea name="description" rows="5"
                                class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all outline-none"
                                placeholder="Describe your college, mission, courses offered, and campus life..."
                                required></textarea>
                        </div>
                    </div>

                    <div class="mt-12">
                        <button type="submit"
                            class="w-full py-5 bg-indigo-600 text-white rounded-2xl font-bold text-lg hover:bg-indigo-700 transition-all shadow-xl shadow-indigo-100 flex items-center justify-center gap-3">
                            Launch Dashboard <i class="fas fa-arrow-right"></i>
                        </button>
                        <p class="text-center text-slate-400 text-sm mt-6">
                            <i class="fas fa-info-circle mr-1"></i> You can edit this information anytime from your
                            dashboard.
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <%- include('../layouts/footer') %>