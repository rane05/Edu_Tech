<%- include('../layouts/header') %>

    <div class="min-h-screen bg-slate-50 pt-24 pb-12 px-4 md:px-8">
        <div class="max-w-4xl mx-auto">
            <!-- Explorer Header -->
            <div class="mb-10">
                <h1 class="text-4xl font-black text-slate-900 tracking-tight mb-2">Message Center</h1>
                <p class="text-slate-500 font-bold uppercase tracking-[0.2em] text-[10px]">Student Inquiry Hub</p>
            </div>

            <div
                class="bg-white rounded-[2.5rem] shadow-xl shadow-slate-200/50 border border-slate-100 overflow-hidden">
                <div class="p-8 border-b border-slate-50 bg-slate-50/50 flex justify-between items-center">
                    <div class="flex items-center gap-3">
                        <span class="w-3 h-3 bg-emerald-500 rounded-full"></span>
                        <h2 class="text-xl font-black text-slate-900 tracking-tight">Active Conversations</h2>
                    </div>
                    <div class="search-box relative group">
                        <i
                            class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-300 group-focus-within:text-indigo-500 transition-colors"></i>
                        <input type="text" placeholder="Search students..."
                            class="pl-11 pr-6 py-2.5 bg-white border border-slate-200 rounded-xl text-sm focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-400 font-bold">
                    </div>
                </div>

                <div class="divide-y divide-slate-50">
                    <% if (students.length> 0) { %>
                        <% students.forEach(student=> { %>
                            <a href="/college/chat/<%= student._id %>"
                                class="flex items-center justify-between p-8 hover:bg-slate-50/80 transition-all group">
                                <div class="flex items-center gap-6">
                                    <div
                                        class="w-16 h-16 bg-gradient-to-br from-indigo-50 to-white rounded-2xl flex items-center justify-center text-indigo-600 font-black text-2xl shadow-sm border border-indigo-50 group-hover:scale-110 transition-transform duration-300">
                                        <%= student.username.charAt(0).toUpperCase() %>
                                    </div>
                                    <div>
                                        <h3
                                            class="text-xl font-black text-slate-900 tracking-tight group-hover:text-indigo-600 transition-colors">
                                            <%= student.username %>
                                        </h3>
                                        <p class="text-sm text-slate-400 font-medium italic">
                                            <%= student.email %>
                                        </p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-6">
                                    <div class="text-right hidden md:block">
                                        <p class="text-[10px] font-black text-slate-300 uppercase tracking-widest mb-1">
                                            Last Interaction</p>
                                        <p class="text-xs font-bold text-slate-500">Recently Active</p>
                                    </div>
                                    <div
                                        class="w-12 h-12 flex items-center justify-center bg-white border border-slate-100 rounded-xl text-slate-400 group-hover:bg-indigo-600 group-hover:text-white group-hover:border-indigo-600 transition-all shadow-sm">
                                        <i class="fas fa-chevron-right text-sm"></i>
                                    </div>
                                </div>
                            </a>
                            <% }) %>
                                <% } else { %>
                                    <div class="p-24 text-center">
                                        <div
                                            class="w-24 h-24 bg-slate-50 rounded-[2.5rem] flex items-center justify-center text-slate-200 text-4xl mx-auto mb-6">
                                            <i class="fas fa-comment-slash"></i>
                                        </div>
                                        <h3 class="text-2xl font-black text-slate-900 tracking-tight">No Active Chats
                                        </h3>
                                        <p class="text-slate-500 mt-2 max-w-xs mx-auto font-medium">When students reach
                                            out to your college, they will appear here as active conversations.</p>
                                    </div>
                                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <%- include('../layouts/footer') %>