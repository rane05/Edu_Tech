<%- include('../layouts/header') %>

    <style>
        :root {
            --dashboard-primary: #4F46E5;
            --dashboard-secondary: #7C3AED;
            --glass-bg: rgba(255, 255, 255, 0.7);
            --glass-border: rgba(255, 255, 255, 0.5);
        }

        .premium-bg {
            background-color: #f8fafc;
            background-image: radial-gradient(at 0% 0%, hsla(253, 16%, 7%, 1) 0, transparent 50%),
                radial-gradient(at 50% 0%, hsla(225, 39%, 30%, 1) 0, transparent 50%),
                radial-gradient(at 100% 0%, hsla(339, 49%, 30%, 1) 0, transparent 50%);
            background-attachment: fixed;
        }

        .glass-morphism {
            background: var(--glass-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--glass-border);
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.07);
        }

        .stat-card-premium {
            background: linear-gradient(135deg, #ffffff 0%, #f1f5f9 100%);
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .stat-card-premium:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }

        .btn-grad {
            background: linear-gradient(to right, #4F46E5 0%, #7C3AED 100%);
            transition: 0.5s;
            background-size: 200% auto;
            color: white;
            box-shadow: 0 0 20px #eee;
            border-radius: 12px;
        }

        .btn-grad:hover {
            background-position: right center;
            /* change the direction of the change here */
            color: #fff;
            text-decoration: none;
            transform: translateY(-2px);
        }

        .badge-premium {
            padding: 4px 12px;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .floating {
            animation: floating 3s ease-in-out infinite;
        }

        @keyframes floating {
            0% {
                transform: translateY(0px);
            }

            50% {
                transform: translateY(-10px);
            }

            100% {
                transform: translateY(0px);
            }
        }
    </style>

    <div class="min-h-screen bg-slate-50 pt-24 pb-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto">
            <!-- Premium Dashboard Header -->
            <div class="glass-morphism rounded-3xl p-8 mb-10 relative overflow-hidden">
                <div class="absolute top-0 right-0 w-64 h-64 bg-indigo-500/10 rounded-full -mr-32 -mt-32 blur-3xl">
                </div>
                <div class="absolute bottom-0 left-0 w-64 h-64 bg-purple-500/10 rounded-full -ml-32 -mb-32 blur-3xl">
                </div>

                <div class="relative z-10 flex flex-col lg:flex-row justify-between items-center gap-8">
                    <div class="flex items-center gap-8 text-center lg:text-left flex-col lg:flex-row">
                        <div
                            class="w-24 h-24 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-[2rem] flex items-center justify-center text-white text-4xl shadow-2xl floating">
                            <i class="fas fa-university"></i>
                        </div>
                        <div>
                            <h1 class="text-4xl font-black text-slate-900 tracking-tight mb-2">
                                <%= college.name %>
                            </h1>
                            <p
                                class="text-lg text-slate-500 font-medium flex items-center justify-center lg:justify-start gap-2">
                                <i class="fas fa-map-marker-alt text-indigo-500"></i>
                                <%= college.location %> • <span class="text-slate-400">
                                        <%= college.university %>
                                    </span>
                            </p>
                            <% if (college.isSponsored) { %>
                                <span
                                    class="inline-flex items-center px-4 py-1.5 rounded-full text-[10px] font-black bg-amber-100 text-amber-800 mt-4 uppercase tracking-[0.2em] border border-amber-200">
                                    <i class="fas fa-star mr-1"></i> Sponsored Partner
                                </span>
                                <% } %>
                        </div>
                    </div>

                    <div class="flex flex-wrap justify-center gap-4">
                        <button onclick="document.getElementById('profileModal').classList.remove('hidden')"
                            class="px-8 py-3.5 bg-white border border-slate-200 rounded-2xl text-slate-800 font-bold hover:bg-slate-50 transition-all flex items-center gap-3 shadow-sm hover:shadow-md">
                            <i class="fas fa-magic text-indigo-500"></i> Edit Profile
                        </button>
                        <div class="relative">
                            <a href="/college/chat/list"
                                class="px-8 py-3.5 btn-grad rounded-2xl font-bold flex items-center gap-3 shadow-xl shadow-indigo-200">
                                <i class="fas fa-paper-plane"></i> Messages
                                <% if (unreadMessages> 0) { %>
                                    <span
                                        class="absolute -top-2 -right-2 bg-rose-500 text-white text-[10px] w-6 h-6 flex items-center justify-center rounded-full border-4 border-white font-black">
                                        <%= unreadMessages %>
                                    </span>
                                    <% } %>
                            </a>
                        </div>
                        <a href="/logout"
                            class="px-8 py-3.5 bg-rose-50 border border-rose-200 rounded-2xl text-rose-600 font-bold hover:bg-rose-100 transition-all flex items-center gap-3 shadow-sm hover:shadow-md">
                            <i class="fas fa-sign-out-alt"></i> Logout
                        </a>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
                <!-- Admission Requests Command Center -->
                <div class="lg:col-span-8 space-y-8">
                    <div
                        class="bg-white rounded-[2.5rem] shadow-xl shadow-slate-200/50 border border-slate-100 overflow-hidden">
                        <div class="p-8 border-b border-slate-50 flex justify-between items-center bg-slate-50/50">
                            <div>
                                <h2 class="text-2xl font-black text-slate-900 tracking-tight">Student Applications</h2>
                                <p class="text-slate-400 text-sm font-bold uppercase tracking-widest mt-1">Real-time
                                    enrollment track</p>
                            </div>
                            <div class="flex items-center gap-2">
                                <span
                                    class="px-5 py-2 bg-indigo-50 text-indigo-600 text-xs font-black rounded-2xl border border-indigo-100 uppercase tracking-tighter">
                                    <%= requests.length %> Total
                                </span>
                            </div>
                        </div>

                        <div class="divide-y divide-slate-100">
                            <% if (requests.length> 0) { %>
                                <% requests.forEach(request=> { %>
                                    <div class="p-8 hover:bg-slate-50/80 transition-all duration-300 group">
                                        <div
                                            class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-8">
                                            <div class="flex items-center gap-5">
                                                <div
                                                    class="w-16 h-16 bg-slate-900 text-white rounded-2xl flex items-center justify-center text-xl font-black shadow-lg shadow-slate-200 group-hover:scale-110 transition-transform duration-300">
                                                    <%= request.studentInfo.name.charAt(0) %>
                                                </div>
                                                <div>
                                                    <h3 class="font-black text-slate-900 text-xl tracking-tight">
                                                        <%= request.studentInfo.name %>
                                                    </h3>
                                                    <div class="flex flex-wrap gap-3 mt-1">
                                                        <span
                                                            class="text-sm text-slate-400 font-bold uppercase tracking-tighter">
                                                            <%= request.studentInfo.preferredBranch %>
                                                        </span>
                                                        <span class="text-slate-300">•</span>
                                                        <span class="text-sm text-slate-400 font-medium">
                                                            <%= new Date(request.createdAt).toLocaleDateString() %>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="flex items-center gap-3">
                                                <% if (request.status==='pending' ) { %>
                                                    <form action="/college/request/<%= request._id %>/accepted"
                                                        method="POST">
                                                        <button
                                                            class="px-6 py-2.5 bg-emerald-500 text-white rounded-xl text-xs font-black uppercase tracking-widest hover:bg-emerald-600 transition-all shadow-lg shadow-emerald-100">Approve</button>
                                                    </form>
                                                    <form action="/college/request/<%= request._id %>/rejected"
                                                        method="POST">
                                                        <button
                                                            class="px-6 py-2.5 bg-white border border-rose-200 text-rose-500 rounded-xl text-xs font-black uppercase tracking-widest hover:bg-rose-50 transition-all">Decline</button>
                                                    </form>
                                                    <% } else { %>
                                                        <div
                                                            class="px-5 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-[0.2em] <%= request.status === 'accepted' ? 'bg-emerald-50 text-emerald-600 border border-emerald-200' : 'bg-rose-50 text-rose-600 border border-rose-200' %>">
                                                            <%= request.status %>
                                                        </div>
                                                        <% } %>
                                                            <a href="/college/chat/<%= request.studentId._id %>"
                                                                class="w-12 h-12 flex items-center justify-center bg-indigo-50 text-indigo-600 rounded-xl hover:bg-indigo-600 hover:text-white transition-all shadow-sm"
                                                                title="Open Conversation">
                                                                <i class="fas fa-comment-dots text-lg"></i>
                                                            </a>
                                            </div>
                                        </div>

                                        <div
                                            class="grid grid-cols-2 lg:grid-cols-4 gap-6 bg-white p-6 rounded-3xl border border-slate-100 shadow-sm">
                                            <div>
                                                <p
                                                    class="text-[10px] text-slate-400 font-black uppercase tracking-widest mb-1">
                                                    Grade 10th</p>
                                                <p class="text-slate-800 font-black text-lg">
                                                    <%= request.studentInfo.marks_10th %><span
                                                            class="text-xs text-slate-400">%</span>
                                                </p>
                                            </div>
                                            <div>
                                                <p
                                                    class="text-[10px] text-slate-400 font-black uppercase tracking-widest mb-1">
                                                    Grade 12th</p>
                                                <p class="text-slate-800 font-black text-lg">
                                                    <%= request.studentInfo.marks_12th %><span
                                                            class="text-xs text-slate-400">%</span>
                                                </p>
                                            </div>
                                            <div class="lg:col-span-2">
                                                <p
                                                    class="text-[10px] text-slate-400 font-black uppercase tracking-widest mb-1">
                                                    Student Connection</p>
                                                <p class="text-slate-800 font-bold truncate text-sm">
                                                    <%= request.studentInfo.email %>
                                                </p>
                                                <p
                                                    class="text-indigo-500 font-black text-xs uppercase tracking-tighter mt-0.5">
                                                    <%= request.studentInfo.phone %>
                                                </p>
                                            </div>
                                        </div>

                                        <% if (request.studentInfo.additionalInfo) { %>
                                            <div
                                                class="mt-5 flex items-start gap-3 bg-amber-50/50 p-4 rounded-2xl border border-amber-100/50">
                                                <i class="fas fa-quote-left text-amber-200 mt-1"></i>
                                                <p class="text-slate-600 text-sm leading-relaxed">
                                                    <%= request.studentInfo.additionalInfo %>
                                                </p>
                                            </div>
                                            <% } %>
                                    </div>
                                    <% }) %>
                                        <% } else { %>
                                            <div class="p-24 text-center">
                                                <div
                                                    class="w-24 h-24 bg-slate-50 rounded-[2rem] flex items-center justify-center text-slate-200 text-4xl mx-auto mb-6 shadow-inner">
                                                    <i class="fas fa-inbox-open"></i>
                                                </div>
                                                <h3 class="text-2xl font-black text-slate-900">Quiet for now</h3>
                                                <p class="text-slate-500 mt-2 max-w-xs mx-auto">Admission requests from
                                                    interested students will be listed here in real-time.</p>
                                            </div>
                                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Strategic Sidebar -->
                <div class="lg:col-span-4 space-y-10">
                    <!-- Institution Profile Info -->
                    <div
                        class="bg-white rounded-[2.5rem] shadow-xl shadow-slate-200/50 border border-slate-100 p-8 overflow-hidden relative group">
                        <div
                            class="absolute -top-12 -right-12 w-40 h-40 bg-indigo-50 rounded-full group-hover:scale-150 transition-transform duration-700">
                        </div>

                        <div class="relative z-10">
                            <h2 class="text-xl font-black text-slate-900 mb-8 flex items-center gap-3">
                                <span class="w-1.5 h-6 bg-indigo-600 rounded-full"></span>
                                Official Stats
                            </h2>

                            <div class="space-y-8">
                                <div class="group/item">
                                    <p
                                        class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2 group-hover/item:text-indigo-500 transition-colors">
                                        Digital Home</p>
                                    <a href="<%= college.website %>" target="_blank"
                                        class="text-slate-900 font-bold hover:text-indigo-600 flex items-center justify-between p-4 bg-slate-50 rounded-2xl transition-all border border-transparent hover:border-indigo-100">
                                        <span class="truncate pr-4">
                                            <%= college.website %>
                                        </span>
                                        <i class="fas fa-arrow-right text-[10px]"></i>
                                    </a>
                                </div>

                                <div>
                                    <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">
                                        Admission Contact</p>
                                    <div class="p-4 bg-slate-50 rounded-2xl border border-transparent">
                                        <p class="text-slate-900 font-black">
                                            <%= college.contactEmail %>
                                        </p>
                                    </div>
                                </div>

                                <div>
                                    <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">
                                        Institutional Pitch</p>
                                    <p
                                        class="text-slate-600 text-sm leading-relaxed bg-slate-50/50 p-5 rounded-2xl border border-dashed border-slate-200">
                                        <%= college.description %>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Growth and Promotion Card -->
                    <div
                        class="bg-slate-900 rounded-[2.5rem] shadow-2xl p-10 text-white relative overflow-hidden group">
                        <div
                            class="absolute top-0 right-0 w-64 h-64 bg-indigo-500 rounded-full blur-[100px] opacity-20 transition-all group-hover:opacity-40">
                        </div>

                        <div class="relative z-10 flex flex-col h-full">
                            <div
                                class="w-16 h-16 bg-white/10 rounded-2xl flex items-center justify-center text-indigo-400 text-2xl mb-8">
                                <i class="fas fa-fire-alt"></i>
                            </div>
                            <h2 class="text-3xl font-black mb-4 leading-tight">Scale Your <br>Placement Reach</h2>
                            <p class="text-indigo-200/70 text-sm mb-10 leading-relaxed font-medium">Elevate your
                                institution status. Sponsored colleges enjoy 4x more engagement and high-quality student
                                leads.</p>

                            <button
                                class="w-full py-5 bg-indigo-500 text-white rounded-2xl font-black text-sm tracking-widest uppercase hover:bg-indigo-400 transition-all shadow-xl shadow-indigo-500/20 active:scale-95">
                                Boost Visibility
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Premium Profile Modal -->
    <div id="profileModal"
        class="fixed inset-0 bg-slate-900/60 backdrop-blur-md z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-[3rem] shadow-2xl w-full max-w-2xl overflow-hidden scale-entering">
            <div class="p-8 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                <div>
                    <h2 class="text-2xl font-black text-slate-900 tracking-tight">Update Profile</h2>
                    <p class="text-xs text-slate-400 font-bold uppercase tracking-widest mt-1">Configure your public
                        portal</p>
                </div>
                <button onclick="document.getElementById('profileModal').classList.add('hidden')"
                    class="w-12 h-12 flex items-center justify-center bg-white text-slate-400 hover:text-rose-500 rounded-2xl shadow-sm transition-all">
                    <i class="fas fa-times text-lg"></i>
                </button>
            </div>
            <form action="/college/profile/update" method="POST" class="p-10">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="space-y-3">
                        <label class="text-xs font-black text-slate-600 uppercase tracking-widest ml-1">College
                            Name</label>
                        <input type="text" name="name" value="<%= college.name %>"
                            class="w-full px-6 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 transition-all outline-none font-bold text-slate-800"
                            required>
                    </div>
                    <div class="space-y-3">
                        <label class="text-xs font-black text-slate-600 uppercase tracking-widest ml-1">University
                            Board</label>
                        <input type="text" name="university" value="<%= college.university %>"
                            class="w-full px-6 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 transition-all outline-none font-bold text-slate-800"
                            required>
                    </div>
                    <div class="space-y-3">
                        <label class="text-xs font-black text-slate-600 uppercase tracking-widest ml-1">Campus
                            Location</label>
                        <input type="text" name="location" value="<%= college.location %>"
                            class="w-full px-6 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 transition-all outline-none font-bold text-slate-800"
                            required>
                    </div>
                    <div class="space-y-3">
                        <label class="text-xs font-black text-slate-600 uppercase tracking-widest ml-1">Official
                            Email</label>
                        <input type="email" name="contactEmail" value="<%= college.contactEmail %>"
                            class="w-full px-6 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 transition-all outline-none font-bold text-slate-800"
                            required>
                    </div>
                    <div class="md:col-span-2 space-y-3">
                        <label class="text-xs font-black text-slate-600 uppercase tracking-widest ml-1">Institutional
                            Web Portal</label>
                        <input type="url" name="website" value="<%= college.website %>"
                            class="w-full px-6 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 transition-all outline-none font-bold text-slate-800"
                            placeholder="https://">
                    </div>
                    <div class="md:col-span-2 space-y-3">
                        <label class="text-xs font-black text-slate-600 uppercase tracking-widest ml-1">About the
                            Institution</label>
                        <textarea name="description" rows="4"
                            class="w-full px-6 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 transition-all outline-none font-medium text-slate-700 resize-none"
                            required><%= college.description %></textarea>
                    </div>
                </div>
                <div class="mt-10 flex gap-6">
                    <button type="button" onclick="document.getElementById('profileModal').classList.add('hidden')"
                        class="flex-1 py-5 bg-slate-100 text-slate-500 rounded-2xl font-black text-sm uppercase tracking-widest hover:bg-slate-200 transition-all">Discard</button>
                    <button type="submit"
                        class="flex-1 py-5 bg-indigo-600 text-white rounded-2xl font-black text-sm uppercase tracking-widest hover:bg-indigo-700 transition-all shadow-2xl shadow-indigo-200">Save
                        Configuration</button>
                </div>
            </form>
        </div>
    </div>

    <style>
        @keyframes scale-in {
            from {
                opacity: 0;
                transform: scale(0.9) translateY(20px);
            }

            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        .scale-entering {
            animation: scale-in 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }
    </style>

    <%- include('../layouts/footer') %>