        <!-- Implementation Scripts -->
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                // Inject Dynamic Split Text before GSAP Initialization
                const ctaHeader = document.getElementById('cta-headline');
                if (ctaHeader) {
                    const text = "Ready to Upgrade Your Trajectory?";
                    const words = text.split(' ');
                    words.forEach((word, i) => {
                        const span = document.createElement('span');
                        span.innerText = word + ' ';
                        span.style.display = 'inline-block';
                        span.classList.add('gsap-cta-word');
                        ctaHeader.appendChild(span);
                        if (i === 2) {
                            ctaHeader.appendChild(document.createElement('br'));
                        }
                    });
                }

                // Interactive Card Glows (Mouse follow map/radial gradient)
                const cards = document.querySelectorAll('.cr-card');
                cards.forEach(card => {
                    card.addEventListener('mousemove', (e) => {
                        const rect = card.getBoundingClientRect();
                        const x = e.clientX - rect.left;
                        const y = e.clientY - rect.top;
                        card.style.background = `radial-gradient(circle at ${x}px ${y}px, rgba(79, 70, 229, 0.04) 0%, white 60%)`;
                    });
                    card.addEventListener('mouseleave', () => {
                        card.style.background = 'white';
                        if (card.classList.contains('cr-card-highlight')) {
                            card.style.background = 'linear-gradient(to bottom right, #ffffff, #F5F3FF)';
                        }
                    });
                });

                // Start GSAP Layer
                if (typeof gsap !== "undefined" && typeof ScrollTrigger !== "undefined") {
                    gsap.registerPlugin(ScrollTrigger);

                    // Initial states
                    gsap.set(".gsap-hero-el", { y: 30, opacity: 0 });
                    gsap.set(".gsap-reveal", { y: 40, opacity: 0, visibility: "visible" });
                    gsap.set(".gsap-cta-word", { y: 30, opacity: 0, rotationX: -45 });

                    // --- 1. Hero Entrance Animation ---
                    const heroTl = gsap.timeline({ defaults: { ease: "power3.out" } });

                    heroTl.to(".gsap-hero-el", {
                        y: 0,
                        opacity: 1,
                        duration: 1,
                        stagger: 0.15,
                        delay: 0.2
                    })
                        .fromTo("#hero-mockup",
                            { y: 40, opacity: 0, rotateX: 10 },
                            { y: 0, opacity: 1, rotateX: 5, duration: 1.5 },
                            "-=1.2"
                        );

                    // Floating mockup
                    gsap.to("#hero-mockup", {
                        y: "+=15",
                        duration: 3,
                        yoyo: true,
                        repeat: -1,
                        ease: "sine.inOut"
                    });

                    // Mouse parallax for mockup
                    const heroSection = document.querySelector('.cr-hero');
                    const mockup = document.getElementById('hero-mockup');

                    if (heroSection && mockup) {
                        heroSection.addEventListener('mousemove', (e) => {
                            if (window.innerWidth > 1024) {
                                const xPos = (e.clientX / window.innerWidth - 0.5) * 20;
                                const yPos = (e.clientY / window.innerHeight - 0.5) * 20;

                                gsap.to(mockup, {
                                    rotateY: xPos - 5,
                                    rotateX: -yPos + 5,
                                    duration: 0.5,
                                    ease: "power2.out"
                                });
                            }
                        });
                        heroSection.addEventListener('mouseleave', () => {
                            gsap.to(mockup, { rotateY: -5, rotateX: 5, duration: 1, ease: "power3.out" });
                        });
                    }

                    // --- 2. Scroll Reveals ---
                    const revealElements = document.querySelectorAll('.gsap-reveal');
                    revealElements.forEach((el) => {
                        gsap.to(el, {
                            scrollTrigger: {
                                trigger: el,
                                start: "top 85%",
                                toggleActions: "play none none reverse"
                            },
                            y: 0,
                            opacity: 1,
                            duration: 0.8,
                            ease: "power3.out"
                        });
                    });

                    // --- 3. Progress Section Counters ---
                    ScrollTrigger.create({
                        trigger: ".cr-dark-block",
                        start: "top 75%",
                        onEnter: () => {
                            gsap.to(".gsap-progress-fill", { width: "70%", duration: 1.5, ease: "power3.inOut" });

                            const counters = document.querySelectorAll('.gsap-counter');
                            counters.forEach(counter => {
                                const target = parseInt(counter.getAttribute('data-target'));
                                gsap.to(counter, {
                                    innerHTML: target,
                                    duration: 2,
                                    snap: { innerHTML: 1 },
                                    ease: "power2.out"
                                });
                            });
                        }
                    });

                    // --- 4. How It Works - Scroll Connector ---
                    const stepsWrp = document.querySelector(".cr-steps-wrapper");
                    if (stepsWrp) {
                        const stepTl = gsap.timeline({
                            scrollTrigger: {
                                trigger: stepsWrp,
                                start: "top 70%",
                                end: "bottom 50%",
                                scrub: 1
                            }
                        });

                        stepTl.to("#step-connector", {
                            width: "100%",
                            ease: "none"
                        });

                        ScrollTrigger.create({
                            trigger: stepsWrp,
                            start: "top 60%",
                            onEnter: () => { document.getElementById('step-1').classList.add('is-active'); }
                        });
                        ScrollTrigger.create({
                            trigger: stepsWrp,
                            start: "top 30%",
                            onEnter: () => { document.getElementById('step-2').classList.add('is-active'); }
                        });
                        ScrollTrigger.create({
                            trigger: stepsWrp,
                            start: "top 10%",
                            onEnter: () => { document.getElementById('step-3').classList.add('is-active'); }
                        });
                    }

                    // --- 5. Infinite Testimonials Carousel ---
                    const track = document.getElementById("testimonial-track");
                    if (track) {
                        // Track width / 2 because we duplicated the cards
                        const scrollTween = gsap.to(track, {
                            x: "-=" + (400 * 3 + 32 * 3) + "px", // Approximate width of 3 cards + gaps
                            duration: 20,
                            ease: "none",
                            repeat: -1,
                            modifiers: {
                                x: gsap.utils.unitize(x => parseFloat(x) % (400 * 3 + 32 * 3)) // Wrap logic
                            }
                        });

                        track.addEventListener("mouseenter", () => scrollTween.pause());
                        track.addEventListener("mouseleave", () => scrollTween.play());
                    }

                    // --- 6. Final CTA Text Animation ---
                    gsap.to(".gsap-cta-word", {
                        scrollTrigger: {
                            trigger: ".cr-final-cta",
                            start: "top 80%"
                        },
                        y: 0,
                        opacity: 1,
                        rotationX: 0,
                        stagger: 0.1,
                        duration: 0.8,
                        ease: "back.out(1.7)"
                    });
                }
            });
        </script>

