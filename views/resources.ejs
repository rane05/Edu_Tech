<%- include('layouts/header'); %>
  <%- include('layouts/navbar'); %>

    <style>
      :root {
        --color-primary: #FFB800;
        --color-secondary: #00A8FF;
        --color-accent: #6C63FF;
        --color-dark: #1A1A2E;
        --color-text: #2D3748;
        --color-text-light: #718096;
        --color-bg: #FFFFFF;
        --color-bg-light: #F7FAFC;
        --color-bg-dark: #16213E;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', sans-serif;
        color: var(--color-text);
        line-height: 1.6;
        background: var(--color-bg);
      }

      /* Hero Section */
      .resources-hero {
        padding: 100px 20px 60px;
        background: var(--color-bg-light);
        text-align: center;
      }

      .hero-title {
        font-size: clamp(2.5rem, 5vw, 3.5rem);
        font-weight: 800;
        color: var(--color-dark);
        margin-bottom: 15px;
      }

      .hero-subtitle {
        font-size: 1.125rem;
        color: var(--color-text-light);
        margin-bottom: 60px;
      }

      /* Two Big Cards Layout */
      .resource-hero-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 40px;
        max-width: 1200px;
        margin: 0 auto;
      }

      .resource-hero-card {
        background: white;
        padding: 50px 40px;
        border-radius: 20px;
        text-align: left;
        position: relative;
        overflow: hidden;
        min-height: 300px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        transition: all 0.3s ease;
        text-decoration: none;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(0, 0, 0, 0.05);
      }

      .resource-hero-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.1);
      }

      /* Specific Card Styles */
      .card-webinar {
        border-bottom: 5px solid var(--color-primary);
      }

      .card-webinar .card-icon-bg {
        background: rgba(255, 184, 0, 0.1);
        color: var(--color-primary);
      }

      .card-hub {
        border-bottom: 5px solid var(--color-secondary);
      }

      .card-hub .card-icon-bg {
        background: rgba(0, 168, 255, 0.1);
        color: var(--color-secondary);
      }

      .card-icon-bg {
        position: absolute;
        top: 40px;
        right: 40px;
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
      }

      .hero-card-tag {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 15px;
        align-self: flex-start;
      }

      .card-webinar .hero-card-tag {
        background: rgba(255, 184, 0, 0.1);
        color: #D97706;
      }

      .card-hub .hero-card-tag {
        background: rgba(0, 168, 255, 0.1);
        color: #0284C7;
      }

      .hero-card-title {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 10px;
        color: var(--color-dark);
      }

      .hero-card-subtitle {
        font-size: 1.05rem;
        color: var(--color-text-light);
      }

      /* Grid Sections */
      .features-section {
        padding: 80px 20px;
        background: white;
      }

      .section-header {
        text-align: left;
        margin-bottom: 40px;
        max-width: 1200px;
        margin-left: auto;
        margin-right: auto;
      }

      .section-header h2 {
        font-size: 2rem;
        font-weight: 700;
        color: var(--color-dark);
        display: flex;
        align-items: center;
        gap: 15px;
      }

      .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 30px;
        max-width: 1200px;
        margin: 0 auto;
      }

      .feature-card {
        background: white;
        border-radius: 15px;
        padding: 30px;
        border: 1px solid #E2E8F0;
        transition: all 0.3s ease;
      }

      .feature-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        border-color: var(--color-secondary);
      }

      .card-icon {
        width: 60px;
        height: 60px;
        background: var(--color-bg-light);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: var(--color-primary);
        margin-bottom: 20px;
      }

      .feature-card h3 {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--color-dark);
        margin-bottom: 15px;
      }

      .feature-card p {
        color: var(--color-text-light);
        margin-bottom: 20px;
        font-size: 0.95rem;
      }

      .btn-link {
        color: var(--color-secondary);
        text-decoration: none;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s;
      }

      .btn-link:hover {
        color: var(--color-primary);
        gap: 12px;
      }

      /* Footer (Matching Home) */
      .footer {
        background: var(--color-bg-dark);
        color: white;
        padding: 60px 20px 30px;
      }

      .footer-container {
        max-width: 1200px;
        margin: 0 auto;
      }

      .footer-top {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
        gap: 40px;
        margin-bottom: 40px;
      }

      .footer-column h3 {
        font-size: 1.125rem;
        margin-bottom: 20px;
        color: white;
      }

      .footer-column ul {
        list-style: none;
      }

      .footer-column ul li {
        margin-bottom: 10px;
      }

      .footer-column a {
        color: rgba(255, 255, 255, 0.7);
        text-decoration: none;
        transition: color 0.3s;
      }

      .footer-column a:hover {
        color: white;
      }

      .newsletter-form {
        display: flex;
        gap: 10px;
        margin-top: 20px;
      }

      .newsletter-form input {
        flex: 1;
        padding: 12px 20px;
        border: none;
        border-radius: 25px;
        outline: none;
      }

      .newsletter-form button {
        padding: 12px 30px;
        background: var(--color-primary);
        color: white;
        border: none;
        border-radius: 25px;
        font-weight: 600;
        cursor: pointer;
      }

      .footer-bottom {
        padding-top: 30px;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        text-align: center;
        color: rgba(255, 255, 255, 0.6);
      }

      /* Responsive */
      @media (max-width: 992px) {
        .resource-hero-grid {
          grid-template-columns: 1fr;
        }

        .footer-top {
          grid-template-columns: 1fr;
        }
      }
    </style>

    <!-- Hero Section with Two Big Cards -->
    <section class="resources-hero">
      <div class="container">
        <h1 class="hero-title">Explore Our <span>Resources</span></h1>
        <p class="hero-subtitle">Expert guides, webinars, and tools to help you succeed.</p>

        <div class="resource-hero-grid">
          <!-- Webinar Card -->
          <a href="/webinars" class="resource-hero-card card-webinar">
            <div class="card-icon-bg"><i class="fas fa-video"></i></div>
            <span class="hero-card-tag">Live Learning</span>
            <h2 class="hero-card-title">Webinars & Workshops</h2>
            <p class="hero-card-subtitle">Join expert sessions on career planning, tech trends, and skill building.</p>
          </a>

          <!-- Resource Hub Card -->
          <a href="#resource-hub" class="resource-hero-card card-hub">
            <div class="card-icon-bg"><i class="fas fa-book-reader"></i></div>
            <span class="hero-card-tag">Library</span>
            <h2 class="hero-card-title">Career Resource Hub</h2>
            <p class="hero-card-subtitle">Access a vast library of articles, guides, and industry reports.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- Resource Hub Section -->
    <section id="resource-hub" class="features-section">
      <div class="container">

        <!-- Search Bar -->
        <div style="max-width: 600px; margin: 0 auto 60px; position: relative;">
          <form action="/search" method="GET">
            <input type="text" name="q" placeholder="Search for resources, tools, guides..."
              style="width: 100%; padding: 15px 50px 15px 25px; border-radius: 50px; border: 1px solid #E2E8F0; background: white; outline: none; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
            <button type="submit"
              style="position: absolute; right: 20px; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--color-text-light); cursor: pointer;">
              <i class="fas fa-search"></i>
            </button>
          </form>
        </div>

        <!-- Career Assessment Tools -->
        <div class="section-header">
          <h2><i class="fas fa-clipboard-check" style="color: var(--color-accent);"></i> Career Assessment Tools</h2>
        </div>

        <div class="cards-grid">
          <div class="feature-card">
            <div class="card-icon"><i class="fas fa-users"></i></div>
            <h3>Myers-Briggs (MBTI)</h3>
            <p>Discover your personality type and find careers that match your preferences and strengths.</p>
            <a href="https://www.16personalities.com/" target="_blank" class="btn-link">Take Test <i
                class="fas fa-arrow-right"></i></a>
          </div>

          <div class="feature-card">
            <div class="card-icon" style="color: var(--color-secondary);"><i class="fas fa-heart"></i></div>
            <h3>Strong Interest Inventory</h3>
            <p>Explore your interests and find career paths that align with your passions.</p>
            <a href="#" class="btn-link">Learn More <i class="fas fa-arrow-right"></i></a>
          </div>

          <div class="feature-card">
            <div class="card-icon" style="color: var(--color-accent);"><i class="fas fa-layer-group"></i></div>
            <h3>Skills Assessment</h3>
            <p>Evaluate your current skills and identify areas for improvement.</p>
            <a href="#" class="btn-link">Start Assessment <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
      </div>
    </section>

    <!-- Additional Resources Section -->
    <section class="features-section" style="padding-top: 0;">
      <div class="container">
        <div class="section-header">
          <h2><i class="fas fa-graduation-cap" style="color: var(--color-primary);"></i> Learning Resources</h2>
        </div>

        <div class="cards-grid">
          <div class="feature-card">
            <div class="card-icon"><i class="fas fa-laptop-code"></i></div>
            <h3>Online Courses</h3>
            <p>Access thousands of courses from top universities and institutions.</p>
            <a href="https://www.coursera.org/" target="_blank" class="btn-link">Browse Courses <i
                class="fas fa-arrow-right"></i></a>
          </div>

          <div class="feature-card">
            <div class="card-icon" style="color: var(--color-secondary);"><i class="fas fa-award"></i></div>
            <h3>Industry Certifications</h3>
            <p>Find relevant certifications to validate your skills and boost your resume.</p>
            <a href="#" class="btn-link">View Certs <i class="fas fa-arrow-right"></i></a>
          </div>

          <div class="feature-card">
            <div class="card-icon" style="color: var(--color-accent);"><i class="fas fa-file-alt"></i></div>
            <h3>Resume Building</h3>
            <p>Create a professional resume with our templates and AI-powered guides.</p>
            <a href="/resume-builder" class="btn-link">Build Resume <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <div class="footer-container">
        <div class="footer-top">
          <div class="footer-column">
            <h3>EduNavigator</h3>
            <p style="color: rgba(255,255,255,0.7); margin-top: 20px;">Your AI-powered guide to career success and
              college admissions.</p>
            <div class="newsletter-form">
              <input type="email" placeholder="Enter your email">
              <button>Subscribe</button>
            </div>
          </div>
          <div class="footer-column">
            <h3>Product</h3>
            <ul>
              <li><a href="#">Career Counseling</a></li>
              <li><a href="#">College Finder</a></li>
              <li><a href="#">Scholarships</a></li>
              <li><a href="#">Projects</a></li>
            </ul>
          </div>
          <div class="footer-column">
            <h3>Company</h3>
            <ul>
              <li><a href="#">About Us</a></li>
              <li><a href="#">Careers</a></li>
              <li><a href="#">Blog</a></li>
              <li><a href="#">Contact</a></li>
            </ul>
          </div>
          <div class="footer-column">
            <h3>Resources</h3>
            <ul>
              <li><a href="#">Help Center</a></li>
              <li><a href="#">FAQs</a></li>
              <li><a href="#">Guides</a></li>
              <li><a href="#">Webinars</a></li>
            </ul>
          </div>
          <div class="footer-column">
            <h3>Legal</h3>
            <ul>
              <li><a href="#">Privacy Policy</a></li>
              <li><a href="#">Terms of Service</a></li>
              <li><a href="#">Cookie Policy</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <p>&copy; 2024 EduNavigator. All rights reserved.</p>
        </div>
      </div>
    </footer>