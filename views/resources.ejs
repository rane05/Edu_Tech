<%- include('layouts/header'); %>
    <%- include('layouts/navbar'); %>

        <!-- GSAP + ScrollTrigger -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

        <style>
            /* Base Reset & Variables */
            :root {
                --primary: #4F46E5;
                --primary-light: #6366f1;
                --accent: #14B8A6;
                --dark: #111827;
                --dark-surface: #1F2937;
                --light-bg: #F9FAFB;
                --text-primary: #1E293B;
                --text-secondary: #64748B;
                --gray-100: #F1F5F9;
                --gray-200: #E2E8F0;
                --gray-300: #CBD5E1;
                --radius: 16px;
                --transition-smooth: cubic-bezier(0.22, 1, 0.36, 1);
                --shadow-soft: 0 10px 40px -10px rgba(0, 0, 0, 0.05);
                --shadow-hover: 0 20px 40px -10px rgba(79, 70, 229, 0.15);
            }

            /* We are stripping Tailwind for this specific page structure */
            .cr-page {
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                color: var(--text-primary);
                background-color: var(--light-bg);
                overflow-x: hidden;
                line-height: 1.5;
            }

            .cr-container {
                max-width: 1280px;
                margin: 0 auto;
                padding: 0 24px;
                position: relative;
                z-index: 2;
            }

            /* 12-Column Grid System */
            .cr-grid {
                display: grid;
                grid-template-columns: repeat(12, 1fr);
                gap: 32px;
            }

            /* Typography */
            .cr-h1 {
                font-size: 56px;
                font-weight: 800;
                line-height: 1.1;
                letter-spacing: -0.02em;
                color: var(--dark);
                margin: 0;
            }

            .cr-h2 {
                font-size: 36px;
                font-weight: 700;
                line-height: 1.2;
                letter-spacing: -0.01em;
                color: var(--dark);
                margin: 0;
            }

            .cr-h3 {
                font-size: 24px;
                font-weight: 600;
                line-height: 1.3;
                color: var(--dark);
                margin: 0;
            }

            .cr-body-large {
                font-size: 18px;
                color: var(--text-secondary);
                line-height: 1.6;
            }

            .cr-body {
                font-size: 16px;
                color: var(--text-secondary);
                line-height: 1.5;
            }

            /* Buttons */
            .cr-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 14px 28px;
                border-radius: 12px;
                font-size: 16px;
                font-weight: 600;
                text-decoration: none;
                transition: all 0.3s var(--transition-smooth);
                cursor: pointer;
                border: none;
            }

            .cr-btn-primary {
                background: var(--primary);
                color: #fff;
                box-shadow: 0 4px 14px 0 rgba(79, 70, 229, 0.39);
            }

            .cr-btn-primary:hover {
                background: var(--primary-light);
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(79, 70, 229, 0.23);
                color: white;
            }

            .cr-btn-secondary {
                background: #fff;
                color: var(--text-primary);
                border: 1px solid var(--gray-200);
                box-shadow: 0 2px 5px rgba(0, 0, 0, 0.02);
            }

            .cr-btn-secondary:hover {
                border-color: var(--gray-300);
                background: var(--gray-100);
                transform: translateY(-2px);
                color: var(--text-primary);
            }

            /* 1. Hero Section */
            .cr-hero {
                position: relative;
                padding: 180px 0 100px;
                background: radial-gradient(circle at 80% 20%, rgba(20, 184, 166, 0.05) 0%, transparent 40%),
                    radial-gradient(circle at 20% 80%, rgba(79, 70, 229, 0.05) 0%, transparent 40%);
            }

            .cr-hero-content {
                grid-column: 1 / 7;
                display: flex;
                flex-direction: column;
                justify-content: center;
                position: relative;
                z-index: 10;
            }

            .cr-hero-visual {
                grid-column: 8 / 13;
                position: relative;
                perspective: 1000px;
            }

            /* Micro Badge */
            .cr-badge {
                display: inline-flex;
                align-items: center;
                padding: 6px 14px;
                background: rgba(79, 70, 229, 0.1);
                color: var(--primary);
                border-radius: 100px;
                font-size: 14px;
                font-weight: 600;
                margin-bottom: 24px;
                width: max-content;
                border: 1px solid rgba(79, 70, 229, 0.2);
            }

            /* Split Highlight */
            .cr-text-gradient {
                background: linear-gradient(135deg, var(--primary), var(--accent));
                -webkit-background-clip: text;
                background-clip: text;
                -webkit-text-fill-color: transparent;
                display: inline-block;
            }

            .cr-hero-actions {
                display: flex;
                gap: 16px;
                margin-top: 40px;
                align-items: center;
            }

            .cr-trust-line {
                margin-top: 32px;
                font-size: 14px;
                color: var(--text-secondary);
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .cr-avatars {
                display: flex;
            }

            .cr-avatars img {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                border: 2px solid white;
                margin-left: -12px;
            }

            .cr-avatars img:first-child {
                margin-left: 0;
            }

            /* Dashboard Mockup Component */
            .cr-mockup-wrapper {
                position: relative;
                width: 100%;
                transform-style: preserve-3d;
            }

            .cr-mockup-glow {
                position: absolute;
                top: 50%;
                left: 50%;
                width: 100%;
                height: 100%;
                transform: translate(-50%, -50%);
                background: radial-gradient(circle, rgba(79, 70, 229, 0.15) 0%, transparent 60%);
                filter: blur(40px);
                z-index: 1;
            }

            .cr-mockup {
                background: white;
                border-radius: 20px;
                box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
                border: 1px solid rgba(0, 0, 0, 0.05);
                padding: 24px;
                position: relative;
                z-index: 2;
                transform: rotateY(-5deg) rotateX(5deg);
                transition: transform 0.1s;
            }

            .cr-mockup-header {
                display: flex;
                gap: 8px;
                margin-bottom: 24px;
            }

            .cr-mockup-dot {
                width: 12px;
                height: 12px;
                border-radius: 50%;
                background: #E2E8F0;
            }

            .cr-mockup-dot:nth-child(1) {
                background: #EF4444;
            }

            .cr-mockup-dot:nth-child(2) {
                background: #F59E0B;
            }

            .cr-mockup-dot:nth-child(3) {
                background: #10B981;
            }

            .cr-mock-line {
                height: 12px;
                background: #F1F5F9;
                border-radius: 6px;
                margin-bottom: 12px;
            }

            .cr-mock-line.w-full {
                width: 100%;
            }

            .cr-mock-line.w-3-4 {
                width: 75%;
            }

            .cr-mock-line.w-1-2 {
                width: 50%;
            }

            .cr-mock-card-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 16px;
                margin-top: 24px;
            }

            .cr-mock-card {
                background: #F8FAFC;
                border: 1px solid #E2E8F0;
                border-radius: 12px;
                height: 80px;
            }

            /* 2. Feature Cards Section */
            .cr-section {
                padding: 120px 0;
            }

            .cr-section-header {
                text-align: center;
                max-width: 600px;
                margin: 0 auto 64px;
            }

            .cr-cards-grid {
                grid-template-columns: repeat(12, 1fr);
            }

            .cr-card {
                grid-column: span 6;
                background: white;
                border-radius: var(--radius);
                padding: 40px;
                border: 1px solid var(--gray-200);
                position: relative;
                overflow: hidden;
                transition: all 0.3s var(--transition-smooth);
                box-shadow: var(--shadow-soft);
                display: flex;
                flex-direction: column;
            }

            .cr-card:hover {
                transform: translateY(-6px);
                box-shadow: var(--shadow-hover);
                border-color: rgba(79, 70, 229, 0.3);
            }

            .cr-card-icon {
                width: 56px;
                height: 56px;
                border-radius: 16px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 24px;
                margin-bottom: 24px;
                transition: transform 0.3s var(--transition-smooth);
            }

            .cr-card:hover .cr-card-icon {
                transform: scale(1.05);
            }

            .cr-card-p1 .cr-card-icon {
                background: rgba(79, 70, 229, 0.1);
                color: var(--primary);
            }

            .cr-card-p2 .cr-card-icon {
                background: rgba(20, 184, 166, 0.1);
                color: var(--accent);
            }

            .cr-card-p3 .cr-card-icon {
                background: rgba(245, 158, 11, 0.1);
                color: #F59E0B;
            }

            .cr-card-p4 .cr-card-icon {
                background: rgba(236, 72, 153, 0.1);
                color: #EC4899;
            }

            .cr-card h3 {
                margin-bottom: 12px;
            }

            .cr-card p {
                margin-bottom: 24px;
                flex-grow: 1;
            }

            .cr-card-link {
                font-weight: 600;
                color: var(--primary);
                display: inline-flex;
                align-items: center;
                gap: 8px;
                text-decoration: none;
                position: relative;
                width: max-content;
            }

            .cr-card-link::after {
                content: '';
                position: absolute;
                bottom: -2px;
                left: 0;
                width: 0%;
                height: 2px;
                background: var(--primary);
                transition: width 0.3s var(--transition-smooth);
            }

            .cr-card:hover .cr-card-link::after {
                width: 100%;
            }

            /* Accent Highlight Card */
            .cr-card-highlight {
                background: linear-gradient(to bottom right, #ffffff, #F5F3FF);
                border-color: rgba(79, 70, 229, 0.2);
            }

            .cr-card-highlight::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                border: 2px solid var(--primary);
                border-radius: var(--radius);
                opacity: 0;
                transition: opacity 0.3s;
                pointer-events: none;
            }

            .cr-card-highlight:hover::before {
                opacity: 0.2;
            }

            .cr-popular-badge {
                position: absolute;
                top: 24px;
                right: 24px;
                background: rgba(79, 70, 229, 0.1);
                color: var(--primary);
                padding: 6px 14px;
                border-radius: 100px;
                font-size: 13px;
                font-weight: 700;
                animation: cr-pulse 2s infinite;
            }

            @keyframes cr-pulse {
                0% {
                    box-shadow: 0 0 0 0 rgba(79, 70, 229, 0.4);
                }

                70% {
                    box-shadow: 0 0 0 8px rgba(79, 70, 229, 0);
                }

                100% {
                    box-shadow: 0 0 0 0 rgba(79, 70, 229, 0);
                }
            }

            /* 3. Progress Section - Dark Block */
            .cr-dark-block {
                background-color: var(--dark);
                border-radius: 24px;
                padding: 80px;
                color: white;
                position: relative;
                overflow: hidden;
                margin: 60px auto;
            }

            .cr-dark-pattern {
                position: absolute;
                inset: 0;
                background-image: radial-gradient(rgba(255, 255, 255, 0.15) 1px, transparent 1px);
                background-size: 24px 24px;
                opacity: 0.5;
            }

            .cr-dark-glow {
                position: absolute;
                top: -50%;
                right: -20%;
                width: 600px;
                height: 600px;
                background: radial-gradient(circle, rgba(79, 70, 229, 0.2) 0%, transparent 70%);
                border-radius: 50%;
            }

            .cr-dark-grid {
                grid-template-columns: repeat(12, 1fr);
                position: relative;
                z-index: 10;
                align-items: center;
            }

            .cr-dark-left {
                grid-column: 1 / 6;
            }

            .cr-dark-left .cr-h2 {
                color: #fff;
            }

            .cr-dark-left .cr-body-large {
                color: #9CA3AF;
                margin-top: 16px;
            }

            .cr-dark-right {
                grid-column: 7 / 13;
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 24px;
            }

            .cr-stat-card {
                background: rgba(255, 255, 255, 0.03);
                border: 1px solid rgba(255, 255, 255, 0.05);
                backdrop-filter: blur(10px);
                border-radius: 16px;
                padding: 32px 24px;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

            .cr-stat-val {
                font-size: 48px;
                font-weight: 800;
                line-height: 1;
                color: white;
                margin-bottom: 8px;
            }

            .cr-stat-label {
                font-size: 14px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                color: var(--accent);
            }

            /* 4. How It Works */
            .cr-steps-wrapper {
                display: flex;
                justify-content: space-between;
                position: relative;
                margin-top: 60px;
            }

            .cr-step-connector {
                position: absolute;
                top: 36px;
                left: 10%;
                right: 10%;
                height: 2px;
                background: var(--gray-200);
                z-index: 1;
            }

            .cr-step-connector-active {
                position: absolute;
                top: 0;
                left: 0;
                bottom: 0;
                width: 0%;
                background: var(--primary);
            }

            .cr-step {
                width: 30%;
                text-align: center;
                position: relative;
                z-index: 2;
            }

            .cr-step-icon {
                width: 72px;
                height: 72px;
                background: white;
                border: 2px solid var(--gray-200);
                border-radius: 50%;
                margin: 0 auto 24px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 24px;
                color: var(--primary);
                transition: all 0.3s;
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            }

            .cr-step.is-active .cr-step-icon {
                border-color: var(--primary);
                background: rgba(79, 70, 229, 0.05);
                transform: scale(1.1);
            }

            .cr-step-title {
                font-size: 20px;
                font-weight: 700;
                color: var(--dark);
                margin-bottom: 12px;
            }

            /* 5. Testimonials Carousel */
            .cr-testimonials {
                overflow: hidden;
                padding: 20px 0;
                mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
                -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
            }

            .cr-testi-track {
                display: flex;
                gap: 32px;
                width: max-content;
            }

            .cr-testi-card {
                width: 400px;
                background: white;
                border: 1px solid var(--gray-200);
                border-radius: var(--radius);
                padding: 40px 32px;
                box-shadow: var(--shadow-soft);
                position: relative;
                transition: transform 0.3s;
            }

            .cr-testi-card:hover {
                transform: translateY(-4px);
                box-shadow: var(--shadow-hover);
            }

            .cr-quote-mark {
                position: absolute;
                top: 16px;
                right: 24px;
                font-size: 80px;
                color: rgba(79, 70, 229, 0.08);
                font-family: serif;
                line-height: 1;
                pointer-events: none;
            }

            .cr-testi-text {
                font-size: 16px;
                color: var(--text-primary);
                font-style: italic;
                margin-bottom: 32px;
                position: relative;
                z-index: 2;
                line-height: 1.6;
            }

            .cr-testi-author {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .cr-testi-author img {
                width: 56px;
                height: 56px;
                border-radius: 50%;
                object-fit: cover;
            }

            .cr-testi-name {
                font-weight: 700;
                color: var(--dark);
                font-size: 16px;
            }

            .cr-testi-role {
                font-size: 14px;
                color: var(--text-secondary);
            }

            /* 6. Final CTA */
            .cr-final-cta {
                text-align: center;
                padding: 160px 0;
                background: linear-gradient(to bottom, transparent, #EEF2FF);
                position: relative;
                overflow: hidden;
            }

            .cr-cta-glow {
                position: absolute;
                bottom: -100px;
                left: 50%;
                transform: translateX(-50%);
                width: 800px;
                height: 400px;
                background: radial-gradient(ellipse, rgba(79, 70, 229, 0.25) 0%, transparent 60%);
                filter: blur(50px);
            }

            /* GSAP Hidden States */
            .gsap-reveal {
                opacity: 0;
                visibility: hidden;
            }

            @media (max-width: 1024px) {
                .cr-hero-content {
                    grid-column: 1 / 13;
                    text-align: center;
                    align-items: center;
                }

                .cr-hero-actions {
                    justify-content: center;
                }

                .cr-hero-visual {
                    display: none;
                }

                .cr-card {
                    grid-column: span 12;
                }

                .cr-dark-left {
                    grid-column: 1 / 13;
                    text-align: center;
                    margin-bottom: 40px;
                }

                .cr-dark-right {
                    grid-column: 1 / 13;
                }
            }

            @media (max-width: 768px) {
                .cr-h1 {
                    font-size: 40px;
                }

                .cr-steps-wrapper {
                    flex-direction: column;
                    gap: 40px;
                }

                .cr-step {
                    width: 100%;
                }

                .cr-step-connector {
                    display: none;
                }

                .cr-dark-block {
                    padding: 40px 24px;
                }

                .cr-dark-right {
                    grid-template-columns: 1fr;
                }

                .cr-testi-card {
                    width: 320px;
                }
            }
        </style>

        <div class="cr-page">
            <div class="cr-container">

                <!-- 1. Hero Section -->
                <section class="cr-hero cr-grid">
                    <div class="cr-hero-content">
                        <div class="cr-badge gsap-hero-el">Career Acceleration Platform</div>
                        <h1 class="cr-h1 gsap-hero-el">
                            Build Your Career.<br>
                            <span class="cr-text-gradient">Engineered for Success.</span>
                        </h1>
                        <p class="cr-body-large gsap-hero-el" style="margin-top: 24px; max-width: 480px;">
                            The tools, structure, and insights you need to land your dream role. Designed for serious
                            engineering students and professionals.
                        </p>
                        <div class="cr-hero-actions gsap-hero-el">
                            <a href="#roadmaps" class="cr-btn cr-btn-primary">Explore Roadmaps</a>
                            <a href="#" class="cr-btn cr-btn-secondary"><i class="fas fa-play"
                                    style="margin-right: 8px;"></i> Watch Demo</a>
                        </div>
                        <div class="cr-trust-line gsap-hero-el">
                            <div class="cr-avatars">
                                <img src="https://i.pravatar.cc/100?img=1" alt="User">
                                <img src="https://i.pravatar.cc/100?img=2" alt="User">
                                <img src="https://i.pravatar.cc/100?img=3" alt="User">
                                <img src="https://i.pravatar.cc/100?img=4" alt="User">
                            </div>
                            <span>Trusted by <strong>2,000+</strong> ambitious learners</span>
                        </div>
                    </div>

                    <div class="cr-hero-visual gsap-hero-el" id="hero-mockup-container">
                        <div class="cr-mockup-wrapper" id="hero-mockup">
                            <div class="cr-mockup-glow"></div>
                            <div class="cr-mockup">
                                <div class="cr-mockup-header">
                                    <div class="cr-mockup-dot"></div>
                                    <div class="cr-mockup-dot"></div>
                                    <div class="cr-mockup-dot"></div>
                                </div>
                                <div class="cr-mock-line w-1-2"></div>
                                <div class="cr-mock-line w-3-4"></div>
                                <div class="cr-mock-line w-full"></div>

                                <div class="cr-mock-card-grid">
                                    <div class="cr-mock-card"></div>
                                    <div class="cr-mock-card"
                                        style="background: rgba(79, 70, 229, 0.05); border-color: rgba(79, 70, 229, 0.2);">
                                    </div>
                                    <div class="cr-mock-card"></div>
                                    <div class="cr-mock-card"></div>
                                </div>
                                <div style="margin-top: 24px;">
                                    <div class="cr-mock-line w-full" style="height: 48px; border-radius: 8px;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- 2. Feature Cards -->
                <section class="cr-section" id="roadmaps">
                    <div class="cr-section-header gsap-reveal">
                        <h2 class="cr-h2">The Toolkit Architecture</h2>
                        <p class="cr-body-large" style="margin-top: 16px;">Structured frameworks to build your profile,
                            prep for interviews, and accelerate growth.</p>
                    </div>

                    <div class="cr-grid cr-cards-grid">

                        <!-- Highlight Card -->
                        <div class="cr-card cr-card-p1 cr-card-highlight gsap-reveal">
                            <div class="cr-popular-badge">Most Popular</div>
                            <div class="cr-card-icon"><i class="fas fa-map-marked-alt"></i></div>
                            <h3 class="cr-h3">Career Roadmap</h3>
                            <p class="cr-body">A step-by-step interactive timeline to master skills, build projects, and get certified.</p>
                            <a href="/career-roadmap/Software Engineering" class="cr-card-link">Find Your Path <i class="fas fa-arrow-right"
                                    style="font-size: 14px;"></i></a>
                        </div>

                        <!-- Standard Cards -->
                        <div class="cr-card cr-card-p2 gsap-reveal">
                            <div class="cr-card-icon"><i class="fas fa-video"></i></div>
                            <h3 class="cr-h3">Webinars</h3>
                            <p class="cr-body">Interactive learning hub. Join live sessions or watch on-demand technical deep dives.</p>
                            <a href="/webinars" class="cr-card-link" style="color: var(--accent);">Explore Webinars <i
                                    class="fas fa-arrow-right" style="font-size: 14px;"></i></a>
                        </div>

                        <div class="cr-card cr-card-p3 gsap-reveal">
                            <div class="cr-card-icon"><i class="fas fa-toolbox"></i></div>
                            <h3 class="cr-h3">Toolkit Dashboard</h3>
                            <p class="cr-body">ATS Resume builders, technical interview prep banks, and skill assessment tools.</p>
                            <a href="/career_resources" class="cr-card-link" style="color: #F59E0B;">Open Toolkit <i
                                    class="fas fa-arrow-right" style="font-size: 14px;"></i></a>
                        </div>

                        <div class="cr-card cr-card-p4 gsap-reveal">
                            <div class="cr-card-icon"><i class="fas fa-user-tie"></i></div>
                            <h3 class="cr-h3">Mentorship</h3>
