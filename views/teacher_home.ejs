<%- include('layouts/header'); %>
    <%- include('layouts/tnavbar'); %>

        <!-- Custom Tailwind Configuration & Scoped Styles -->
        <style>
            @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

            :root {
                --sidebar-width: 280px;
            }

            body {
                font-family: 'Inter', sans-serif;
                transition: background-color 0.3s, color 0.3s;
            }

            .dark body {
                background-color: #0f172a;
                color: #f1f5f9;
            }

            .glass-card {
                background: rgba(255, 255, 255, 0.95);
                backdrop-filter: blur(10px);
                border: 1px solid rgba(255, 255, 255, 0.2);
            }

            .dark .glass-card {
                background: rgba(30, 41, 59, 0.7);
                border: 1px solid rgba(255, 255, 255, 0.05);
            }

            .custom-scrollbar::-webkit-scrollbar {
                width: 6px;
            }

            .custom-scrollbar::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 10px;
            }

            .dark .custom-scrollbar::-webkit-scrollbar-thumb {
                background: #475569;
            }

            @keyframes pulse-custom {

                0%,
                100% {
                    opacity: 1;
                    transform: scale(1);
                }

                50% {
                    opacity: 0.7;
                    transform: scale(1.05);
                }
            }

            .animate-pulse-custom {
                animation: pulse-custom 2s infinite;
            }
        </style>

        <div class="flex min-h-screen bg-slate-50 dark:bg-slate-900 pt-16">
            <!-- Sidebar: Fixed Position on Desktop -->
            <aside
                class="hidden lg:flex w-72 flex-col fixed left-0 top-16 bottom-0 z-20 bg-indigo-700 dark:bg-slate-800 text-white overflow-y-auto custom-scrollbar shadow-2xl transition-all duration-300">
                <!-- Sidebar Profile -->
                <div class="p-6 text-center border-b border-indigo-600 dark:border-slate-700">
                    <div
                        class="w-20 h-20 bg-white/20 rounded-full mx-auto mb-3 flex items-center justify-center text-3xl font-bold">
                        <%= username.charAt(0).toUpperCase() %>
                    </div>
                    <h4 class="font-bold text-lg">Prof. <%= username %>
                    </h4>
                    <p class="text-indigo-200 dark:text-slate-400 text-xs mt-1 uppercase tracking-widest">
                        <%= collegeName %>
                    </p>
                </div>

                <!-- Sidebar Insights -->
                <div class="p-6 space-y-8">
                    <!-- Syllabus Health -->
                    <div>
                        <h5
                            class="text-xs font-semibold text-indigo-100 dark:text-slate-300 uppercase tracking-widest mb-4">
                            Syllabus Health</h5>
                        <div class="flex flex-col items-center">
                            <div class="relative w-32 h-32">
                                <canvas id="syllabusDoughnut" width="128" height="128"></canvas>
                                <div class="absolute inset-0 flex flex-col items-center justify-center">
                                    <span class="text-xl font-bold">75%</span>
                                    <span class="text-[10px] opacity-70">COMPLETED</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- College Toppers -->
                    <div>
                        <h5
                            class="text-xs font-semibold text-indigo-100 dark:text-slate-300 uppercase tracking-widest mb-4">
                            🏆 College Toppers</h5>
                        <div class="space-y-3">
                            <% if(locals.topPerformers && topPerformers.length> 0) { %>
                                <% topPerformers.forEach((perf, index)=> { %>
                                    <div
                                        class="flex items-center justify-between bg-white/10 dark:bg-slate-700/50 p-3 rounded-xl transition-hover hover:bg-white/20">
                                        <div class="flex items-center gap-3">
                                            <span class="text-indigo-300 dark:text-slate-500 font-bold text-sm">#<%=
                                                    index + 1 %></span>
                                            <div>
                                                <p class="text-xs font-bold truncate w-24">
                                                    <%= perf.userId ? perf.userId.username : 'Student' %>
                                                </p>
                                                <p class="text-[10px] opacity-60">
                                                    <%= new Date(perf.date).toLocaleDateString() %>
                                                </p>
                                            </div>
                                        </div>
                                        <span class="text-xs font-bold text-indigo-200">
                                            <%= perf.score %> pts
                                        </span>
                                    </div>
                                    <% }); %>
                                        <% } else { %>
                                            <p class="text-xs text-indigo-300 italic text-center py-4">Waiting for first
                                                quiz...</p>
                                            <% } %>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- Main Content Area -->
            <main class="flex-1 lg:ml-72 p-6 transition-all duration-300">
                <!-- Top Toolbar (Unified Search & Dark Mode) -->
                <div class="flex flex-col md:flex-row gap-4 mb-8 items-center justify-between">
                    <div class="relative w-full md:w-96 group">
                        <i
                            class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-indigo-500 transition-colors"></i>
                        <input type="text" placeholder="Search students, tasks, or insights..."
                            class="w-full pl-12 pr-4 py-3 bg-white dark:bg-slate-800 border-none rounded-2xl shadow-sm focus:ring-2 focus:ring-indigo-500 transition-all dark:text-white">
                    </div>

                    <div class="flex items-center gap-4">
                        <!-- Dark Mode Toggle -->
                        <button id="darkModeToggle"
                            class="p-3 bg-white dark:bg-slate-800 rounded-2xl shadow-sm text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                            <i class="fas fa-sun block dark:hidden"></i>
                            <i class="fas fa-moon hidden dark:block"></i>
                        </button>
                        <div
                            class="flex items-center gap-2 px-4 py-2 bg-emerald-50 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 rounded-full text-xs font-bold border border-emerald-100 dark:border-emerald-900/50">
                            <span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
                            INSTITUTIONAL NODE ACTIVE
                        </div>
                    </div>
                </div>

                <!-- Content Command Center -->
                <section class="mb-10">
                    <div class="flex items-center justify-between mb-6">
                        <h2 class="text-2xl font-bold text-slate-800 dark:text-white flex items-center gap-3">
                            <i class="fas fa-rocket text-indigo-500"></i> Content Command Center
                        </h2>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 xl:grid-cols-5 gap-6">
                        <!-- Task Card -->
                        <div class="glass-card p-6 rounded-3xl shadow-lg border-t-4 border-indigo-500 group">
                            <div class="flex justify-between items-start mb-4">
                                <div
                                    class="w-10 h-10 bg-indigo-100 dark:bg-indigo-900/50 rounded-xl flex items-center justify-center text-indigo-600 dark:text-indigo-400">
                                    <i class="fas fa-tasks"></i>
                                </div>
                                <span
                                    class="text-[10px] font-bold text-indigo-500 dark:text-indigo-400 uppercase tracking-widest">ASSIGN</span>
                            </div>
                            <form action="/addTask" method="POST">
                                <input type="text" name="title" placeholder="Assignment Topic" required
                                    class="w-full bg-slate-50 dark:bg-slate-900/50 border-none rounded-xl text-sm p-3 mb-2 focus:ring-1 focus:ring-indigo-500 dark:text-white">
                                <input type="date" name="dueDate" required
                                    class="w-full bg-slate-50 dark:bg-slate-900/50 border-none rounded-xl text-sm p-3 mb-4 focus:ring-1 focus:ring-indigo-500 dark:text-white">
                                <button type="submit"
                                    class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-bold shadow-indigo-200 dark:shadow-none transition-all">POST
                                    TASK</button>
                            </form>
                        </div>

                        <!-- Quiz Card -->
                        <div class="glass-card p-6 rounded-3xl shadow-lg border-t-4 border-amber-500">
                            <div class="flex justify-between items-start mb-4">
                                <div
                                    class="w-10 h-10 bg-amber-100 dark:bg-amber-900/50 rounded-xl flex items-center justify-center text-amber-600 dark:text-amber-400">
                                    <i class="fas fa-bolt"></i>
                                </div>
                                <span
                                    class="text-[10px] font-bold text-amber-500 dark:text-amber-400 uppercase tracking-widest">TEST</span>
                            </div>
                            <form action="/addQuiz" method="POST">
                                <input type="text" name="title" placeholder="Quiz Name" required
                                    class="w-full bg-slate-50 dark:bg-slate-900/50 border-none rounded-xl text-sm p-3 mb-2 focus:ring-1 focus:ring-amber-500 dark:text-white">
                                <input type="text" name="description" placeholder="Instructions/Link"
                                    class="w-full bg-slate-50 dark:bg-slate-900/50 border-none rounded-xl text-sm p-3 mb-4 focus:ring-1 focus:ring-amber-500 dark:text-white">
                                <button type="submit"
                                    class="w-full py-2.5 bg-amber-500 hover:bg-amber-600 text-white rounded-xl text-xs font-bold transition-all">LAUNCH
                                    QUIZ</button>
                            </form>
                        </div>

                        <!-- Live Card -->
                        <div class="glass-card p-6 rounded-3xl shadow-lg border-t-4 border-rose-500">
                            <div class="flex justify-between items-start mb-4">
                                <div
                                    class="w-10 h-10 bg-rose-100 dark:bg-rose-900/50 rounded-xl flex items-center justify-center text-rose-600 dark:text-rose-400">
                                    <i class="fas fa-video text-xs animate-pulse"></i>
                                </div>
                                <span
                                    class="text-[10px] font-bold text-rose-500 dark:text-rose-400 uppercase tracking-widest">STREAM</span>
                            </div>
                            <form action="/startLiveSession" method="POST">
                                <input type="text" name="title" placeholder="Session Title" required
                                    class="w-full bg-slate-50 dark:bg-slate-900/50 border-none rounded-xl text-sm p-3 mb-2 focus:ring-1 focus:ring-rose-500 dark:text-white">
                                <input type="url" name="description" placeholder="Meeting URL" required
                                    class="w-full bg-slate-50 dark:bg-slate-900/50 border-none rounded-xl text-sm p-3 mb-4 focus:ring-1 focus:ring-rose-500 dark:text-white">
                                <button type="submit"
                                    class="w-full py-2.5 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-xs font-bold transition-all">START
                                    LIVE</button>
                            </form>
                        </div>

                        <!-- Announcement Card -->
                        <div class="glass-card p-6 rounded-3xl shadow-lg border-t-4 border-emerald-500">
                            <div class="flex justify-between items-start mb-4">
                                <div
                                    class="w-10 h-10 bg-emerald-100 dark:bg-emerald-900/50 rounded-xl flex items-center justify-center text-emerald-600 dark:text-emerald-400">
                                    <i class="fas fa-bullhorn"></i>
                                </div>
                                <span
                                    class="text-[10px] font-bold text-emerald-500 dark:text-emerald-400 uppercase tracking-widest">CIRCULAR</span>
                            </div>
                            <form action="/addAnnouncement" method="POST">
                                <input type="text" name="title" placeholder="News Topic" required
                                    class="w-full bg-slate-50 dark:bg-slate-900/50 border-none rounded-xl text-sm p-3 mb-2 focus:ring-1 focus:ring-emerald-500 dark:text-white">
                                <input type="date" name="date" required
                                    class="w-full bg-slate-50 dark:bg-slate-900/50 border-none rounded-xl text-sm p-3 mb-4 focus:ring-1 focus:ring-emerald-500 dark:text-white">
                                <button type="submit"
                                    class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition-all">BROADCAST</button>
                            </form>
                        </div>

                        <!-- Resources Card -->
                        <div class="glass-card p-6 rounded-3xl shadow-lg border-t-4 border-cyan-500">
                            <div class="flex justify-between items-start mb-4">
                                <div
                                    class="w-10 h-10 bg-cyan-100 dark:bg-cyan-900/50 rounded-xl flex items-center justify-center text-cyan-600 dark:text-cyan-400">
                                    <i class="fas fa-book-open"></i>
                                </div>
                                <span
                                    class="text-[10px] font-bold text-cyan-500 dark:text-cyan-400 uppercase tracking-widest">DRIVE</span>
                            </div>
                            <form action="/addResource" method="POST">
                                <input type="text" name="title" placeholder="Doc Name" required
                                    class="w-full bg-slate-50 dark:bg-slate-900/50 border-none rounded-xl text-sm p-3 mb-2 focus:ring-1 focus:ring-cyan-500 dark:text-white">
                                <textarea name="description" placeholder="Notes/Links" rows="1"
                                    class="w-full bg-slate-50 dark:bg-slate-900/50 border-none rounded-xl text-sm p-3 mb-4 focus:ring-1 focus:ring-cyan-500 dark:text-white"></textarea>
                                <button type="submit"
                                    class="w-full py-2.5 bg-cyan-600 hover:bg-cyan-700 text-white rounded-xl text-xs font-bold transition-all">SHARE
                                    DOCS</button>
                            </form>
                        </div>
                    </div>
                </section>

                <!-- Monitoring & Analytics Section -->
                <div class="grid grid-cols-1 xl:grid-cols-3 gap-8 mb-10">
                    <!-- Analytics Chart -->
                    <div class="xl:col-span-2 glass-card p-8 rounded-3xl shadow-xl">
                        <div class="flex items-center justify-between mb-8">
                            <div>
                                <h3 class="text-xl font-bold dark:text-white">Average Class Performance</h3>
                                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Institutional Aptitude
                                    Benchmarks</p>
                            </div>
                        </div>
                        <div class="h-64">
                            <canvas id="aptitudeChart"></canvas>
                        </div>
                    </div>

                    <!-- Live Session Monitor Panel -->
                    <div class="glass-card p-8 rounded-3xl shadow-xl flex flex-col justify-center text-center">
                        <h3
                            class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-[0.2em] mb-6">
                            Active Transmission</h3>
                        <% if(locals.liveSessions && liveSessions.length> 0) { %>
                            <div
                                class="bg-rose-50 dark:bg-rose-900/20 border border-rose-100 dark:border-rose-900/50 p-6 rounded-3xl">
                                <div
                                    class="inline-flex items-center gap-2 px-3 py-1 bg-rose-500 text-white rounded-full text-[10px] font-black animate-pulse-custom mb-4">
                                    <i class="fas fa-circle text-[6px]"></i> LIVE STREAMING
                                </div>
                                <h4 class="font-bold text-lg dark:text-white mb-2 truncate">
                                    <%= liveSessions[0].title %>
                                </h4>
                                <p class="text-xs text-slate-500 dark:text-slate-400 mb-6 truncate">
                                    <%= liveSessions[0].description %>
                                </p>
                                <a href="<%= liveSessions[0].description %>" target="_blank"
                                    class="inline-block px-8 py-3 bg-rose-600 hover:bg-rose-700 text-white rounded-2xl text-sm font-bold shadow-lg shadow-rose-200 dark:shadow-none transition-all">
                                    JOIN BROADCAST
                                </a>
                            </div>
                            <% } else { %>
                                <div class="flex flex-col items-center opacity-40 py-10">
                                    <i
                                        class="fas fa-satellite-dish text-6xl text-slate-300 dark:text-slate-600 mb-4"></i>
                                    <p class="text-sm font-medium">No active broadcasts</p>
                                </div>
                                <% } %>
                    </div>
                </div>

                <!-- Lists Section: Student Roster & Doubts -->
                <div class="grid grid-cols-1 xl:grid-cols-2 gap-8">
                    <!-- Student Roster -->
                    <div
                        class="glass-card rounded-3xl shadow-xl overflow-hidden border border-slate-200/50 dark:border-slate-800">
                        <div
                            class="p-6 bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
                            <h3 class="font-bold dark:text-white flex items-center gap-2">
                                <i class="fas fa-user-graduate text-indigo-500"></i> Student Roster
                            </h3>
                            <span class="text-xs font-bold text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full">
                                <%= students.length %> Total
                            </span>
                        </div>
                        <div class="overflow-y-auto custom-scrollbar" style="max-height: 480px;">
                            <% if(students.length> 0) { %>
                                <table class="w-full text-left">
                                    <thead
                                        class="bg-slate-50 dark:bg-slate-800 text-[10px] font-black text-slate-400 uppercase tracking-widest">
                                        <tr>
                                            <th class="px-6 py-4">Student</th>
                                            <th class="px-6 py-4 text-center">Progress</th>
                                            <th class="px-6 py-4 text-right">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                        <% students.forEach(student=> { %>
                                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors">
                                                <td class="px-6 py-4">
                                                    <div class="flex items-center gap-3">
                                                        <div
                                                            class="w-10 h-10 bg-slate-100 dark:bg-slate-700 rounded-xl flex items-center justify-center text-slate-500">
                                                            <i class="fas fa-face-smile"></i>
                                                        </div>
                                                        <div>
                                                            <p class="text-sm font-bold dark:text-white">
                                                                <%= student.fullName %>
                                                            </p>
                                                            <p class="text-[10px] text-slate-400">ID: <%=
                                                                    student.userId.toString().slice(-6) %>
                                                            </p>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="px-6 py-4">
                                                    <div class="flex items-center gap-3">
                                                        <div
                                                            class="flex-1 h-2 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
                                                            <div class="h-full bg-indigo-500"
                                                                style="width: calc(<%= student.progress || 0 %> * 1%)">
                                                            </div>
                                                        </div>
                                                        <span
                                                            class="text-xs font-bold text-slate-600 dark:text-slate-400">
                                                            <%= student.progress %>%
                                                        </span>
                                                    </div>
                                                </td>
                                                <td class="px-6 py-4 text-right">
                                                    <button class="p-2 text-slate-300 hover:text-indigo-500"><i
                                                            class="fas fa-ellipsis-v"></i></button>
                                                </td>
                                            </tr>
                                            <% }); %>
                                    </tbody>
                                </table>
                                <% } else { %>
                                    <div class="p-20 text-center opacity-50">
                                        <i class="fas fa-user-clock text-4xl mb-3"></i>
                                        <p class="text-sm">Roster is empty</p>
                                    </div>
                                    <% } %>
                        </div>
                    </div>

                    <!-- Doubt Management -->
                    <div
                        class="glass-card rounded-3xl shadow-xl overflow-hidden border border-slate-200/50 dark:border-slate-800">
                        <div
                            class="p-6 bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
                            <h3 class="font-bold dark:text-white flex items-center gap-2">
                                <i class="fas fa-comment-alt text-amber-500"></i> Knowledge Request Queue
                            </h3>
                            <% const pendingCount=doubts.filter(d=> d.status === 'pending').length; %>
                                <span class="text-xs font-bold text-amber-600 bg-amber-50 px-3 py-1 rounded-full">
                                    <%= pendingCount %> Urgent
                                </span>
                        </div>
                        <div class="p-6 overflow-y-auto custom-scrollbar space-y-4" style="max-height: 480px;">
                            <% if (doubts && doubts.length> 0) { %>
                                <% doubts.forEach(doubt=> { %>
                                    <div
                                        class="p-5 bg-white dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-700 <%= doubt.status === 'answered' ? 'opacity-70' : 'ring-1 ring-amber-100 dark:ring-amber-900/30 shadow-md' %>">
                                        <div class="flex justify-between items-start mb-4">
                                            <div class="flex items-center gap-2">
                                                <span
                                                    class="px-2 py-1 rounded text-[9px] font-black uppercase tracking-tighter <%= doubt.status === 'pending' ? 'bg-amber-100 text-amber-700' : 'bg-emerald-100 text-emerald-700' %>">
                                                    <%= doubt.status %>
                                                </span>
                                                <span class="text-[10px] text-slate-400">
                                                    <%= new Date(doubt.createdAt).toLocaleDateString() %>
                                                </span>
                                            </div>
                                            <div class="text-[10px] font-bold text-slate-500">
                                                FROM: <%= doubt.studentId ? doubt.studentId.username : 'Anonymous' %>
                                            </div>
                                        </div>
                                        <h4 class="font-bold text-sm dark:text-white mb-2">
                                            <%= doubt.title %>
                                        </h4>
                                        <p class="text-xs text-slate-500 dark:text-slate-400 mb-4 line-clamp-2">
                                            <%= doubt.description %>
                                        </p>

                                        <% if (doubt.status==='pending' ) { %>
                                            <form action="/replyDoubt" method="POST" class="mt-4 flex gap-2">
                                                <input type="hidden" name="doubtId" value="<%= doubt._id %>">
                                                <input type="text" name="reply"
                                                    placeholder="Write institutional response..." required
                                                    class="flex-1 bg-slate-50 dark:bg-slate-900 border-none rounded-xl text-xs p-2.5 focus:ring-1 focus:ring-indigo-500 dark:text-white">
                                                <button type="submit"
                                                    class="px-4 py-2.5 bg-indigo-600 text-white rounded-xl text-xs font-bold hover:bg-indigo-700 transition-all">REPLY</button>
                                            </form>
                                            <% } else { %>
                                                <div
                                                    class="mt-2 pt-2 border-t border-slate-50 dark:border-slate-700 flex items-start gap-2">
                                                    <i class="fas fa-check-circle text-emerald-500 mt-1 text-xs"></i>
                                                    <p class="text-xs italic text-slate-500 dark:text-slate-400">
                                                        <%= doubt.teacherReply %>
                                                    </p>
                                                </div>
                                                <% } %>
                                    </div>
                                    <% }); %>
                                        <% } else { %>
                                            <div class="text-center py-20 opacity-30">
                                                <i class="fas fa-comments text-5xl mb-3"></i>
                                                <p class="text-sm">Inbox clear!</p>
                                            </div>
                                            <% } %>
                        </div>
                    </div>
                </div>
            </main>
        </div>

        <!-- JS: Charts and Dark Mode Logic -->
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                // Dark Mode Logic
                const darkModeToggle = document.getElementById('darkModeToggle');
                const setupDarkMode = () => {
                    const isDark = localStorage.getItem('darkMode') === 'true' ||
                        (!('darkMode' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches);
                    document.documentElement.classList.toggle('dark', isDark);
                };

                darkModeToggle.addEventListener('click', () => {
                    const isDarkNow = document.documentElement.classList.toggle('dark');
                    localStorage.setItem('darkMode', isDarkNow);
                    // Redraw charts if needed (to change labels color)
                    window.location.reload(); // Quickest way to sync chart themes
                });
                setupDarkMode();

                const isDarkTheme = document.documentElement.classList.contains('dark');
                const labelColor = isDarkTheme ? '#94a3b8' : '#64748b';
                const gridColor = isDarkTheme ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)';

                // Syllabus Doughnut
                const sCtx = document.getElementById('syllabusDoughnut');
                if (sCtx) {
                    new Chart(sCtx, {
                        type: 'doughnut',
                        data: {
                            datasets: [{
                                data: [75, 25],
                                backgroundColor: ['#fff', 'rgba(255,255,255,0.2)'],
                                borderWidth: 0,
                                cutout: '80%'
                            }]
                        },
                        options: {
                            responsive: false,
                            plugins: { legend: { display: false }, tooltip: { enabled: false } }
                        }
                    });
                }

                // Aptitude Bar Chart
                const aCtx = document.getElementById('aptitudeChart');
                if (aCtx) {
                    new Chart(aCtx, {
                        type: 'bar',
                        data: {
                            labels: ['Mathematics', 'Science', 'English', 'Social Studies', 'Reasoning'],
                            datasets: [{
                                label: 'Average Score (%)',
                                data: [78, 85, 72, 80, 88],
                                backgroundColor: isDarkTheme ? 'rgba(99, 102, 241, 0.5)' : 'rgba(99, 102, 241, 0.8)',
                                borderRadius: 8,
                                borderWidth: 0
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: { legend: { display: false } },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    max: 100,
                                    grid: { color: gridColor },
                                    ticks: { color: labelColor, font: { size: 10 } }
                                },
                                x: {
                                    grid: { display: false },
                                    ticks: { color: labelColor, font: { size: 10 } }
                                }
                            }
                        }
                    });
                }
            });
        </script>

