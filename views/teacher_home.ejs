<%- include('layouts/header'); %>
    <%- include('layouts/tnavbar'); %>

        <!-- Custom Tailwind Configuration & Scoped Styles -->
        <style>
            @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap');

            :root {
                --glass-bg: rgba(255, 255, 255, 0.7);
                --glass-border: rgba(255, 255, 255, 0.2);
                --glass-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.07);
            }

            .dark {
                --glass-bg: rgba(15, 23, 42, 0.6);
                --glass-border: rgba(255, 255, 255, 0.05);
                --glass-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
            }

            body {
                font-family: 'Outfit', sans-serif;
                background-color: #f8fafc;
                transition: background-color 0.5s ease;
            }

            .dark body {
                background-color: #020617;
            }

            .glass-morphism {
                background: var(--glass-bg);
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                border: 1px solid var(--glass-border);
                box-shadow: var(--glass-shadow);
            }

            .custom-scrollbar::-webkit-scrollbar {
                width: 6px;
            }

            .custom-scrollbar::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 10px;
            }

            .dark .custom-scrollbar::-webkit-scrollbar-thumb {
                background: #334155;
            }

            .nav-blur {
                backdrop-filter: blur(8px);
                background: rgba(255, 255, 255, 0.8);
            }

            .dark .nav-blur {
                background: rgba(15, 23, 42, 0.8);
            }

            @keyframes float {
                0% {
                    transform: translateY(0px);
                }

                50% {
                    transform: translateY(-10px);
                }

                100% {
                    transform: translateY(0px);
                }
            }

            .float-animation {
                animation: float 6s ease-in-out infinite;
            }

            @keyframes pulse-soft {

                0%,
                100% {
                    opacity: 1;
                }

                50% {
                    opacity: 0.6;
                }
            }

            .pulse-soft {
                animation: pulse-soft 2s ease-in-out infinite;
            }

            .gradient-text {
                background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
                -webkit-background-clip: text;
                background-clip: text;
                -webkit-text-fill-color: transparent;
            }

            /* Fix for progress bar widths */
            .progress-bar-fill {
                transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);
            }
        </style>

        <div class="min-h-screen pb-20 px-4 md:px-8 pt-8">
            <div class="max-w-7xl mx-auto space-y-10">

                <!-- Hero Header Section -->
                <header
                    class="relative overflow-hidden rounded-[2.5rem] p-8 md:p-12 glass-morphism border-none shadow-2xl">
                    <div class="absolute top-0 right-0 -mr-20 -mt-20 w-80 h-80 bg-indigo-500/10 rounded-full blur-3xl">
                    </div>
                    <div
                        class="absolute bottom-0 left-0 -ml-20 -mb-20 w-80 h-80 bg-purple-500/10 rounded-full blur-3xl">
                    </div>

                    <div class="relative flex flex-col md:flex-row justify-between items-center gap-8">
                        <div class="text-center md:text-left">
                            <div
                                class="inline-flex items-center gap-2 px-4 py-1.5 bg-indigo-100 dark:bg-indigo-900/40 text-indigo-600 dark:text-indigo-400 rounded-full text-xs font-bold mb-4 border border-indigo-200 dark:border-indigo-800">
                                <span class="w-2 h-2 bg-indigo-500 rounded-full pulse-soft"></span>
                                FACULTY ACCESS GRANTED
                            </div>
                            <h1
                                class="text-4xl md:text-5xl font-extrabold text-slate-800 dark:text-white mb-2 leading-tight">
                                Welcome, <span class="gradient-text">Prof. <%= username %></span>
                            </h1>
                            <p class="text-slate-500 dark:text-slate-400 font-medium">
                                <i class="fas fa-university mr-2"></i>
                                <%= collegeName %> | Institutional Dashboard
                            </p>
                        </div>

                        <div class="flex items-center gap-4">
                            <!-- Search & Toggle Group -->
                            <div
                                class="flex items-center gap-3 bg-white/50 dark:bg-slate-800/50 p-2 rounded-3xl border border-white/20">
                                <div class="relative hidden sm:block">
                                    <i
                                        class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                                    <input type="text" placeholder="Global search..."
                                        class="pl-12 pr-4 py-2.5 bg-white dark:bg-slate-900 border-none rounded-2xl w-64 text-sm focus:ring-2 focus:ring-indigo-500 transition-all dark:text-white">
                                </div>
                                <button id="darkModeToggle"
                                    class="p-3 bg-white dark:bg-slate-900 rounded-2xl shadow-sm text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all">
                                    <i class="fas fa-sun block dark:hidden"></i>
                                    <i class="fas fa-moon hidden dark:block"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </header>

                <!-- Insights Row -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- Syllabus Card -->
                    <div class="glass-morphism rounded-[2rem] p-6 flex items-center gap-6">
                        <div class="relative w-24 h-24 shrink-0">
                            <canvas id="syllabusDoughnut" width="96" height="96"></canvas>
                            <div
                                class="absolute inset-0 flex items-center justify-center font-bold text-lg dark:text-white">
                                <%= syllabusHealth %>%
                            </div>
                        </div>
                        <div>
                            <h3 class="text-sm font-black text-slate-400 uppercase tracking-widest mb-1">Syllabus Health
                            </h3>
                            <p class="text-2xl font-bold dark:text-white">Course 104-A</p>
                            <span class="text-xs text-emerald-500 font-bold">+12% from last month</span>
                        </div>
                    </div>

                    <!-- Leaderboard Card -->
                    <div class="glass-morphism rounded-[2rem] p-6">
                        <h3 class="text-sm font-black text-slate-400 uppercase tracking-widest mb-4">🏆 Top Performers
                        </h3>
                        <div class="flex -space-x-3 mb-4">
                            <% if(locals.topPerformers && topPerformers.length> 0) { %>
                                <% topPerformers.slice(0, 3).forEach((perf, i)=> { %>
                                    <div
                                        class="w-10 h-10 rounded-full border-2 border-white dark:border-slate-800 bg-indigo-500 flex items-center justify-center text-white text-xs font-bold ring-2 ring-indigo-500/20">
                                        <%= perf.userId ? perf.userId.username.charAt(0).toUpperCase() : 'S' %>
                                    </div>
                                    <% }); %>
                                        <div
                                            class="w-10 h-10 rounded-full border-2 border-white dark:border-slate-800 bg-slate-200 dark:bg-slate-700 flex items-center justify-center text-slate-500 text-xs font-bold">
                                            +<%= topPerformers.length> 3 ? topPerformers.length - 3 : 0 %>
                                        </div>
                                        <% } %>
                        </div>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Class average improved to <span
                                class="text-indigo-500 font-bold">
                                <%= classAverages.total %> pts
                            </span> this week.</p>
                    </div>

                    <!-- Active Monitor Card -->
                    <div
                        class="glass-morphism rounded-[2rem] p-6 relative overflow-hidden bg-gradient-to-br from-indigo-500/10 to-purple-500/10">
                        <div class="flex justify-between items-start mb-4">
                            <h3 class="text-sm font-black text-slate-400 uppercase tracking-widest">Live Status</h3>
                            <span
                                class="px-3 py-1 bg-emerald-100 dark:bg-emerald-900/40 text-emerald-600 dark:text-emerald-400 text-[10px] font-black rounded-full">NODAL
                                ACTIVE</span>
                        </div>
                        <div class="flex items-center gap-4">
                            <div
                                class="w-12 h-12 bg-white dark:bg-slate-800 rounded-2xl flex items-center justify-center text-indigo-500 shadow-sm">
                                <i class="fas fa-users text-xl"></i>
                            </div>
                            <div>
                                <p class="text-2xl font-bold dark:text-white">
                                    <%= students.length %>
                                </p>
                                <p class="text-xs text-slate-500">Connected Students</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Content Command Center -->
                <section>
                    <div class="flex items-center gap-4 mb-8">
                        <div class="h-1 w-12 bg-indigo-500 rounded-full"></div>
                        <h2 class="text-2xl font-bold text-slate-800 dark:text-white">Content Command Center</h2>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
                        <% const cards=[ { type: 'task' , icon: 'fa-tasks' , color: 'indigo' , title: 'Task' ,
                            action: '/addTask' , fields: [{ name: 'title' , placeholder: 'Topic' , type: 'text' }, {
                            name: 'dueDate' , placeholder: 'Due' , type: 'date' }], btn: 'Post' }, { type: 'quiz' ,
                            icon: 'fa-bolt' , color: 'amber' , title: 'Quiz' , action: '/addQuiz' , fields: [{
                            name: 'title' , placeholder: 'Name' , type: 'text' }, { name: 'description' ,
                            placeholder: 'Instructions' , type: 'text' }], btn: 'Launch' }, { type: 'live' ,
                            icon: 'fa-video' , color: 'rose' , title: 'Live' , action: '/startLiveSession' , fields: [{
                            name: 'title' , placeholder: 'Title' , type: 'text' }, { name: 'description' ,
                            placeholder: 'URL' , type: 'url' }], btn: 'Stream' }, { type: 'announcement' ,
                            icon: 'fa-bullhorn' , color: 'emerald' , title: 'Circlr' , action: '/addAnnouncement' ,
                            fields: [{ name: 'title' , placeholder: 'News' , type: 'text' }, { name: 'date' ,
                            placeholder: 'Date' , type: 'date' }], btn: 'Broadcast' }, { type: 'resource' ,
                            icon: 'fa-book-open' , color: 'cyan' , title: 'Drive' , action: '/addResource' , fields: [{
                            name: 'title' , placeholder: 'Name' , type: 'text' }, { name: 'description' ,
                            placeholder: 'Notes/Link' , type: 'textarea' }], btn: 'Share' } ]; %>

                            <% cards.forEach(card=> { %>
                                <div
                                    class="glass-morphism p-6 rounded-[2rem] hover:scale-[1.02] transition-all duration-300 group border-t-4 border-<%= card.color %>-500">
                                    <div class="flex justify-between items-center mb-6">
                                        <div
                                            class="w-10 h-10 bg-<%= card.color %>-100 dark:bg-<%= card.color %>-900/30 text-<%= card.color %>-600 dark:text-<%= card.color %>-400 rounded-xl flex items-center justify-center">
                                            <i class="fas <%= card.icon %>"></i>
                                        </div>
                                        <span
                                            class="text-[10px] font-black text-<%= card.color %>-500/70 uppercase tracking-widest">
                                            <%= card.title %>
                                        </span>
                                    </div>
                                    <form action="<%= card.action %>" method="POST" class="space-y-3">
                                        <% card.fields.forEach(field=> { %>
                                            <% if (field.type==='textarea' ) { %>
                                                <textarea name="<%= field.name %>"
                                                    placeholder="<%= field.placeholder %>" rows="1"
                                                    class="w-full bg-slate-50 dark:bg-slate-900/50 border-none rounded-xl text-xs p-3 focus:ring-1 focus:ring-<%= card.color %>-500 dark:text-white"></textarea>
                                                <% } else { %>
                                                    <input type="<%= field.type %>" name="<%= field.name %>"
                                                        placeholder="<%= field.placeholder %>" required
                                                        class="w-full bg-slate-50 dark:bg-slate-900/50 border-none rounded-xl text-xs p-3 focus:ring-1 focus:ring-<%= card.color %>-500 dark:text-white">
                                                    <% } %>
                                                        <% }); %>
                                                            <button type="submit"
                                                                class="w-full py-3 bg-<%= card.color %>-500 hover:bg-<%= card.color %>-600 text-white rounded-xl text-[10px] font-black uppercase tracking-wider transition-all shadow-lg shadow-<%= card.color %>-500/20">
                                                                <%= card.btn %>
                                                            </button>
                                    </form>
                                </div>
                                <% }); %>
                    </div>
                </section>

                <!-- Monitoring & Analytics Row -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                    <!-- Analytics Chart -->
                    <div class="lg:col-span-2 glass-morphism p-8 rounded-[2.5rem]">
                        <div class="flex items-center justify-between mb-8">
                            <div>
                                <h3 class="text-xl font-bold dark:text-white">Class Aptitude Analytics</h3>
                                <p class="text-xs text-slate-400 mt-1">Institutional benchmarks across standard domains
                                </p>
                            </div>
                            <div class="flex gap-2">
                                <div class="w-3 h-3 bg-indigo-500 rounded-full"></div>
                                <div class="w-3 h-3 bg-slate-200 dark:bg-slate-800 rounded-full"></div>
                            </div>
                        </div>
                        <div class="h-80 w-full">
                            <canvas id="aptitudeChart"></canvas>
                        </div>
                    </div>

                    <!-- Live Stream Panel -->
                    <div
                        class="glass-morphism p-8 rounded-[2.5rem] flex flex-col items-center justify-center text-center relative overflow-hidden">
                        <% if(locals.liveSessions && liveSessions.length> 0) { %>
                            <div class="absolute top-4 right-4 animate-pulse">
                                <span
                                    class="px-3 py-1 bg-rose-500 text-white text-[10px] font-black rounded-full shadow-lg shadow-rose-500/50">LIVE
                                    NOW</span>
                            </div>
                            <div
                                class="w-20 h-20 bg-rose-100 dark:bg-rose-900/30 rounded-3xl flex items-center justify-center text-rose-500 mb-6 float-animation">
                                <i class="fas fa-broadcast-tower text-3xl"></i>
                            </div>
                            <h4 class="text-lg font-bold dark:text-white mb-2">
                                <%= liveSessions[0].title %>
                            </h4>
                            <p class="text-xs text-slate-400 mb-8 line-clamp-2">
                                <%= liveSessions[0].description %>
                            </p>
                            <a href="<%= liveSessions[0].description %>" target="_blank"
                                class="px-8 py-3 bg-rose-500 hover:bg-rose-600 text-white rounded-full text-sm font-bold shadow-xl shadow-rose-500/20 transition-all">
                                JOIN TRANSMISSION
                            </a>
                            <% } else { %>
                                <i class="fas fa-satellite text-6xl text-slate-200 dark:text-slate-800 mb-6"></i>
                                <h4 class="text-sm font-bold text-slate-400 uppercase tracking-widest">No Active Streams
                                </h4>
                                <p class="text-xs text-slate-400 mt-2">Start a live session from the command center.</p>
                                <% } %>
                    </div>
                </div>

                <!-- Records & Requests Segment -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                    <!-- Roster Table -->
                    <div class="glass-morphism rounded-[2.5rem] overflow-hidden">
                        <div class="p-8 border-b border-white/10 flex justify-between items-center">
                            <h3 class="text-xl font-bold dark:text-white">Student Roster</h3>
                            <span
                                class="text-xs font-bold text-indigo-500 bg-indigo-50 dark:bg-indigo-900/40 px-3 py-1 rounded-full">
                                <%= students.length %> Enrolled
                            </span>
                        </div>
                        <div class="p-4 custom-scrollbar overflow-y-auto max-height-[400px]">
                            <table class="w-full">
                                <thead
                                    class="text-[10px] font-black text-slate-400 uppercase tracking-widest text-left">
                                    <tr>
                                        <th class="px-4 py-4">Student</th>
                                        <th class="px-4 py-4">Learning Velocity</th>
                                        <th class="px-4 py-4 text-right">Access</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-white/5">
                                    <% students.forEach(student=> { %>
                                        <tr class="group hover:bg-white/5 transition-all">
                                            <td class="px-4 py-4">
                                                <div class="flex items-center gap-3">
                                                    <div
                                                        class="w-10 h-10 bg-gradient-to-br from-indigo-500/20 to-purple-500/20 rounded-xl flex items-center justify-center font-bold text-indigo-500">
                                                        <%= student.fullName.charAt(0) %>
                                                    </div>
                                                    <div>
                                                        <p class="text-sm font-bold dark:text-white">
                                                            <%= student.fullName %>
                                                        </p>
                                                        <p class="text-[10px] text-slate-500">ID: <%=
                                                                student.userId.toString().slice(-6) %>
                                                        </p>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="px-4 py-4">
                                                <div
                                                    class="w-full bg-slate-100 dark:bg-slate-800 h-2 rounded-full overflow-hidden">
                                                    <div class="h-full bg-indigo-500 progress-bar-fill student-progress-bar"
                                                        data-progress="<%= student.progress || 0 %>"></div>
                                                </div>
                                            </td>
                                            <td class="px-4 py-4 text-right">
                                                <button
                                                    class="w-8 h-8 rounded-lg text-slate-400 hover:text-indigo-500 hover:bg-indigo-50 dark:hover:bg-indigo-900/30 transition-all">
                                                    <i class="fas fa-external-link-alt text-xs"></i>
                                                </button>
                                            </td>
                                        </tr>
                                        <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Doubt Queue -->
                    <div class="glass-morphism rounded-[2.5rem] overflow-hidden flex flex-col">
                        <div class="p-8 border-b border-white/10 flex justify-between items-center">
                            <h3 class="text-xl font-bold dark:text-white">Knowledge Sync</h3>
                            <% const pendingCount=doubts.filter(d=> d.status === 'pending').length; %>
                                <span
                                    class="text-xs font-bold text-amber-500 bg-amber-50 dark:bg-amber-900/40 px-3 py-1 rounded-full">
                                    <%= pendingCount %> Pending
                                </span>
                        </div>
                        <div class="p-6 space-y-4 custom-scrollbar overflow-y-auto max-height-[400px]">
                            <% if (doubts && doubts.length> 0) { %>
                                <% doubts.forEach(doubt=> { %>
                                    <div
                                        class="p-5 rounded-[1.5rem] <%= doubt.status === 'pending' ? 'bg-amber-500/5 border border-amber-500/20' : 'bg-white/5 border border-transparent opacity-60' %>">
                                        <div class="flex justify-between items-start mb-2">
                                            <span
                                                class="text-[10px] font-black uppercase tracking-tighter text-<%= doubt.status === 'pending' ? 'amber' : 'emerald' %>-500">
                                                <%= doubt.status %>
                                            </span>
                                            <span class="text-[10px] text-slate-500">
                                                <%= doubt.studentId ? doubt.studentId.username : 'Student' %>
                                            </span>
                                        </div>
                                        <h4 class="text-sm font-bold dark:text-white mb-2">
                                            <%= doubt.title %>
                                        </h4>
                                        <p class="text-xs text-slate-500 dark:text-slate-400 mb-4 line-clamp-2">
                                            <%= doubt.description %>
                                        </p>

                                        <% if (doubt.status==='pending' ) { %>
                                            <form action="/replyDoubt" method="POST" class="flex gap-2">
                                                <input type="hidden" name="doubtId" value="<%= doubt._id %>">
                                                <input type="text" name="reply" placeholder="Write response..." required
                                                    class="flex-1 bg-white dark:bg-slate-900 border-none rounded-xl text-xs p-2.5 focus:ring-1 focus:ring-indigo-500 dark:text-white">
                                                <button type="submit"
                                                    class="px-4 py-2.5 bg-indigo-600 text-white rounded-xl text-xs font-bold hover:bg-indigo-700 transition-all">RESOLVE</button>
                                            </form>
                                            <% } else { %>
                                                <div
                                                    class="flex items-center gap-2 text-xs text-emerald-500 font-medium italic">
                                                    <i class="fas fa-check-circle"></i>
                                                    <%= doubt.teacherReply %>
                                                </div>
                                                <% } %>
                                    </div>
                                    <% }); %>
                                        <% } else { %>
                                            <div class="text-center py-20 opacity-30">
                                                <i class="fas fa-check-double text-5xl mb-4"></i>
                                                <p class="text-sm font-medium">Clear Skies! No pending queries.</p>
                                            </div>
                                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Secondary Lists -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <!-- Recent Tasks -->
                    <div class="glass-morphism rounded-[2.5rem] p-8">
                        <div class="flex justify-between items-center mb-6">
                            <h3 class="font-bold dark:text-white">Active Assignments</h3>
                            <i class="fas fa-chevron-right text-slate-400 text-xs"></i>
                        </div>
                        <div class="space-y-4">
                            <% tasks.slice(0, 4).forEach(task=> { %>
                                <div
                                    class="flex items-center justify-between p-4 bg-white/40 dark:bg-slate-800/40 rounded-2xl border border-white/10">
                                    <div class="flex items-center gap-4">
                                        <div
                                            class="w-10 h-10 bg-indigo-500/10 text-indigo-500 rounded-xl flex items-center justify-center">
                                            <i class="fas fa-file-alt"></i>
                                        </div>
                                        <div>
                                            <p class="text-sm font-bold dark:text-white">
                                                <%= task.title %>
                                            </p>
                                            <p class="text-[10px] text-slate-400">Due: <%= task.dueDate %>
                                            </p>
                                        </div>
                                    </div>
                                    <span
                                        class="text-[10px] font-black text-indigo-500 <%= new Date(task.dueDate) < new Date() ? 'text-rose-500' : '' %>">
                                        <%= new Date(task.dueDate) < new Date() ? 'EXPIRED' : 'ACTIVE' %>
                                    </span>
                                </div>
                                <% }); %>
                        </div>
                    </div>

                    <!-- Announcements -->
                    <div class="glass-morphism rounded-[2.5rem] p-8">
                        <div class="flex justify-between items-center mb-6">
                            <h3 class="font-bold dark:text-white">Broadcast History</h3>
                            <i class="fas fa-chevron-right text-slate-400 text-xs"></i>
                        </div>
                        <div class="space-y-4">
                            <% announcements.slice(0, 4).forEach(ann=> { %>
                                <div
                                    class="flex items-start gap-4 p-4 bg-white/40 dark:bg-slate-800/40 rounded-2xl border border-white/10">
                                    <div
                                        class="w-10 h-10 bg-emerald-500/10 text-emerald-500 rounded-xl flex items-center justify-center shrink-0">
                                        <i class="fas fa-bell"></i>
                                    </div>
                                    <div>
                                        <p class="text-sm font-bold dark:text-white">
                                            <%= ann.title %>
                                        </p>
                                        <p class="text-[10px] text-slate-400 mt-1">
                                            <%= ann.date %>
                                        </p>
                                    </div>
                                </div>
                                <% }); %>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- JS: Logic for Charts & System States -->
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                // System States
                const darkModeToggle = document.getElementById('darkModeToggle');
                const setupDarkMode = () => {
                    const isDark = localStorage.getItem('darkMode') === 'true' ||
                        (!('darkMode' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches);
                    document.documentElement.classList.toggle('dark', isDark);
                };

                darkModeToggle.addEventListener('click', () => {
                    const isDark = document.documentElement.classList.toggle('dark');
                    localStorage.setItem('darkMode', isDark);
                    window.location.reload(); // Re-sync chart colors
                });
                setupDarkMode();

                const isDark = document.documentElement.classList.contains('dark');
                const labelColor = isDark ? '#94a3b8' : '#64748b';
                const gridColor = isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)';

                // Set Student Progress Bars
                document.querySelectorAll('.student-progress-bar').forEach(el => {
                    el.style.width = (el.dataset.progress || 0) + '%';
                });

                // Syllabus Doughnut
                const sCtx = document.getElementById('syllabusDoughnut');
                if (sCtx) {
                    new Chart(sCtx, {
                        type: 'doughnut',
                        data: {
                            datasets: [{
                                data: [Number('<%= syllabusHealth || 0 %>'), 100 - Number('<%= syllabusHealth || 0 %>')],
                                backgroundColor: isDark ? ['#6366f1', '#1e293b'] : ['#6366f1', '#f1f5f9'],
                                borderWidth: 0,
                                cutout: '80%',
                                borderRadius: 10
                            }]
                        },
                        options: {
                            responsive: false,
                            plugins: { legend: { display: false }, tooltip: { enabled: false } }
                        }
                    });
                }

                // Aptitude Bar Chart
                const aCtx = document.getElementById('aptitudeChart');
                if (aCtx) {
                    new Chart(aCtx, {
                        type: 'bar',
                        data: {
                            labels: ['Quantitative', 'Verbal', 'Logical', 'Overall'],
                            datasets: [{
                                data: [
                                    Number('<%= classAverages.quantitative || 0 %>'),
                                    Number('<%= classAverages.verbal || 0 %>'),
                                    Number('<%= classAverages.logical || 0 %>'),
                                    Number('<%= classAverages.total || 0 %>')
                                ],
                                backgroundColor: isDark ? 'rgba(99, 102, 241, 0.5)' : 'rgba(99, 102, 241, 0.8)',
                                borderRadius: 12,
                                barThickness: 40
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: { legend: { display: false } },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    max: 100,
                                    grid: { color: gridColor, drawBorder: false },
                                    ticks: { color: labelColor, font: { family: 'Outfit', size: 10 } }
                                },
                                x: {
                                    grid: { display: false },
                                    ticks: { color: labelColor, font: { family: 'Outfit', size: 10 } }
                                }
                            }
                        }
                    });
                }
            });
        </script>

        <%- include('layouts/footer'); %>