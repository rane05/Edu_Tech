<%- include('layouts/header'); -%>
    <%- include('layouts/tnavbar'); -%>

        <!-- Custom Premium Styles -->
        <style>
            @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap');

            :root {
                --primary: #4f46e5;
                --primary-light: #818cf8;
                --secondary: #ec4899;
                --accent: #f59e0b;
                --bg-main: #f8fafc;
                --glass-bg: rgba(255, 255, 255, 0.7);
                --glass-border: rgba(255, 255, 255, 0.2);
            }

            body {
                font-family: 'Outfit', sans-serif;
                background: var(--bg-main);
                color: #1e293b;
                overflow-x: hidden;
            }

            .glass-card {
                background: var(--glass-bg);
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                border: 1px solid var(--glass-border);
                box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.07);
                border-radius: 24px;
                transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            }

            .glass-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 12px 40px 0 rgba(31, 38, 135, 0.12);
            }

            .gradient-text {
                background: linear-gradient(135deg, var(--primary), var(--secondary));
                -webkit-background-clip: text;
                background-clip: text;
                -webkit-text-fill-color: transparent;
            }

            .btn-premium {
                background: linear-gradient(135deg, var(--primary), var(--primary-light));
                color: white;
                border-radius: 12px;
                font-weight: 600;
                transition: all 0.3s ease;
                box-shadow: 0 4px 15px rgba(79, 70, 229, 0.3);
            }

            .btn-premium:hover {
                transform: scale(1.02);
                box-shadow: 0 6px 20px rgba(79, 70, 229, 0.4);
            }

            .stat-icon {
                width: 48px;
                height: 48px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 14px;
                font-size: 20px;
            }

            .custom-scrollbar::-webkit-scrollbar {
                width: 6px;
            }

            .custom-scrollbar::-webkit-scrollbar-track {
                background: transparent;
            }

            .custom-scrollbar::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 10px;
            }

            /* Modal Styles */
            .modal-backdrop {
                background: rgba(0, 0, 0, 0.4);
                backdrop-filter: blur(4px);
            }

            .animate-in {
                animation: fadeInScale 0.4s ease forwards;
            }

            @keyframes fadeInScale {
                from {
                    opacity: 0;
                    transform: scale(0.95);
                }

                to {
                    opacity: 1;
                    transform: scale(1);
                }
            }

            .nav-pill {
                padding: 8px 16px;
                border-radius: 99px;
                font-weight: 600;
                font-size: 14px;
                transition: all 0.3s ease;
            }

            .nav-pill.active {
                background: var(--primary);
                color: white;
            }

            .dashboard-grid {
                display: grid;
                grid-template-columns: repeat(12, 1fr);
                gap: 24px;
            }

            .col-span-12 {
                grid-column: span 12;
            }

            .col-span-8 {
                grid-column: span 8;
            }

            .col-span-4 {
                grid-column: span 4;
            }

            .col-span-6 {
                grid-column: span 6;
            }

            @media (max-width: 1024px) {

                .col-span-8,
                .col-span-4,
                .col-span-6 {
                    grid-column: span 12;
                }
            }
        </style>

        <div class="min-h-screen p-6 md:p-10 max-w-7xl mx-auto">
            <!-- Header Area -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-10 gap-6">
                <div>
                    <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 mb-2">
                        Hello, <span class="gradient-text">
                            <%= username %>
                        </span>! 👋
                    </h1>
                    <p class="text-slate-500 font-medium flex items-center gap-2">
                        <i class="fas fa-university text-primary"></i>
                        <%= collegeName %> | Faculty Dashboard
                    </p>
                </div>
                <div class="flex items-center gap-4">
                    <div class="glass-card px-4 py-2 flex items-center gap-3">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Invite Code</span>
                        <span class="text-lg font-black text-primary">
                            <%= teacherCode %>
                        </span>
                        <button onclick="navigator.clipboard.writeText('<%= teacherCode %>')"
                            class="text-slate-400 hover:text-primary transition-colors">
                            <i class="far fa-copy"></i>
                        </button>
                    </div>
                    <button id="darkModeToggle" class="glass-card p-3 text-slate-600 hover:text-primary">
                        <i class="fas fa-moon"></i>
                    </button>
                </div>
            </div>

            <!-- Quick Stats -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-10">
                <div class="glass-card p-6">
                    <div class="flex items-center justify-between mb-4">
                        <div class="stat-icon bg-blue-100 text-blue-600">
                            <i class="fas fa-users"></i>
                        </div>
                        <span class="text-xs font-bold text-green-500 bg-green-50 px-2 py-1 rounded-full">+12%</span>
                    </div>
                    <h3 class="text-slate-500 font-semibold text-sm">Total Students</h3>
                    <p class="text-2xl font-black text-slate-900">
                        <%= analytics.studentCount %>
                    </p>
                </div>
                <div class="glass-card p-6">
                    <div class="flex items-center justify-between mb-4">
                        <div class="stat-icon bg-indigo-100 text-indigo-600">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <span class="text-xs font-bold text-blue-500 bg-blue-50 px-2 py-1 rounded-full">Optimal</span>
                    </div>
                    <h3 class="text-slate-500 font-semibold text-sm">Avg. Progress</h3>
                    <p class="text-2xl font-black text-slate-900">
                        <%= analytics.avgProgress %>%
                    </p>
                </div>
                <div class="glass-card p-6">
                    <div class="flex items-center justify-between mb-4">
                        <div class="stat-icon bg-amber-100 text-amber-600">
                            <i class="fas fa-question-circle"></i>
                        </div>
                        <span class="text-xs font-bold text-amber-500 bg-amber-50 px-2 py-1 rounded-full">
                            <%= doubts.length %> New
                        </span>
                    </div>
                    <h3 class="text-slate-500 font-semibold text-sm">Pending Doubts</h3>
                    <p class="text-2xl font-black text-slate-900">
                        <%= doubts.length %>
                    </p>
                </div>
                <div class="glass-card p-6">
                    <div class="flex items-center justify-between mb-4">
                        <div class="stat-icon bg-rose-100 text-rose-600">
                            <i class="fas fa-video"></i>
                        </div>
                        <span class="text-xs font-bold text-rose-500 bg-rose-50 px-2 py-1 rounded-full">Next 2h</span>
                    </div>
                    <h3 class="text-slate-500 font-semibold text-sm">Active Sessions</h3>
                    <p class="text-2xl font-black text-slate-900">
                        <%= doubtSessions.length %>
                    </p>
                </div>
            </div>

            <!-- Main Dashboard Grid -->
            <div class="dashboard-grid">

                <!-- Doubt Sessions Management -->
                <div class="col-span-8 glass-card p-8">
                    <div class="flex justify-between items-center mb-8">
                        <h2 class="text-2xl font-bold text-slate-900">Live Doubt Sessions</h2>
                        <button onclick="toggleModal('sessionModal')"
                            class="btn-premium px-6 py-2.5 flex items-center gap-2">
                            <i class="fas fa-plus"></i> Schedule Session
                        </button>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <% if (doubtSessions && doubtSessions.length> 0) { %>
                            <% doubtSessions.forEach(session=> { %>
                                <div
                                    class="p-6 border border-slate-100 rounded-3xl hover:border-primary/30 transition-all group bg-white/50">
                                    <div class="flex justify-between items-start mb-4">
                                        <div
                                            class="bg-primary/10 text-primary px-3 py-1 rounded-full text-[10px] font-black uppercase">
                                            <%= session.date %>
                                        </div>
                                        <span class="text-slate-400 group-hover:text-primary transition-colors">
                                            <i class="fas fa-ellipsis-h"></i>
                                        </span>
                                    </div>
                                    <h3 class="text-lg font-bold text-slate-900 mb-1">
                                        <%= session.title %>
                                    </h3>
                                    <p class="text-slate-500 text-sm mb-4 flex items-center gap-2">
                                        <i class="far fa-clock"></i>
                                        <%= session.sessionTime %> (<%= session.sessionDuration %>)
                                    </p>
                                    <a href="<%= session.link %>" target="_blank"
                                        class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-slate-900 text-white rounded-xl text-sm font-semibold hover:bg-primary transition-all">
                                        <i class="fas fa-external-link-alt"></i> Join Room
                                    </a>
                                </div>
                                <% }); %>
                                    <% } else { %>
                                        <div
                                            class="col-span-2 text-center py-12 bg-slate-50 rounded-3xl border-2 border-dashed border-slate-200">
                                            <div class="text-4xl mb-3 text-slate-300">📅</div>
                                            <p class="text-slate-500 font-medium">No sessions scheduled yet.</p>
                                        </div>
                                        <% } %>
                    </div>
                </div>

                <!-- Assignments & Tasks -->
                <div class="col-span-4 glass-card p-8">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-xl font-bold text-slate-900">Task Center</h2>
                        <button onclick="toggleModal('taskModal')"
                            class="text-primary font-bold text-sm hover:underline">+ New</button>
                    </div>

                    <div class="space-y-4 max-h-[400px] overflow-y-auto pr-2 custom-scrollbar">
                        <% if (tasks && tasks.length> 0) { %>
                            <% tasks.forEach(task=> { %>
                                <div
                                    class="flex items-center gap-4 p-4 rounded-2xl bg-white/40 border border-slate-100 group">
                                    <div
                                        class="w-2 h-10 bg-indigo-500 rounded-full group-hover:scale-y-110 transition-transform">
                                    </div>
                                    <div class="flex-1">
                                        <h4 class="text-sm font-bold text-slate-800">
                                            <%= task.title %>
                                        </h4>
                                        <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider mt-0.5">
                                            <i class="far fa-calendar-alt"></i> Due: <%= task.dueDate %>
                                        </p>
                                    </div>
                                </div>
                                <% }); %>
                                    <% } else { %>
                                        <p class="text-center text-slate-400 py-10 text-sm">All tasks cleared!</p>
                                        <% } %>
                    </div>
                </div>

                <!-- Student Doubts Section -->
                <div class="col-span-12 glass-card p-8">
                    <div class="flex justify-between items-center mb-8">
                        <div>
                            <h2 class="text-2xl font-bold text-slate-900">Instant Doubt Solver</h2>
                            <p class="text-slate-500 text-sm">Help your students overcome their challenges</p>
                        </div>
                        <div class="flex gap-2">
                            <button class="nav-pill active">Pending</button>
                            <button class="nav-pill text-slate-400 hover:bg-slate-100">Resolved</button>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        <% if (doubts && doubts.length> 0) { %>
                            <% doubts.forEach(doubt=> { %>
                                <div class="glass-card p-6 border-l-4 border-rose-500 bg-white/40">
                                    <div class="flex items-center gap-3 mb-4">
                                        <div
                                            class="w-10 h-10 rounded-full bg-slate-200 border-2 border-white shadow-sm flex items-center justify-center font-bold text-slate-600">
                                            <%= doubt.studentName.charAt(0) %>
                                        </div>
                                        <div>
                                            <h4 class="text-sm font-bold text-slate-900">
                                                <%= doubt.studentName %>
                                            </h4>
                                            <p class="text-[10px] text-slate-400 font-bold uppercase">
                                                <%= doubt.subject %>
                                            </p>
                                        </div>
                                    </div>
                                    <p class="text-slate-800 font-medium mb-6 text-sm line-clamp-3">"<%= doubt.question
                                            %>"</p>

                                    <form action="/answerDoubt" method="POST" class="space-y-3">
                                        <input type="hidden" name="doubtId" value="<%= doubt._id %>">
                                        <textarea name="answer" placeholder="Your expert solution..."
                                            class="w-full bg-white/70 border-none rounded-2xl px-4 py-3 text-sm focus:ring-2 focus:ring-primary outline-none min-h-[80px]"
                                            required></textarea>
                                        <button type="submit"
                                            class="w-full py-2.5 bg-slate-900 text-white rounded-xl text-sm font-bold hover:bg-primary transition-all">
                                            Send Solution
                                        </button>
                                    </form>
                                </div>
                                <% }); %>
                                    <% } else { %>
                                        <div class="col-span-full text-center py-20">
                                            <div class="text-6xl mb-4">✨</div>
                                            <h3 class="text-xl font-bold text-slate-900">Clear Skies!</h3>
                                            <p class="text-slate-500">All students are on the right track for now.</p>
                                        </div>
                                        <% } %>
                    </div>
                </div>

                <!-- Learning Resources (Study Vault) -->
                <div class="col-span-8 glass-card p-8">
                    <div class="flex justify-between items-center mb-8">
                        <div>
                            <h2 class="text-2xl font-bold text-slate-900">Campus Study Vault</h2>
                            <p class="text-slate-500 text-sm">Shared learning materials and research papers</p>
                        </div>
                        <button onclick="toggleModal('resourceModal')"
                            class="text-primary font-bold text-sm bg-primary/10 px-4 py-2 rounded-xl hover:bg-primary hover:text-white transition-all">
                            + Share Material
                        </button>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        <% if (resources && resources.length> 0) { %>
                            <% resources.forEach(res=> { %>
                                <div
                                    class="p-5 bg-white border border-slate-100 rounded-3xl hover:shadow-xl hover:-translate-y-1 transition-all group">
                                    <div class="flex items-center gap-4 mb-4">
                                        <div
                                            class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center font-xl group-hover:bg-emerald-600 group-hover:text-white transition-all">
                                            <% if(res.link && (res.link.includes('youtube') ||
                                                res.link.includes('youtu.be'))) { %>
                                                <i class="fab fa-youtube"></i>
                                                <% } else if(res.link && res.link.includes('drive.google')) { %>
                                                    <i class="fab fa-google-drive"></i>
                                                    <% } else { %>
                                                        <i class="fas fa-file-alt"></i>
                                                        <% } %>
                                        </div>
                                        <div class="overflow-hidden">
                                            <h3 class="font-bold text-slate-900 text-sm truncate">
                                                <%= res.title %>
                                            </h3>
                                            <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">
                                                Resource</p>
                                        </div>
                                    </div>
                                    <a href="<%= res.link %>" target="_blank"
                                        class="text-xs font-bold text-emerald-600 hover:text-emerald-700 flex items-center gap-1">
                                        Accessibility Link <i class="fas fa-arrow-right ml-1"></i>
                                    </a>
                                </div>
                                <% }); %>
                                    <% } else { %>
                                        <div
                                            class="col-span-3 text-center py-12 bg-slate-50 rounded-3xl border-2 border-dashed border-slate-200">
                                            <p class="text-slate-400 font-medium italic">Vault is empty. Be the first to
                                                share!</p>
                                        </div>
                                        <% } %>
                    </div>
                </div>

                <!-- Announcements Feed -->
                <div class="col-span-4 glass-card p-8">
                    <h2 class="text-xl font-bold text-slate-900 mb-6">Campus Feed</h2>
                    <div class="space-y-6">
                        <% announcements.forEach(announcement=> { %>
                            <div class="relative pl-6 border-l-2 border-slate-200">
                                <div class="absolute -left-[5px] top-0 w-2 h-2 rounded-full bg-primary"></div>
                                <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-1">
                                    <%= announcement.date %>
                                </p>
                                <h4 class="text-sm font-bold text-slate-800 leading-tight">
                                    <%= announcement.title %>
                                </h4>
                            </div>
                            <% }); %>

                                <form action="/addAnnouncement" method="POST"
                                    class="mt-8 pt-6 border-t border-slate-100">
                                    <p class="text-xs font-bold text-slate-500 mb-3 uppercase">Post New Feed</p>
                                    <input type="text" name="title" placeholder="What's happening?"
                                        class="w-full bg-slate-50 border-none rounded-xl px-4 py-2.5 text-sm mb-3 outline-none focus:ring-2 focus:ring-primary"
                                        required>
                                    <div class="flex gap-2">
                                        <input type="date" name="date"
                                            class="flex-1 bg-slate-50 border-none rounded-xl px-3 text-xs outline-none"
                                            required>
                                        <button type="submit"
                                            class="bg-indigo-600 text-white px-4 py-2 rounded-xl text-xs font-bold">Post</button>
                                    </div>
                                </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modals -->
        <!-- Session Modal -->
        <div id="sessionModal" class="fixed inset-0 z-50 hidden modal-backdrop flex items-center justify-center p-4">
            <div class="glass-card w-full max-w-lg p-8 animate-in bg-white shadow-2xl">
                <div class="flex justify-between items-center mb-6">
                    <h3 class="text-2xl font-bold text-slate-900">Schedule Doubt Session</h3>
                    <button onclick="toggleModal('sessionModal')" class="text-slate-400 hover:text-rose-500"><i
                            class="fas fa-times"></i></button>
                </div>
                <form action="/addDoubtSession" method="POST" class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Session Title</label>
                        <input type="text" name="title" placeholder="e.g., Final Physics Exam Prep"
                            class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-primary"
                            required>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Date</label>
                            <input type="date" name="date"
                                class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 outline-none"
                                required>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Time</label>
                            <input type="time" name="sessionTime"
                                class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 outline-none"
                                required>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Duration</label>
                            <select name="sessionDuration"
                                class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 outline-none">
                                <option value="30 mins">30 mins</option>
                                <option value="45 mins" selected>45 mins</option>
                                <option value="1 hour">1 hour</option>
                                <option value="1.5 hours">1.5 hours</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Meeting Link</label>
                            <input type="url" name="sessionLink" placeholder="Zoom/Meet link"
                                class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 outline-none"
                                required>
                        </div>
                    </div>
                    <button type="submit" class="w-full btn-premium py-4 mt-4">Broadcast to Students</button>
                </form>
            </div>
        </div>

        <!-- Resource Modal -->
        <div id="resourceModal" class="fixed inset-0 z-50 hidden modal-backdrop flex items-center justify-center p-4">
            <div class="glass-card w-full max-w-md p-8 animate-in bg-white shadow-2xl">
                <div class="flex justify-between items-center mb-6">
                    <h3 class="text-2xl font-bold text-slate-900">Share Study Material</h3>
                    <button onclick="toggleModal('resourceModal')" class="text-slate-400 hover:text-rose-500"><i
                            class="fas fa-times"></i></button>
                </div>
                <form action="/addResource" method="POST" class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Material Title</label>
                        <input type="text" name="title" placeholder="Notes title"
                            class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-emerald-500"
                            required>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Link
                            (Drive/PDF/Video)</label>
                        <input type="url" name="link" placeholder="https://..."
                            class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-emerald-500"
                            required>
                    </div>
                    <button type="submit"
                        class="w-full bg-emerald-600 text-white font-bold rounded-xl py-4 mt-4 hover:bg-emerald-700 shadow-lg shadow-emerald-100 transition-all">Publish
                        Resource</button>
                </form>
            </div>
        </div>

        <!-- Task Modal -->
        <div id="taskModal" class="fixed inset-0 z-50 hidden modal-backdrop flex items-center justify-center p-4">
            <div class="glass-card w-full max-w-md p-8 animate-in bg-white shadow-2xl">
                <div class="flex justify-between items-center mb-6">
                    <h3 class="text-2xl font-bold text-slate-900">New Assignment</h3>
                    <button onclick="toggleModal('taskModal')" class="text-slate-400 hover:text-rose-500"><i
                            class="fas fa-times"></i></button>
                </div>
                <form action="/addTask" method="POST" class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Task Description</label>
                        <input type="text" name="title" placeholder="Assignment name"
                            class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-indigo-500"
                            required>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Due Date</label>
                        <input type="date" name="dueDate"
                            class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 outline-none"
                            required>
                    </div>
                    <button type="submit"
                        class="w-full bg-indigo-600 text-white font-bold rounded-xl py-4 mt-4 hover:bg-indigo-700 transition-all">Assign
                        Task</button>
                </form>
            </div>
        </div>

        <%- include('layouts/footer'); -%>

            <script>
                function toggleModal(id) {
                    const modal = document.getElementById(id);
                    modal.classList.toggle('hidden');
                }

                // Close modals on clicking backdrop
                window.onclick = function (event) {
                    if (event.target.classList.contains('modal-backdrop')) {
                        event.target.classList.add('hidden');
                    }
                }

                // Dark Mode (Simplified)
                const darkModeToggle = document.getElementById('darkModeToggle');
                darkModeToggle.addEventListener('click', () => {
                    document.body.classList.toggle('dark-mode');
                    // Add dark mode specific logic if needed
                });
            </script>