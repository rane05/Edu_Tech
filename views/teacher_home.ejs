<%- include('layouts/header'); -%>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap');

        :root {
            --bg-main: #f4f7fb;
            --text-dark: #1e293b;
            --text-muted: #64748b;
            --primary: #5c6bc0;
            --card-bg: #ffffff;
            --border-color: #e2e8f0;
            --shadow-sm: 0 4px 15px rgba(0, 0, 0, 0.03);
            --shadow-md: 0 8px 30px rgba(0, 0, 0, 0.05);
            --radius-lg: 24px;
            --radius-md: 16px;
            --radius-sm: 12px;
        }

        body {
            font-family: 'Outfit', sans-serif;
            background-color: var(--bg-main);
            color: var(--text-dark);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        /* Layout */
        .dashboard-layout {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar */
        .sidebar {
            width: 260px;
            background: var(--bg-main);
            padding: 32px 24px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            border-right: 1px solid var(--border-color);
            position: fixed;
            height: 100vh;
            overflow-y: auto;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 14px 20px;
            border-radius: var(--radius-sm);
            color: var(--text-muted);
            font-weight: 600;
            font-size: 15px;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .nav-item i {
            font-size: 18px;
            width: 24px;
            text-align: center;
        }

        .nav-item.active {
            background: #eef2ff;
            color: var(--primary);
        }

        .nav-item:hover:not(.active) {
            background: rgba(0, 0, 0, 0.03);
            color: var(--text-dark);
        }

        .sidebar-promo {
            margin-top: auto;
            background: linear-gradient(135deg, #7c83fd, #5c6bc0);
            border-radius: var(--radius-lg);
            padding: 24px;
            color: white;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .sidebar-promo-btn {
            background: #fcd05b;
            color: #1e293b;
            border: none;
            padding: 10px 20px;
            border-radius: 99px;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            margin-top: 16px;
            width: 100%;
            transition: transform 0.2s ease;
        }

        .sidebar-promo-btn:hover {
            transform: scale(1.05);
        }

        .school-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
            font-size: 18px;
            margin-top: 24px;
            justify-content: center;
            color: var(--text-dark);
        }

        /* Main Content */
        .main-content {
            flex: 1;
            margin-left: 260px;
            padding: 40px;
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        /* Top Header Row */
        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 8px;
        }

        .greeting h1 {
            font-size: 28px;
            font-weight: 800;
            margin: 0 0 4px 0;
            color: var(--text-dark);
        }

        .greeting p {
            font-size: 14px;
            color: var(--text-muted);
            margin: 0;
            font-weight: 500;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .icon-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: white;
            border: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            cursor: pointer;
            transition: all 0.2s;
        }

        .icon-btn:hover {
            color: var(--text-dark);
            border-color: #cbd5e1;
        }

        /* Top Row Cards */
        .hero-banner {
            background: linear-gradient(100deg, #93a5cf 0%, #e4efe9 100%);
            background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
            border-radius: var(--radius-lg);
            padding: 30px 40px;
            color: white;
            display: flex;
            align-items: center;
            gap: 30px;
            flex: 1;
            box-shadow: var(--shadow-md);
            position: relative;
            overflow: hidden;
        }

        .hero-banner h2 {
            font-size: 22px;
            font-weight: 700;
            margin: 0 0 8px 0;
        }

        .hero-banner p {
            font-size: 15px;
            opacity: 0.9;
            margin: 0;
            font-weight: 500;
        }

        .profile-card {
            background: var(--card-bg);
            border-radius: var(--radius-lg);
            padding: 24px;
            display: flex;
            align-items: center;
            gap: 20px;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--border-color);
            min-width: 320px;
        }

        .profile-avatar {
            width: 70px;
            height: 70px;
            border-radius: var(--radius-md);
            background: #eef2ff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
        }

        .profile-info h3 {
            margin: 0 0 4px 0;
            font-size: 18px;
            font-weight: 700;
        }

        .profile-info p {
            margin: 0 0 12px 0;
            font-size: 13px;
            color: var(--text-muted);
        }

        .profile-stats {
            display: flex;
            gap: 12px;
        }

        .p-stat {
            background: #f1f5f9;
            padding: 6px 12px;
            border-radius: 99px;
            font-size: 12px;
            font-weight: 600;
            color: var(--text-muted);
        }

        .p-stat span {
            color: var(--text-dark);
            font-weight: 800;
        }

        /* Dashboard Grid */
        .bento-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
        }

        .card {
            background: var(--card-bg);
            border-radius: var(--radius-lg);
            padding: 28px;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--border-color);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }

        .card-title {
            font-size: 18px;
            font-weight: 800;
            margin: 0;
        }

        .view-all {
            background: #f1f5f9;
            color: var(--primary);
            padding: 6px 14px;
            border-radius: 99px;
            font-size: 12px;
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
            border: none;
        }

        /* Working Hours (Stats) */
        .stat-bar-container {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .stat-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--border-color);
        }

        .stat-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .stat-val {
            font-size: 24px;
            font-weight: 800;
            color: var(--text-dark);
        }

        .stat-label {
            font-size: 13px;
            color: var(--text-muted);
            font-weight: 500;
        }

        /* Group Chats (Doubts) */
        .chat-item {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 12px 0;
            border-bottom: 1px solid var(--border-color);
        }

        .chat-item:last-child {
            border-bottom: none;
        }

        .chat-icon {
            width: 44px;
            height: 44px;
            border-radius: var(--radius-sm);
            background: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            flex-shrink: 0;
        }

        .chat-info {
            flex: 1;
            min-width: 0;
        }

        .chat-info h4 {
            margin: 0 0 4px 0;
            font-size: 15px;
            font-weight: 700;
            color: var(--text-dark);
        }

        .chat-info p {
            margin: 0;
            font-size: 13px;
            color: var(--text-muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .badge {
            background: var(--primary);
            color: white;
            font-size: 12px;
            font-weight: 700;
            min-width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }

        /* Calendar Placeholder */
        .calendar-widget {
            text-align: center;
        }

        /* Student Tests (Tasks) */
        .col-span-2 {
            grid-column: span 2;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
        }

        .data-table th {
            text-align: left;
            padding: 12px 16px;
            font-size: 13px;
            color: var(--text-muted);
            font-weight: 600;
            border-bottom: 1px solid var(--border-color);
        }

        .data-table td {
            padding: 16px;
            font-size: 14px;
            font-weight: 500;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        .data-table tr:last-child td {
            border-bottom: none;
        }

        .test-name {
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--text-dark);
            font-weight: 600;
        }

        .test-name i {
            color: var(--primary);
            font-size: 16px;
            background: #eef2ff;
            padding: 8px;
            border-radius: 50%;
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            border-radius: 99px;
            font-size: 12px;
            font-weight: 600;
        }

        .status-active {
            color: var(--primary);
        }

        .status-reviewed {
            color: #10b981;
        }

        .status-pending {
            color: #f59e0b;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
        }

        .dot-active {
            background: var(--primary);
        }

        .dot-reviewed {
            background: #10b981;
        }

        .dot-pending {
            background: #f59e0b;
        }

        /* Upcoming Classes */
        .class-card {
            background: #f8fafc;
            border-radius: var(--radius-md);
            padding: 16px;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 16px;
            border: 1px solid #f1f5f9;
        }

        .class-time {
            font-size: 15px;
            font-weight: 800;
            color: var(--text-dark);
            background: white;
            padding: 8px 12px;
            border-radius: var(--radius-sm);
            box-shadow: var(--shadow-sm);
        }

        .class-info flex {
            flex: 1;
        }

        .class-info h4 {
            margin: 0 0 4px 0;
            font-size: 14px;
            font-weight: 700;
        }

        .class-info p {
            margin: 0;
            font-size: 12px;
            color: var(--text-muted);
        }

        .link-btn {
            width: 32px;
            height: 32px;
            background: var(--primary);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            flex-shrink: 0;
        }

        @media (max-width: 1024px) {

            .dashboard-grid,
            .bento-grid {
                grid-template-columns: 1fr;
            }

            .col-span-2 {
                grid-column: span 1;
            }

            .main-content {
                margin-left: 0;
                padding: 20px;
            }

            .sidebar {
                display: none;
            }

            .top-row {
                flex-direction: column;
            }

            .profile-card {
                width: 100%;
            }
        }
    </style>

    <div class="dashboard-layout">
        <!-- Sidebar -->
        <aside class="sidebar">
            <a href="/teacher_home" class="nav-item active">
                <i class="fas fa-border-all"></i> Dashboard
            </a>
            <a href="#" onclick="toggleModal('sessionModal')" class="nav-item">
                <i class="far fa-calendar-alt"></i> Schedule
            </a>
            <a href="#" class="nav-item">
                <i class="far fa-envelope"></i> Inbox
            </a>
            <a href="/studentlist" class="nav-item">
                <i class="far fa-user"></i> Students
            </a>
            <a href="#" onclick="toggleModal('taskModal')" class="nav-item">
                <i class="far fa-file-alt"></i> Assignments
            </a>
            <a href="#" onclick="toggleModal('resourceModal')" class="nav-item">
                <i class="far fa-folder-open"></i> Share Resource
            </a>
            <a href="#" class="nav-item">
                <i class="fas fa-cog"></i> Settings
            </a>

            <div class="sidebar-promo">
                <div style="font-size: 24px; margin-bottom: 8px;">✨</div>
                <p style="font-size: 14px; font-weight: 600; margin: 0 0 8px 0;">Create new class session now</p>
                <button class="sidebar-promo-btn" onclick="toggleModal('sessionModal')">Create class</button>
            </div>

            <div class="school-logo">
                <a href="/tprofile"
                    style="color: inherit; text-decoration: none; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-shield-alt"></i>
                    <%= collegeName || "Your College" %>
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <!-- Top Header -->
            <div class="top-header">
                <div class="greeting">
                    <h1>Welcome back, <span style="color: var(--primary)">
                            <%= username %>
                        </span></h1>
                    <p>
                        <%= new Date().toLocaleDateString('en-US', { month: 'long' , day: 'numeric' , weekday: 'long' })
                            %>
                    </p>
                </div>
                <div class="header-actions">
                    <button class="icon-btn"><i class="fas fa-search"></i></button>
                    <button class="icon-btn"><i class="far fa-bell"></i></button>
                </div>
            </div>

            <!-- Banner & Profile Row -->
            <div style="display: flex; gap: 24px; flex-wrap: wrap;">
                <div class="hero-banner">
                    <div style="font-size: 60px; opacity: 0.2; position: absolute; left: -10px; bottom: -20px;">🎓</div>
                    <div style="position: relative; z-index: 1;">
                        <h2>Your students average progress is <%= analytics.avgProgress %>%.</h2>
                        <p>Level up your students to improve your teacher rank!</p>
                    </div>
                </div>

                <div class="profile-card">
                    <div class="profile-avatar">👨‍🏫</div>
                    <div class="profile-info">
                        <h3>
                            <%= username %>
                        </h3>
                        <p>Invite Code: <strong style="color: var(--primary)">
                                <%= teacherCode %>
                            </strong></p>
                        <div class="profile-stats">
                            <a href="/studentlist" class="p-stat" style="text-decoration: none; color: inherit;">Students: <span>
                                    <%= analytics.studentCount %>
                                </span></a>
                            <div class="p-stat">Classes: <span>
                                    <%= doubtSessions.length %>
                                </span></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3-Col Grid -->
            <div class="bento-grid">

                <!-- Quick Stats (Working Hours Eqv) -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Overview Stats</h3>
                    </div>
                    <div class="stat-bar-container">
                        <a href="/studentlist" class="stat-row" style="text-decoration: none; color: inherit;">
                            <div>
                                <div class="stat-label">Total Enrolled</div>
                                <div class="stat-val">
                                    <%= analytics.studentCount %>
                                </div>
                            </div>
                            <i class="fas fa-users" style="color: #64748b; font-size: 20px;"></i>
                        </a>
                        <div class="stat-row">
                            <div>
                                <div class="stat-label">Pending Doubts</div>
                                <div class="stat-val">
                                    <%= doubts.length %>
                                </div>
                            </div>
                            <i class="fas fa-question-circle" style="color: #f59e0b; font-size: 20px;"></i>
                        </div>
                        <div class="stat-row">
                            <div>
                                <div class="stat-label">Active Tasks</div>
                                <div class="stat-val">
                                    <%= tasks.length %>
                                </div>
                            </div>
                            <i class="far fa-file-alt" style="color: #10b981; font-size: 20px;"></i>
                        </div>
                    </div>
                </div>

                <!-- Pending Doubts (Group Chats Eqv) -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Pending Doubts</h3>
                        <span class="view-all">
                            <%= doubts.length %> Total
                        </span>
                    </div>

                    <% if(doubts.length> 0) { %>
                        <% doubts.slice(0, 4).forEach(doubt=> { %>
                            <div class="chat-item">
                                <div class="chat-icon">
                                    <%= doubt.studentName.charAt(0) %>
                                </div>
                                <div class="chat-info">
                                    <h4>
                                        <%= doubt.studentName || (doubt.studentId ? doubt.studentId.username : 'Student') %>
                                    </h4>
                                    <p style="font-weight: 700; color: var(--text-dark); margin-bottom: 2px;">
                                        <%= doubt.subject || doubt.title || 'Doubt' %>
                                    </p>
                                    <p>
                                        <%= doubt.question || doubt.description %>
                                    </p>
                                </div>
                                <button 
                                    data-id="<%= doubt._id %>" 
                                    data-question="<%= (doubt.question || doubt.description || '').replace(/"/g, '&quot;') %>" 
                                    onclick="openAnswerModalFromBtn(this)" 
                                    class="view-all" 
                                    style="background: var(--primary); color: white; margin-left: auto;">
                                    Answer
                                </button>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <div
                                        style="text-align: center; padding: 30px 0; color: var(--text-muted); font-size: 14px;">
                                        No pending doubts. Great job!
                                    </div>
                                    <% } %>
                </div>

                <!-- Minimal Calendar Placeholder -->
                <div class="card calendar-widget">
                    <div class="card-header">
                        <i class="fas fa-chevron-left" style="color: var(--text-muted); cursor: pointer;"></i>
                        <h3 class="card-title" style="font-size: 15px;">
                            <%= new Date().toLocaleString('default', { month: 'long' , year: 'numeric' }) %>
                        </h3>
                        <i class="fas fa-chevron-right" style="color: var(--text-muted); cursor: pointer;"></i>
                    </div>
                    <!-- Simple static mock grid for visual parity with the design -->
                    <div
                        style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; font-size: 13px; font-weight: 600; color: var(--text-muted); margin-bottom: 12px;">
                        <div>S</div>
                        <div>M</div>
                        <div>T</div>
                        <div>W</div>
                        <div>T</div>
                        <div>F</div>
                        <div>S</div>
                    </div>
                    <div
                        style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; font-size: 13px; font-weight: 500; color: var(--text-dark);">
                        <div style="color: #cbd5e1">29</div>
                        <div style="color: #cbd5e1">30</div>
                        <div style="color: #cbd5e1">31</div>
                        <div>1</div>
                        <div>2</div>
                        <div>3</div>
                        <div>4</div>
                        <div>5</div>
                        <div>6</div>
                        <div
                            style="background: var(--primary); color: white; border-radius: 50%; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                            7</div>
                        <div>8</div>
                        <div>9</div>
                        <div>10</div>
                        <div>11</div>
                    </div>
                </div>

                <!-- Student Tests (Tasks) -->
                <div class="card col-span-2">
                    <div class="card-header">
                        <h3 class="card-title">Manage Tasks</h3>
                        <button class="view-all" onclick="toggleModal('taskModal')">New Task</button>
                    </div>

                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Task Name</th>
                                <th>Deadline</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if(tasks.length> 0) { %>
                                <% tasks.forEach(task=> { %>
                                    <tr>
                                        <td>
                                            <div class="test-name">
                                                <i class="fas fa-link"></i>
                                                <%= task.title %>
                                            </div>
                                        </td>
                                        <td>
                                            <%= task.dueDate %>
                                        </td>
                                        <td>
                                            <div class="status-pill">
                                                <div class="status-dot dot-active"></div>
                                                <span class="status-active">Active</span>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="3" style="text-align: center;">No active tasks assigned
                                                    yet.</td>
                                            </tr>
                                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Upcoming Classes (Sessions) -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Live Sessions</h3>
                        <button class="view-all" onclick="toggleModal('sessionModal')">New</button>
                    </div>

                    <% if(doubtSessions.length> 0) { %>
                        <% doubtSessions.forEach(session=> { %>
                            <div class="class-card">
                                <div class="class-time">
                                    <%= session.sessionTime %>
                                </div>
                                <div class="class-info">
                                    <h4>
                                        <%= session.title %>
                                    </h4>
                                    <p>
                                        <%= session.date %> • <%= session.sessionDuration %>
                                    </p>
                                </div>
                                <a href="<%= session.link %>" target="_blank" class="link-btn">
                                    <i class="fas fa-video"></i>
                                </a>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <div
                                        style="text-align: center; padding: 20px 0; font-size: 13px; color: var(--text-muted);">
                                        No upcoming sessions
                                    </div>
                                    <% } %>
                </div>

            </div>
        </main>
    </div>

    <!-- Keep Existing Modals but simply styled them slightly to avoid conflicts -->
    <div id="sessionModal"
        style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 100; align-items: center; justify-content: center;">
        <div
            style="background: white; padding: 32px; border-radius: 24px; width: 100%; max-width: 400px; margin: auto; margin-top: 10vh;">
            <h3 style="margin-top: 0;">Schedule Class</h3>
            <form action="/addDoubtSession" method="POST">
                <input type="text" name="title" placeholder="Session Title" required
                    style="width: 100%; padding: 12px; margin-bottom: 12px; border-radius: 12px; border: 1px solid #e2e8f0;">
                <input type="date" name="date" required
