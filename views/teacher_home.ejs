<%- include('layouts/header'); -%>
    <%- include('layouts/tnavbar'); -%>
        <!-- <body class="bg-gray-50 dark:bg-gray-900"> -->
        <!-- Main Container -->
        <div class="min-h-screen p-15">
            <!-- Header Section -->
            <header class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 mb-10">
                <div class="flex justify-between items-center">
                    <div>
                        <h1 class="text-3xl font-bold text-gray-800 dark:text-gray-800">
                            <%= collegeName %> Dashboard
                        </h1>
                        <p class="text-gray-600 dark:text-gray-400">Welcome, <%= username %> | Senior Instructional
                                Officer</p>
                        <div class="mt-4 flex flex-wrap gap-2">
                            <span
                                class="inline-flex items-center px-4 py-1.5 rounded-full bg-blue-100 text-blue-800 text-sm font-semibold">
                                <i class="fas fa-university mr-2"></i> Institutional Connection Active
                            </span>
                            <span
                                class="inline-flex items-center px-4 py-1.5 rounded-full bg-indigo-100 text-indigo-800 text-sm font-semibold">
                                <i class="fas fa-key mr-2"></i> Code: <%= teacherCode %>
                            </span>
                        </div>
                    </div>
                    <!-- Dark Mode Toggle -->
                    <button id="darkModeToggle" class="p-2 rounded-lg bg-gray-200 dark:bg-gray-700">
                        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                            <path class="dark:hidden"
                                d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z">
                            </path>
                            <path class="hidden dark:block"
                                d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
                        </svg>
                    </button>
                </div>
            </header>

            <!-- Search and Filter Section -->
            <div class="bg-white dark:bg-white-200 rounded-lg shadow-lg p-6 mb-6">
                <div class="flex flex-col md:flex-row gap-4">
                    <input type="text" placeholder="Search Students..."
                        class="flex-1 px-4 py-2 rounded-lg border dark:bg-gray-700 dark:border-gray-600">
                    <select class="px-4 py-2 rounded-lg border dark:bg-gray-700 dark:border-gray-600">
                        <option>All Subjects</option>
                        <option>Mathematics</option>
                        <option>Science</option>
                        <option>English</option>
                    </select>
                    <select class="px-4 py-2 rounded-lg border dark:bg-gray-700 dark:border-gray-600">
                        <option>All Status</option>
                        <option>In Progress</option>
                        <option>Completed</option>
                    </select>
                </div>
            </div>

            <!-- Main Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-6">
                <!-- Institutional Analytics -->
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6">
                    <h2 class="text-xl font-semibold mb-4 text-gray-800 dark:text-gray-800">Class Analysis</h2>
                    <div class="grid grid-cols-2 gap-4">
                        <div class="text-center p-3 bg-blue-50 rounded-xl">
                            <span class="block text-2xl font-bold text-blue-600">
                                <%= analytics.avgProgress %>%
                            </span>
                            <span class="text-xs text-blue-500 uppercase font-semibold">Avg Progress</span>
                        </div>
                        <div class="text-center p-3 bg-purple-50 rounded-xl">
                            <span class="block text-2xl font-bold text-purple-600">
                                <%= analytics.studentCount %>
                            </span>
                            <span class="text-xs text-purple-500 uppercase font-semibold">Enrolled</span>
                        </div>
                    </div>
                    <div class="mt-6">
                        <h4 class="text-sm font-medium text-gray-500 mb-2">College Ecosystem Health</h4>
                        <div class="w-full bg-gray-100 rounded-full h-4 overflow-hidden">
                            <div class="bg-gradient-to-r from-blue-400 to-indigo-600 h-full transition-all duration-1000"
                                style="width: <%= analytics.avgProgress %>%"></div>
                        </div>
                    </div>
                </div>

                <!-- Student Progress -->
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6">
                    <h2 class="text-xl font-semibold mb-4 text-gray-800 dark:text-gray-800">Student Progress</h2>
                    <div class="space-y-4 max-h-64 overflow-y-auto pr-2 custom-scrollbar">
                        <% if (students.length> 0) { %>
                            <% students.slice(0, 10).forEach(student=> { %>
                                <div
                                    class="group flex items-center justify-between p-2 hover:bg-gray-50 rounded-lg transition-colors">
                                    <div class="flex items-center gap-3">
                                        <div
                                            class="w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-700 text-xs font-bold">
                                            <%= student.fullName.charAt(0) %>
                                        </div>
                                        <span class="text-sm font-medium text-gray-700">
                                            <%= student.fullName %>
                                        </span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <span class="text-xs font-semibold text-blue-600">
                                            <%= student.progress %>%
                                        </span>
                                        <div class="w-12 bg-gray-200 rounded-full h-1">
                                            <div class="bg-blue-500 h-1 rounded-full"
                                                style="width: <%= student.progress %>%"></div>
                                        </div>
                                    </div>
                                </div>
                                <% }); %>
                                    <% } else { %>
                                        <p class="text-center text-gray-500 py-10">No students found for this college
                                            yet.</p>
                                        <% } %>
                    </div>
                    <% if (students.length> 10) { %>
                        <div class="mt-4 text-center">
                            <a href="/studentlist"
                                class="text-sm font-semibold text-indigo-600 hover:text-indigo-800">View All <%=
                                    students.length %> Students →</a>
                        </div>
                        <% } %>
                </div>

                <!-- Tasks and Assignments -->
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 flex flex-col">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-xl font-bold text-gray-800">Assign Tasks</h2>
                        <button onclick="toggleForm('taskForm')" class="text-blue-600 font-bold text-sm">+ New</button>
                    </div>

                    <form id="taskForm" action="/addTask" method="POST"
                        class="hidden mb-6 p-4 bg-blue-50 rounded-xl space-y-3">
                        <input type="text" name="title" placeholder="What needs to be done?"
                            class="w-full px-3 py-2 rounded-lg border focus:ring-2 focus:ring-blue-400 outline-none"
                            required>
                        <input type="date" name="dueDate" class="w-full px-3 py-2 rounded-lg border outline-none"
                            required>
                        <button type="submit"
                            class="w-full py-2 bg-blue-600 text-white font-bold rounded-lg hover:bg-blue-700 transition-colors">Assign
                            to Class</button>
                    </form>

                    <div class="space-y-3 overflow-y-auto max-h-64 pr-2 custom-scrollbar">
                        <% if (tasks.length> 0) { %>
                            <% tasks.forEach(task=> { %>
                                <div
                                    class="p-3 border border-gray-100 rounded-xl hover:border-blue-200 transition-colors">
                                    <h3 class="text-sm font-bold text-gray-800">
                                        <%= task.title %>
                                    </h3>
                                    <p class="text-[10px] text-gray-400 mt-1 uppercase tracking-wider font-bold">Due:
                                        <%= task.dueDate %>
                                    </p>
                                </div>
                                <% }); %>
                                    <% } else { %>
                                        <p class="text-xs text-gray-400 text-center py-10">No active tasks</p>
                                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Interaction Row: Doubts & Resources -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-10">
                <!-- Doubts Section -->
                <div class="bg-white rounded-2xl shadow-xl p-8 border border-red-50">
                    <div class="flex justify-between items-center mb-8">
                        <h2 class="text-2xl font-black text-gray-900 flex items-center gap-3">
                            <span class="w-3 h-3 bg-red-500 rounded-full animate-pulse"></span>
                            Student Doubts
                        </h2>
                        <span class="bg-red-100 text-red-700 px-3 py-1 rounded-full text-xs font-black uppercase">
                            <%= doubts.length %> Pending
                        </span>
                    </div>

                    <div class="space-y-6">
                        <% if (doubts.length> 0) { %>
                            <% doubts.forEach(doubt=> { %>
                                <div
                                    class="p-6 bg-slate-50 rounded-2xl border border-slate-100 relative overflow-hidden group">
                                    <div class="absolute top-0 left-0 w-1 h-full bg-red-400"></div>
                                    <div class="flex justify-between items-start mb-4">
                                        <div>
                                            <span
                                                class="text-[10px] font-black uppercase text-slate-400 tracking-tighter">
                                                <%= doubt.subject %>
                                            </span>
                                            <h3 class="font-bold text-slate-900 mt-1 text-lg">"<%= doubt.question %>"
                                            </h3>
                                        </div>
                                        <div class="text-right">
                                            <p class="text-xs font-bold text-slate-600">
                                                <%= doubt.studentName %>
                                            </p>
                                            <p class="text-[10px] text-slate-400 font-medium">Just now</p>
                                        </div>
                                    </div>

                                    <form action="/answerDoubt" method="POST" class="mt-4 flex gap-2">
                                        <input type="hidden" name="doubtId" value="<%= doubt._id %>">
                                        <input type="text" name="answer" placeholder="Type your expert solution..."
                                            class="flex-1 bg-white border-2 border-slate-200 rounded-xl px-4 py-2 text-sm focus:border-blue-500 outline-none transition-all"
                                            required>
                                        <button type="submit"
                                            class="bg-blue-600 text-white px-6 py-2 rounded-xl text-sm font-black hover:scale-105 active:scale-95 transition-all">Reply</button>
                                    </form>
                                </div>
                                <% }); %>
                                    <% } else { %>
                                        <div class="text-center py-16">
                                            <i class="fas fa-check-circle text-green-400 text-4xl mb-4"></i>
                                            <p class="text-slate-400 font-bold">Inbox is clear! All doubts resolved.</p>
                                        </div>
                                        <% } %>
                    </div>
                </div>

                <!-- Learning Resources Section -->
                <div class="bg-white rounded-2xl shadow-xl p-8 border border-emerald-50">
                    <div class="flex justify-between items-center mb-8">
                        <h2 class="text-2xl font-black text-gray-900 flex items-center gap-3">
                            📚 Study Vault
                        </h2>
                        <button onclick="toggleForm('resourceForm')"
                            class="text-emerald-600 font-black text-sm hover:underline">+ Share Material</button>
                    </div>

                    <form id="resourceForm" action="/addResource" method="POST"
                        class="hidden mb-10 p-6 bg-emerald-50 rounded-2xl space-y-4 border border-emerald-100">
                        <div>
                            <label
                                class="text-[10px] font-black uppercase text-emerald-600 tracking-widest pl-1">Title</label>
                            <input type="text" name="title" placeholder="e.g., Quantum Mechanics Notes"
                                class="w-full bg-white border-none rounded-xl px-4 py-3 text-sm shadow-sm outline-none focus:ring-2 focus:ring-emerald-400"
                                required>
                        </div>
                        <div>
                            <label class="text-[10px] font-black uppercase text-emerald-600 tracking-widest pl-1">Link
                                (Drive/PDF/YouTube)</label>
                            <input type="url" name="link" placeholder="https://..."
                                class="w-full bg-white border-none rounded-xl px-4 py-3 text-sm shadow-sm outline-none focus:ring-2 focus:ring-emerald-400"
                                required>
                        </div>
                        <button type="submit"
                            class="w-full py-4 bg-emerald-600 text-white font-black rounded-xl hover:bg-emerald-700 shadow-lg shadow-emerald-200 transition-all">Publish
                            Resource</button>
                    </form>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <% if (resources.length> 0) { %>
                            <% resources.forEach(res=> { %>
                                <a href="<%= res.link %>" target="_blank"
                                    class="p-6 bg-white border border-slate-100 rounded-2xl hover:border-emerald-300 hover:shadow-lg transition-all flex flex-col justify-between group">
                                    <div
                                        class="w-10 h-10 bg-emerald-100 rounded-xl flex items-center justify-center text-emerald-600 mb-4 group-hover:scale-110 transition-transform">
                                        <i class="fas fa-file-alt"></i>
                                    </div>
                                    <div>
                                        <h3 class="font-black text-slate-900 text-sm leading-tight">
                                            <%= res.title %>
                                        </h3>
                                        <p class="text-[10px] text-slate-400 mt-2 font-bold tracking-widest uppercase">
                                            Click to open</p>
                                    </div>
                                </a>
                                <% }); %>
                                    <% } else { %>
                                        <div
                                            class="col-span-full text-center py-16 bg-slate-50 rounded-2xl border-2 border-dashed border-slate-200">
                                            <p class="text-slate-400 text-sm font-bold">No resources shared yet.</p>
                                        </div>
                                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Aptitude Test Analytics -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6">
                    <h2 class="text-xl font-semibold mb-4 text-gray-800 dark:text-white">Aptitude Test Results</h2>
                    <canvas id="aptitudeChart" class="w-full"></canvas>
                </div>

                <!-- Announcements -->
                <div class="bg-white rounded-2xl shadow-lg p-8 mb-10 border border-slate-100">
                    <div class="flex justify-between items-center mb-8">
                        <h2 class="text-xl font-black text-slate-900">Campus Announcements</h2>
                        <form action="/addAnnouncement" method="POST" class="flex gap-2">
                            <input type="text" name="title" placeholder="Blast announcement..."
                                class="px-4 py-2 bg-slate-50 rounded-xl border-none outline-none focus:ring-2 focus:ring-indigo-400 text-sm w-64"
                                required>
                            <input type="date" name="date" class="bg-slate-50 rounded-xl border-none text-sm px-4"
                                required>
                            <button type="submit"
                                class="bg-indigo-600 text-white px-6 py-2 rounded-xl text-sm font-black hover:bg-indigo-700">Post</button>
                        </form>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <% announcements.forEach(announcement=> { %>
                            <div class="p-5 bg-indigo-50/50 rounded-2xl border border-indigo-100">
                                <span class="text-[9px] font-black uppercase text-indigo-400 tracking-widest">Posted on
                                    <%= announcement.date %>
                                </span>
                                <h3 class="font-bold text-slate-800 mt-2">
                                    <%= announcement.title %>
                                </h3>
                            </div>
                            <% }); %>
                    </div>
                </div>

            </div>
        </div>
        <%- include('layouts/footer'); -%>

            <script>
                // Toggle Forms
                function toggleForm(id) {
                    const form = document.getElementById(id);
                    form.classList.toggle('hidden');
                }

                // Dark Mode Toggle
                const darkModeToggle = document.getElementById('darkModeToggle');
                darkModeToggle.addEventListener('click', () => {
                    document.documentElement.classList.toggle('dark');
                    localStorage.setItem('darkMode', document.documentElement.classList.contains('dark'));
                });

                // Check Dark Mode Preference
                if (localStorage.getItem('darkMode') === 'true' ||
                    (!localStorage.getItem('darkMode') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                    document.documentElement.classList.add('dark');
                }

                // Aptitude Chart
                const ctx = document.getElementById('aptitudeChart').getContext('2d');
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: ['Mathematics', 'Science', 'English', 'General Knowledge'],
                        datasets: [{
                            label: 'Class Average (%)',
                            data: [75, 82, 65, 78],
                            backgroundColor: [
                                'rgba(59, 130, 246, 0.5)',
                                'rgba(16, 185, 129, 0.5)',
                                'rgba(239, 68, 68, 0.5)',
                                'rgba(139, 92, 246, 0.5)'
                            ],
                            borderColor: [
                                'rgb(59, 130, 246)',
                                'rgb(16, 185, 129)',
                                'rgb(239, 68, 68)',
                                'rgb(139, 92, 246)'
                            ],
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        scales: {
                            y: {
                                beginAtZero: true,
                                max: 100
                            }
                        }
                    }
                });
            </script>
            <!-- </body> -->