<%- include('layouts/header') %>

  <body>
    <%- include('layouts/navbar') %>
      <div class="container py-5">
        <div class="row justify-content-center">
          <div class="card shadow-lg" style="width: 1500px;">
            <div class="card-body">
              <div class="text-center mb-4" style="font-family: 'Times new roman', sans-serif; font-weight: bold;">
                <h1>Aptitude Test</h1>
              </div>
              <div class="row">
                <div class="col-md-3">
                  <div class="card bg-light mb-3 text-center"
                    style="height: 100%; max-height: 400px; overflow-y: auto;">
                    <div class="card-body">
                      <div class="xp-section mb-3"
                        style="background: #2C3E50; color: white; padding: 10px; border-radius: 8px;">
                        <div class="level-badge" style="font-size: 1.2rem; font-weight: bold;">
                          <i class="fas fa-star"></i> Level <span id="user-level">1</span>
                        </div>
                        <div class="xp-progress mt-2">
                          <div class="progress" style="height: 8px;">
                            <div id="xp-bar" class="progress-bar bg-warning" role="progressbar" style="width: 0%"></div>
                          </div>
                          <small class="mt-1 d-block">XP: <span id="current-xp">0</span>/<span
                              id="next-level-xp">100</span></small>
                        </div>
                      </div>
                      <h5 class="card-title">Time Left</h5>
                      <div id="timer" class="display-4">60:00</div>
                      <button id="start-btn" class="btn btn-primary btn-lg mt-3" onclick="startTest()">Start
                        Test</button>
                    </div>
                    <div class="card-body">
                      <h5 class="card-title">Jump to Question</h5>
                      <h6 class="mt-3" style="font-family: 'Times new roman', sans-serif; font-weight: bold;">Verbal
                        Ability</h6>
                      <% questions.filter(function(q){ return q.section==='Verbal Ability' }).forEach(function(question,
                        index){ %>
                        <button type="button" id="nav-verbal-<%= index %>" class="btn btn-outline-danger btn-sm mb-1"
                          onclick="jumpToQuestion(<%= index %>)">Q<%= index + 1 %></button>
                        <% }); %>
                          <h6 class="mt-3" style="font-family: 'Times new roman', sans-serif; font-weight: bold;">
                            Logical Reasoning</h6>
                          <% questions.filter(function(q){ return q.section==='Logical Reasoning'
                            }).forEach(function(question, index){ %>
                            <button type="button" id="nav-logical-<%= index %>"
                              class="btn btn-outline-danger btn-sm mb-1" onclick="jumpToQuestion(<%= index + 20 %>)">Q
                              <%= index + 1 %></button>
                            <% }); %>
                              <h6 class="mt-3" style="font-family: 'Times new roman', sans-serif; font-weight: bold;">
                                Quantitative Aptitude</h6>
                              <% questions.filter(function(q){ return q.section==='Quantitative Aptitude'
                                }).forEach(function(question, index){ %>
                                <button type="button" id="nav-quant-<%= index %>"
                                  class="btn btn-outline-danger btn-sm mb-1"
                                  onclick="jumpToQuestion(<%= index + 40 %>)">Q<%= index + 1 %></button>
                                <% }); %>
                    </div>
                  </div>
                </div>
                <div class="col-md-9">
                  <form id="aptitudeForm" action="/responses/submit" method="POST" style="display: none;"
                    onsubmit="disableSubmitButton()">
                    <div id="questions-container">
                      <% questions.forEach(function(question, index){ %>
                        <div class="card mb-4 question" id="question-<%= index %>"
                          style="display: <%= index === 0 ? 'block' : 'none' %>;">
                          <div class="card-body">
                            <h5 class="card-title">Q<%= index + 1 %>: <%= question.questionText %>
                            </h5>
                            <div class="row" style="padding-top: 50px;">
                              <% Object.entries(question.options).forEach(function(opt){ var key=opt[0], val=opt[1]; %>
                                <div class="col-md-6 mb-2" style="padding-bottom: 25px;">
                                  <div class="form-check">
                                    <input class="form-check-input" type="radio" name="question-<%= question._id %>"
                                      value="<%= key %>">
                                    <label class="form-check-label">(<%= key %>) <%= val %></label>
                                  </div>
                                </div>
                                <% }); %>
                            </div>
                            <div class="d-flex justify-content-between mt-3" style="padding-top: 25px;">
                              <button type="button" class="btn btn-secondary"
                                onclick="previousQuestion()">Previous</button>
                              <button type="button" class="btn btn-primary" onclick="nextQuestion()">Next</button>
                              <button type="button" class="btn btn-success"
                                onclick="saveAnswer('<%= question._id %>', <%= index %>)">Save and Next</button>
                            </div>
                          </div>
                        </div>
                        <% }); %>
                    </div>
                    <div class="text-center mt-4">
                      <button type="submit" id="submit-btn" class="btn btn-danger btn-lg">Submit Test</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <%- include('layouts/footer') %>
        <script>
          let timer, totalTime = 3600, currentQuestion = 0, answers = {}, userXP = 0, userLevel = 1, baseXP = 100, questionStartTime;
          function calculateXPForLevel(l) { return baseXP * l; }
          function awardXP(a) {
            userXP += a;
            let n = calculateXPForLevel(userLevel);
            if (userXP >= n) { userLevel++; showLevelUpAnimation(); }
            document.getElementById('current-xp').textContent = userXP;
            document.getElementById('next-level-xp').textContent = calculateXPForLevel(userLevel);
            document.getElementById('user-level').textContent = userLevel;
            document.getElementById('xp-bar').style.width = (userXP % n) / n * 100 + '%';
          }
          function showLevelUpAnimation() {
            let div = document.createElement('div');
            div.style.cssText = 'position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(44,62,80,0.9);color:white;padding:20px;border-radius:10px;animation:fadeInOut 2s forwards;z-index:1000;';
            div.innerHTML = '<h3>🎉 Level Up!</h3><p>You reached Level ' + userLevel + '</p>';
            document.body.appendChild(div);
            setTimeout(function () { div.remove(); }, 2000);
          }
          function startTest() {
            document.getElementById('start-btn').style.display = 'none';
            document.getElementById('aptitudeForm').style.display = 'block';
            questionStartTime = Date.now();
            timer = setInterval(function () {
              let m = Math.floor(totalTime / 60), s = totalTime % 60;
              document.getElementById('timer').innerHTML = m + ':' + (s < 10 ? '0' + s : s);
              totalTime--;
              if (totalTime < 0) {
                clearInterval(timer);
                alert("Time's up! Submitting.");
                document.getElementById('aptitudeForm').submit();
              }
            }, 1000);
          }
          function jumpToQuestion(n) {
            document.querySelectorAll('.question').forEach(function (q, i) { q.style.display = i === n ? 'block' : 'none'; });
            currentQuestion = n;
            questionStartTime = Date.now();
          }
          function nextQuestion() {
            let q = document.querySelectorAll('.question');
            if (currentQuestion < q.length - 1) {
              q[currentQuestion].style.display = 'none';
              currentQuestion++;
              q[currentQuestion].style.display = 'block';
              questionStartTime = Date.now();
            }
          }
          function previousQuestion() {
            let q = document.querySelectorAll('.question');
            if (currentQuestion > 0) {
              q[currentQuestion].style.display = 'none';
              currentQuestion--;
              q[currentQuestion].style.display = 'block';
              questionStartTime = Date.now();
            }
          }
          function saveAnswer(id, idx) {
            let sel = document.querySelector('input[name="question-' + id + '"]:checked');
            if (sel) {
              answers[id] = sel.value;
              let sec = getSection(idx), nIdx = sec === 'verbal' ? idx : (sec === 'logical' ? idx - 20 : idx - 40);
              awardXP(10 + Math.max(0, 30 - Math.floor((Date.now() - questionStartTime) / 1000)));
              let btn = document.getElementById('nav-' + sec + '-' + nIdx);
              if (btn) { btn.classList.remove('btn-outline-danger'); btn.classList.add('btn-outline-success'); }
              nextQuestion();
            } else { alert("Select an answer"); }
          }
          function getSection(i) { return i < 20 ? 'verbal' : (i < 40 ? 'logical' : 'quant'); }
          function disableSubmitButton() { let b = document.getElementById('submit-btn'); if (b) b.disabled = true; }
          const style = document.createElement('style');
          style.textContent = '@keyframes fadeInOut{0%{opacity:0;transform:translate(-50%,-50%) scale(0.8);}10%{opacity:1;transform:translate(-50%,-50%) scale(1.1);}20%{transform:translate(-50%,-50%) scale(1);}80%{opacity:1;}100%{opacity:0;}}';
          document.head.appendChild(style);
        </script>
  </body>

  </html>