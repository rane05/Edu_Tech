<%- include('layouts/header') %>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&display=swap');

        :root {
            --primary-gradient: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
            --secondary-gradient: linear-gradient(135deg, #3b82f6 0%, #2dd4bf 100%);
            --accent-gradient: linear-gradient(135deg, #f59e0b 0%, #ef4444 100%);
            --glass-bg: rgba(255, 255, 255, 0.9);
            --glass-border: rgba(255, 255, 255, 0.4);
        }

        body {
            font-family: 'Outfit', sans-serif;
            background: radial-gradient(circle at 10% 20%, #f1f5f9 0%, #e2e8f0 100%);
            color: #1e293b;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--glass-border);
            border-radius: 2rem;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease;
        }

        .glass-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.1);
        }

        .header-section {
            padding: 120px 0 60px;
            text-align: center;
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.05) 0%, rgba(168, 85, 247, 0.05) 100%);
        }

        .gradient-text {
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 800;
        }

        .section-title {
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 3rem;
            text-align: center;
        }

        .exam-card {
            padding: 2.5rem;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .exam-icon {
            width: 60px;
            height: 60px;
            border-radius: 1.25rem;
            background: var(--primary-gradient);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 10px 20px rgba(99, 102, 241, 0.2);
        }

        .btn-premium {
            background: var(--primary-gradient);
            border: none;
            color: white;
            padding: 1rem 2.5rem;
            border-radius: 1rem;
            font-weight: 700;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            text-decoration: none;
            box-shadow: 0 10px 20px rgba(99, 102, 241, 0.2);
        }

        .btn-premium:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(99, 102, 241, 0.3);
            color: white;
        }

        /* Scholarship Tool Styling */
        .scholarship-card {
            border-left: 5px solid #6366f1;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .badge-merit {
            background: #eef2ff;
            color: #6366f1;
            padding: 0.25rem 0.75rem;
            border-radius: 99px;
            font-size: 0.75rem;
            font-weight: 700;
        }

        .badge-deadline {
            background: #fff1f2;
            color: #e11d48;
            padding: 0.25rem 0.75rem;
            border-radius: 99px;
            font-size: 0.75rem;
            font-weight: 700;
        }

        /* Cost Calculator Styling */
        .cost-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 1rem;
            margin-top: 1.5rem;
        }

        .cost-item {
            background: white;
            padding: 1rem;
            border-radius: 1rem;
            text-align: center;
            border: 1px solid #f1f5f9;
        }

        .cost-val {
            font-weight: 800;
            color: #1e293b;
            font-size: 1.25rem;
            display: block;
        }

        .cost-label {
            font-size: 0.7rem;
            color: #94a3b8;
            text-transform: uppercase;
            font-weight: 700;
        }

        /* Visa Checklist */
        .visa-check-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 0.75rem 0;
            border-bottom: 1px solid #f1f5f9;
            font-weight: 600;
            color: #475569;
        }

        .visa-check-item i {
            color: #10b981;
        }

        .country-selector-btn {
            padding: 0.5rem 1.5rem;
            border-radius: 99px;
            border: 2px solid #e2e8f0;
            background: white;
            font-weight: 700;
            transition: all 0.2s;
        }

        .country-selector-btn.active {
            background: #1e293b;
            color: white;
            border-color: #1e293b;
        }
    </style>

    <body>
        <%- include('layouts/navbar') %>

            <!-- Hero Section -->
            <header class="header-section">
                <div class="container">
                    <h1 class="text-6xl font-black mb-6">Your Gateway to <span class="gradient-text">Global
                            Education</span></h1>
                    <p class="text-xl text-slate-500 max-w-2xl mx-auto mb-10">Expand your horizons. Discover top-tier
                        opportunities at world-renowned universities and shape your international career path today.</p>
                    <div class="flex justify-center gap-6">
                        <a href="#scholarships" class="btn-premium">Find Scholarships</a>
                        <a href="#visa" class="btn-premium bg-slate-900 shadow-none">Visa Guide</a>
                    </div>
                </div>
            </header>

            <!-- Main Content Container for Global Studies -->
            <div class="container py-20">
                <!-- AI Spotlight Section (IELTS) -->
                <div class="glass-card p-10 mb-20 border-2 border-indigo-500 relative overflow-hidden">
                    <div class="row align-items-center">
                        <div class="col-lg-7">
                            <span class="badge-merit mb-4 d-inline-block">Special Collaboration</span>
                            <h2 class="text-4xl font-bold mb-4">Master <span class="text-blue-500">IELTS</span> with AI
                            </h2>
                            <p class="text-lg text-slate-600 mb-8">Boost your speaking and listening scores with our
                                dedicated AI-powered IELTS preparation buddy. Practice anytime, anywhere with real-time
                                feedback.</p>
                            <a href="https://ielts-talk-mate.vercel.app/" target="_blank" class="btn-premium"
                                style="background: #00A8FF;">
                                <i class="fas fa-headset"></i> Start Practice on Talk-Mate
                            </a>
                        </div>
                        <div class="col-lg-5 d-none d-lg-block text-center">
                            <div class="text-9xl opacity-20"><i class="fas fa-microphone-alt"></i></div>
                        </div>
                    </div>
                </div>

                <!-- NEW: Scholarship Explorer -->
                <section id="scholarships" class="mb-24">
                    <h2 class="section-title">Global <span class="gradient-text">Scholarship Vault</span> 2025</h2>
                    <div class="row g-4">
                        <div class="col-lg-4">
                            <div class="glass-card scholarship-card">
                                <div class="flex justify-between mb-3">
                                    <span class="badge-merit">Fully Funded</span>
                                    <span class="badge-deadline">Due: Nov 2025</span>
                                </div>
                                <h4 class="font-bold mb-2">Chevening Scholarships</h4>
                                <p class="text-xs text-slate-500 mb-4">Full funding for a Master's degree at any UK
                                    university for outstanding leaders.</p>
                                <div class="flex justify-between items-center mt-4">
                                    <span class="text-sm font-bold text-slate-900">United Kingdom</span>
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3">View
                                        Details</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="glass-card scholarship-card" style="border-color: #10b981;">
                                <div class="flex justify-between mb-3">
                                    <span class="badge-merit" style="background:#ecfdf5; color:#10b981;">Merit
                                        Based</span>
                                    <span class="badge-deadline">Due: Oct 2025</span>
                                </div>
                                <h4 class="font-bold mb-2">Fulbright Program</h4>
                                <p class="text-xs text-slate-500 mb-4">The flagship international exchange program for
                                    graduate study and research in the USA.</p>
                                <div class="flex justify-between items-center mt-4">
                                    <span class="text-sm font-bold text-slate-900">USA</span>
                                    <button class="btn btn-sm btn-outline-success rounded-pill px-3">View
                                        Details</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="glass-card scholarship-card" style="border-color: #f59e0b;">
                                <div class="flex justify-between mb-3">
                                    <span class="badge-merit" style="background:#fffbeb; color:#f59e0b;">Partial
                                        Fund</span>
                                    <span class="badge-deadline">Due: Mar 2025</span>
                                </div>
                                <h4 class="font-bold mb-2">Erasmus Mundus</h4>
                                <p class="text-xs text-slate-500 mb-4">Study across at least two European countries with
                                    a prestigious EU-funded scholarship.</p>
                                <div class="flex justify-between items-center mt-4">
                                    <span class="text-sm font-bold text-slate-900">European Union</span>
                                    <button class="btn btn-sm btn-outline-warning rounded-pill px-3">View
                                        Details</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="text-center mt-10">
                        <button class="btn btn-primary btn-lg rounded-pill px-5">Load More Scholarships <i
                                class="fas fa-plus ml-2"></i></button>
                    </div>
                </section>

                <!-- NEW: Cost of Living Comparison -->
                <section class="mb-24">
                    <h2 class="section-title">Global <span class="gradient-text">Cost Comparison</span></h2>
                    <p class="text-center text-slate-500 mb-10 max-w-xl mx-auto">Estimating your monthly expenses is key
                        to a stress-free study experience. Here's a snapshot of major cities (USD).</p>
                    <div class="row g-4">
                        <div class="col-lg-6">
                            <div class="glass-card p-6 h-100">
                                <div class="flex items-center gap-4 mb-4">
                                    <div
                                        class="w-12 h-12 bg-slate-900 text-white rounded-xl flex items-center justify-center font-bold">
                                        NYC</div>
                                    <div>
                                        <h4 class="font-bold mb-0">New York City, USA</h4>
                                        <span class="text-xs text-slate-400">High-End Innovation Hub</span>
                                    </div>
                                </div>
                                <div class="cost-grid">
                                    <div class="cost-item">
                                        <span class="cost-label">Rent</span>
                                        <span class="cost-val">$2,200</span>
                                    </div>
                                    <div class="cost-item">
                                        <span class="cost-label">Food</span>
                                        <span class="cost-val">$600</span>
                                    </div>
                                    <div class="cost-item">
                                        <span class="cost-label">Life</span>
                                        <span class="cost-val">$400</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="glass-card p-6 h-100">
                                <div class="flex items-center gap-4 mb-4">
                                    <div
                                        class="w-12 h-12 bg-blue-600 text-white rounded-xl flex items-center justify-center font-bold">
                                        LON</div>
                                    <div>
                                        <h4 class="font-bold mb-0">London, UK</h4>
                                        <span class="text-xs text-slate-400">Global Financial & Cultural Core</span>
                                    </div>
                                </div>
                                <div class="cost-grid">
                                    <div class="cost-item">
                                        <span class="cost-label">Rent</span>
                                        <span class="cost-val">$1,800</span>
                                    </div>
                                    <div class="cost-item">
                                        <span class="cost-label">Food</span>
                                        <span class="cost-val">$500</span>
                                    </div>
                                    <div class="cost-item">
                                        <span class="cost-label">Life</span>
                                        <span class="cost-val">$450</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- NEW: Visa & Post-Study Work Section -->
                <section id="visa" class="mb-24">
                    <div class="row g-6 align-items-center">
                        <div class="col-lg-6">
                            <h2 class="text-4xl font-bold mb-6">Navigating <span class="gradient-text">Visas &
                                    Work</span></h2>
                            <p class="text-slate-500 mb-8">Understanding your rights and requirements is the final
                                hurdle. We've simplified the major stay-back and visa rules for 2025.</p>

                            <div class="flex gap-3 mb-8">
                                <button class="country-selector-btn active" onclick="updateVisaInfo('usa')">USA
                                    (F-1)</button>
                                <button class="country-selector-btn" onclick="updateVisaInfo('uk')">UK
                                    (Student)</button>
                                <button class="country-selector-btn" onclick="updateVisaInfo('canada')">Canada
                                    (SP)</button>
                            </div>

                            <div id="visa-details" class="glass-card p-8 animate-fade">
                                <h4 id="visa-title" class="font-bold mb-4">USA Student Visa (F-1)</h4>
                                <div class="visa-check-item"><i class="fas fa-check-circle"></i> <span>Certificate of
                                        Eligibility (I-20)</span></div>
                                <div class="visa-check-item"><i class="fas fa-check-circle"></i> <span>SEVIS Fee Payment
                                        Receipt</span></div>
                                <div class="visa-check-item"><i class="fas fa-check-circle"></i> <span>Form DS-160
                                        Confirmation</span></div>
                                <div class="visa-check-item"><i class="fas fa-check-circle"></i> <span>Proof of
                                        Financial Support</span></div>

                                <div class="mt-8 pt-6 border-t">
                                    <span class="text-xs font-black uppercase text-indigo-500">Post-Study Work
                                        (OPT)</span>
                                    <p class="text-sm text-slate-600 mt-2">12 months for standard degrees, extension up
                                        to 24 months for STEM students.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="glass-card p-4">
                                <div class="p-4 bg-slate-900 rounded-3xl text-white">
                                    <h4 class="font-bold mb-4 text-center">AI Document Checklist</h4>
                                    <div class="space-y-4">
                                        <div class="p-3 bg-white/10 rounded-xl flex justify-between items-center">
                                            <span class="text-sm">Statement of Purpose</span>
                                            <span class="badge bg-green-500">Verified</span>
                                        </div>
                                        <div class="p-3 bg-white/10 rounded-xl flex justify-between items-center">
                                            <span class="text-sm">Letter of Rec (Academic)</span>
                                            <span class="badge bg-blue-500">In Progress</span>
                                        </div>
                                        <div class="p-3 bg-white/10 rounded-xl flex justify-between items-center">
                                            <span class="text-sm">Resume / CV</span>
                                            <span class="badge bg-yellow-500">Review Required</span>
                                        </div>
                                    </div>
                                    <button class="btn btn-light w-100 mt-6 font-bold py-3 rounded-xl">Unlock AI Doc
                                        Assistant</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Existing Roadmap Steps (Integrated) -->
                <section id="roadmap" class="mb-24 py-16">
                    <h2 class="section-title">Planning your <span class="gradient-text">Timeline</span></h2>
                    <div class="row">
                        <div class="col-md-3 text-center mb-8">
                            <div
                                class="w-16 h-16 bg-white shadow-lg rounded-full flex items-center justify-center mx-auto mb-4 font-black text-xl border-4 border-indigo-500">
                                1</div>
                            <h5 class="font-bold">Research</h5>
                            <p class="text-xs text-slate-400">18 Months Out</p>
                        </div>
                        <div class="col-md-3 text-center mb-8">
                            <div
                                class="w-16 h-16 bg-white shadow-lg rounded-full flex items-center justify-center mx-auto mb-4 font-black text-xl border-4 border-indigo-200">
                                2</div>
                            <h5 class="font-bold">Tests</h5>
                            <p class="text-xs text-slate-400">12 Months Out</p>
                        </div>
                        <div class="col-md-3 text-center mb-8">
                            <div
                                class="w-16 h-16 bg-white shadow-lg rounded-full flex items-center justify-center mx-auto mb-4 font-black text-xl border-4 border-indigo-200">
                                3</div>
                            <h5 class="font-bold">Apply</h5>
                            <p class="text-xs text-slate-400">8 Months Out</p>
                        </div>
                        <div class="col-md-3 text-center mb-8">
                            <div
                                class="w-16 h-16 bg-white shadow-lg rounded-full flex items-center justify-center mx-auto mb-4 font-black text-xl border-4 border-indigo-200">
                                4</div>
                            <h5 class="font-bold">Visa</h5>
                            <p class="text-xs text-slate-400">3 Months Out</p>
                        </div>
                    </div>
                </section>

                <!-- CTA Section -->
                <div class="glass-card p-12 text-center bg-slate-900 text-white border-none">
                    <h2 class="text-4xl font-bold mb-4">Start your global story today.</h2>
                    <p class="opacity-70 mb-8 max-w-xl mx-auto">Our advisors are here to help you navigate the complex
                        world of global education. Let's build your future together.</p>
                    <a href="/book-advisor" class="btn-premium">Book Global Strategy Session</a>
                </div>
            </div>

            <%- include('layouts/footer') %>
                <script>
                    function updateVisaInfo(country) {
                        const title = document.getElementById('visa-title');
                        const details = document.getElementById('visa-details');
                        const btns = document.querySelectorAll('.country-selector-btn');

                        btns.forEach(b => b.classList.remove('active'));
                        event.target.classList.add('active');

                        if (country === 'usa') {
                            title.innerText = 'USA Student Visa (F-1)';
                            details.innerHTML = `
                    <h4 class="font-bold mb-4">USA Student Visa (F-1)</h4>
                    <div class="visa-check-item"><i class="fas fa-check-circle"></i> <span>Certificate of Eligibility (I-20)</span></div>
                    <div class="visa-check-item"><i class="fas fa-check-circle"></i> <span>SEVIS Fee Payment Receipt</span></div>
                    <div class="visa-check-item"><i class="fas fa-check-circle"></i> <span>Form DS-160 Confirmation</span></div>
                    <div class="visa-check-item"><i class="fas fa-check-circle"></i> <span>Proof of Financial Support</span></div>
                    <div class="mt-8 pt-6 border-t">
                        <span class="text-xs font-black uppercase text-indigo-500">Post-Study Work (OPT)</span>
                        <p class="text-sm text-slate-600 mt-2">12 months standard, +24 months extension for STEM (Science, Tech, Engineering, Math) degrees.</p>
                    </div>
                `;
                        } else if (country === 'uk') {
                            title.innerText = 'UK Student Visa (Tier 4)';
                            details.innerHTML = `
                    <h4 class="font-bold mb-4">UK Student Visa</h4>
                    <div class="visa-check-item"><i class="fas fa-check-circle"></i> <span>CAS (Confirmation of Acceptance)</span></div>
                    <div class="visa-check-item"><i class="fas fa-check-circle"></i> <span>IHS (Immigration Health Surcharge)</span></div>
                    <div class="visa-check-item"><i class="fas fa-check-circle"></i> <span>TB Test Results (if applicable)</span></div>
                    <div class="visa-check-item"><i class="fas fa-check-circle"></i> <span>Maintenance Funds Proof</span></div>
                    <div class="mt-8 pt-6 border-t">
                        <span class="text-xs font-black uppercase text-indigo-500">Graduate Route (PSW)</span>
                        <p class="text-sm text-slate-600 mt-2">2 years of stay-back for Bachelor's/Master's graduates, 3 years for PhD graduates.</p>
                    </div>
                `;
                        } else if (country === 'canada') {
                            title.innerText = 'Canada Study Permit';
                            details.innerHTML = `
                    <h4 class="font-bold mb-4">Canada Study Permit</h4>
                    <div class="visa-check-item"><i class="fas fa-check-circle"></i> <span>Letter of Acceptance (LOA)</span></div>
                    <div class="visa-check-item"><i class="fas fa-check-circle"></i> <span>GIC (Guaranteed Investment Cert)</span></div>
                    <div class="visa-check-item"><i class="fas fa-check-circle"></i> <span>CAQ (for Quebec universities)</span></div>
                    <div class="visa-check-item"><i class="fas fa-check-circle"></i> <span>Passport & Biometrics</span></div>
                    <div class="mt-8 pt-6 border-t">
                        <span class="text-xs font-black uppercase text-indigo-500">PGWP (Stay Back)</span>
                        <p class="text-sm text-slate-600 mt-2">Post-Graduation Work Permit (PGWP) allows stays from 8 months to 3 years depending on course duration.</p>
                    </div>
                `;
                        }
                    }
                </script>
    </body>

    </html>