<%- include('layouts/header'); %>
    <%- include('layouts/navbar'); %>

        <style>
            body {
                background-color: #f8fafc;
            }
        </style>

        <div class="min-h-screen pt-32 pb-12 px-4 sm:px-6 lg:px-8 font-sans text-slate-800">
            <div class="max-w-7xl mx-auto space-y-8">

                <!-- Header -->
                <div class="text-center md:text-left mb-12 max-w-2xl">
                    <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl mb-4">
                        Meet Your <span class="text-indigo-600">Mentor</span>
                    </h1>
                    <p class="text-lg text-slate-600">
                        Get 1:1 guidance from industry leaders who have been in your shoes. Level up your career with
                        tailored advice, resume reviews, and mock interviews.
                    </p>
                </div>

                <div class="flex flex-col lg:flex-row gap-8 items-start">

                    <!-- Sticky Sidebar Filters -->
                    <div
                        class="w-full lg:w-80 shrink-0 bg-white p-6 rounded-2xl shadow-sm border border-gray-200 lg:sticky lg:top-8">
                        <h3 class="font-bold text-slate-800 mb-6 flex items-center gap-2">
                            <i class="fas fa-filter text-indigo-500"></i> Filters
                        </h3>

                        <div class="space-y-6">
                            <div>
                                <label
                                    class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2 block">Search</label>
                                <div class="relative">
                                    <div
                                        class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                        <i class="fas fa-search text-sm"></i>
                                    </div>
                                    <input type="text" id="mentorSearch" placeholder="Name, company..."
                                        class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 transition-colors outline-none" />
                                </div>
                            </div>

                            <div>
                                <label
                                    class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2 block">Domain</label>
                                <select id="mentorDomain"
                                    class="w-full bg-slate-50 border border-slate-200 text-slate-700 text-sm rounded-lg p-2 focus:ring-2 focus:ring-indigo-500 outline-none">
                                    <option value="All">All Domains</option>
                                    <option value="System Design">System Design</option>
                                    <option value="Frontend Architecture">Frontend Architecture</option>
                                    <option value="Career Growth">Career Growth</option>
                                </select>
                            </div>

                            <div>
                                <label
                                    class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2 block">Experience</label>
                                <select id="mentorExp"
                                    class="w-full bg-slate-50 border border-slate-200 text-slate-700 text-sm rounded-lg p-2 focus:ring-2 focus:ring-indigo-500 outline-none">
                                    <option value="Any">Any Experience</option>
                                    <option value="3">3+ Years</option>
                                    <option value="5">5+ Years</option>
                                    <option value="10">10+ Years</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Main Content Grid -->
                    <div class="flex-1 w-full">
                        <div class="flex items-center justify-between mb-6">
                            <h2 class="text-2xl font-bold text-slate-800" id="resultsTitle">Top Rated Mentors</h2>
                            <span
                                class="text-sm font-medium text-slate-500 bg-white px-3 py-1.5 rounded-full border border-slate-200"
                                id="resultCount">0 found</span>
                        </div>

                        <div id="mentorGrid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                            <!-- Render Cards -->
                        </div>

                        <div id="emptyState"
                            class="hidden flex-col items-center justify-center py-24 text-center bg-white rounded-2xl border border-gray-100 border-dashed">
                            <div
                                class="w-16 h-16 bg-slate-50 border border-slate-100 rounded-full flex items-center justify-center mb-6 text-slate-400">
                                <i class="fas fa-users text-2xl"></i>
                            </div>
                            <h3 class="text-xl font-semibold text-slate-800 mb-2">No mentors found</h3>
                            <p class="text-slate-500 max-w-sm">
                                We couldn't find any mentors matching your filters. Try adjusting your search criteria.
                            </p>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- Booking Modal -->
        <div id="bookingModal" class="hidden fixed inset-0 z-50 items-center justify-center p-4">
            <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" onclick="toggleBookingModal(false)"></div>
            <div class="bg-white rounded-xl shadow-xl w-full max-w-md relative z-10 flex flex-col scale-95 opacity-0 transition-all duration-300"
                id="bookingContent">
                <div class="flex items-center justify-between p-6 border-b border-gray-100">
                    <h2 class="text-xl font-semibold text-slate-800">Book Session</h2>
                    <button onclick="toggleBookingModal(false)"
                        class="text-slate-400 hover:text-slate-600 p-2 rounded-full hover:bg-slate-100"><i
                            class="fas fa-times"></i></button>
                </div>
                <div class="p-6" id="bookingStep1">
                    <div id="bookingHeaderInfo"
                        class="flex items-center gap-4 p-4 bg-indigo-50/50 rounded-xl border border-indigo-100 mb-6">
                    </div>
                    <div>
                        <label class="text-sm font-semibold text-slate-700 mb-3 block">Available Slots</label>
                        <div id="bookingSlots" class="space-y-2">
                        </div>
                    </div>
                    <div class="pt-4 mt-6 border-t border-slate-100 flex justify-end gap-3">
                        <button onclick="toggleBookingModal(false)"
                            class="px-4 py-2 text-slate-600 border border-slate-200 hover:bg-slate-50 rounded-lg font-medium transition-colors">Cancel</button>
                        <button onclick="confirmBooking()"
                            class="bg-indigo-600 text-white rounded-lg px-4 py-2 hover:bg-indigo-700 transition-colors font-medium">Confirm
                            Booking</button>
                    </div>
                </div>

                <div id="bookingStep2" class="hidden text-center py-8 space-y-4 px-6">
                    <div
                        class="w-16 h-16 bg-green-100 text-green-500 rounded-full flex items-center justify-center mx-auto mb-6">
                        <i class="fas fa-check-circle text-3xl"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-slate-800">Session Confirmed!</h3>
                    <p class="text-slate-600 text-sm">
                        An invitation has been sent to your email. You are all set for your session.
                    </p>
                    <button
                        class="mt-6 w-full bg-slate-800 text-white rounded-lg px-4 py-2 hover:bg-slate-900 font-medium transition-colors"
                        onclick="toggleBookingModal(false)">Close Menu</button>
                </div>
            </div>
        </div>

        <script>
            // Mock Data
            const MENTORS = [
                {
                    id: "m1",
                    name: "Emily Chen",
                    role: "Senior Staff Engineer",
                    company: "Netflix",
                    exp: 12,
                    rating: 4.9,
                    reviews: 142,
                    specs: ["System Design", "Frontend Architecture", "Career Growth"],
                    bio: "Helping engineers break into big tech and level up to Staff.",
                    isVerified: true,
                    price: 150,
                    img: "https://i.pravatar.cc/150?u=emily",
                    slots: ["2026-03-01T10:00:00Z", "2026-03-02T14:30:00Z"]
                },
                {
                    id: "m2",
                    name: "James Wilson",
                    role: "Engineering Manager",
                    company: "Stripe",
                    exp: 8,
                    rating: 4.8,
                    reviews: 89,
                    specs: ["Backend Architecture", "Interview Prep"],
                    bio: "Passionate about building scalable payments infrastructure and mentoring juniors.",
                    isVerified: true,
                    price: 120,
                    img: "https://i.pravatar.cc/150?u=james",
                    slots: ["2026-03-03T16:00:00Z"]
                },
                {
                    id: "m3",
                    name: "Priya Patel",
                    role: "Lead Product Designer",
                    company: "Figma",
                    exp: 5,
                    rating: 5.0,
                    reviews: 210,
                    specs: ["Product Design", "Portfolio Review"],
                    bio: "I specialize in creating pixel-perfect, accessible user interfaces.",
                    isVerified: false,
                    price: 90,
                    img: "https://i.pravatar.cc/150?u=priya",
                    slots: []
                }
            ];

            let selectedMentor = null;

            const LocalStore = {
                getSavedMentors: () => JSON.parse(localStorage.getItem("savedMentors") || "[]"),
                toggleMentor: (id) => {
                    let sm = LocalStore.getSavedMentors();
                    if (sm.includes(id)) sm = sm.filter(x => x !== id);
                    else sm.push(id);
                    localStorage.setItem("savedMentors", JSON.stringify(sm));
                    return sm;
                }
            };

            const renderMentors = (data) => {
                const g = document.getElementById("mentorGrid");
                const e = document.getElementById("emptyState");
                const saved = LocalStore.getSavedMentors();

                document.getElementById("resultCount").innerText = `${data.length} found`;

                if (data.length === 0) {
                    g.classList.add("hidden");
                    e.classList.remove("hidden");
                    e.classList.add("flex");
                    return;
                }

                e.classList.add("hidden");
                e.classList.remove("flex");
                g.classList.remove("hidden");

                g.innerHTML = data.map(m => {
                    const isSaved = saved.includes(m.id);
                    const heartCol = isSaved ? "text-rose-500" : "text-slate-300";
                    const heartBg = isSaved ? "bg-rose-50" : "hover:bg-slate-50";

                    return `
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 flex flex-col h-full group hover:shadow-md hover:-translate-y-1 transition-all">
        <div class="p-6 pb-4">
          <div class="flex justify-between items-start mb-4">
            <div class="relative">
               <img src="${m.img}" class="w-16 h-16 rounded-full object-cover ring-4 ring-indigo-50 group-hover:ring-indigo-100 transition-all" />
               ${m.isVerified ? `<div class="absolute -bottom-1 -right-1 bg-white rounded-full p-0.5"><i class="fas fa-certificate text-teal-500 bg-white"></i></div>` : ''}
            </div>
            <button onclick="toggleSave('${m.id}')" class="p-2 rounded-full transition-colors ${heartBg} hover:text-rose-400">
               <i class="fas fa-heart ${heartCol} text-lg"></i>
            </button>
          </div>

          <div>
            <h3 class="text-xl font-bold text-slate-800 transition-colors group-hover:text-indigo-600">${m.name}</h3>
            <p class="text-sm font-medium text-slate-600">${m.role} @ ${m.company}</p>
            <div class="flex items-center gap-2 mt-2 text-sm text-slate-500">
              <span class="flex items-center gap-1.5"><i class="fas fa-star text-amber-400"></i> ${m.rating} (${m.reviews})</span>
              <span class="text-slate-300">&bull;</span>
              <span>${m.exp}y exp</span>
            </div>
          </div>

          <p class="text-sm text-slate-500 mt-4 line-clamp-2 leading-relaxed h-10">${m.bio}</p>

          <div class="mt-4 flex flex-wrap gap-1.5 h-6 overflow-hidden">
            ${m.specs.map(s => `<span class="px-2 py-0.5 text-[10px] text-slate-600 bg-slate-100 rounded-full font-medium whitespace-nowrap">${s}</span>`).join('')}
          </div>
        </div>

        <div class="mt-auto px-6 py-4 border-t border-gray-100 bg-slate-50/50 flex items-center justify-between rounded-b-xl">
           <div class="font-semibold text-slate-800">$${m.price} <span class="text-xs text-slate-500 font-normal">/ session</span></div>
           <button onclick="openBooking('${m.id}')" class="bg-indigo-600 text-white shadow-sm shadow-indigo-200 px-3 py-1.5 rounded-lg text-sm font-medium hover:bg-indigo-700 transition-colors gap-2 inline-flex items-center">
             <i class="fas fa-comment-dots"></i> Book
           </button>
        </div>
      </div>
    `;
                }).join('');
            };

            window.toggleSave = (id) => {
                LocalStore.toggleMentor(id);
                filterMentors();
            };

            window.openBooking = (id) => {
                selectedMentor = MENTORS.find(m => m.id === id);
                if (!selectedMentor) return;

                const h = document.getElementById("bookingHeaderInfo");
                h.innerHTML = `
    <img src="${selectedMentor.img}" class="w-12 h-12 rounded-full object-cover" />
    <div class="flex-1">
      <p class="font-semibold text-indigo-900">${selectedMentor.name}</p>
      <p class="text-sm text-indigo-700">${selectedMentor.role}</p>
    </div>
    <div class="font-bold text-indigo-900">$${selectedMentor.price}</div>
  `;

                const s = document.getElementById("bookingSlots");
                if (selectedMentor.slots.length === 0) {
                    s.innerHTML = `<p class="text-sm text-slate-500 italic p-3 border border-slate-100 rounded-lg">No available slots this week.</p>`;
                } else {
                    s.innerHTML = selectedMentor.slots.map((d, i) => {
                        const dt = new Date(d);
                        return `
        <label class="flex items-center justify-between p-3 border border-slate-200 rounded-lg cursor-pointer hover:border-indigo-500 hover:bg-slate-50 transition-colors">
          <div class="flex items-center gap-3 text-sm text-slate-700 font-medium">
            <input type="radio" name="slot" value="${i}" class="accent-indigo-600 w-4 h-4 cursor-pointer" />
            ${dt.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric' })}
          </div>
          <span class="text-xs text-slate-500 flex items-center gap-1.5"><i class="fas fa-clock"></i> ${dt.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' })}</span>
        </label>
      `;
                    }).join("");
                }

                toggleBookingModal(true);
            };

            window.confirmBooking = () => {
                const selected = document.querySelector('input[name="slot"]:checked');
                if (!selected && selectedMentor.slots.length > 0) {
                    alert("Please select a slot.");
                    return;
                }

                document.getElementById("bookingStep1").classList.add("hidden");
                document.getElementById("bookingStep2").classList.remove("hidden");
            };

            window.toggleBookingModal = (show) => {
                const m = document.getElementById("bookingModal");
                const c = document.getElementById("bookingContent");
                if (show) {
                    document.getElementById("bookingStep1").classList.remove("hidden");
                    document.getElementById("bookingStep2").classList.add("hidden");

                    m.classList.remove("hidden");
                    m.classList.add("flex");
                    setTimeout(() => { c.classList.remove("scale-95", "opacity-0"); document.body.style.overflow = "hidden"; }, 10);
                } else {
                    c.classList.add("scale-95", "opacity-0");
                    setTimeout(() => { m.classList.add("hidden"); m.classList.remove("flex"); document.body.style.overflow = "auto"; }, 300);
                }
            };

            const filterMentors = () => {
                const q = document.getElementById('mentorSearch').value.toLowerCase();
                const d = document.getElementById('mentorDomain').value;
                const e = document.getElementById('mentorExp').value;

                const res = MENTORS.filter(m => {
                    let me = true;
                    if (e !== "Any") {
                        me = m.exp >= parseInt(e);
                    }
                    const md = d === "All" || m.specs.includes(d);
                    const mq = !q || m.name.toLowerCase().includes(q) || m.company.toLowerCase().includes(q) || m.role.toLowerCase().includes(q);

                    return me && md && mq;
                });

                if (q || d !== "All" || e !== "Any") {
                    document.getElementById("resultsTitle").innerText = "Search Results";
                } else {
                    document.getElementById("resultsTitle").innerText = "Top Rated Mentors";
                }

                renderMentors(res);
            };

            document.getElementById('mentorSearch').addEventListener('input', filterMentors);
            document.getElementById('mentorDomain').addEventListener('change', filterMentors);
            document.getElementById('mentorExp').addEventListener('change', filterMentors);

            document.addEventListener("DOMContentLoaded", filterMentors);
        </script>

        <%- include('layouts/footer'); %>