<%- include('layouts/header') %>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&display=swap');

        :root {
            --primary-gradient: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
        }

        body {
            font-family: 'Outfit', sans-serif;
            background: radial-gradient(circle at 10% 20%, #f1f5f9 0%, #e2e8f0 100%);
            color: #1e293b;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding-top: 100px;
        }

        .success-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.4);
            border-radius: 2.5rem;
            box-shadow: 0 40px 100px rgba(0, 0, 0, 0.1);
            padding: 4rem;
            max-width: 800px;
            width: 90%;
            text-align: center;
        }

        .check-icon {
            width: 100px;
            height: 100px;
            background: #10b981;
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            margin: 0 auto 2rem;
            box-shadow: 0 20px 40px rgba(16, 185, 129, 0.3);
            animation: scaleIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .pathway-preview {
            background: #f8fafc;
            border: 1px dashed #cbd5e1;
            border-radius: 1.5rem;
            padding: 2rem;
            margin-top: 3rem;
            text-align: left;
        }

        .path-step {
            display: flex;
            gap: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .path-num {
            width: 30px;
            height: 30px;
            background: #6366f1;
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 0.8rem;
            flex-shrink: 0;
        }

        @keyframes scaleIn {
            0% {
                transform: scale(0);
            }

            100% {
                transform: scale(1);
            }
        }

        .btn-premium {
            background: var(--primary-gradient);
            border: none;
            color: white;
            padding: 1rem 2.5rem;
            border-radius: 1rem;
            font-weight: 700;
            text-decoration: none;
            display: inline-block;
            margin-top: 2rem;
            box-shadow: 0 10px 20px rgba(99, 102, 241, 0.2);
        }
    </style>

    <body>
        <%- include('layouts/navbar') %>

            <div class="success-card">
                <!-- Intelligent Pathway Generation Module -->
                <div class="check-icon"><i class="fas fa-check"></i></div>
                <h1 class="text-4xl font-black mb-4">Strategic Session Confirmed!</h1>
                <p class="text-lg text-slate-500">Congratulations <%= name %>, your session for studying **<%= course %>
                            ** in **<%= country %>** (Intake: **<%= intake %>**) has been locked in.</p>

                <div class="pathway-preview">
                    <h4 class="font-bold mb-6 text-indigo-600"><i class="fas fa-map-signs mr-2"></i> Your Preparation
                        Pathway (Preview)</h4>

                    <div class="path-step">
                        <div class="path-num">1</div>
                        <div>
                            <h6 class="font-bold mb-1">Application Hub Pre-Set</h6>
                            <p class="text-sm text-slate-500 mb-0">Our advisor is currently shortlisting **top 5
                                universities** in <%= country %> that match your profile.</p>
                        </div>
                    </div>

                    <div class="path-step">
                        <div class="path-num">2</div>
                        <div>
                            <h6 class="font-bold mb-1">Scholarship Matching</h6>
                            <p class="text-sm text-slate-500 mb-0">Scanning for <%= intake %> intake scholarships
                                    applicable to <%= course %> students.</p>
                        </div>
                    </div>

                    <div class="path-step">
                        <div class="path-num">3</div>
                        <div>
                            <h6 class="font-bold mb-1">Priority Review Meeting</h6>
                            <p class="text-sm text-slate-500 mb-0">Expect a call/email within **24 hours** to schedule
                                your initial profile assessment.</p>
                        </div>
                    </div>
                </div>

                <a href="/dashboard" class="btn-premium">Go to My Dashboard</a>
                <p class="text-xs text-slate-400 mt-6">A summary of your session booking has been saved to your profile
                    profile analytics.</p>
            </div>

            <%- include('layouts/footer') %>
    </body>

    </html>