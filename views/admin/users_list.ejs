<%- include('../layouts/header') %>

    <style>
        .glass-table-wrapper {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(10px);
            border-radius: 2.5rem;
            border: 1px solid rgba(255, 255, 255, 0.5);
        }

        .role-pill {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
        }
    </style>

    <div class="min-h-screen bg-slate-50 pt-24 pb-12 px-4 md:px-8">
        <div class="max-w-6xl mx-auto">
            <!-- Explorer Header -->
            <div class="mb-10 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
                <div>
                    <h1 class="text-4xl font-black text-slate-900 tracking-tight mb-2 capitalize">
                        <%= role %> Architecture
                    </h1>
                    <p class="text-slate-500 font-bold uppercase tracking-[0.2em] text-[10px] flex items-center gap-2">
                        <span class="w-1.5 h-1.5 bg-indigo-500 rounded-full"></span>
                        Directory of Registered <%= role %>s
                    </p>
                </div>
                <a href="/admin/dashboard"
                    class="px-6 py-3 bg-white border border-slate-200 rounded-2xl text-slate-800 font-black text-xs uppercase tracking-widest hover:bg-slate-50 transition-all flex items-center gap-3 shadow-sm">
                    <i class="fas fa-arrow-left text-indigo-500"></i> Control Hub
                </a>
            </div>

            <div class="glass-table-wrapper shadow-xl shadow-slate-200/50 overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-900 text-white">
                                <th class="px-8 py-6 text-[10px] font-black uppercase tracking-[0.2em]">Profile Identity
                                </th>
                                <th class="px-8 py-6 text-[10px] font-black uppercase tracking-[0.2em]">Communication
                                </th>
                                <th class="px-8 py-6 text-[10px] font-black uppercase tracking-[0.2em]">Designation/Loc
                                </th>
                                <th class="px-8 py-6 text-[10px] font-black uppercase tracking-[0.2em]">Management</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            <% if (users.length> 0) { %>
                                <% users.forEach(u=> { %>
                                    <tr class="hover:bg-slate-50/50 transition-all duration-300">
                                        <td class="px-8 py-6">
                                            <div class="flex items-center gap-5">
                                                <div
                                                    class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center font-black shadow-inner">
                                                    <%= u.username.charAt(0).toUpperCase() %>
                                                </div>
                                                <div>
                                                    <p class="font-black text-slate-900 tracking-tight">
                                                        <%= u.username %>
                                                    </p>
                                                    <span
                                                        class="px-2 py-0.5 bg-slate-100 text-slate-400 text-[8px] font-black uppercase tracking-widest rounded">
                                                        <%= role %>
                                                    </span>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-8 py-6">
                                            <div class="flex items-center gap-2 font-bold text-slate-600 text-sm">
                                                <i class="fas fa-envelope text-slate-300"></i>
                                                <%= u.email || 'No Email Provided' %>
                                            </div>
                                        </td>
                                        <td class="px-8 py-6">
                                            <div
                                                class="stat-pill px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl inline-block">
                                                <p class="text-xs font-bold text-slate-700">
                                                    <%= u.education || u.location || 'N/A' %>
                                                </p>
                                            </div>
                                        </td>
                                        <td class="px-8 py-6">
                                            <div class="flex gap-4">
                                                <button
                                                    class="w-10 h-10 flex items-center justify-center bg-white border border-slate-200 text-slate-400 hover:text-indigo-600 hover:border-indigo-600 rounded-xl transition-all shadow-sm">
                                                    <i class="fas fa-eye text-sm"></i>
                                                </button>
                                                <button
                                                    class="w-10 h-10 flex items-center justify-center bg-white border border-slate-200 text-slate-400 hover:text-rose-600 hover:border-rose-600 rounded-xl transition-all shadow-sm">
                                                    <i class="fas fa-trash-alt text-sm"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="4" class="px-8 py-24 text-center">
                                                    <div class="flex flex-col items-center opacity-30">
                                                        <i class="fas fa-user-slash text-4xl mb-4"></i>
                                                        <p class="font-black uppercase tracking-[0.2em] text-xs">No <%=
                                                                role %>s in local registry</p>
                                                    </div>
                                                </td>
                                            </tr>
                                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <%- include('../layouts/footer') %>