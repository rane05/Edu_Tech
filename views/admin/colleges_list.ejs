<%- include('../layouts/header') %>

    <style>
        .glass-table-wrapper {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(10px);
            border-radius: 2.5rem;
            border: 1px solid rgba(255, 255, 255, 0.5);
        }

        .table-row-hover:hover {
            background: rgba(99, 102, 241, 0.02);
        }
    </style>

    <div class="min-h-screen bg-slate-50 pt-24 pb-12 px-4 md:px-8">
        <div class="max-w-6xl mx-auto">
            <!-- Explorer Header -->
            <div class="mb-10 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
                <div>
                    <h1 class="text-4xl font-black text-slate-900 tracking-tight mb-2">Institutional Registry</h1>
                    <p class="text-slate-500 font-bold uppercase tracking-[0.2em] text-[10px] flex items-center gap-2">
                        <span class="w-1.5 h-1.5 bg-indigo-500 rounded-full"></span>
                        Central Management Hub
                    </p>
                </div>
                <a href="/admin/dashboard"
                    class="px-6 py-3 bg-white border border-slate-200 rounded-2xl text-slate-800 font-black text-xs uppercase tracking-widest hover:bg-slate-50 transition-all flex items-center gap-3 shadow-sm">
                    <i class="fas fa-arrow-left text-indigo-500"></i> Back to Control
                </a>
            </div>

            <div class="glass-table-wrapper shadow-xl shadow-slate-200/50 overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-900 text-white">
                                <th class="px-8 py-6 text-[10px] font-black uppercase tracking-[0.2em]">Partner
                                    Institution</th>
                                <th class="px-8 py-6 text-[10px] font-black uppercase tracking-[0.2em]">Deployment</th>
                                <th class="px-8 py-6 text-[10px] font-black uppercase tracking-[0.2em]">Operational
                                    Status</th>
                                <th class="px-8 py-6 text-[10px] font-black uppercase tracking-[0.2em]">Strategic Level
                                </th>
                                <th class="px-8 py-6 text-[10px] font-black uppercase tracking-[0.2em]">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            <% if (colleges.length> 0) { %>
                                <% colleges.forEach(clg=> { %>
                                    <tr class="table-row-hover transition-all duration-300">
                                        <td class="px-8 py-6">
                                            <div class="flex items-center gap-5">
                                                <div
                                                    class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center font-black shadow-inner border border-indigo-100">
                                                    <%= clg.name.charAt(0).toUpperCase() %>
                                                </div>
                                                <div>
                                                    <p class="font-black text-slate-900 tracking-tight">
                                                        <%= clg.name %>
                                                    </p>
                                                    <p
                                                        class="text-[10px] text-slate-400 font-bold uppercase tracking-tighter">
                                                        <%= clg.university %>
                                                    </p>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-8 py-6">
                                            <div class="flex items-center gap-2 font-bold text-slate-600 text-sm">
                                                <i class="fas fa-map-marker-alt text-slate-300"></i>
                                                <%= clg.location %>
                                            </div>
                                        </td>
                                        <td class="px-8 py-6">
                                            <span
                                                class="inline-flex items-center px-3 py-1 bg-emerald-50 text-emerald-600 text-[9px] font-black uppercase tracking-widest rounded-full border border-emerald-100">
                                                <span
                                                    class="w-1.5 h-1.5 bg-emerald-500 rounded-full mr-2 animate-pulse"></span>
                                                Active
                                            </span>
                                        </td>
                                        <td class="px-8 py-6">
                                            <% if (clg.isSponsored) { %>
                                                <span
                                                    class="inline-flex items-center px-4 py-2 bg-amber-50 text-amber-600 text-[10px] font-black uppercase tracking-widest rounded-xl border border-amber-200 shadow-sm">
                                                    <i class="fas fa-gem mr-2 text-[10px]"></i> Premium
                                                </span>
                                                <% } else { %>
                                                    <span
                                                        class="text-slate-300 text-[10px] font-black uppercase tracking-widest ml-1">Standard</span>
                                                    <% } %>
                                        </td>
                                        <td class="px-8 py-6">
                                            <form action="/admin/college/sponsor/<%= clg._id %>" method="POST">
                                                <button type="submit"
                                                    class="px-5 py-2.5 <%= clg.isSponsored ? 'bg-rose-50 text-rose-500 border border-rose-100 hover:bg-rose-100' : 'bg-indigo-600 text-white hover:bg-slate-900' %> rounded-xl text-[10px] font-black uppercase tracking-widest transition-all shadow-sm">
                                                    <%= clg.isSponsored ? 'Revoke Boost' : 'Boost Rank' %>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="5" class="px-8 py-24 text-center">
                                                    <div class="flex flex-col items-center opacity-30">
                                                        <i class="fas fa-database text-4xl mb-4"></i>
                                                        <p class="font-black uppercase tracking-[0.2em] text-xs">
                                                            Registry is currently empty</p>
                                                    </div>
                                                </td>
                                            </tr>
                                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <%- include('../layouts/footer') %>