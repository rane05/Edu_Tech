<%- include('../layouts/header') %>

    <div class="min-h-screen bg-slate-50 pt-24 pb-12 px-4">
        <div class="max-w-6xl mx-auto">
            <div class="mb-8 flex justify-between items-center">
                <div>
                    <h1 class="text-3xl font-bold text-slate-900">User Feedback & Reviews</h1>
                    <p class="text-slate-500">Listen to what your users are saying.</p>
                </div>
                <a href="/admin/dashboard"
                    class="text-sm font-bold text-indigo-600 hover:underline flex items-center gap-2 font-bold px-4 py-2 bg-white rounded-xl border border-slate-200">
                    <i class="fas fa-arrow-left"></i> Dashboard
                </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <% if (feedbacks.length> 0) { %>
                    <% feedbacks.forEach(fb=> { %>
                        <div
                            class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 flex flex-col justify-between group hover:shadow-xl transition-all duration-300">
                            <div>
                                <div class="flex justify-between items-start mb-4">
                                    <div class="flex items-center gap-3">
                                        <div
                                            class="w-10 h-10 bg-slate-100 rounded-xl flex items-center justify-center text-slate-400 font-bold group-hover:bg-indigo-600 group-hover:text-white transition-all">
                                            <%= fb.username.charAt(0) %>
                                        </div>
                                        <div>
                                            <h3 class="font-bold text-slate-900">
                                                <%= fb.username %>
                                            </h3>
                                            <span
                                                class="px-2 py-0.5 bg-slate-100 text-slate-500 text-[10px] font-black uppercase rounded-md tracking-tighter">
                                                <%= fb.role %>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="text-amber-400 text-sm">
                                        <% for(let i=0; i<fb.rating; i++) { %><i class="fas fa-star"></i>
                                            <% } %>
                                    </div>
                                </div>
                                <h4 class="font-bold text-slate-900 mb-2 mt-4">
                                    <%= fb.subject %>
                                </h4>
                                <p class="text-slate-600 text-sm leading-relaxed mb-6 italic">"<%= fb.message %>"</p>
                            </div>
                            <div class="flex justify-between items-center pt-4 border-t border-slate-50">
                                <span class="text-[10px] text-slate-400 font-bold uppercase tracking-widest">
                                    <%= new Date(fb.createdAt).toLocaleDateString() %>
                                </span>
                                <form action="/admin/feedback/delete/<%= fb._id %>" method="POST">
                                    <button type="submit" class="text-slate-300 hover:text-rose-500 transition-colors">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                        <% }) %>
                            <% } else { %>
                                <div class="col-span-full py-20 text-center">
                                    <div
                                        class="w-20 h-20 bg-slate-100 rounded-full flex items-center justify-center text-slate-300 mx-auto mb-6">
                                        <i class="fas fa-comment-slash text-3xl"></i>
                                    </div>
                                    <h3 class="text-xl font-bold text-slate-900">No feedback yet</h3>
                                    <p class="text-slate-500">User reviews and complaints will appear here.</p>
                                </div>
                                <% } %>
            </div>
        </div>
    </div>

    <%- include('../layouts/footer') %>