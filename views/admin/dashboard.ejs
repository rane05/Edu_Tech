<%- include('../layouts/header') %>

    <style>
        .admin-gradient-bg {
            background: radial-gradient(circle at top right, #f8fafc, #eff6ff);
        }

        .glass-panel {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.4);
        }

        .admin-card {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid transparent;
        }

        .admin-card:hover {
            transform: translateY(-5px);
            border-color: rgba(99, 102, 241, 0.2);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05);
        }

        .sidebar-link {
            transition: all 0.2s ease;
        }

        .sidebar-link:hover {
            background: rgba(99, 102, 241, 0.05);
            transform: translateX(5px);
        }

        .pulse-amber {
            box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.4);
            animation: pulse-amber 2s infinite;
        }

        @keyframes pulse-amber {
            0% {
                box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.4);
            }

            70% {
                box-shadow: 0 0 0 10px rgba(245, 158, 11, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(245, 158, 11, 0);
            }
        }
    </style>

    <div class="min-h-screen bg-slate-50 pt-24 pb-12 px-4 md:px-8">
        <div class="max-w-7xl mx-auto">
            <!-- Modern Admin Header -->
            <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6 mb-12">
                <div>
                    <h1 class="text-4xl font-black text-slate-900 tracking-tight mb-2">Platform Control Hub</h1>
                    <p class="text-slate-500 font-medium flex items-center gap-2">
                        <span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
                        System operational • Monitoring <%= stats.studentCount + stats.teacherCount + stats.collegeCount
                            %> total nodes
                    </p>
                </div>
                <div class="flex flex-wrap gap-4">
                    <a href="/admin/feedback"
                        class="px-6 py-3 bg-white border border-slate-200 rounded-2xl text-slate-800 font-black text-xs uppercase tracking-widest hover:bg-slate-50 transition-all flex items-center gap-3 shadow-sm">
                        <i class="fas fa-comment-alt text-indigo-500"></i> Feedback Logs
                    </a>
                    <button
                        class="px-6 py-3 bg-slate-900 text-white rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-slate-800 transition-all shadow-xl shadow-slate-200 flex items-center gap-3">
                        <i class="fas fa-shield-alt text-emerald-400"></i> Security Audit
                    </button>
                </div>
            </div>

            <!-- System Intelligence Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-16">
                <a href="/admin/users/student"
                    class="glass-panel admin-card p-8 rounded-[2rem] relative overflow-hidden group">
                    <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                        <i class="fas fa-user-graduate text-6xl text-blue-600"></i>
                    </div>
                    <div class="flex items-center gap-4 mb-6">
                        <div
                            class="w-12 h-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center text-xl shadow-inner">
                            <i class="fas fa-graduation-cap"></i>
                        </div>
                        <span class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Scholars</span>
                    </div>
                    <h3 class="text-4xl font-black text-slate-900 mb-1">
                        <%= stats.studentCount %>
                    </h3>
                    <p class="text-xs text-slate-400 font-bold uppercase tracking-tight">Active Students</p>
                </a>

                <a href="/admin/users/teacher"
                    class="glass-panel admin-card p-8 rounded-[2rem] relative overflow-hidden group">
                    <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                        <i class="fas fa-chalkboard-teacher text-6xl text-emerald-600"></i>
                    </div>
                    <div class="flex items-center gap-4 mb-6">
                        <div
                            class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center text-xl shadow-inner">
                            <i class="fas fa-user-tie"></i>
                        </div>
                        <span class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Mentors</span>
                    </div>
                    <h3 class="text-4xl font-black text-slate-900 mb-1">
                        <%= stats.teacherCount %>
                    </h3>
                    <p class="text-xs text-slate-400 font-bold uppercase tracking-tight">Expert Educators</p>
                </a>

                <a href="/admin/users/parent"
                    class="glass-panel admin-card p-8 rounded-[2rem] relative overflow-hidden group">
                    <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                        <i class="fas fa-users text-6xl text-amber-600"></i>
                    </div>
                    <div class="flex items-center gap-4 mb-6">
                        <div
                            class="w-12 h-12 bg-amber-50 text-amber-600 rounded-xl flex items-center justify-center text-xl shadow-inner">
                            <i class="fas fa-heart"></i>
                        </div>
                        <span class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Guardians</span>
                    </div>
                    <h3 class="text-4xl font-black text-slate-900 mb-1">
                        <%= stats.parentCount %>
                    </h3>
                    <p class="text-xs text-slate-400 font-bold uppercase tracking-tight">Parental Accounts</p>
                </a>

                <a href="/admin/colleges"
                    class="glass-panel admin-card p-8 rounded-[2rem] relative overflow-hidden group">
                    <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                        <i class="fas fa-university text-6xl text-indigo-600"></i>
                    </div>
                    <div class="flex items-center gap-4 mb-6">
                        <div
                            class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center text-xl shadow-inner">
                            <i class="fas fa-building"></i>
                        </div>
                        <span
                            class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Institutions</span>
                    </div>
                    <h3 class="text-4xl font-black text-slate-900 mb-1">
                        <%= stats.collegeCount %>
                    </h3>
                    <p class="text-xs text-slate-400 font-bold uppercase tracking-tight">Registered Colleges</p>
                </a>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
                <!-- Experience Monitoring (Feedback) -->
                <div class="lg:col-span-7">
                    <div
                        class="bg-white rounded-[2.5rem] shadow-xl shadow-slate-200/40 border border-slate-100 overflow-hidden">
                        <div class="p-8 border-b border-slate-50 flex justify-between items-center bg-slate-50/30">
                            <div>
                                <h2 class="text-2xl font-black text-slate-900 tracking-tight">User Sentiment</h2>
                                <p class="text-[10px] font-black text-slate-300 uppercase tracking-[0.2em] mt-1">Direct
                                    feedback stream</p>
                            </div>
                            <a href="/admin/feedback"
                                class="w-10 h-10 flex items-center justify-center bg-white rounded-xl text-slate-400 hover:text-indigo-600 shadow-sm transition-all">
                                <i class="fas fa-expand-alt text-sm"></i>
                            </a>
                        </div>

                        <div class="divide-y divide-slate-50">
                            <% if (feedbacks.length> 0) { %>
                                <% feedbacks.forEach(fb=> { %>
                                    <div class="p-8 hover:bg-slate-50/50 transition-all duration-300">
                                        <div class="flex justify-between items-start mb-4">
                                            <div class="flex items-center gap-4">
                                                <div
                                                    class="w-12 h-12 bg-slate-900 text-white rounded-xl flex items-center justify-center text-sm font-black shadow-lg">
                                                    <%= fb.username.charAt(0).toUpperCase() %>
                                                </div>
                                                <div>
                                                    <div class="flex items-center gap-3">
                                                        <h4 class="font-black text-slate-900">
                                                            <%= fb.username %>
                                                        </h4>
                                                        <span
                                                            class="px-3 py-1 bg-indigo-50 text-indigo-600 text-[9px] font-black uppercase tracking-widest rounded-full border border-indigo-100">
                                                            <%= fb.role %>
                                                        </span>
                                                    </div>
                                                    <div class="flex text-amber-400 text-[10px] mt-1">
                                                        <% for(let i=0; i<fb.rating; i++) { %><i
                                                                class="fas fa-star"></i>
                                                            <% } %>
                                                                <% for(let i=fb.rating; i<5; i++) { %><i
                                                                        class="far fa-star opacity-30"></i>
                                                                    <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="pl-16">
                                            <h5 class="text-sm font-black text-slate-800 mb-2 tracking-tight">
                                                <%= fb.subject %>
                                            </h5>
                                            <p class="text-slate-500 text-sm leading-relaxed mb-1 font-medium italic">"
                                                <%= fb.message %>"</p>
                                        </div>
                                    </div>
                                    <% }) %>
                                        <% } else { %>
                                            <div class="p-20 text-center">
                                                <i class="fas fa-smile text-4xl text-slate-200 mb-4"></i>
                                                <p class="text-slate-400 font-bold uppercase tracking-widest text-xs">
                                                    Awaiting fresh reviews</p>
                                            </div>
                                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Strategic Assets (Colleges) -->
                <div class="lg:col-span-5">
                    <div
                        class="bg-white rounded-[2.5rem] shadow-xl shadow-slate-200/40 border border-slate-100 overflow-hidden">
                        <div class="p-8 border-b border-slate-50 flex justify-between items-center bg-slate-50/30">
                            <div>
                                <h2 class="text-2xl font-black text-slate-900 tracking-tight">Enterprise Partners</h2>
                                <p class="text-[10px] font-black text-slate-300 uppercase tracking-[0.2em] mt-1">Recent
                                    college registrations</p>
                            </div>
                            <a href="/admin/colleges"
                                class="w-10 h-10 flex items-center justify-center bg-white rounded-xl text-slate-400 hover:text-indigo-600 shadow-sm transition-all">
                                <i class="fas fa-cog text-sm"></i>
                            </a>
                        </div>

                        <div class="divide-y divide-slate-50">
                            <% if (recentColleges.length> 0) { %>
                                <% recentColleges.forEach(clg=> { %>
                                    <div class="p-8 flex items-center justify-between group">
                                        <div class="flex items-center gap-5">
                                            <div
                                                class="w-14 h-14 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                                                <i class="fas fa-university text-xl"></i>
                                            </div>
                                            <div>
                                                <h4 class="font-black text-slate-900 tracking-tight">
                                                    <%= clg.name %>
                                                </h4>
                                                <p
                                                    class="text-xs text-slate-400 font-bold flex items-center gap-1 mt-1">
                                                    <i class="fas fa-map-marker-alt text-slate-300"></i>
                                                    <%= clg.location %>
                                                </p>
                                            </div>
                                        </div>

                                        <div class="flex flex-col items-end gap-3">
                                            <% if (clg.isSponsored) { %>
                                                <span
                                                    class="w-8 h-8 flex items-center justify-center bg-amber-100 text-amber-600 rounded-full pulse-amber"
                                                    title="Premium Partner">
                                                    <i class="fas fa-gem text-xs"></i>
                                                </span>
                                                <% } %>
                                                    <form action="/admin/college/sponsor/<%= clg._id %>" method="POST">
                                                        <button
                                                            class="px-4 py-2 border border-slate-200 text-slate-500 rounded-xl text-[10px] font-black uppercase tracking-widest hover:border-indigo-500 hover:text-indigo-600 transition-all bg-white">
                                                            <%= clg.isSponsored ? 'Revoke Status' : 'Boost' %>
                                                        </button>
                                                    </form>
                                        </div>
                                    </div>
                                    <% }) %>
                                        <% } else { %>
                                            <div class="p-20 text-center">
                                                <i class="fas fa-building text-4xl text-slate-200 mb-4"></i>
                                                <p class="text-slate-400 font-bold uppercase tracking-widest text-xs">No
                                                    new registrations</p>
                                            </div>
                                            <% } %>
                        </div>
                    </div>

                    <!-- Admin Action Card -->
                    <div
                        class="mt-10 bg-indigo-900 rounded-[2.5rem] p-10 text-white relative overflow-hidden shadow-2xl">
                        <div
                            class="absolute -top-20 -left-20 w-64 h-64 bg-indigo-500 rounded-full blur-[100px] opacity-20">
                        </div>
                        <div class="relative z-10">
                            <h3 class="text-2xl font-black mb-4">Developer Tools</h3>
                            <p class="text-indigo-200 text-sm mb-8 leading-relaxed font-medium">Access low-level
                                platform configurations and API monitoring logs.</p>
                            <button
                                class="w-full py-5 bg-white text-indigo-900 rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-indigo-50 transition-all shadow-xl shadow-indigo-900/40">
                                Launch Terminal
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('../layouts/footer') %>