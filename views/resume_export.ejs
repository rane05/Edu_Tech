<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= profile.fullName %> - Resume</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f3f4f6;
            color: #111827;
        }
        .resume-container {
            max-width: 800px;
            margin: 40px auto;
            background: white;
            padding: 50px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }
        .header {
            border-bottom: 2px solid #e5e7eb;
            padding-bottom: 20px;
            margin-bottom: 20px;
        }
        .section-title {
            color: #374151;
            font-size: 1.125rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 15px;
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 5px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        @media print {
            body { background: white !important; margin: 0; padding: 0; }
            .resume-container { box-shadow: none; margin: 0 auto; padding: 0; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body class="antialiased" onload="window.print()">

    <!-- Print Action Bar -->
    <div class="no-print text-center py-4 bg-indigo-600 text-white shadow-md">
        <p class="mb-2">This is your print-ready resume layout.</p>
        <button onclick="window.print()" class="px-4 py-2 bg-white text-indigo-600 font-bold rounded shadow hover:bg-slate-50 transition">
            <i class="fas fa-print"></i> Print / Save as PDF
        </button>
    </div>

    <div class="resume-container">
        <!-- Header Section -->
        <header class="header text-center">
            <h1 class="text-4xl font-extrabold text-slate-900 tracking-tight mb-2 uppercase">
                <%= profile.fullName %>
            </h1>
            <p class="text-lg text-slate-600 font-medium mb-3">
                <%= profile.careerGoal || (roadmap ? roadmap.careerTitle : 'Aspiring Professional') %>
            </p>
            <div class="flex flex-wrap justify-center items-center gap-4 text-sm text-slate-500">
                <% if(profile.email) { %> <span><i class="fas fa-envelope"></i> <%= profile.email %></span> <% } %>
                <% if(profile.phone) { %> <span><i class="fas fa-phone"></i> <%= profile.phone %></span> <% } %>
                <% if(profile.state || profile.district) { %> <span><i class="fas fa-map-marker-alt"></i> <%= profile.district %>, <%= profile.state %></span> <% } %>
                <br>
                <% if(profile.linkedin && profile.linkedin !== 'N/A') { %> <span><i class="fab fa-linkedin"></i> <%= profile.linkedin %></span> <% } %>
                <% if(profile.twitter && profile.twitter !== 'N/A') { %> <span><i class="fab fa-twitter"></i> <%= profile.twitter %></span> <% } %>
            </div>
        </header>

        <!-- Education -->
        <section class="mb-8">
            <h2 class="section-title"><i class="fas fa-graduation-cap"></i> Education</h2>
            <div class="flex justify-between items-start mb-2">
                <div>
                    <h3 class="font-bold text-slate-800 text-lg"><%= profile.collegeName || 'N/A' %></h3>
                    <p class="text-slate-600 italic"><%= profile.course || 'N/A' %></p>
                </div>
                <div class="text-right">
                    <span class="font-semibold text-slate-500"><%= profile.year || 'Enrollment Year' %></span>
                </div>
            </div>
        </section>

        <!-- Skills Base + AI Suggestions -->
        <section class="mb-8">
            <h2 class="section-title"><i class="fas fa-code"></i> Technical Skills</h2>
            <div class="space-y-4">
                <div>
                    <h4 class="font-bold text-slate-700 text-sm mb-2">Core Competencies:</h4>
                    <p class="text-slate-600 leading-relaxed font-medium">
                        <%= profile.skills || 'General Studies' %>
                    </p>
                </div>
                
                <% if(roadmap && roadmap.skill_gap && roadmap.skill_gap.missing_skills.length > 0) { %>
                <div class="bg-blue-50/50 p-4 border border-blue-100 rounded-lg">
                    <h4 class="font-bold text-blue-800 text-sm mb-2 flex justify-between">
                        <span>Ongoing Learning (AI Identified Gaps)</span>
                        <span class="text-xs font-normal bg-indigo-100 text-indigo-700 px-2 py-0.5 rounded">Continuous Learner</span>
                    </h4>
                    <ul class="list-disc list-inside text-sm text-slate-600">
                        <% roadmap.skill_gap.missing_skills.slice(0, 5).forEach(m => { %>
                            <li>Actively developing skills in <strong><%= m %></strong></li>
                        <% }); %>
                    </ul>
                </div>
                <% } %>
            </div>
        </section>

        <!-- Notable Projects -->
        <% if(roadmap && roadmap.generated_phases) { %>
        <section class="mb-8">
            <h2 class="section-title"><i class="fas fa-laptop-code"></i> Academic & Personal Projects</h2>
            <div class="space-y-5">
                <% 
                let projectCount = 0;
                roadmap.generated_phases.forEach(p => { 
                    if(p.projects && p.projects.length > 0 && projectCount < 3) { 
                        p.projects.forEach(proj => {
                            if(projectCount < 3) {
                %>
                <div>
                    <h3 class="font-bold text-slate-800"><%= proj.title %></h3>
                    <p class="text-sm text-slate-500 mb-1 font-semibold uppercase tracking-wide">Phase Focus: <%= p.phaseName %></p>
                    <p class="text-slate-600 text-sm mt-1 leading-relaxed"><%= proj.objective %></p>
                </div>
                <% 
                                projectCount++;
                            }
                        }); 
                    } 
                }); 
                if (projectCount === 0) {
                %>
                <p class="text-slate-500 italic">No specific projects listed in roadmap yet.</p>
                <% } %>
            </div>
        </section>
        <% } %>

        <% if(profile.interviewStats && profile.interviewStats.length > 0) { %>
        <!-- Soft Skills / Extracurricular Insights -->
        <section class="mb-8">
            <h2 class="section-title"><i class="fas fa-comments"></i> Soft Skills & Professional Readiness</h2>
            <p class="text-slate-600 text-sm leading-relaxed mb-2">Validated through interactive simulation environments:</p>
            <ul class="list-disc list-inside text-sm text-slate-600">
                <% 
                // Only show top recent performances
                profile.interviewStats.slice(-3).reverse().forEach(stat => {
                %>
                <li>Demonstrated <strong><%= stat.overallSentiment %></strong> communication in <%= stat.role %> behavioral simulation.</li>
                <% }); %>
            </ul>
        </section>
        <% } %>

    </div>

</body>
</html>
