<!-- Custom Tailwind Configuration & Scoped Styles -->
<style>
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap');

    :root {
        --glass-bg: rgba(255, 255, 255, 0.7);
        --glass-border: rgba(255, 255, 255, 0.2);
        --glass-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.07);
    }

    .dark {
        --glass-bg: rgba(15, 23, 42, 0.6);
        --glass-border: rgba(255, 255, 255, 0.05);
        --glass-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
    }

    body {
        font-family: 'Outfit', sans-serif;
        background-color: #f8fafc;
        transition: background-color 0.5s ease;
    }

    .dark body {
        background-color: #020617;
    }

    .glass-morphism {
        background: var(--glass-bg);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--glass-border);
        box-shadow: var(--glass-shadow);
    }

    .gradient-text {
        background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }
</style>

<div class="min-h-screen pb-20 px-4 md:px-8 pt-24">
    <div class="max-w-6xl mx-auto">
        <!-- Header -->
        <div class="flex flex-col md:flex-row justify-between items-center mb-10 gap-6">
            <div>
                <h1 class="text-4xl font-extrabold text-slate-800 dark:text-white leading-tight">
                    Student <span class="gradient-text">Directory</span>
                </h1>
                <p class="text-slate-500 dark:text-slate-400 font-medium">
                    <i class="fas fa-university mr-2"></i>
                    <%= collegeName %> | Enrolled Talent
                </p>
            </div>
            <div class="flex items-center gap-4">
                <span class="px-6 py-2 glass-morphism rounded-full text-indigo-500 font-bold text-sm">
                    <%= students.length %> Total Students
                </span>
                <a href="/teacher_home"
                    class="p-3 glass-morphism rounded-2xl text-slate-600 dark:text-slate-300 hover:text-indigo-500 transition-all">
                    <i class="fas fa-arrow-left mr-2"></i> Dashboard
                </a>
            </div>
        </div>

        <!-- Student Grid -->
        <% if (students.length> 0) { %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <% students.forEach((student, index)=> { %>
                    <div
                        class="glass-morphism p-6 rounded-[2.5rem] hover:scale-[1.02] transition-all duration-300 group relative overflow-hidden">
                        <div class="absolute top-0 right-0 p-6 opacity-5 group-hover:opacity-10 transition-opacity">
                            <span class="text-6xl font-black text-slate-900 dark:text-white">#<%= index + 1 %></span>
                        </div>

                        <div class="flex flex-col items-center text-center">
                            <div class="relative mb-6">
                                <div
                                    class="w-24 h-24 rounded-[2rem] overflow-hidden border-4 border-white dark:border-slate-800 shadow-xl">
                                    <img src="<%= student.profileImage || '/images/default-profile.png' %>"
                                        alt="<%= student.fullName %>" class="w-full h-full object-cover">
                                </div>
                                <div
                                    class="absolute -bottom-2 -right-2 w-8 h-8 bg-indigo-500 rounded-xl flex items-center justify-center text-white text-xs border-2 border-white dark:border-slate-800">
                                    <%= student.year.charAt(0) %>
                                </div>
                            </div>

                            <h3 class="text-xl font-bold text-slate-800 dark:text-white mb-1">
                                <%= student.fullName %>
                            </h3>
                            <p class="text-xs text-indigo-500 font-black uppercase tracking-widest mb-6">
                                <%= student.year %> Student
                            </p>

                            <div class="w-full space-y-3 mb-8">
                                <div
                                    class="flex items-center gap-3 p-3 bg-white/40 dark:bg-slate-800/40 rounded-2xl border border-white/10">
                                    <i class="fas fa-envelope text-indigo-500 text-sm"></i>
                                    <span class="text-sm dark:text-slate-300 truncate">
                                        <%= student.email %>
                                    </span>
                                </div>
                                <div
                                    class="flex items-center gap-3 p-3 bg-white/40 dark:bg-slate-800/40 rounded-2xl border border-white/10">
                                    <i class="fas fa-phone text-emerald-500 text-sm"></i>
                                    <span class="text-sm dark:text-slate-300">
                                        <%= student.phone %>
                                    </span>
                                </div>
                            </div>

                            <button
                                class="w-full py-4 bg-slate-800 dark:bg-white text-white dark:text-slate-900 rounded-2xl text-xs font-black uppercase tracking-widest hover:bg-slate-900 dark:hover:bg-slate-200 transition-all shadow-lg">
                                View Profile Analytics
                            </button>
                        </div>
                    </div>
                    <% }) %>
            </div>
            <% } else { %>
                <div class="glass-morphism rounded-[3rem] p-20 text-center">
                    <i class="fas fa-user-slash text-6xl text-slate-200 dark:text-slate-800 mb-6"></i>
                    <h3 class="text-2xl font-bold text-slate-400">Classroom currently empty</h3>
                    <p class="text-slate-500 mt-2">No students from <%= collegeName %> have linked their profiles yet.
                    </p>
                </div>
                <% } %>
    </div>
</div>

<script>
    // System States (Syncing dark mode)
    const setupDarkMode = () => {
        const isDark = localStorage.getItem('darkMode') === 'true' ||
            (!('darkMode' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', isDark);
    };
    setupDarkMode();
</script>

<%- include('layouts/footer'); -%>