<%- include('layouts/header'); %>
    <%- include('layouts/navbar'); %>

        <div class="container" style="margin-top: 100px; margin-bottom: 50px;">
            <div class="row">
                <!-- Search Form -->
                <div class="col-md-4">
                    <div class="card p-4 shadow-sm" style="border-radius: 12px; border: none; background: #fff;">
                        <h3 class="mb-4 fw-bold text-primary">🎓 College Predictor</h3>
                        <form action="/api/cet/predict" method="POST">
                            <div class="mb-3">
                                <label class="form-label fw-bold">CET Percentile</label>
                                <input type="number" step="0.01" name="score" class="form-control"
                                    placeholder="e.g. 85.5" value="<%= locals.score || '' %>" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Category</label>
                                <select name="category" class="form-select" required>
                                    <option value="OPEN" <%=locals.category==='OPEN' ? 'selected' : '' %>>OPEN / General
                                    </option>
                                    <option value="OBC" <%=locals.category==='OBC' ? 'selected' : '' %>>OBC</option>
                                    <option value="SC" <%=locals.category==='SC' ? 'selected' : '' %>>SC</option>
                                    <option value="ST" <%=locals.category==='ST' ? 'selected' : '' %>>ST</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Location (City)</label>
                                <input type="text" name="location" class="form-control" placeholder="e.g. Mumbai, Pune"
                                    value="<%= locals.location || '' %>">
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Preferred Branch</label>
                                <input type="text" name="branch" class="form-control"
                                    placeholder="e.g. Computer Science" value="<%= locals.branch || '' %>">
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">🔮 Predict
                                Colleges</button>
                        </form>

                        <% if(locals.error) { %>
                            <div class="alert alert-danger mt-3">
                                <%= error %>
                            </div>
                            <% } %>
                    </div>

                    <div class="mt-4 p-3 bg-light rounded-3 border">
                        <h6 class="fw-bold text-primary mb-2"><i class="fas fa-magic me-2"></i>How it works</h6>
                        <small class="text-muted">
                            Our AI models analyze last 5 years of cutoffs to estimate your chance of admission across
                            different rounds.
                            <strong>Safe</strong> means you have a high chance (>85% Fit).
                        </small>
                    </div>
                </div>

                <!-- Results Display -->
                <div class="col-md-8">
                    <% if(locals.results && results.length> 0) { %>
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h4 class="fw-bold mb-0">🎯 Recommended Colleges (<%= results.length %>)</h4>
                            <div class="text-muted small">Showing Top Matches</div>
                        </div>

                        <% results.forEach(college=> { %>
                            <div class="card mb-4 shadow-sm border-0 overflow-hidden" style="border-radius: 15px;">
                                <div class="card-body p-4">
                                    <div class="row">
                                        <div class="col-md-8">
                                            <div class="d-flex align-items-center mb-2">
                                                <span
                                                    class="badge <%= college.badgeClass || 'bg-info' %> me-2 px-3 py-2">
                                                    <%= college.type || 'Match' %>
                                                </span>
                                                <span class="text-muted small"><i
                                                        class="fas fa-map-marker-alt me-1"></i>
                                                    <%= college.location || 'Maharashtra' %>
                                                </span>
                                            </div>
                                            <h5 class="fw-bold mb-1 text-dark">
                                                <%= college.name %>
                                            </h5>
                                            <p class="text-muted small mb-3">
                                                <%= college.university || 'Affiliated Institution' %>
                                            </p>

                                            <h6 class="fw-bold small text-uppercase text-secondary">Best Matching
                                                Branches:</h6>
                                            <div class="d-flex flex-column gap-2">
                                                <% college.branches.slice(0, 3).forEach(b=> { %>
                                                    <div
                                                        class="p-2 border rounded bg-light d-flex justify-content-between align-items-center">
                                                        <div>
                                                            <div class="fw-bold small">
                                                                <%= b.name %>
                                                            </div>
                                                            <div class="text-muted" style="font-size: 0.75rem;">
                                                                Latest Cutoff: <strong>
                                                                    <%= b.cutoff.toFixed(2) %>%
                                                                </strong> (Round <%= b.round %>, <%= b.year %>)
                                                            </div>
                                                        </div>
                                                        <div class="text-end">
                                                            <div class="fw-bold text-primary"
                                                                style="font-size: 0.85rem;">
                                                                <%= b.fitScore %>% Fit
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <% }); %>
                                            </div>
                                        </div>
                                        <div
                                            class="col-md-4 text-center d-flex flex-column justify-content-center align-items-center border-start ps-4">
                                            <div class="mb-3">
                                                <div class="display-6 fw-bold text-primary">
                                                    <%= college.fitScore %>%
                                                </div>
                                                <div class="text-uppercase text-muted"
                                                    style="font-size: 0.7rem; letter-spacing: 1px;">Overall Fit Score
                                                </div>
                                            </div>
                                            <button class="btn btn-outline-primary btn-sm rounded-pill px-4">View
                                                Details</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                                <% } else if(locals.results) { %>
                                    <div class="text-center py-5 bg-white rounded shadow-sm">
                                        <i class="fas fa-search fa-3x text-muted mb-3"></i>
                                        <h4>No exact matches found</h4>
                                        <p class="text-muted">Try removing location or branch filters to see more
                                            results.</p>
                                        <a href="/cet-predictor" class="btn btn-primary">Clear Filters</a>
                                    </div>
                                    <% } else { %>
                                        <div class="text-center py-5 bg-white rounded shadow-sm"
                                            style="border: 2px dashed #eee;">
                                            <i class="fas fa-university fa-4x text-primary mb-4 opacity-50"></i>
                                            <h3>Ready to predict your future?</h3>
                                            <p class="text-muted">Enter your CET details on the left to get
                                                institutional recommendations.</p>
                                        </div>
                                        <% } %>
                </div>
            </div>
        </div>