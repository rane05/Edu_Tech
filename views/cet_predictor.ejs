                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h5 class="card-title text-primary">
                                                <%= college.name %>
                                            </h5>
                                            <h6 class="card-subtitle mb-2 text-muted"><i
                                                    class="fas fa-map-marker-alt"></i>
                                                <%= college.location %>
