            <!-- ===== RIGHT: Analytics Panel ===== -->
            <div class="col-lg-3 d-none d-lg-block">
                <div class="analytics-panel sticky-top" style="top: 80px;">

                    <% if (locals.results && results.length > 0) { %>
                    <h6 class="fw-bold mb-2">Admission Overview</h6>
                    <div class="d-flex justify-content-around text-center mb-3">
                        <div>
                            <% var safeLen = results.filter(function(r){ return r.type===' Safe'; }).length; %>
                                                                <div class="fw-bold text-success h5 mb-0">
                                                                    <%= safeLen %>
                                                                </div>
                                                                <small class="text-muted">Safe</small>
                                                    </div>
                                                    <div>
                                                        <% var modLen=results.filter(function(r){ return
                                                            r.type==='Moderate' ; }).length; %>
                                                            <div class="fw-bold text-warning h5 mb-0">
                                                                <%= modLen %>
                                                            </div>
                                                            <small class="text-muted">Moderate</small>
                                                    </div>
                                                    <div>
                                                        <% var drmLen=results.filter(function(r){ return
                                                            r.type==='Dream' ; }).length; %>
                                                            <div class="fw-bold text-danger h5 mb-0">
                                                                <%= drmLen %>
                                                            </div>
                                                            <small class="text-muted">Dream</small>
                                                    </div>
                                                </div>
                                                <div class="progress mb-1" style="height:8px">
                                                    <% var safeP=Math.round(safeLen / results.length * 100); %>
                                                        <% var modP=Math.round(modLen / results.length * 100); %>
                                                            <% var drmP=Math.round(drmLen / results.length * 100); %>
                                                                <div class="progress-bar bg-success"
                                                                    style="width:<%= safeP %>%"></div>
                                                                <div class="progress-bar bg-warning"
                                                                    style="width:<%= modP %>%"></div>
                                                                <div class="progress-bar bg-danger"
                                                                    style="width:<%= drmP %>%"></div>
                                                </div>
                                                <small class="text-muted d-block mb-3">Distribution of <%=
                                                        results.length %> results</small>
                                                <hr>
                                                <% } %>

                                                    <h6 class="fw-bold mb-3">Branch Trends (2024)</h6>
                                                    <canvas id="trendChart" height="140"></canvas>

                                                    <div class="mt-4 p-3 bg-light rounded-3 border">
                                                        <h6 class="fw-bold text-primary mb-1"><i
                                                                class="fas fa-lightbulb me-2"></i>AI Tip</h6>
                                                        <small class="text-muted">
                                                            <% if (locals.results && results.length> 0) { %>
                                                                You qualify for <strong>
                                                                    <%= results.length %>
                                                                </strong> colleges.
                                                                <strong>
                                                                    <%= results.filter(r=>r.type==='Safe').length %>
