                                                                <% } else { %>
                                                                    Students with borderline scores often secure seats
                                                                    in
                                                                    Round 2-3. Explore multiple categories!
                                                                    <% } %>
                                                        </small>
                                                    </div>

                                                    <!-- Wishlist Panel -->
                                                    <div class="mt-4 p-3 bg-white rounded-3 border" id="wishlist-panel"
                                                        style="display:none">
                                                        <h6 class="fw-bold mb-2"><i
                                                                class="fas fa-heart text-danger me-2"></i>Saved Colleges
                                                        </h6>
                                                        <div id="wishlist-items" class="d-flex flex-column gap-2"></div>
                                                    </div>
                                            </div>
                                        </div>
                                </div>
                </div><!-- /container -->

                <!-- ===== COMPARE BAR ===== -->
                <div id="compare-bar">
                    <div id="compare-items"></div>
                    <button class="btn btn-warning fw-bold px-4" onclick="openCompare()">
                        <i class="fas fa-balance-scale me-2"></i>Compare Now
                    </button>
                    <button class="btn btn-outline-light btn-sm" onclick="clearCompare()">Clear</button>
                </div>

                <!-- ===== CUTOFF HISTORY MODAL ===== -->
                <div class="modal fade" id="historyModal" tabindex="-1">
                    <div class="modal-dialog modal-lg modal-history">
                        <div class="modal-content">
                            <div class="modal-header" style="background: var(--primary-gradient); color: white;">
