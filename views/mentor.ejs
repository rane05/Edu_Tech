    <style>
      .spirit-shape {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        z-index: -1;
        opacity: 0.15;
        animation: float 10s infinite ease-in-out;
      }

      .shape-1 {
        width: 300px;
        height: 300px;
        background: var(--color-primary);
        top: -100px;
        left: -100px;
      }

      .shape-2 {
        width: 400px;
        height: 400px;
        background: var(--color-secondary);
        bottom: 20%;
        right: -100px;
        animation-delay: -5s;
      }

      .badge-glass {
        display: inline-block;
        padding: 6px 16px;
        background: rgba(255, 184, 0, 0.1);
        border: 1px solid rgba(255, 184, 0, 0.2);
        border-radius: var(--radius-full);
        color: var(--color-primary);
        font-weight: 700;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        backdrop-filter: blur(4px);
        margin-bottom: 1rem;
      }

      .mentor-img-large {
        width: 180px;
        height: 180px;
        object-fit: cover;
        border-radius: var(--radius-2xl);
        border: 4px solid white;
      }

      .mentor-card-enhanced {
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        border: 1px solid rgba(0, 0, 0, 0.05);
      }

      .stat-mini {
        border-left: 2px solid var(--color-primary);
        padding-left: 12px;
      }

      .skill-tag-pill {
        background: var(--gray-100);
        color: var(--color-dark);
        padding: 4px 12px;
        border-radius: var(--radius-full);
        font-size: 0.85rem;
        font-weight: 500;
        border: 1px solid var(--gray-200);
        transition: all 0.2s;
      }

      .skill-tag-pill:hover {
        background: var(--color-primary);
        color: var(--color-dark);
        border-color: var(--color-primary);
      }

      .bg-success-soft {
        background-color: rgba(16, 185, 129, 0.1);
      }

      .bg-primary-soft {
        background-color: rgba(37, 99, 235, 0.1);
      }

      .sparkle-dot {
        font-size: 0.5rem;
        vertical-align: middle;
        margin-right: 4px;
        animation: pulse Sparkle 2s infinite;
      }

      @keyframes pulseSparkle {
        0% {
          opacity: 0.4;
          transform: scale(0.8);
        }

        50% {
          opacity: 1;
          transform: scale(1.2);
        }

        100% {
          opacity: 0.4;
          transform: scale(0.8);
        }
      }

      .mentor-bio {
        line-height: 1.7;
        font-size: 1.05rem;
      }

      .h1 {
        font-size: 1.75rem;
        font-weight: 800;
        letter-spacing: -0.02em;
      }

      @media (max-width: 768px) {
        .mentor-img-large {
          width: 140px;
          height: 140px;
        }
      }
    </style>

