<%- include('layouts/header'); %>
  <%- include('layouts/navbar'); %>

    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

      :root {
        --primary-gradient: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
        --accent: #6366F1;
        --secondary-accent: #22C55E;
        --warning: #F59E0B;
        --bg-main: #F7F9FC;
        --card-bg: rgba(255, 255, 255, 0.7);
        --text-primary: #0F172A;
        --text-secondary: #64748B;
        --text-muted: #94A3B8;
      }

      body {
        font-family: 'Inter', sans-serif !important;
        background-color: var(--bg-main) !important;
        background-image:
          radial-gradient(circle at 10% 20%, rgba(99, 102, 241, 0.05), transparent 40%),
          radial-gradient(circle at 90% 0%, rgba(139, 92, 246, 0.05), transparent 40%) !important;
        background-attachment: fixed;
        color: var(--text-primary);
        overflow-x: hidden;
      }

      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        font-weight: 700 !important;
        letter-spacing: -0.03em !important;
        color: var(--text-primary) !important;
      }

      /* Hero Section */
      .hero-glass {
        background: linear-gradient(135deg, #FFFFFF 0%, #F1F5F9 100%) !important;
        border-radius: 2rem !important;
        border: 1px solid rgba(255, 255, 255, 0.8) !important;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.03) !important;
        position: relative;
        overflow: hidden;
        margin-top: 2rem;
      }

      .hero-glass::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -10%;
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.1) 0%, transparent 70%);
        border-radius: 50%;
        pointer-events: none;
      }

      .badge-premium {
        display: inline-block;
        padding: 6px 16px;
        background: rgba(99, 102, 241, 0.1);
        border: 1px solid rgba(99, 102, 241, 0.2);
        border-radius: 20px;
        color: var(--accent);
        font-weight: 700;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 1rem;
      }

      .text-gradient {
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        display: inline-block;
      }

      /* Mentor Cards */
      .mentor-card {
        background: var(--card-bg) !important;
        border-radius: 1.5rem !important;
        border: 1px solid rgba(255, 255, 255, 0.8) !important;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04) !important;
        transition: all 0.4s cubic-bezier(.4, 0, .2, 1) !important;
        backdrop-filter: blur(20px) !important;
        -webkit-backdrop-filter: blur(20px) !important;
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
      }

      .mentor-card:hover {
        transform: translateY(-6px) !important;
        box-shadow: 0 20px 40px rgba(99, 102, 241, 0.1) !important;
        border-color: rgba(255, 255, 255, 1) !important;
      }

      .mentor-card-header {
        position: relative;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1.25rem;
        border-bottom: 1px solid rgba(0, 0, 0, 0.03);
      }

      .mentor-avatar-wrapper {
        position: relative;
        flex-shrink: 0;
      }

      .mentor-avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid white;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08);
      }

      .status-indicator {
        position: absolute;
        bottom: 2px;
        right: 2px;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        border: 2px solid white;
        background: var(--secondary-accent);
      }

      .status-busy {
        background: var(--warning);
      }

      .mentor-name {
        font-size: 1.25rem;
        font-weight: 800;
        margin-bottom: 0.25rem;
        color: var(--text-primary);
      }

      .mentor-headline {
        font-size: 0.85rem;
        color: var(--accent);
        font-weight: 600;
        margin-bottom: 0;
        line-height: 1.4;
      }

      .mentor-card-body {
        padding: 1.5rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
      }

      .mentor-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin-bottom: 1.25rem;
        text-align: center;
        background: rgba(248, 250, 252, 0.5);
        padding: 1rem;
        border-radius: 1rem;
      }

      .stat-val {
        display: block;
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--text-primary);
      }

      .stat-lbl {
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-secondary);
        font-weight: 700;
      }

      .mentor-bio {
        font-size: 0.9rem;
        color: var(--text-secondary);
        line-height: 1.6;
        margin-bottom: 1.5rem;
        flex-grow: 1;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .mentor-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
      }

      .mentor-tag {
        background: white;
        border: 1px solid rgba(0, 0, 0, 0.05);
        color: var(--text-secondary);
        padding: 4px 12px;
        border-radius: 100px;
        font-size: 0.75rem;
        font-weight: 600;
        transition: all 0.2s;
      }

      .mentor-card:hover .mentor-tag {
        border-color: rgba(99, 102, 241, 0.2);
        color: var(--accent);
      }

      /* Buttons */
      .btn-premium {
        background: var(--primary-gradient) !important;
        border-radius: 12px !important;
        box-shadow: 0 8px 20px rgba(99, 102, 241, 0.3) !important;
        color: white !important;
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        transition: all 0.3s ease !important;
        border: none;
        width: 100%;
        text-align: center;
        text-decoration: none;
        display: inline-block;
      }

      .btn-premium:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 25px rgba(99, 102, 241, 0.4) !important;
        color: white !important;
      }

      /* Search & Filter Bar */
      .search-bar-container {
        position: sticky;
        top: 20px;
        z-index: 100;
        margin-bottom: 2rem;
      }

      .search-input-wrapper {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0, 0, 0, 0.05);
        border-radius: 1rem;
        padding: 0.5rem 1rem;
        display: flex;
        align-items: center;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        transition: all 0.3s;
      }

      .search-input-wrapper:focus-within {
        border-color: var(--accent);
        box-shadow: 0 10px 40px rgba(99, 102, 241, 0.15);
      }

      .search-input {
        border: none;
        background: transparent;
        padding: 10px 15px;
        width: 100%;
        font-size: 1rem;
        color: var(--text-primary);
        font-weight: 500;
      }

      .search-input:focus {
        outline: none;
      }

      .search-icon {
        color: var(--accent);
        font-size: 1.2rem;
        margin-left: 10px;
      }

      /* Staggered Animations */
      .stagger-item {
        opacity: 0;
        transform: translateY(30px);
        animation: fadeInUp 0.6s cubic-bezier(0.165, 0.84, 0.44, 1) forwards;
      }

      @keyframes fadeInUp {
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
    </style>

    <div class="container pb-5">

      <!-- Hero Section -->
      <div class="hero-glass p-5 text-center mb-5 stagger-item" style="animation-delay: 0.1s;">
        <span class="badge-premium">Expert Guidance</span>
        <h1 class="display-4 fw-black mb-3 text-balance">
          Learn from the <span class="text-gradient">Best in Tech</span>
        </h1>
        <p class="text-muted mx-auto fs-5 text-balance" style="max-width: 700px; font-weight: 500;">
          Direct access to 60+ world-class mentors, leading YouTubers, and engineers from top companies. Book your
          1-on-1 session instantly.
        </p>
      </div>

      <!-- Live Search Bar -->
      <div class="row justify-content-center search-bar-container stagger-item" style="animation-delay: 0.2s;">
        <div class="col-lg-8">
          <div class="search-input-wrapper">
            <i class="fas fa-search search-icon"></i>
            <input type="text" id="mentorSearch" class="search-input"
              placeholder="Search by name, company, or domain (e.g. Google, System Design)...">
          </div>
        </div>
      </div>

      <!-- Mentors Grid -->
      <div class="row g-4" id="mentorsGrid">
        <% if(mentors && mentors.length> 0) { %>
          <% mentors.forEach((mentor, index)=> { %>
            <div class="col-12 col-md-6 col-lg-4 mentor-col stagger-item"
              style="animation-delay: <%= 0.2 + (index * 0.05) %>s;"
              data-search="<%= mentor.name.toLowerCase() %> <%= mentor.headline.toLowerCase() %> <%= mentor.tags.join(' ').toLowerCase() %>">
              <div class="mentor-card">
                <div class="mentor-card-header">
                  <div class="mentor-avatar-wrapper">
                    <img src="<%= mentor.img %>" alt="<%= mentor.name %>" class="mentor-avatar">
                    <div class="status-indicator <%= mentor.status.includes('Available') ? '' : 'status-busy' %>"
                      title="<%= mentor.status %>"></div>
                  </div>
                  <div>
                    <h3 class="mentor-name">
                      <%= mentor.name %>
                    </h3>
                    <p class="mentor-headline">
                      <%= mentor.headline %>
                    </p>
                    <div class="d-flex align-items-center mt-1">
                      <i class="fas fa-star text-warning" style="font-size: 0.8rem;"></i>
                      <span class="ms-1 fw-bold" style="font-size: 0.85rem;">
                        <%= mentor.rating %>
                      </span>
                      <span class="text-muted ms-1" style="font-size: 0.75rem;">(<%= mentor.reviews %>)</span>
                    </div>
                  </div>
                </div>
                <div class="mentor-card-body">
                  <div class="mentor-stats">
                    <div>
                      <span class="stat-val">
                        <%= mentor.students %>
                      </span>
                      <span class="stat-lbl">Students</span>
                    </div>
                    <div>
                      <span class="stat-val">
                        <%= mentor.exp %>
                      </span>
                      <span class="stat-lbl">Years Exp</span>
                    </div>
                    <div>
                      <span class="stat-val">
                        <%= mentor.sessions %>
                      </span>
                      <span class="stat-lbl">Sessions</span>
                    </div>
                  </div>

                  <p class="mentor-bio">
                    <%= mentor.bio %>
                  </p>

                  <div class="mentor-tags">
                    <% mentor.tags.forEach(tag=> { %>
                      <span class="mentor-tag">
                        <%= tag %>
                      </span>
                      <% }) %>
                  </div>

                  <div class="mt-auto pt-3 border-top" style="border-color: rgba(0,0,0,0.03) !important;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                      <span
                        class="badge <%= mentor.status.includes('Available') ? 'bg-success' : 'bg-warning text-dark' %> bg-opacity-10 text-<%= mentor.status.includes('Available') ? 'success' : 'warning' %> fw-bold px-3 py-2 rounded-pill"
                        style="font-size: 0.7rem;">
                        <i class="fas fa-calendar-check me-1"></i>
                        <%= mentor.status %>
                      </span>
                    </div>
                    <a href="https://calendly.com/mrsachinchaurasiya/30min" target="_blank" class="btn-premium">
                      View Profile & Book
                    </a>
                  </div>
                </div>
              </div>
            </div>
            <% }) %>
              <% } else { %>
                <div class="col-12 text-center py-5">
                  <h3 class="text-muted">No Mentors Found.</h3>
                </div>
                <% } %>
      </div>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const searchInput = document.getElementById('mentorSearch');
        const mentorCols = document.querySelectorAll('.mentor-col');

        searchInput.addEventListener('input', (e) => {
          const searchTerm = e.target.value.toLowerCase().trim();

          mentorCols.forEach(col => {
            const searchData = col.getAttribute('data-search');
            if (searchData.includes(searchTerm)) {
              col.style.display = 'block';
              // Optional: reset animation so it pops back in smoothly
              col.style.animation = 'none';
              col.offsetHeight; /* trigger reflow */
              col.style.animation = 'fadeInUp 0.4s ease forwards';
            } else {
              col.style.display = 'none';
            }
          });
        });
      });
    </script>

    <%- include('layouts/footer'); %>